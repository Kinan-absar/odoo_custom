<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="asr_account_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Account Statement</h2>
                        <table class="table table-sm table-borderless mb-3">
                            <tr><td><strong>Type</strong></td><td><span t-esc="'Receivable (Customer)' if o.statement_type == 'receivable' else 'Payable (Vendor)'"/></td></tr>
                            <tr><td><strong>Partner</strong></td><td><span t-field="o.partner_id"/></td></tr>
                            <tr><td><strong>Company</strong></td><td><span t-field="o.company_id"/></td></tr>
                            <tr><td><strong>Period</strong></td><td><span t-field="o.date_from"/> - <span t-field="o.date_to"/></td></tr>
                        </table>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th><th>Journal Entry</th><th>Reference</th><th>Due Date</th>
                                    <th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-field="l.date"/></td>
                                    <td><span t-esc="l.move or ''"/></td>
                                    <td><span t-esc="l.reference or ''"/></td>
                                    <td><span t-field="l.due_date"/></td>
                                    <td class="text-end"><span t-field="l.debit"/></td>
                                    <td class="text-end"><span t-field="l.credit"/></td>
                                    <td class="text-end"><span t-field="l.balance"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="mt-3 text-end">
                            <strong>Final Balance: </strong><span t-field="o.final_balance"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
