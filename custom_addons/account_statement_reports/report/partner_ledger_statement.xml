<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="asr_partner_ledger_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="color:#714B67; margin-bottom:4px;">Account Statement</h2>
                        <div style="margin-bottom:16px;">
                            <strong t-out="o.partner_id.display_name"/>
                            <span t-if="o.date_from or o.date_to"> — </span>
                            <span t-if="o.date_from" t-out="o.date_from"/>
                            <span t-if="o.date_from and o.date_to"> to </span>
                            <span t-if="o.date_to" t-out="o.date_to"/>
                        </div>

                        <table class="table table-sm table-borderless" style="margin-bottom:12px;">
                            <tbody>
                                <tr>
                                    <td><strong>Company</strong></td><td t-out="o.company_id.display_name"/>
                                    <td><strong>Account Type</strong></td><td t-out="dict(o._fields['account_type'].selection).get(o.account_type)"/>
                                </tr>
                                <tr>
                                    <td><strong>Opening Balance</strong></td>
                                    <td><span t-out="o.opening_balance" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td><strong>Entries</strong></td><td t-out="dict(o._fields['move_state'].selection).get(o.move_state)"/>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered" style="font-size:11px; width:100%;">
                            <thead>
                                <tr style="background:#f2f2f2;">
                                    <th>Date</th>
                                    <th>Journal Entry</th>
                                    <th>Reference</th>
                                    <th>Due Date</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-if="o.show_opening_balance">
                                    <td t-out="o.date_from or ''"/>
                                    <td>Opening Balance</td>
                                    <td></td><td></td><td></td><td></td>
                                    <td class="text-end"><span t-out="o.opening_balance" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td t-out="line.date or ''"/>
                                    <td t-out="line.move_name or ''"/>
                                    <td t-out="line.reference or ''"/>
                                    <td t-out="line.due_date or ''"/>
                                    <td class="text-end"><span t-out="line.debit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td class="text-end"><span t-out="line.credit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td class="text-end"><span t-out="line.balance" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="6" class="text-end"><strong>Final Balance</strong></td>
                                    <td class="text-end"><strong><span t-out="o.final_balance" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
