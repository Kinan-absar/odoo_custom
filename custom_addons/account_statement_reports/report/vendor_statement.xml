<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="asr_vendor_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-set="statement_kind" t-value="'payable'"/>
                <t t-set="statement_title" t-value="'Vendor Statement'"/>
                <t t-set="partner_label" t-value="'Vendor'"/>
                <t t-set="layout_document_title" t-value="False"/>
                <t t-call="web.external_layout"><t t-call="account_statement_reports.asr_statement_document"/></t>
            </t>
        </t>
    </template>
</odoo>
