<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_form_statement_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.statement.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <!--
                Keep Odoo's own Vendor Bills smart button and MOVE it to the front.
                We identify it by its supplier_invoice_count field instead of referencing
                a version-specific action XML ID.
            -->
            <xpath expr="//div[@name='button_box']/button[1]" position="before">
                <xpath expr="//div[@name='button_box']/button[field[@name='supplier_invoice_count']]" position="move"/>

                <button name="action_open_account_statement"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="customer_rank == 0 and supplier_rank == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="statement_balance" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Account Statement</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
