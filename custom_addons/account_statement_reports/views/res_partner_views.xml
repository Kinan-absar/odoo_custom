<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_form_statement_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.statement.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <!-- Hide Odoo's original Vendor Bills smart button so we can reinsert it first. -->
            <xpath expr="//div[@name='button_box']/button[@name='%(account.res_partner_action_supplier_bills)d']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Put the most useful accounting buttons first so they remain outside More. -->
            <xpath expr="//div[@name='button_box']/button[1]" position="before">
                <button class="oe_stat_button"
                        type="action"
                        name="%(account.res_partner_action_supplier_bills)d"
                        groups="account.group_account_invoice"
                        icon="fa-pencil-square-o"
                        help="Vendor Bills"
                        invisible="supplier_invoice_count == 0">
                    <field string="Vendor Bills" name="supplier_invoice_count" widget="statinfo"/>
                </button>

                <button name="action_open_account_statement"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="customer_rank == 0 and supplier_rank == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="statement_balance" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Account Statement</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
