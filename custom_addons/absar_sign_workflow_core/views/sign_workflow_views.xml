<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_absar_sign_workflow_list" model="ir.ui.view">
        <field name="name">absar.sign.workflow.list</field>
        <field name="model">absar.sign.workflow</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="model_id"/>
                <field name="project_id" optional="show"/>
                <field name="step_count" string="Signers"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_absar_sign_workflow_form" model="ir.ui.view">
        <field name="name">absar.sign.workflow.form</field>
        <field name="model">absar.sign.workflow</field>
        <field name="arch" type="xml">
            <form string="Signing Workflow">
                <header>
                    <button name="action_use_template" type="object" string="Create Project Workflow" class="btn-primary" invisible="not is_template"/>
                    <button name="action_validate_workflow" type="object" string="Validate" invisible="is_template" class="btn-primary" icon="fa-check"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Purchase Order Signing"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_template" invisible="1"/>
                            <field name="project_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Signer Chain"/>
                    <div class="text-muted mb-3">
                        Signers are followed in sequence. Internal and portal users are supported. Odoo Sign roles and movable signature placeholders are prepared automatically, and the Send wizard is prefilled with the configured users and order. ABSAR workflows use separate signer invitations (not the in-person Sign Now flow). After generating a document, move the signature boxes to the correct places and press Send.
                    </div>
                    <div class="text-muted mb-3" invisible="model_name not in ('purchase.order', 'construction.contract', 'construction.measurement', 'construction.ipc')">
                        Signature placement is independent of the signer role. Choose Printed Heading and enter the text printed on the document, or Saved Position (page and percentages from the left/top; date appears below signature). Review in Template always requires manual placement before sending. If a heading cannot be located uniquely, the template opens for review and no invitation is sent automatically.
                    </div>
                    <field name="step_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="signer_user_id" required="not parent.is_template"/>
                            <field name="sign_role_id" optional="show"/>
                            <field name="signer_partner_id" optional="hide"/>
                            <field name="po_placement_mode" column_invisible="parent.model_name not in ('purchase.order', 'construction.contract', 'construction.measurement', 'construction.ipc')"/>
                            <field name="po_printed_heading" column_invisible="parent.model_name not in ('purchase.order', 'construction.contract', 'construction.measurement', 'construction.ipc')" readonly="po_placement_mode != 'heading'" optional="show"/>
                            <field name="po_signature_page" column_invisible="parent.model_name not in ('purchase.order', 'construction.contract', 'construction.measurement', 'construction.ipc')" readonly="po_placement_mode != 'position'" optional="hide"/>
                            <field name="po_signature_x" column_invisible="parent.model_name not in ('purchase.order', 'construction.contract', 'construction.measurement', 'construction.ipc')" readonly="po_placement_mode != 'position'" optional="hide"/>
                            <field name="po_signature_y" column_invisible="parent.model_name not in ('purchase.order', 'construction.contract', 'construction.measurement', 'construction.ipc')" readonly="po_placement_mode != 'position'" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_absar_sign_workflow" model="ir.actions.act_window">
        <field name="name">Signing Workflows</field>
        <field name="res_model">absar.sign.workflow</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_absar_document_signing_root"
              name="Document Signing"
              sequence="95"
              groups="base.group_system"/>
    <menuitem id="menu_absar_document_signing_configuration"
              name="Configuration"
              parent="menu_absar_document_signing_root"
              sequence="10"
              groups="base.group_system"/>
    <menuitem id="menu_absar_signing_workflows"
              name="Signing Workflows"
              parent="menu_absar_document_signing_configuration"
              action="action_absar_sign_workflow"
              sequence="10"
              groups="base.group_system"/>
    <record id="action_workflow_templates" model="ir.actions.act_window">
        <field name="name">Workflow Templates</field>
        <field name="res_model">absar.sign.workflow</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_template', '=', True)]</field>
        <field name="context">{'active_test': False, 'default_is_template': True, 'default_active': False}</field>
    </record>
    <menuitem id="menu_sign_workflow_templates" name="Workflow Templates" parent="menu_absar_document_signing_configuration" action="action_workflow_templates" sequence="41" groups="base.group_system"/>
</odoo>
