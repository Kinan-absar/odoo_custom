<odoo>
    <record id="rule_sign_workflow_company" model="ir.rule">
        <field name="name">Signing workflows: allowed companies</field>
        <field name="model_id" ref="model_absar_sign_workflow"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sign_workflow_step_company" model="ir.rule">
        <field name="name">Signing workflow steps: allowed companies</field>
        <field name="model_id" ref="model_absar_sign_workflow_step"/>
        <field name="domain_force">[('workflow_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
