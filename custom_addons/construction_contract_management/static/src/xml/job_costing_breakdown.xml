<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_contract_management.JobCostingBreakdown" owl="1">
        <div class="ccm-job-costing-table-wrap">
            <div class="ccm-job-costing-toolbar">
                <strong>Actual Profitability</strong>
                <button type="button" class="btn btn-link ccm-job-costing-print" t-on-click="printReport"><i class="fa fa-print me-1"/>Print report</button>
            </div>
            <table class="ccm-job-costing-breakdown" aria-label="Actual profitability">
                <thead><tr><th>Profitability</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    <tr class="ccm-job-costing-total-row"><td>Actual Revenue</td><td class="text-end ccm-job-costing-amount" t-esc="formatAmount(payload.revenue_total)"/></tr>
                    <t t-foreach="[sections[1], sections[2]]" t-as="section" t-key="section.key">
                        <tr class="ccm-job-costing-section-row"><td><button type="button" class="ccm-job-costing-toggle" t-on-click="() => this.toggleSection(section.key)" t-att-aria-expanded="state.expanded[section.key] ? 'true' : 'false'"><i class="fa fa-chevron-right" t-att-class="state.expanded[section.key] ? 'is-open' : ''"/><span t-esc="section.label"/></button></td><td class="text-end ccm-job-costing-amount" t-esc="formatAmount(section.total)"/></tr>
                        <t t-if="state.expanded[section.key]"><tr t-if="!section.rows.length" class="ccm-job-costing-account-row ccm-job-costing-empty"><td colspan="2">No matching accounts.</td></tr><tr t-foreach="section.rows" t-as="row" t-key="row.account_id" class="ccm-job-costing-account-row"><td t-esc="row.account"/><td class="text-end ccm-job-costing-amount" t-esc="formatAmount(row.amount)"/></tr></t>
                    </t>
                    <tr class="ccm-job-costing-total-row"><td>Actual Cost</td><td class="text-end ccm-job-costing-amount" t-esc="formatAmount(payload.cost_total)"/></tr>
                    <t t-foreach="[sections[0], sections[3]]" t-as="section" t-key="section.key">
                        <tr class="ccm-job-costing-section-row"><td><button type="button" class="ccm-job-costing-toggle" t-on-click="() => this.toggleSection(section.key)" t-att-aria-expanded="state.expanded[section.key] ? 'true' : 'false'"><i class="fa fa-chevron-right" t-att-class="state.expanded[section.key] ? 'is-open' : ''"/><span t-esc="section.label"/></button></td><td class="text-end ccm-job-costing-amount" t-esc="formatAmount(section.total)"/></tr>
                        <t t-if="state.expanded[section.key]"><tr t-if="!section.rows.length" class="ccm-job-costing-account-row ccm-job-costing-empty"><td colspan="2">No matching accounts.</td></tr><tr t-foreach="section.rows" t-as="row" t-key="row.account_id" class="ccm-job-costing-account-row"><td t-esc="row.account"/><td class="text-end ccm-job-costing-amount" t-esc="formatAmount(row.amount)"/></tr></t>
                    </t>
                    <tr class="ccm-job-costing-total-row ccm-job-costing-profit-row"><td>Actual Profit</td><td class="text-end ccm-job-costing-amount" t-att-class="payload.profit_total &lt; 0 ? 'is-negative' : 'is-positive'" t-esc="formatAmount(payload.profit_total)"/></tr>
                    <tr class="ccm-job-costing-total-row"><td>Actual Profit Margin</td><td class="text-end ccm-job-costing-amount" t-esc="(payload.margin || 0).toFixed(2) + '%'"/></tr>
                </tbody>
            </table>
        </div>
    </t>
</templates>
