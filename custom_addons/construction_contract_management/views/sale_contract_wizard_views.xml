<odoo>
    <record id="view_sale_construction_contract_wizard_form" model="ir.ui.view">
        <field name="name">sale.construction.contract.wizard.form</field>
        <field name="model">sale.construction.contract.wizard</field>
        <field name="arch" type="xml">
            <form string="Create / Link Client Contract">
                <group>
                    <field name="sale_order_id"/>
                    <field name="partner_id"/>
                    <field name="project_id"/>
                    <field name="scope_name"/>
                    <field name="mode" widget="radio"/>
                    <field name="contract_id"
                           domain="[('partner_id', '=', partner_id), ('contract_direction', '=', 'inbound'), ('project_id', '=', project_id)]"
                           invisible="mode != 'existing'"
                           required="mode == 'existing'"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Continue" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
