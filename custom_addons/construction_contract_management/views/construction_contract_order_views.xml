<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_construction_contract_order_list" model="ir.ui.view">
    <field name="name">construction.contract.order.list</field>
    <field name="model">construction.contract.order</field>
    <field name="arch" type="xml">
      <list string="Contract Orders" class="ccm_list ccm_table">
        <field name="currency_id" column_invisible="True"/>
        <field name="sequence" widget="handle"/>
        <field name="name" class="fw-semibold ccm_reference"/>
        <field name="contract_id"/>
        <field name="sale_order_id" optional="hide"/>
        <field name="scope_name" optional="show"/>
        <field name="project_id" optional="show"/>
        <field name="order_amount" sum="Total" optional="show" widget="monetary"/>
        <field name="boq_amount" sum="BOQ Total" optional="show" widget="monetary"/>
      </list>
    </field>
  </record>
  <record id="view_construction_contract_order_form" model="ir.ui.view">
    <field name="name">construction.contract.order.form</field>
    <field name="model">construction.contract.order</field>
    <field name="arch" type="xml">
      <form string="Contract Order" class="ccm_form">
        <header>
          <button name="action_refresh_boq_from_sale" string="Refresh BOQ from Sales" type="object" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart">
              <div class="o_stat_info">
                <span class="o_stat_text">Sales Order</span>
                <span class="o_stat_value">
                  <field name="sale_order_id"/>
                </span>
              </div>
            </button>
            <button name="action_view_measurements" type="object" class="oe_stat_button" icon="fa-ruler">
              <field name="measurement_count" widget="statinfo" string="Measurements"/>
            </button>
            <button name="action_view_ipcs" type="object" class="oe_stat_button" icon="fa-file-text-o">
              <field name="ipc_count" widget="statinfo" string="IPCs"/>
            </button>
          </div>
          <div class="oe_title ccm_document_header ccm_document_title" name="ccm_document_header">
            <div class="ccm_document_icon">
              <i class="fa fa-list-alt" aria-hidden="true"/>
            </div>
            <span class="ccm_document_type">Contract Order</span>
            <h1>
              <field name="name" readonly="1"/>
            </h1>
          </div>
          <field name="currency_id" invisible="1"/>
          <div class="ccm_summary_grid" name="ccm_summary_grid">
            <div class="ccm_summary_card">
              <span class="ccm_summary_label">Order Value</span>
              <field name="order_amount" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
            <div class="ccm_summary_card">
              <span class="ccm_summary_label">BOQ Value</span>
              <field name="boq_amount" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
            <div class="ccm_summary_card">
              <span class="ccm_summary_label">Measurements</span>
              <field name="measurement_count" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
            <div class="ccm_summary_card ccm_summary_accent">
              <span class="ccm_summary_label">IPCs</span>
              <field name="ipc_count" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
          </div>
          <group>
            <group string="Contract &amp; Source" class="ccm_field_section">
              <field name="contract_id" readonly="1"/>
              <field name="sale_order_id" readonly="1"/>
              <field name="scope_name"/>
              <field name="project_id" readonly="1"/>
            </group>
            <group string="Commercial Details" class="ccm_field_section">
              <field name="customer_reference" readonly="1"/>
              <field name="payment_term_id" readonly="1"/>
              <field name="order_amount" readonly="1"/>
              <field name="boq_amount" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="BOQ" name="ccm_boq">
              <field name="boq_line_ids">
                <list editable="bottom" class="ccm_lines">
                  <field name="currency_id" column_invisible="True"/>
                  <control>
                    <create string="Add a line"/>
                    <create string="Add a section" context="{'default_display_type': 'line_section'}"/>
                    <create string="Add a note" context="{'default_display_type': 'line_note'}"/>
                  </control>
                  <field name="display_type" column_invisible="True"/>
                  <field name="sequence" widget="handle"/>
                  <field name="item_code" invisible="display_type != False"/>
                  <field name="description" decoration-bf="display_type == 'line_section'" decoration-it="display_type == 'line_note'" class="ccm_line_description"/>
                  <field name="uom_id" invisible="display_type != False"/>
                  <field name="contract_qty" invisible="display_type != False"/>
                  <field name="unit_rate" string="Contract Rate" invisible="display_type != False" widget="monetary"/>
                  <field name="total_amount" readonly="1" invisible="display_type != False" widget="monetary" sum="Total"/>
                  <field name="measured_qty" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="certified_qty" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="remaining_qty" readonly="1" invisible="display_type != False" string="Remaining Qty"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
</odoo>
