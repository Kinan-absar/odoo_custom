<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- List View -->
  <record id="view_construction_measurement_list" model="ir.ui.view">
    <field name="name">construction.measurement.list</field>
    <field name="model">construction.measurement</field>
    <field name="arch" type="xml">
      <list string="Measurements" default_order="id desc" class="ccm_list ccm_table">
        <field name="name" class="fw-semibold ccm_reference"/>
        <field name="contract_id"/>
        <field name="contract_order_id" optional="show"/>
        <field name="sale_order_id" optional="hide"/>
        <field name="project_id" optional="show"/>
        <field name="date" optional="show"/>
        <field name="period_from" optional="hide"/>
        <field name="period_to" optional="hide"/>
        <field name="prepared_by" optional="show"/>
        <field name="checked_by" optional="hide"/>
        <field name="state" widget="badge" decoration-success="state in ['approved', 'active', 'completed', 'closed', 'done', 'posted']" decoration-warning="state in ['submitted', 'under_review', 'checked']" decoration-danger="state in ['rejected', 'cancelled']" decoration-muted="state == 'draft'"/>
      </list>
    </field>
  </record>
  <!-- Form View -->
  <record id="view_construction_measurement_form" model="ir.ui.view">
    <field name="name">construction.measurement.form</field>
    <field name="model">construction.measurement</field>
    <field name="arch" type="xml">
      <form string="Measurement" class="ccm_form">
        <header>
          <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_check" string="Check" type="object" class="btn-primary" invisible="state != 'submitted'"/>
          <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'checked'"/>
          <button name="action_reject" string="Reject" type="object" invisible="state not in ['submitted','checked']"/>
          <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
          <button name="action_load_boq_lines" string="Load BOQ Lines" type="object" class="btn-secondary" invisible="state != 'draft'"/>
          <button name="%(construction_contract_management.action_report_construction_measurement)d" string="Print" type="action" class="btn-secondary" invisible="not id"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,checked,approved,rejected"/>
        </header>
        <sheet>
          <div class="ccm_document_header" name="ccm_document_header">
            <div class="ccm_document_icon">
              <i class="fa fa-tasks" aria-hidden="true"/>
            </div>
            <div class="oe_title ccm_document_title">
              <span class="ccm_document_type">Measurement Sheet</span>
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>
          </div>
          <group>
            <group string="Contract &amp; Source" class="ccm_field_section">
              <field name="contract_id" readonly="state == 'approved'"/>
              <field name="contract_order_id" readonly="state == 'approved'" domain="[('contract_id', '=', contract_id)]"/>
              <field name="sale_order_id" readonly="1"/>
              <field name="project_id" readonly="1"/>
            </group>
            <group string="Dates &amp; Review" class="ccm_field_section">
              <field name="date" readonly="state == 'approved'"/>
              <field name="period_from" readonly="state == 'approved'"/>
              <field name="period_to" readonly="state == 'approved'"/>
              <field name="prepared_by" readonly="state == 'approved'" widget="many2one_avatar_user"/>
              <field name="checked_by" readonly="state == 'approved'" widget="many2one_avatar_user"/>
            </group>
          </group>
          <notebook>
            <page string="Measurement Lines" name="ccm_measurement_lines">
              <field name="line_ids" readonly="state == 'approved'">
                <list editable="bottom" class="ccm_lines">
                  <field name="display_type" column_invisible="True"/>
                  <field name="boq_line_id" invisible="display_type != False"/>
                  <field name="description" decoration-bf="display_type == 'line_section'" decoration-it="display_type == 'line_note'" readonly="1" class="ccm_line_description"/>
                  <field name="previous_qty" invisible="display_type != False" string="Previous Qty"/>
                  <field name="previous_percent" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="current_qty" invisible="display_type != False" string="Current Qty"/>
                  <field name="current_percent" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="cumulative_qty" readonly="1" invisible="display_type != False" string="Total Qty"/>
                  <field name="cumulative_percent" readonly="1" invisible="display_type != False" widget="progressbar"/>
                  <field name="allowed_qty" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="remaining_qty" readonly="1" invisible="display_type != False" string="Remaining Qty"/>
                  <field name="remarks" invisible="display_type != False" optional="hide"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <!-- Search View -->
  <record id="view_construction_measurement_search" model="ir.ui.view">
    <field name="name">construction.measurement.search</field>
    <field name="model">construction.measurement</field>
    <field name="arch" type="xml">
      <search string="Search Measurements">
        <field name="name"/>
        <field name="contract_id"/>
        <field name="contract_order_id"/>
        <field name="sale_order_id"/>
        <field name="project_id"/>
        <separator/>
        <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
        <filter string="Checked" name="filter_checked" domain="[('state', '=', 'checked')]"/>
        <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
        <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
        <group expand="0" string="Group By">
          <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
          <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
          <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>
  <!-- Action -->
  <record id="action_construction_measurement" model="ir.actions.act_window">
    <field name="name">Measurements</field>
    <field name="res_model">construction.measurement</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_construction_measurement_search"/>
  </record>
</odoo>
