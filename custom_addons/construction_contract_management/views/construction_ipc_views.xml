<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!-- List View -->
  <record id="view_construction_ipc_list" model="ir.ui.view">
    <field name="name">construction.ipc.list</field>
    <field name="model">construction.ipc</field>
    <field name="arch" type="xml">
      <list string="IPCs" default_order="id desc" class="ccm_list ccm_table">
        <field name="currency_id" column_invisible="True"/>
        <field name="name" class="fw-semibold ccm_reference"/>
        <field name="contract_id"/>
        <field name="contract_order_id" optional="show"/>
        <field name="sale_order_id" optional="hide"/>
        <field name="contract_direction" optional="hide" widget="badge" decoration-info="contract_direction == 'inbound'" decoration-warning="contract_direction == 'outbound'"/>
        <field name="measurement_id" optional="show"/>
        <field name="ipc_date" optional="show"/>
        <field name="current_work_value" optional="show" widget="monetary"/>
        <field name="retention_amount" optional="hide" widget="monetary"/>
        <field name="advance_recovery_amount" optional="hide" widget="monetary"/>
        <field name="deduction_amount" optional="hide" widget="monetary"/>
        <field name="net_amount" widget="monetary"/>
        <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-warning="payment_status in ['partial', 'in_payment']" decoration-danger="payment_status in ['reversed', 'cancelled']" decoration-muted="payment_status in ['no_move', 'not_paid', 'invoicing_legacy']"/>
        <field name="state" widget="badge" decoration-success="state in ['approved', 'active', 'completed', 'closed', 'done', 'posted']" decoration-warning="state in ['submitted', 'under_review', 'checked']" decoration-danger="state in ['rejected', 'cancelled']" decoration-muted="state == 'draft'"/>
      </list>
    </field>
  </record>
  <!-- Form View -->
  <record id="view_construction_ipc_form" model="ir.ui.view">
    <field name="name">construction.ipc.form</field>
    <field name="model">construction.ipc</field>
    <field name="arch" type="xml">
      <form string="IPC" class="ccm_form">
        <header>
          <button name="action_load_from_measurement" string="Load from Measurement" type="object" class="btn-primary" invisible="state != 'draft' or not measurement_id"/>
          <button name="action_submit_review" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'under_review'"/>
          <button name="action_done" string="Mark Done" type="object" invisible="state != 'approved'"/>
          <button name="action_cancel" string="Cancel" type="object" invisible="state in ['done','cancelled']"/>
          <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
          <button name="action_create_move" string="Create Invoice/Bill" type="object" class="btn-primary" invisible="state not in ['approved','done'] or (move_id and payment_status not in ['reversed','cancelled'])"/>
          <button name="action_link_existing_move" string="Link Existing Invoice/Bill" type="object" class="btn-secondary" invisible="state not in ['approved','done'] or (move_id and payment_status not in ['reversed','cancelled'])"/>
          <button name="%(construction_contract_management.action_report_construction_ipc)d" string="Print" type="action" class="btn-secondary" invisible="not id"/>
          <button name="action_view_move" string="View Invoice/Bill" type="object" invisible="not move_id"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,under_review,approved,done,cancelled"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not move_id">
              <field name="move_count" widget="statinfo" string="Invoice/Bill"/>
            </button>
          </div>
          <div class="ccm_document_header" name="ccm_document_header">
            <div class="ccm_document_icon">
              <i class="fa fa-file-text-o" aria-hidden="true"/>
            </div>
            <div class="oe_title ccm_document_title">
              <span class="ccm_document_type">Interim Payment Certificate</span>
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>
          </div>
          <field name="currency_id" invisible="1"/>
          <div class="ccm_summary_grid" name="ccm_summary_grid">
            <div class="ccm_summary_card">
              <span class="ccm_summary_label">Current Work</span>
              <field name="current_work_value" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
            <div class="ccm_summary_card">
              <span class="ccm_summary_label">Retention</span>
              <field name="retention_amount" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
            <div class="ccm_summary_card">
              <span class="ccm_summary_label">Advance Recovery</span>
              <field name="advance_recovery_amount" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
            <div class="ccm_summary_card ccm_summary_accent">
              <span class="ccm_summary_label">Net Payable</span>
              <field name="net_amount" readonly="1" nolabel="1" class="ccm_summary_value"/>
            </div>
          </div>
          <group>
            <group string="Contract &amp; Source" class="ccm_field_section">
              <field name="contract_id"/>
              <field name="contract_order_id" domain="[('contract_id', '=', contract_id)]"/>
              <field name="sale_order_id" readonly="1"/>
              <field name="contract_direction" readonly="1" widget="badge" decoration-info="contract_direction == 'inbound'" decoration-warning="contract_direction == 'outbound'"/>
              <field name="measurement_id" domain="[('contract_id', '=', contract_id), '|', ('contract_order_id', '=', contract_order_id), ('contract_order_id', '=', False), ('state', '=', 'approved')]"/>
            </group>
            <group string="Certification Period" class="ccm_field_section">
              <field name="ipc_date"/>
              <field name="period_from"/>
              <field name="period_to"/>
              <field name="payment_status" readonly="1" widget="badge" decoration-success="payment_status == 'paid'" decoration-warning="payment_status in ['partial', 'in_payment']" decoration-danger="payment_status in ['reversed', 'cancelled']" decoration-muted="payment_status in ['no_move', 'not_paid', 'invoicing_legacy']"/>
            </group>
          </group>
          <notebook>
            <page string="IPC Lines" name="ccm_ipc_lines">
              <field name="line_ids">
                <list editable="bottom" class="ccm_lines">
                  <field name="currency_id" column_invisible="True"/>
                  <field name="display_type" column_invisible="True"/>
                  <field name="boq_line_id" invisible="display_type != False"/>
                  <field name="measurement_line_id" optional="hide" invisible="display_type != False"/>
                  <field name="description" decoration-bf="display_type == 'line_section'" decoration-it="display_type == 'line_note'" readonly="1" class="ccm_line_description"/>
                  <field name="previous_qty" invisible="display_type != False" string="Previous Qty"/>
                  <field name="previous_percent" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="current_qty" invisible="display_type != False" string="Current Qty"/>
                  <field name="current_percent" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="cumulative_qty" invisible="display_type != False" string="Total Qty"/>
                  <field name="cumulative_percent" readonly="1" invisible="display_type != False" widget="progressbar"/>
                  <field name="allowed_qty" readonly="1" invisible="display_type != False" optional="hide"/>
                  <field name="remaining_qty" readonly="1" invisible="display_type != False" string="Remaining Qty"/>
                  <field name="unit_rate" invisible="display_type != False" widget="monetary"/>
                  <field name="current_value" readonly="1" invisible="display_type != False" widget="monetary" sum="Total"/>
                  <field name="cumulative_value" readonly="1" invisible="display_type != False" widget="monetary" sum="Total"/>
                </list>
              </field>
            </page>
            <page string="Amounts" name="ccm_amounts">
              <group>
                <group string="Work Valuation" class="ccm_field_section">
                  <field name="previous_certified_value" readonly="1"/>
                  <field name="current_work_value" readonly="1"/>
                  <field name="cumulative_certified_value" readonly="1"/>
                </group>
                <group string="Deductions" class="ccm_field_section">
                  <field name="deduct_advance" readonly="state not in ['draft', 'under_review']"/>
                  <field name="advance_recovery_amount" readonly="1"/>
                  <field name="deduct_retention_on_invoice" readonly="state not in ['draft', 'under_review']"/>
                  <field name="retention_amount" readonly="1"/>
                  <field name="deduction_amount"/>
                </group>
              </group>
              <group>
                <group string="VAT &amp; Net Payable" class="ccm_field_section">
                  <field name="vat_amount" readonly="1"/>
                  <field name="gross_with_vat" readonly="1"/>
                  <field name="net_amount" readonly="1"/>
                </group>
                <group string="Accounting &amp; Payment" class="ccm_field_section">
                  <field name="payment_status" readonly="1" widget="badge" decoration-success="payment_status == 'paid'" decoration-warning="payment_status in ['partial', 'in_payment']" decoration-danger="payment_status in ['reversed', 'cancelled']" decoration-muted="payment_status in ['no_move', 'not_paid', 'invoicing_legacy']"/>
                  <field name="move_id" readonly="1"/>
                  <field name="move_history_ids" widget="many2many_tags" readonly="1"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <!-- Search View -->
  <record id="view_construction_ipc_search" model="ir.ui.view">
    <field name="name">construction.ipc.search</field>
    <field name="model">construction.ipc</field>
    <field name="arch" type="xml">
      <search string="Search IPCs">
        <field name="name"/>
        <field name="contract_id"/>
        <field name="measurement_id"/>
        <filter string="Client Contract" name="filter_inbound" domain="[('contract_direction','=','inbound')]"/>
        <filter string="Subcontract" name="filter_outbound" domain="[('contract_direction','=','outbound')]"/>
        <separator/>
        <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Under Review" name="filter_under_review" domain="[('state', '=', 'under_review')]"/>
        <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
        <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
        <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
        <separator/>
        <filter string="Unpaid" name="filter_payment_unpaid" domain="[('payment_status', 'in', ['not_paid', 'partial', 'in_payment'])]"/>
        <filter string="Paid" name="filter_payment_paid" domain="[('payment_status', '=', 'paid')]"/>
        <filter string="Not Invoiced / Posted" name="filter_payment_no_move" domain="[('payment_status', '=', 'no_move')]"/>
        <group expand="0" string="Group By">
          <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
          <filter string="Direction" name="group_direction" context="{'group_by': 'contract_direction'}"/>
          <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Payment Status" name="group_payment_status" context="{'group_by': 'payment_status'}"/>
        </group>
      </search>
    </field>
  </record>
  <!-- Action -->
  <record id="action_construction_ipc" model="ir.actions.act_window">
    <field name="name">IPCs</field>
    <field name="res_model">construction.ipc</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_construction_ipc_search"/>
  </record>
</odoo>
