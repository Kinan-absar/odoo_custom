<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_construction_contract_form_job_costing" model="ir.ui.view">
        <field name="name">construction.contract.form.job.costing</field>
        <field name="model">construction.contract</field>
        <field name="inherit_id" ref="construction_contract_management.view_construction_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_job_cost_purchase_orders" class="oe_stat_button" icon="fa-shopping-cart" invisible="not analytic_account_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="purchase_commitment_amount" widget="monetary"/></span>
                        <span class="o_stat_text">PO Commitments</span>
                    </div>
                </button>
                <button type="object" name="action_view_job_cost_analytic_items" class="oe_stat_button" icon="fa-line-chart" invisible="not analytic_account_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="actual_cost_amount" widget="monetary"/></span>
                        <span class="o_stat_text">Actual Cost</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Job Costing" name="ccm_job_costing" invisible="contract_direction != 'inbound'">
                    <group>
                        <group string="Setup" class="ccm_field_section">
                            <field name="analytic_account_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="job_cost_budget"/>
                            <field name="forecast_remaining_cost"/>
                        </group>
                        <group string="Profitability" class="ccm_field_section">
                            <field name="revised_amount" readonly="1" string="Revised Contract Revenue"/>
                            <field name="forecast_final_cost" readonly="1"/>
                            <field name="forecast_profit" readonly="1" decoration-danger="forecast_profit &lt; 0" decoration-success="forecast_profit &gt;= 0"/>
                            <field name="forecast_margin_percent" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Cost Position"/>
                    <group col="4">
                        <group string="Committed &amp; Billed" class="ccm_field_section">
                            <field name="purchase_commitment_amount" readonly="1"/>
                            <field name="purchase_billed_amount" readonly="1"/>
                            <field name="open_purchase_commitment" readonly="1"/>
                        </group>
                        <group string="Actual &amp; Forecast" class="ccm_field_section">
                            <field name="vendor_bill_cost_amount" readonly="1"/>
                            <field name="other_accounting_cost_amount" readonly="1"/>
                            <field name="actual_cost_amount" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Actual Profitability"/>
                    <div class="ccm_actual_profit_table_wrap">
                        <table class="table table-sm ccm_actual_profit_table">
                            <thead>
                                <tr><th scope="col">Actual Profitability Breakdown</th><th scope="col">Amount</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Customer Invoice Revenue</td>
                                    <td><field name="invoice_revenue_credit_amount" readonly="1" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td>Customer Advance Recovered</td>
                                    <td><field name="miscellaneous_revenue_credit_amount" readonly="1" nolabel="1"/></td>
                                </tr>
                                <tr class="ccm_actual_profit_subtotal">
                                    <td>Total Actual Revenue</td>
                                    <td><field name="actual_revenue_amount" readonly="1" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td>Vendor Bill Cost</td>
                                    <td><field name="vendor_bill_cost_amount" readonly="1" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td>Other Accounting Cost</td>
                                    <td><field name="other_accounting_cost_amount" readonly="1" nolabel="1"/></td>
                                </tr>
                                <tr class="ccm_actual_profit_subtotal">
                                    <td>Total Actual Cost</td>
                                    <td><field name="actual_cost_amount" readonly="1" nolabel="1"/></td>
                                </tr>
                                <tr class="ccm_actual_profit_total">
                                    <td>Actual Profit</td>
                                    <td><field name="actual_profit_amount" readonly="1" nolabel="1" decoration-danger="actual_profit_amount &lt; 0" decoration-success="actual_profit_amount &gt;= 0"/></td>
                                </tr>
                                <tr class="ccm_actual_profit_total">
                                    <td>Actual Profit Margin</td>
                                    <td><field name="actual_profit_margin_percent" readonly="1" nolabel="1"/> %</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <separator string="Budget Health"/>
                    <group>
                        <group class="ccm_field_section">
                            <field name="budget_variance" readonly="1" decoration-danger="budget_variance &lt; 0" decoration-success="budget_variance &gt;= 0"/>
                            <field name="budget_consumed_percent" readonly="1"/>
                        </group>
                        <group class="ccm_field_section">
                            <div class="o_form_label">How it works</div>
                            <div class="text-muted">
                                Actual Cost = (Vendor Bills debit - Vendor Bills credit) + Miscellaneous Operations debit. Actual Revenue = work-invoice credits (excluding customer advance invoices) + recovered-advance credits from miscellaneous entries. Actual Profit = Actual Revenue - Actual Cost. Actual Margin = Actual Profit / Actual Revenue. Only posted journal items allocated to the selected Job Cost Analytic Account (or explicitly linked to this contract) are included; figures follow Debit and Credit columns rather than account types. Open PO Commitment = confirmed PO value less posted PO bills. Forecast Final Cost = Actual Cost + Open PO Commitment + Uncommitted Forecast Cost. Forecast Profit = Revised Contract Revenue less Forecast Final Cost.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_construction_job_cost" model="ir.ui.view">
        <field name="name">account.move.form.construction.job.cost</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="construction_contract_id" options="{'no_create': True}" />
            </xpath>
        </field>
    </record>
</odoo>
