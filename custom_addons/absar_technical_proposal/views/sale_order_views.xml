<odoo>
 <record id="view_sale_order_form_absar_technical" model="ir.ui.view"><field name="name">sale.order.form.absar.technical</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml">
  <xpath expr="(//field[@name='partner_id'])[1]" position="after"><field name="absar_proposal_type"/></xpath>
  <xpath expr="//form/header" position="inside"><button name="action_absar_print_technical_proposal" type="object" string="Print Technical Proposal" icon="fa-file-pdf-o" invisible="absar_proposal_type != 'technical'"/></xpath>
  <xpath expr="//notebook" position="inside"><page string="Technical Proposal" name="absar_technical_proposal" invisible="absar_proposal_type != 'technical'">
   <group><group><field name="absar_proposal_title"/><field name="absar_proposal_reference"/><field name="absar_proposal_template_id" domain="[('company_id', 'in', [False, company_id])]"/></group><group><button name="action_absar_load_proposal_template" type="object" string="Load / Replace From Template" class="btn-secondary" invisible="state not in ('draft', 'sent')" confirm="Replace existing technical sections and milestones with the selected template?"/><div class="text-muted">Template loading replaces proposal sections and milestones only; quotation lines remain unchanged.</div></group></group>
   <notebook><page string="Sections"><field name="absar_proposal_section_ids"><list><field name="sequence" widget="handle"/><field name="section_type"/><field name="name"/><field name="include_in_report"/><field name="page_break_before"/></list><form><group><field name="section_type"/><field name="name"/><field name="include_in_report"/><field name="page_break_before"/></group><separator string="Section Content"/><field name="content" widget="html" placeholder="Write the technical proposal section here..." colspan="2"/></form></field></page>
   <page string="Payment Milestones"><field name="absar_proposal_payment_ids"><list><field name="sequence" widget="handle"/><field name="name"/><field name="percentage"/><field name="due_condition"/><field name="amount" readonly="1" sum="Total"/></list></field><div class="text-muted">Optional staged payment terms (for example, 75% advance and 25% on handover). Amounts use the VAT-exclusive quotation total; percentages must add up to 100% when milestones are used.</div></page>
   </notebook>
  </page></xpath>
 </field></record>
</odoo>