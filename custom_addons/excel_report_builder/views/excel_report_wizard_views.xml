<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_excel_report_wizard_form" model="ir.ui.view">
        <field name="name">excel.report.wizard.form</field>
        <field name="model">excel.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Excel Report">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="report_name" readonly="1"/></h2>
                    </div>
                    <group>
                        <field name="report_id" invisible="1"/>
                        <field name="model_name" readonly="1"/>
                        <field name="has_date_filter" invisible="1"/>
                    </group>
                    <group string="Period" invisible="not has_date_filter">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The XLSX file is generated using your current Odoo access rights and record rules.
                    </div>
                </sheet>
                <footer>
                    <button name="action_download" type="object" string="Download XLSX" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
