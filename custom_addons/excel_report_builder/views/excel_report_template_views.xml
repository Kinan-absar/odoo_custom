<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_excel_report_template_list" model="ir.ui.view">
        <field name="name">excel.report.template.list</field>
        <field name="model">excel.report.template</field>
        <field name="arch" type="xml">
            <list string="Excel Reports" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="model_id"/>
                <field name="group_field_id" optional="show"/>
                <field name="max_rows" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'ready'" decoration-info="state == 'draft'"/>
                <button name="action_generate" type="object" string="Generate" class="btn-primary" icon="fa-file-excel-o"/>
            </list>
        </field>
    </record>

    <record id="view_excel_report_template_search" model="ir.ui.view">
        <field name="name">excel.report.template.search</field>
        <field name="model">excel.report.template</field>
        <field name="arch" type="xml">
            <search string="Excel Reports">
                <field name="name"/>
                <field name="model_id"/>
                <filter string="Ready" name="ready" domain="[('state','=','ready')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Model" name="group_model" context="{'group_by':'model_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_excel_report_template_form" model="ir.ui.view">
        <field name="name">excel.report.template.form</field>
        <field name="model">excel.report.template</field>
        <field name="arch" type="xml">
            <form string="Excel Report">
                <header>
                    <button name="action_generate" type="object" string="Generate Excel" class="btn-primary" icon="fa-file-excel-o"/>
                    <button name="action_mark_ready" type="object" string="Mark Ready" class="btn-secondary" invisible="state == 'ready'" groups="excel_report_builder.group_excel_report_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" groups="excel_report_builder.group_excel_report_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Customer Outstanding Report"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="description" placeholder="What is this report used for?"/>
                        </group>
                        <group>
                            <field name="date_field_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="max_rows"/>
                            <field name="order_by" placeholder="e.g. invoice_date desc, name"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Columns" name="columns">
                            <field name="column_ids" context="{'default_report_id': id}">
                                <list editable="bottom" string="Report Columns">
                                    <field name="model_id" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="column_type"/>
                                    <field name="name"/>
                                    <field name="field_id" options="{'no_create': True, 'no_open': True}" invisible="column_type != 'field'"/>
                                    <field name="source_field_a_id" options="{'no_create': True, 'no_open': True}" invisible="column_type == 'field'"/>
                                    <field name="source_field_b_id" options="{'no_create': True, 'no_open': True}" invisible="column_type == 'field'"/>
                                    <field name="number_format" optional="show"/>
                                    <field name="total" optional="show"/>
                                    <field name="width" optional="hide"/>
                                </list>
                                <form string="Report Column">
                                    <field name="model_id" invisible="1"/>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="column_type"/>
                                        <field name="name"/>
                                        <field name="field_id" options="{'no_create': True, 'no_open': True}" invisible="column_type != 'field'"/>
                                        <field name="source_field_a_id" options="{'no_create': True, 'no_open': True}" invisible="column_type == 'field'"/>
                                        <field name="source_field_b_id" options="{'no_create': True, 'no_open': True}" invisible="column_type == 'field'"/>
                                        <field name="number_format"/>
                                        <field name="total"/>
                                        <field name="width"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Filters" name="filters">
                            <group>
                                <field name="domain_expression" placeholder="[('state', '=', 'posted')]" groups="excel_report_builder.group_excel_report_manager"/>
                            </group>
                            <separator string="Saved Filters"/>
                            <field name="filter_ids" context="{'default_report_id': id}">
                                <list editable="bottom">
                                    <field name="model_id" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="operator"/>
                                    <field name="value"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-3" role="alert">
                                Saved filters are always applied. If a Runtime Date Field is configured, users can additionally choose From/To dates whenever they generate the report.
                            </div>
                        </page>

                        <page string="Grouping &amp; Totals" name="grouping">
                            <group>
                                <group>
                                    <field name="group_field_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="second_group_field_id" options="{'no_create': True, 'no_open': True}"/>
                                </group>
                                <group>
                                    <field name="show_subtotals"/>
                                    <field name="show_grand_total"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Tick “Total Column” on numeric columns to calculate subtotals and the grand total.
                            </div>
                        </page>

                        <page string="Excel Layout" name="layout">
                            <group>
                                <group>
                                    <field name="sheet_name"/>
                                    <field name="include_title"/>
                                    <field name="include_company"/>
                                    <field name="include_generated_info"/>
                                </group>
                                <group>
                                    <field name="freeze_header"/>
                                    <field name="autofilter"/>
                                    <field name="alternate_rows"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_excel_report_template" model="ir.actions.act_window">
        <field name="name">Excel Reports</field>
        <field name="res_model">excel.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_excel_report_template_search"/>
        <field name="context">{'search_default_ready': 1}</field>
    </record>
</odoo>
