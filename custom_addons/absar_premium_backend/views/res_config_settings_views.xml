<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_absar_theme" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.absar.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="ABSAR Theme" name="absar_theme" groups="base.group_system">
                    <block title="Backend Appearance" name="absar_theme_backend">
                        <setting string="Primary Color" help="Leave empty to keep Odoo's original primary color.">
                            <div class="content-group o_absar_theme_settings">
                                <div class="row mt16">
                                    <label for="absar_primary_color" class="col-lg-3 o_light_label"/>
                                    <field name="absar_primary_color" placeholder="#875A7B" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="absar_primary_hover_color" class="col-lg-3 o_light_label"/>
                                    <field name="absar_primary_hover_color" placeholder="Auto" class="oe_inline"/>
                                </div>
                                <div class="mt16 o_absar_theme_preview">
                                    <span class="o_absar_preview_label">Preview</span>
                                    <span class="btn o_absar_preview_primary" role="button">Primary Button</span>
                                    <span class="badge o_absar_preview_badge">Selected</span>
                                    <span class="o_absar_preview_link">Sample Link</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Backend Font" help="Change only the Odoo backend font. PDF reports keep the Arabic-safe report font.">
                            <field name="absar_backend_font"/>
                        </setting>
                        <setting string="Rounded Buttons" help="Use rounded corners on backend buttons.">
                            <field name="absar_rounded_buttons"/>
                        </setting>
                        <setting string="Rounded App Icons" help="Round the application launcher icons.">
                            <field name="absar_rounded_apps"/>
                        </setting>
                    </block>
                    <block title="PDF / QWeb Reports" name="absar_theme_reports">
                        <setting string="Arabic Report Font" help="Noto Sans Arabic is kept enabled for PDF/QWeb reports for consistent Arabic rendering, including mixed Arabic/English address lines.">
                            <div class="text-muted">Noto Sans Arabic (fixed for report reliability)</div>
                        </setting>
                    </block>
                    <block title="Reset" name="absar_theme_reset">
                        <setting string="Restore Odoo Defaults" help="Clear custom backend color/font settings. Rounded buttons and app icons return to enabled.">
                            <button name="action_absar_reset_theme" type="object" string="Restore Odoo Defaults" class="btn btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
