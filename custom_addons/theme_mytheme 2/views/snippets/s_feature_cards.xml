<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_aurora_feature_cards" name="Aurora Feature Cards">
        <section class="s_aurora_feature_cards pt-5 pb-5"
                 data-name="Aurora Feature Cards"
                 data-snippet="s_aurora_feature_cards"
                 data-vcss="001"
                 data-vxml="001">
            <div class="container">
                <div class="row justify-content-center mb-5">
                    <div class="col-lg-7 text-center">
                        <h2 class="o_aurora_animate">Why choose us</h2>
                        <p class="text-muted o_aurora_animate">
                            A short line explaining the three things you do best.
                        </p>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="o_aurora_feature_card o_aurora_animate h-100">
                            <div class="o_aurora_feature_icon" aria-hidden="true">
                                <i class="fa fa-bolt"/>
                            </div>
                            <h4>Fast</h4>
                            <p>Describe your first key benefit here in one or two lines.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="o_aurora_feature_card o_aurora_animate h-100">
                            <div class="o_aurora_feature_icon" aria-hidden="true">
                                <i class="fa fa-shield"/>
                            </div>
                            <h4>Reliable</h4>
                            <p>Describe your second key benefit here in one or two lines.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="o_aurora_feature_card o_aurora_animate h-100">
                            <div class="o_aurora_feature_icon" aria-hidden="true">
                                <i class="fa fa-heart"/>
                            </div>
                            <h4>Loved</h4>
                            <p>Describe your third key benefit here in one or two lines.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_aurora_feature_cards_snippet_entry"
              inherit_id="website.snippets"
              name="Aurora Feature Cards Snippet Entry">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_mytheme.s_aurora_feature_cards"
               string="Aurora Feature Cards"
               group="columns"
               t-thumbnail="/theme_mytheme/static/src/img/s_feature_cards_thumb.svg">
                <keywords>features, cards, benefits, services, columns, aurora</keywords>
            </t>
        </xpath>
    </template>
</odoo>
