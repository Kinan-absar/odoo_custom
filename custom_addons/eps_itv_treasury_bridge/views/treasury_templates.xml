<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <template id="portal_treasury_payment_list" name="CEO Payment Approvals">
    <t t-call="employee_portal_suite.employee_portal_layout">
      <style>
        .eps-treasury-table { font-size: 11.5px; table-layout: fixed; width: 100%; }
        .eps-treasury-table th, .eps-treasury-table td { padding: .32rem .38rem; vertical-align: middle; line-height: 1.2; }
        .eps-treasury-table th { font-size: 10.5px; white-space: nowrap; font-weight: 600; }
        .eps-treasury-table .eps-money, .eps-treasury-table .eps-date, .eps-treasury-table .eps-status { white-space: nowrap; }
        .eps-treasury-table .eps-truncate { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .eps-treasury-table .badge { font-size: 10px; padding: .25em .45em; font-weight: 600; }
        .eps-treasury-table .btn { font-size: 10.5px; padding: .16rem .35rem; line-height: 1.25; }
        .eps-treasury-table .form-control, .eps-treasury-table .input-group-text { font-size: 10.5px; padding: .22rem .35rem; }
        .eps-treasury-table textarea.form-control { min-height: 42px; resize: vertical; }
        .eps-col-date { width: 6%; }
        .eps-col-payment { width: 9%; }
        .eps-col-plan { width: 7%; }
        .eps-col-partner { width: 11%; }
        .eps-col-po { width: 8%; }
        .eps-col-money { width: 7%; }
        .eps-col-status { width: 11%; }
        .eps-col-review { width: 20%; }
        .eps-col-status .badge { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .eps-icon-btn { min-width: 28px; }
        .eps-summary-table { font-size: 11.5px; table-layout: fixed; width: 100%; }
        .eps-summary-table th, .eps-summary-table td { padding: .32rem .38rem; vertical-align: middle; line-height: 1.2; }
        .eps-summary-table th { font-size: 10.5px; white-space: nowrap; font-weight: 600; }
        .eps-weekly-col-date { width: 8%; }
        .eps-weekly-col-flow { width: 6%; }
        .eps-weekly-col-description { width: 10%; }
        .eps-weekly-col-partner { width: 15%; }
        .eps-weekly-col-money { width: 8%; }
        .eps-weekly-col-status { width: 13%; }
        .eps-weekly-col-status .badge { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        @media (max-width: 1200px) {
          .eps-treasury-table { font-size: 10.5px; }
          .eps-treasury-table th { font-size: 9.8px; }
          .eps-treasury-table th, .eps-treasury-table td { padding: .25rem .28rem; }
        }

        .eps-mobile-filter { overflow-x: auto; flex-wrap: nowrap; -webkit-overflow-scrolling: touch; padding-bottom: .25rem; }
        .eps-mobile-filter .btn { white-space: nowrap; }
        .eps-mobile-card { border-radius: .85rem; }
        .eps-mobile-label { color: #6c757d; font-size: .75rem; margin-bottom: .12rem; }
        .eps-mobile-value { font-size: .92rem; overflow-wrap: anywhere; }
        .eps-mobile-money { font-weight: 700; font-size: 1rem; }
        .eps-mobile-actions .btn { min-height: 44px; font-weight: 600; }
        .eps-mobile-actions textarea { min-height: 72px; }
        .eps-mobile-po { white-space: normal; text-align: left; }
        @media (max-width: 767.98px) {
          .eps-page-head { align-items: stretch !important; flex-direction: column; gap: .75rem; }
          .eps-page-head .btn { width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: center; }
          .eps-page-title { font-size: 1.45rem; }
          .container.py-4 { padding-top: 1rem !important; padding-bottom: 1.5rem !important; }
        }
      </style>
      <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3 eps-page-head">
          <div>
            <h3 class="mb-1 eps-page-title">Payment Approvals</h3>
            <p class="text-muted mb-0">Review, adjust, approve, hold, or reject planned outgoing payments.</p>
          </div>
          <a href="/my/employee/treasury/plans" class="btn btn-outline-primary btn-sm">Weekly Cash Plans</a>
        </div>
        <div t-if="message" class="alert alert-success">
          <t t-esc="message"/>
        </div>
        <div t-if="error" class="alert alert-danger">
          <t t-esc="error"/>
        </div>
        <div class="btn-group mb-3 eps-mobile-filter w-100" role="group" aria-label="Payment status filters">
          <a t-attf-class="btn btn-sm #{'btn-primary' if current_status == 'pending' else 'btn-outline-primary'}" href="/my/employee/treasury/payments?status=pending">Pending <t t-if="counts"><span class="badge text-bg-light ms-1"><t t-esc="counts.get('pending', 0)"/></span></t></a>
          <a t-attf-class="btn btn-sm #{'btn-primary' if current_status == 'approved' else 'btn-outline-primary'}" href="/my/employee/treasury/payments?status=approved">Approved <t t-if="counts"><span class="badge text-bg-light ms-1"><t t-esc="counts.get('approved', 0)"/></span></t></a>
          <a t-attf-class="btn btn-sm #{'btn-primary' if current_status == 'held' else 'btn-outline-primary'}" href="/my/employee/treasury/payments?status=held">On Hold <t t-if="counts"><span class="badge text-bg-light ms-1"><t t-esc="counts.get('held', 0)"/></span></t></a>
          <a t-attf-class="btn btn-sm #{'btn-primary' if current_status == 'rejected' else 'btn-outline-primary'}" href="/my/employee/treasury/payments?status=rejected">Rejected <t t-if="counts"><span class="badge text-bg-light ms-1"><t t-esc="counts.get('rejected', 0)"/></span></t></a>
          <a t-attf-class="btn btn-sm #{'btn-primary' if current_status == 'all' else 'btn-outline-primary'}" href="/my/employee/treasury/payments?status=all">All <t t-if="counts"><span class="badge text-bg-light ms-1"><t t-esc="counts.get('all', 0)"/></span></t></a>
        </div>
        <div class="card border-0 shadow-sm d-none d-lg-block">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 eps-treasury-table">
              <thead class="table-light">
                <tr>
                  <th class="eps-col-date">Date</th>
                  <th class="eps-col-payment">Payment</th>
                  <th class="eps-col-plan">Weekly Plan</th>
                  <th class="eps-col-partner">Partner / Project</th>
                  <th class="eps-col-po">Purchase Order</th>
                  <th class="eps-col-money">PO Paid</th>
                  <th class="eps-col-money">PO Due</th>
                  <th class="eps-col-money">Requested</th>
                  <th class="eps-col-money">Approved</th>
                  <th class="eps-col-status">Status</th>
                  <th class="eps-col-review">CEO Review</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="lines" t-as="line">
                  <tr>
                    <td>
                      <t t-esc="line.planned_date"/>
                    </td>
                    <td>
                      <div class="fw-semibold">
                        <t t-esc="line.name"/>
                      </div>
                      <small class="text-muted">
                        <t t-esc="line.category_id.name"/>
                      </small>
                    </td>
                    <td>
                      <a t-att-href="'/my/employee/treasury/plans/%s' % line.run_id.id">
                        <t t-esc="line.run_id.name"/>
                      </a>
                    </td>
                    <td>
                      <div t-if="line.partner_id" class="eps-truncate" t-att-title="line.partner_id.name">
                        <t t-esc="line.partner_id.name"/>
                      </div>
                      <small t-if="line.project_id" class="text-muted eps-truncate" t-att-title="line.project_id.name">
                        <t t-esc="line.project_id.name"/>
                      </small>
                    </td>
                    <td>
                      <t t-if="line.portal_purchase_order_ids">
                        <div t-foreach="line.portal_purchase_order_ids" t-as="po" class="mb-1">
                          <a t-att-href="'/my/employee/treasury/purchase-order/%s' % po.id"
                             class="btn btn-sm btn-outline-primary py-0 px-2"
                             title="View Purchase Order"
                             target="_blank" rel="noopener">
                            <i class="fa fa-eye me-1"/>
                            <t t-esc="po.name"/>
                          </a>
                        </div>
                      </t>
                      <span t-else="" class="text-muted small">No PO linked</span>
                    </td>
                    <td>
                      <span t-if="line.purchase_order_ids" t-field="line.po_amount_paid" t-options="{'widget':'monetary','display_currency':line.currency_id}"/>
                      <span t-else="" class="text-muted">—</span>
                    </td>
                    <td>
                      <span t-if="line.purchase_order_ids" t-field="line.po_balance_due" t-options="{'widget':'monetary','display_currency':line.currency_id}"/>
                      <span t-else="" class="text-muted">—</span>
                    </td>
                    <td>
                      <span t-field="line.forecast_amount" t-options="{'widget':'monetary','display_currency':line.currency_id}"/>
                    </td>
                    <td>
                      <span t-field="line.approved_amount" t-options="{'widget':'monetary','display_currency':line.currency_id}"/>
                    </td>
                    <td class="eps-status eps-col-status">
                      <span class="badge text-bg-secondary" t-att-title="dict(line._fields['ceo_decision'].selection).get(line.ceo_decision)">
                        <t t-esc="dict(line._fields['ceo_decision'].selection).get(line.ceo_decision)"/>
                      </span>
                    </td>
                    <td>
                      <form t-if="line.ceo_decision in ('pending', 'held')" t-att-action="'/my/employee/treasury/lines/%s/review' % line.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="input-group input-group-sm mb-2">
                          <span class="input-group-text">Amount</span>
                          <input type="number" step="0.01" min="0" name="approved_amount" class="form-control" t-att-value="line.approved_amount or line.forecast_amount"/>
                        </div>
                        <textarea name="comment" class="form-control form-control-sm mb-2" rows="2" placeholder="CEO comment">
                          <t t-esc="line.ceo_comment or ''"/>
                        </textarea>
                        <button name="decision" value="approved" class="btn btn-success btn-sm eps-icon-btn" title="Approve" aria-label="Approve"><i class="fa fa-check"/></button>
                        <button name="decision" value="held" class="btn btn-warning btn-sm eps-icon-btn ms-1" title="Hold" aria-label="Hold"><i class="fa fa-pause"/></button>
                        <button name="decision" value="rejected" class="btn btn-outline-danger btn-sm eps-icon-btn ms-1" title="Reject" aria-label="Reject"><i class="fa fa-times"/></button>
                      </form>
                      <div t-else="" class="small">
                        <div t-if="line.ceo_comment" class="text-muted">
                          <t t-esc="line.ceo_comment"/>
                        </div>
                        <div t-if="line.ceo_approved_by" class="text-muted">Reviewed by CEO</div>
                      </div>
                    </td>
                  </tr>
                </t>
                <tr t-if="not lines">
                  <td colspan="11" class="text-center text-muted py-5">No payments found.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="d-lg-none">
          <t t-foreach="lines" t-as="line">
            <div class="card border-0 shadow-sm mb-3 eps-mobile-card">
              <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                  <div class="min-w-0">
                    <div class="fw-bold eps-mobile-value"><t t-esc="line.name"/></div>
                    <div class="text-muted small"><t t-esc="line.category_id.name"/></div>
                  </div>
                  <span class="badge rounded-pill text-bg-secondary flex-shrink-0">
                    <t t-esc="dict(line._fields['ceo_decision'].selection).get(line.ceo_decision)"/>
                  </span>
                </div>
                <div class="row g-3 mb-3">
                  <div class="col-6">
                    <div class="eps-mobile-label">Planned date</div>
                    <div class="eps-mobile-value"><t t-esc="line.planned_date"/></div>
                  </div>
                  <div class="col-6">
                    <div class="eps-mobile-label">Weekly plan</div>
                    <a class="eps-mobile-value" t-att-href="'/my/employee/treasury/plans/%s' % line.run_id.id"><t t-esc="line.run_id.name"/></a>
                  </div>
                  <div class="col-12">
                    <div class="eps-mobile-label">Partner / Project</div>
                    <div class="eps-mobile-value fw-semibold" t-if="line.partner_id"><t t-esc="line.partner_id.name"/></div>
                    <div class="eps-mobile-value text-muted" t-if="line.project_id"><t t-esc="line.project_id.name"/></div>
                    <div class="eps-mobile-value text-muted" t-if="not line.partner_id and not line.project_id">Not specified</div>
                  </div>
                  <div class="col-6">
                    <div class="eps-mobile-label">Requested</div>
                    <div class="eps-mobile-money"><span t-field="line.forecast_amount" t-options="{'widget':'monetary','display_currency':line.currency_id}"/></div>
                  </div>
                  <div class="col-6">
                    <div class="eps-mobile-label">Approved</div>
                    <div class="eps-mobile-money"><span t-field="line.approved_amount" t-options="{'widget':'monetary','display_currency':line.currency_id}"/></div>
                  </div>
                  <div class="col-6" t-if="line.purchase_order_ids">
                    <div class="eps-mobile-label">PO paid</div>
                    <div class="eps-mobile-value"><span t-field="line.po_amount_paid" t-options="{'widget':'monetary','display_currency':line.currency_id}"/></div>
                  </div>
                  <div class="col-6" t-if="line.purchase_order_ids">
                    <div class="eps-mobile-label">PO due</div>
                    <div class="eps-mobile-value"><span t-field="line.po_balance_due" t-options="{'widget':'monetary','display_currency':line.currency_id}"/></div>
                  </div>
                  <div class="col-12">
                    <div class="eps-mobile-label">Purchase order</div>
                    <t t-if="line.portal_purchase_order_ids">
                      <div class="d-grid gap-2">
                        <a t-foreach="line.portal_purchase_order_ids" t-as="po"
                           t-att-href="'/my/employee/treasury/purchase-order/%s' % po.id"
                           class="btn btn-outline-primary btn-sm eps-mobile-po"
                           target="_blank" rel="noopener">
                          <i class="fa fa-eye me-2"/><t t-esc="po.name"/>
                        </a>
                      </div>
                    </t>
                    <span t-else="" class="text-muted eps-mobile-value">No PO linked</span>
                  </div>
                </div>
                <form class="eps-mobile-actions" t-if="line.ceo_decision in ('pending', 'held')" t-att-action="'/my/employee/treasury/lines/%s/review' % line.id" method="post">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <label class="form-label fw-semibold mb-1">Approved amount</label>
                  <input type="number" step="0.01" min="0" name="approved_amount" class="form-control mb-2" t-att-value="line.approved_amount or line.forecast_amount"/>
                  <label class="form-label fw-semibold mb-1">CEO comment</label>
                  <textarea name="comment" class="form-control mb-3" rows="3" placeholder="Add a comment"><t t-esc="line.ceo_comment or ''"/></textarea>
                  <div class="d-grid gap-2">
                    <button name="decision" value="approved" class="btn btn-success"><i class="fa fa-check me-2"/>Approve</button>
                    <div class="row g-2">
                      <div class="col-6"><button name="decision" value="held" class="btn btn-warning w-100"><i class="fa fa-pause me-2"/>Hold</button></div>
                      <div class="col-6"><button name="decision" value="rejected" class="btn btn-outline-danger w-100"><i class="fa fa-times me-2"/>Reject</button></div>
                    </div>
                  </div>
                </form>
                <div t-else="" class="border-top pt-3 small">
                  <div t-if="line.ceo_comment" class="mb-1"><span class="text-muted">Comment: </span><t t-esc="line.ceo_comment"/></div>
                  <div t-if="line.ceo_approved_by" class="text-muted">Reviewed by CEO</div>
                </div>
              </div>
            </div>
          </t>
          <div t-if="not lines" class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-5">No payments found.</div></div>
        </div>
      </div>
    </t>
  </template>
  <template id="portal_treasury_plan_list" name="CEO Weekly Cash Plans">
    <t t-call="employee_portal_suite.employee_portal_layout">
      <style>
        .eps-treasury-table { font-size: 11.5px; table-layout: fixed; width: 100%; }
        .eps-treasury-table th, .eps-treasury-table td { padding: .32rem .38rem; vertical-align: middle; line-height: 1.2; }
        .eps-treasury-table th { font-size: 10.5px; white-space: nowrap; font-weight: 600; }
        .eps-treasury-table .eps-money, .eps-treasury-table .eps-date, .eps-treasury-table .eps-status { white-space: nowrap; }
        .eps-treasury-table .eps-truncate { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .eps-treasury-table .badge { font-size: 10px; padding: .25em .45em; font-weight: 600; }
        .eps-treasury-table .btn { font-size: 10.5px; padding: .16rem .35rem; line-height: 1.25; }
        .eps-treasury-table .form-control, .eps-treasury-table .input-group-text { font-size: 10.5px; padding: .22rem .35rem; }
        .eps-treasury-table textarea.form-control { min-height: 42px; resize: vertical; }
        .eps-col-date { width: 6%; }
        .eps-col-payment { width: 9%; }
        .eps-col-plan { width: 7%; }
        .eps-col-partner { width: 11%; }
        .eps-col-po { width: 8%; }
        .eps-col-money { width: 7%; }
        .eps-col-status { width: 11%; }
        .eps-col-review { width: 20%; }
        .eps-col-status .badge { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .eps-icon-btn { min-width: 28px; }
        .eps-summary-table { font-size: 11.5px; table-layout: fixed; width: 100%; }
        .eps-summary-table th, .eps-summary-table td { padding: .32rem .38rem; vertical-align: middle; line-height: 1.2; }
        .eps-summary-table th { font-size: 10.5px; white-space: nowrap; font-weight: 600; }
        .eps-weekly-col-date { width: 8%; }
        .eps-weekly-col-flow { width: 6%; }
        .eps-weekly-col-description { width: 10%; }
        .eps-weekly-col-partner { width: 15%; }
        .eps-weekly-col-money { width: 8%; }
        .eps-weekly-col-status { width: 13%; }
        .eps-weekly-col-status .badge { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
