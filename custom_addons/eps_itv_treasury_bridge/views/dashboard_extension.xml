<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="employee_portal_dashboard_treasury" inherit_id="employee_portal_suite.employee_portal_dashboard">
        <xpath expr="//div[hasclass('st-attention-grid')]" position="inside">
            <t t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')">
                <t t-set="treasury_pending_count" t-value="request.env['cash.plan.line'].sudo().search_count([('company_id','in',request.env.user.company_ids.ids),('flow_type','=','out'),('ceo_decision','=','pending')])"/>
                <t t-if="treasury_pending_count &gt; 0">
                    <a href="/my/employee/treasury/payments" class="st-attention-card">
                        <div class="st-attention-top"><div class="st-attention-icon warn"><i class="fa fa-check-square-o"/></div><span class="badge bg-warning">CEO review</span></div>
                        <h3><t t-esc="treasury_pending_count"/> Payment<t t-if="treasury_pending_count != 1">s</t></h3>
                        <p>Outgoing payments are waiting for your treasury decision.</p>
                        <div class="st-card-action">Review Payments</div>
                    </a>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('st-workspace-grid')]" position="inside">
            <t t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')">
                <t t-set="treasury_pending_count" t-value="request.env['cash.plan.line'].sudo().search_count([('company_id','in',request.env.user.company_ids.ids),('flow_type','=','out'),('ceo_decision','=','pending')])"/>
                <t t-set="weekly_plan_count" t-value="request.env['cash.plan.run'].sudo().search_count([('company_id','in',request.env.user.company_ids.ids)])"/>
                <a href="/my/employee/treasury/payments" class="st-module-card">
                    <div class="st-module-icon"><i class="fa fa-check-square-o"/></div>
                    <div><div class="st-module-title">Payment Approvals</div><div class="st-module-meta"><t t-esc="treasury_pending_count"/> awaiting CEO review</div></div>
                    <i class="fa fa-angle-right st-module-arrow"/>
                </a>
                <a href="/my/employee/treasury/plans" class="st-module-card">
                    <div class="st-module-icon"><i class="fa fa-line-chart"/></div>
                    <div><div class="st-module-title">Weekly Cash Plans</div><div class="st-module-meta"><t t-esc="weekly_plan_count"/> plans available</div></div>
                    <i class="fa fa-angle-right st-module-arrow"/>
                </a>
            </t>
        </xpath>
    </template>
</odoo>
