<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="employee_portal_layout_treasury"
              inherit_id="employee_portal_suite.employee_portal_layout">

        <!-- Desktop approvals dropdown -->
        <xpath expr="//div[@id='app-d']/a[@href='/my/employee/material/approvals']" position="after">
            <t t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')">
                <a href="/my/employee/treasury/payments" class="ep-sub-link">Payment Approvals</a>
                <a href="/my/employee/treasury/plans" class="ep-sub-link">Weekly Cash Plans</a>
            </t>
        </xpath>

        <!-- Mobile approvals menu -->
        <xpath expr="//div[@id='approvalMenu']/t[last()]" position="after">
            <t t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')">
                <a href="/my/employee/treasury/payments" class="fab-item">
                    <i class="fa fa-check-square-o"></i>
                    <span>Payment Approvals</span>
                </a>
                <a href="/my/employee/treasury/plans" class="fab-item">
                    <i class="fa fa-line-chart"></i>
                    <span>Weekly Cash Plans</span>
                </a>
            </t>
        </xpath>
    </template>
</odoo>
