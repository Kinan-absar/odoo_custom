<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="employee_portal_layout_treasury" inherit_id="employee_portal_suite.employee_portal_layout">
        <xpath expr="//a[@href='/my/employee/material/approvals'][hasclass('stitch-nav-link')]" position="after">
            <t t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')">
                <a href="/my/employee/treasury/payments" t-att-class="'stitch-nav-link active' if request.httprequest.path.startswith('/my/employee/treasury/payments') else 'stitch-nav-link'"><i class="fa fa-check-square-o"/><span>Payment Approvals</span></a>
                <a href="/my/employee/treasury/plans" t-att-class="'stitch-nav-link active' if request.httprequest.path.startswith('/my/employee/treasury/plans') else 'stitch-nav-link'"><i class="fa fa-line-chart"/><span>Weekly Cash Plans</span></a>
            </t>
        </xpath>
        <xpath expr="//div[@id='approvalMenu']/t[last()]" position="after">
            <t t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')">
                <a href="/my/employee/treasury/payments" class="fab-item"><i class="fa fa-check-square-o"/><span>Payment Approvals</span></a>
                <a href="/my/employee/treasury/plans" class="fab-item"><i class="fa fa-line-chart"/><span>Weekly Cash Plans</span></a>
            </t>
        </xpath>
    </template>
</odoo>
