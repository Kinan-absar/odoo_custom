<odoo>
 <record id="group_portal_sales_creator" model="res.groups">
  <field name="name">Employee Portal: Sales &amp; Proposals - Prepare</field>
 </record>
 <record id="group_portal_sales_approver" model="res.groups">
  <field name="name">Employee Portal: Sales &amp; Proposals - Approve</field>
  <field name="implied_ids" eval="[(4, ref('absar_portal_sales.group_portal_sales_creator'))]"/>
 </record>
 <record id="group_portal_sales_monitor" model="res.groups">
  <field name="name">Employee Portal: Sales &amp; Proposals - Monitor (Read Only)</field>
 </record>
 <record id="group_portal_sales_user" model="res.groups"><field name="name">Sales User (All Company Documents)</field><field name="implied_ids" eval="[(4, ref('group_portal_sales_creator'))]"/><field name="comment">Work on all company-compatible quotations and sales orders. Existing issuer approvals remain required. Grants no internal accounting or sales model ACLs.</field></record>
</odoo>
