<odoo>
 <template id="sales_list" name="Employee Portal Sales List">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container aps-wrap py-4"><div class="aps-head"><h3>Sales &amp; Proposals</h3><a t-if="can_create" class="btn btn-primary" href="/my/employee/sales/new">+ New Offer</a></div>
    <p class="text-muted">Prepare quotations and technical proposals for internal approval. Approval never confirms a Sales Order.</p><a t-if="is_approver" class="btn btn-outline-primary mb-3" href="/my/employee/sales/approvals">Pending Approvals (<t t-out="pending_count"/>)</a>
    <div class="aps-panel table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Number</th><th>Customer</th><th>Project</th><th>Type</th><th>Prepared by</th><th>Value (excl. VAT)</th><th>Review</th><th/></tr></thead><tbody>
     <t t-foreach="orders" t-as="o"><tr class="aps-click-row" tabindex="0" role="link" t-att-data-href="'/my/employee/sales/%s' % o.id"><td><strong t-out="o.name"/></td><td t-out="o.partner_id.name"/><td t-out="o.construction_project_id.name or '—'"/><td t-out="dict(o._fields['absar_proposal_type'].selection).get(o.absar_proposal_type)"/><td t-out="o.absar_portal_creator_id.name"/><td><t t-out="'%.2f' % o.amount_untaxed"/> <t t-out="o.currency_id.name"/></td><td><span t-att-class="'aps-status aps-status-' + (o.absar_portal_review_state or 'draft')" t-out="dict(o._fields['absar_portal_review_state'].selection).get(o.absar_portal_review_state)"/></td><td><a t-att-href="'/my/employee/sales/%s' % o.id">Open</a></td></tr></t>
     <tr t-if="not orders"><td colspan="8" class="text-muted">No portal sales records yet.</td></tr>
    </tbody></table></div>
   </div>
  </t>
 </template>
 <template id="sales_new" name="New Portal Sales Offer">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container aps-wrap py-4"><a href="/my/employee/sales">&#8592; Sales &amp; Proposals</a><h3 class="mt-3">Create an offer</h3>
    <div t-if="error" class="alert alert-danger" t-out="error"/>
    <form method="post" action="/my/employee/sales/create" class="aps-panel aps-form">
     <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
     <label>Customer</label><select name="partner_id" class="form-select" required="required"><option value="">Select customer</option><option t-foreach="partners" t-as="p" t-att-value="p.id" t-out="p.name"/></select>
     <label>Project (optional)</label><select name="project_id" class="form-select"><option value="">Choose a project</option><option t-foreach="projects" t-as="project" t-att-value="project.id" t-out="project.name"/></select>
     <label>Offer type</label><select name="kind" class="form-select"><option value="standard">Standard Quotation</option><option value="technical">Technical &amp; Financial Proposal</option></select>
     <label>Technical proposal template (optional)</label><select name="template_id" class="form-select"><option value="">None</option><option t-foreach="templates" t-as="t" t-att-value="t.id" t-out="t.name"/></select>
     <label>Expiration date (optional)</label><input type="date" name="validity_date" class="form-control"/>
     <button class="btn btn-primary mt-3">Create Draft</button>
    </form>
   </div>
  </t>
 </template>
 <template id="sales_detail" name="Portal Sales Offer Editor">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container aps-wrap py-4"><a href="/my/employee/sales">&#8592; Sales &amp; Proposals</a>
    <div class="aps-head mt-3"><div><h3><t t-out="order.name"/> · <t t-out="order.partner_id.name"/></h3><span t-att-class="'aps-status aps-status-' + (order.absar_portal_review_state or 'draft')" t-out="dict(order._fields['absar_portal_review_state'].selection).get(order.absar_portal_review_state)"/></div>
     <a t-if="order.absar_portal_review_state == 'approved'" t-att-href="'/my/employee/sales/%s/pdf' % order.id" class="btn btn-outline-primary" target="_blank">Print / Download PDF</a></div>
    <div t-if="error or request.params.get('error')" class="alert alert-warning" t-out="error or 'The requested change could not be saved. Check the values and try again.'"/>
    <div t-if="order.absar_portal_review_note" class="alert alert-info"><strong>Reviewer note:</strong> <t t-out="order.absar_portal_review_note"/></div>
    <div class="aps-panel"><h5>Offer details</h5><div class="row"><div class="col-md-4"><span class="text-muted">Customer</span><p t-out="order.partner_id.name"/></div><div class="col-md-4"><span class="text-muted">Document type</span><p t-out="dict(order._fields['absar_proposal_type'].selection).get(order.absar_proposal_type)"/></div><div class="col-md-4"><span class="text-muted">Project</span><p t-out="order.construction_project_id.name or 'Not assigned'"/></div></div>
     <form t-if="can_edit" t-att-action="'/my/employee/sales/%s/save' % order.id" method="post" class="row g-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
      <div class="col-md-4"><label>Proposal reference (automatic)</label><input class="form-control" t-att-value="order.name" readonly="readonly"/></div>
      <div class="col-md-4"><label>Project</label><select class="form-select" name="project_id"><option value="">No project</option><option t-foreach="projects" t-as="project" t-att-value="project.id" t-att-selected="order.construction_project_id.id == project.id and 'selected' or None" t-out="project.name"/></select></div><div class="col-md-4"><label>Expiration date</label><input class="form-control" type="date" name="validity_date" t-att-value="order.validity_date or ''"/></div>
      <div t-if="order.absar_proposal_type == 'technical'" class="col-md-4"><label>Proposal title</label><input class="form-control" name="title" t-att-value="order.absar_proposal_title or ''"/></div>
      <div class="col-12"><button class="btn btn-outline-primary">Save Details</button></div>
     </form>
    </div>
    <div class="aps-panel"><h5>Bill of Quantities / Order Lines</h5><div class="table-responsive"><table class="table"><thead><tr><th>Description</th><th>Unit</th><th class="text-end">Quantity</th><th class="text-end">Unit Rate</th><th class="text-end">Subtotal</th><th/></tr></thead><tbody>
     <tr t-foreach="order.order_line" t-as="l"><td style="white-space:pre-wrap" t-out="l.name"/><td t-out="l.product_uom.name if not l.display_type else ''"/><td class="text-end" t-out="'%.2f' % l.product_uom_qty if not l.display_type else ''"/><td class="text-end" t-out="'%.2f' % l.price_unit if not l.display_type else ''"/><td class="text-end" t-out="'%.2f' % l.price_subtotal if not l.display_type else ''"/><td><form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/line/%s/delete' % (order.id,l.id)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>
     <tr t-if="can_edit" class="aps-inline-add-row"><td colspan="6">
      <details class="aps-add-item"><summary>+ Add Item</summary>
       <form method="post" t-att-action="'/my/employee/sales/%s/line/add' % order.id" class="aps-inline-add-form">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <div class="aps-add-description"><label>Description</label><textarea class="form-control" name="description" rows="2" required="required"/></div>
        <div><label>Unit</label><select name="uom_id" class="form-select"><option t-foreach="units" t-as="unit" t-att-value="unit.id" t-att-selected="unit.name == 'Units' and 'selected' or None" t-out="unit.name"/></select></div>
        <div><label>Quantity</label><input type="number" class="form-control" name="qty" min="0.001" step="any" value="1" required="required"/></div>
        <div><label>Unit rate</label><input type="number" class="form-control" name="rate" min="0" step="any" value="0" required="required"/></div>
        <div class="aps-add-actions"><button type="submit" class="aps-text-action">Save &amp; Add Item</button><button type="button" class="aps-text-action aps-cancel-add">Cancel</button></div>
       </form>
      </details>
     </td></tr>
    </tbody></table></div>
    <div class="aps-total">Proposal value (excluding VAT): <strong><t t-out="'%.2f' % order.amount_untaxed"/> <t t-out="order.currency_id.name"/></strong></div></div>
    <t t-if="order.absar_proposal_type == 'technical'">
     <div class="aps-panel"><h5>Technical Proposal Template</h5>
      <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/template' % order.id" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-8"><select name="template_id" class="form-select" required="required"><option value="">Choose a template</option><option t-foreach="templates" t-as="t" t-att-value="t.id" t-out="t.name"/></select></div><div class="col-md-4"><button class="btn btn-outline-primary" data-aps-confirm="Replace existing proposal sections and milestones with the selected template?">Load / Replace Template</button></div></form>
      <p t-if="not can_edit" class="text-muted" t-out="order.absar_proposal_template_id.name or 'Custom proposal'"/>
     </div>
     <div class="aps-panel"><h5>Technical Sections</h5><p t-if="can_edit" class="text-muted small">Drag the handle to reorder sections, or use Move Up / Move Down.</p><div class="aps-sortable" t-att-data-reorder-url="'/my/employee/sales/%s/sections/reorder' % order.id" t-att-data-csrf="request.csrf_token()"><div t-foreach="order.absar_proposal_section_ids.sorted(key=lambda s:(s.sequence,s.id))" t-as="s" class="aps-section" t-att-data-section-id="s.id">
      <div t-if="can_edit" class="aps-drag-handle" draggable="true" title="Drag to reorder">&#9776; Drag to reorder</div>
      <form t-att-action="'/my/employee/sales/%s/section/%s/save' % (order.id,s.id)" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
       <label>Section type</label><select name="section_type" class="form-select" t-att-disabled="not can_edit and 'disabled' or None"><option t-foreach="s._fields['section_type'].selection" t-as="opt" t-att-value="opt[0]" t-att-selected="s.section_type == opt[0] and 'selected' or None" t-out="opt[1]"/></select>
       <label class="mt-2">Section title</label><input class="form-control" name="name" t-att-value="s.name" t-att-readonly="not can_edit and 'readonly' or None"/>
       <label class="mt-2">Content</label>
       <div class="aps-editor" t-att-data-editable="can_edit and '1' or '0'">
        <div t-if="can_edit" class="aps-editor-toolbar" role="toolbar" aria-label="Format text"><button type="button" data-aps-format="bold" title="Bold"><b>B</b></button><button type="button" data-aps-format="italic" title="Italic"><i>I</i></button><button type="button" data-aps-format="underline" title="Underline"><u>U</u></button><select aria-label="Text size" class="aps-font-size"><option value="">Text size</option><option value="2">Small</option><option value="3">Normal</option><option value="4">Large</option><option value="5">Extra large</option></select><button type="button" data-aps-format="insertUnorderedList" title="Bullet list">&#8226; List</button></div>
        <div class="aps-editor-body" t-att-contenteditable="can_edit and 'true' or 'false'" t-field="s.content"/>
        <textarea name="content" hidden="hidden" t-out="s.content or ''"/>
       </div>
       <div t-if="can_edit" class="d-flex gap-3 align-items-center mt-2"><label><input type="checkbox" name="include" value="1" t-att-checked="s.include_in_report and 'checked' or None"/> Include in PDF</label><label><input type="checkbox" name="page_break" value="1" t-att-checked="s.page_break_before and 'checked' or None"/> New PDF page</label><button class="btn btn-sm btn-outline-primary">Save Section</button></div>
      </form>
      <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/section/%s/move' % (order.id,s.id)" class="d-inline-flex gap-2 mt-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-secondary" name="direction" value="up">Move Up</button><button class="btn btn-sm btn-outline-secondary" name="direction" value="down">Move Down</button></form>
      <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/section/%s/delete' % (order.id,s.id)" class="mt-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-danger" data-aps-confirm="Remove this section?">Delete Section</button></form>
     </div>
     </div><form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/section/add' % order.id" class="aps-new row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-3"><select class="form-select" name="section_type"><option t-foreach="order.env['absar.proposal.section']._fields['section_type'].selection" t-as="opt" t-att-value="opt[0]" t-out="opt[1]"/></select></div><div class="col-md-4"><input class="form-control" name="name" placeholder="New section title" required="required"/></div><div class="col-md-5"><textarea class="form-control" rows="2" name="content" placeholder="Initial text (can be formatted after adding)"/></div><div class="col-12 d-flex gap-3 align-items-center"><label><input type="checkbox" name="page_break" value="1"/> Start on new PDF page</label><button class="btn btn-outline-primary">+ Add Section</button></div></form>
     </div>
     <div class="aps-panel"><h5>Payment Milestones</h5><div class="table-responsive"><table class="table"><thead><tr><th>Milestone</th><th>%</th><th>Due condition</th><th/></tr></thead><tbody><tr t-foreach="order.absar_proposal_payment_ids" t-as="p"><td t-out="p.name"/><td t-out="p.percentage"/><td t-out="p.due_condition"/><td><form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/milestone/%s/delete' % (order.id,p.id)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr></tbody></table></div>
      <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/milestone/add' % order.id" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-4"><input class="form-control" name="name" placeholder="Milestone" required="required"/></div><div class="col-md-2"><input class="form-control" name="percentage" type="number" step="0.01" min="0" max="100" placeholder="%" required="required"/></div><div class="col-md-4"><input class="form-control" name="due_condition" placeholder="Payment due condition"/></div><div class="col-md-2"><button class="btn btn-outline-primary">Add</button></div></form>
     </div>
    </t>
    <div class="aps-panel"><h5>Internal Review</h5>
     <p class="text-muted">Submission locks the draft. Approval permits PDF access but does not send the quotation or confirm the Sales Order.</p>
     <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="submit"/><button class="btn btn-primary" t-att-disabled="not order.order_line and 'disabled' or None">Submit for Approval</button></form>
     <div t-if="can_review" class="d-flex gap-3 flex-wrap"><form method="post" t-att-action="'/my/employee/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="approve"/><button class="btn btn-success">Approve for Sending</button></form>
      <form method="post" t-att-action="'/my/employee/sales/%s/workflow' % order.id" class="d-flex gap-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="return"/><input class="form-control" name="note" placeholder="Reason for correction" required="required"/><button class="btn btn-outline-danger">Return</button></form></div>
    </div>
    <div class="aps-modal" id="aps-modal" hidden="hidden"><div class="aps-modal-content" role="dialog" aria-modal="true" aria-labelledby="aps-modal-title"><h5 id="aps-modal-title">Confirm action</h5><p id="aps-modal-text"/><div class="d-flex gap-2 justify-content-end"><button type="button" class="btn btn-light" id="aps-modal-cancel">Cancel</button><button type="button" class="btn btn-primary" id="aps-modal-ok">Continue</button></div></div></div>
   </div>
  </t>
 </template>
</odoo>
