<odoo>
 <template id="sales_workspace_header"><header class="aps-workspace-header"><div class="aps-workspace-brand"><span class="aps-workspace-icon"><i class="fa fa-line-chart" aria-hidden="true"/></span><div><strong>Sales</strong><small t-out="request.env.company.name"/></div></div><nav class="aps-app-nav" aria-label="Sales workspace"><a t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_creator')" href="/my/employee/sales/updates">Review Updates</a><a href="/my/employee/sales" t-att-class="'active' if request.httprequest.path.rstrip('/') == '/my/employee/sales' else ''"><t t-out="'Quotations &amp; Sales Orders' if request.env.user.has_group('absar_portal_sales.group_portal_sales_user') else 'My Quotations'"/></a><a t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor')" href="/my/employee/sales/monitor">Monitoring</a><a t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_approver')" href="/my/employee/sales/approvals">Approvals</a></nav></header></template>

 <template id="sales_list" name="Employee Portal Sales List">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container aps-wrap py-4"><t t-call="absar_portal_sales.sales_workspace_header"/>
    <div class="aps-head"><h3 t-out="'Sales Review Updates' if updates_only else 'Sales Monitoring' if monitoring else ('Pending Approvals' if queue_only else ('Quotations &amp; Sales Orders' if request.env.user.has_group('absar_portal_sales.group_portal_sales_user') else 'My Quotations'))"/><a t-if="can_create and not monitoring and not queue_only and not updates_only" class="btn btn-primary" href="/my/employee/sales/new">+ New Quotation</a></div>
    <p class="text-muted" t-if="monitoring">Read-only visibility across your allowed companies. Backend quotations and confirmed Sales Orders can be filtered separately.</p>
    <form class="aps-monitor-filters" t-att-action="'/my/employee/sales/updates' if updates_only else '/my/employee/sales/monitor' if monitoring else ('/my/employee/sales/approvals' if queue_only else '/my/employee/sales')" method="get">
     <input class="form-control" name="q" type="search" t-att-value="q" placeholder="Search quotation, customer, project, salesperson"/>
     <select t-if="monitoring or request.env.user.has_group('absar_portal_sales.group_portal_sales_user')" name="source" class="form-select" aria-label="Source"><option value="all">All sources</option><option value="portal" t-att-selected="source == 'portal' and 'selected' or None">Portal</option><option value="backend" t-att-selected="source == 'backend' and 'selected' or None">Backend</option></select>
     <select t-if="monitoring or request.env.user.has_group('absar_portal_sales.group_portal_sales_user')" name="sales_state" class="form-select" aria-label="Sales status"><option value="all">All sales statuses</option><option value="quotation" t-att-selected="sales_state == 'quotation' and 'selected' or None">Quotations</option><option value="order" t-att-selected="sales_state == 'order' and 'selected' or None">Sales Orders</option><option value="cancel" t-att-selected="sales_state == 'cancel' and 'selected' or None">Cancelled</option></select>
     <select t-if="monitoring or request.env.user.has_group('absar_portal_sales.group_portal_sales_user')" name="review" class="form-select" aria-label="Internal review"><option value="all">All review statuses</option><option value="na" t-att-selected="review == 'na' and 'selected' or None">Not applicable (backend)</option><option value="draft" t-att-selected="review == 'draft' and 'selected' or None">Portal draft</option><option value="submitted" t-att-selected="review == 'submitted' and 'selected' or None">Awaiting approval</option><option value="approved" t-att-selected="review == 'approved' and 'selected' or None">Approved</option><option value="returned" t-att-selected="review == 'returned' and 'selected' or None">Returned</option></select>
     <button class="btn btn-outline-primary" type="submit">Filter</button>
    </form>
    <p class="aps-result-count"><t t-out="total_count"/> matching records · Page <t t-out="page"/> of <t t-out="pages"/></p>
    <div class="table-responsive aps-panel"><table class="table table-hover align-middle aps-sales-table"><thead><tr><th>Number</th><th>Customer</th><th>Project</th><th>Salesperson</th><th>Date</th><th class="text-end">Total</th><th>Status</th><th>Approval</th></tr></thead><tbody>
     <tr t-foreach="orders" t-as="o" class="aps-click-row" t-att-data-href="'/my/employee/sales/%s' % o.id">
      <td><a t-att-href="'/my/employee/sales/%s' % o.id" t-out="o.name"/></td><td t-out="o.partner_id.name"/><td t-out="o.construction_project_id.name or '—'"/><td t-out="o.user_id.name or '—'"/><td><span t-field="o.date_order" t-options="{'widget':'date'}"/></td>
      <td class="text-end text-nowrap"><t t-out="'{:,.2f}'.format(o.amount_total)"/> <t t-out="o.currency_id.name"/></td><td t-out="dict(o._fields['state'].selection).get(o.state)"/>
      <td><span t-if="o.absar_portal_creator_id" class="aps-status" t-out="dict(o._fields['absar_order_review_state'].selection).get(o.absar_order_review_state) if o.absar_order_review_state != 'none' else dict(o._fields['absar_portal_review_state'].selection).get(o.absar_portal_review_state)"/><span t-else="">—</span></td>
     </tr><tr t-if="not orders"><td colspan="8">No quotations match these filters.</td></tr>
    </tbody></table></div>
    <nav class="aps-pagination" aria-label="Quotation pages"><a t-if="page &gt; 1" class="btn btn-outline-secondary" t-att-href="previous_url">← Previous</a><span>Page <t t-out="page"/> / <t t-out="pages"/></span><a t-if="page &lt; pages" class="btn btn-outline-secondary" t-att-href="next_url">Next →</a></nav>
   </div>
  </t>
 </template>
 <template id="sales_new" name="New Portal Sales Quotation">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container aps-wrap py-4"><t t-call="absar_portal_sales.sales_workspace_header"/><a href="/my/employee/sales">← Quotations</a>
    <div class="aps-head mt-3"><h3>New Quotation</h3><span class="aps-status">Draft</span></div>
    <div t-if="error" class="alert alert-danger" t-out="error"/>
    <div class="aps-panel"><div id="aps-new-details" class="row g-3 mb-4">
     <div class="col-md-6"><label>Customer</label><select name="partner_id" class="form-select aps-customer-select" required="required"><option value="">Select customer</option><option t-foreach="partners" t-as="p" t-att-data-commercial-id="p.commercial_partner_id.id" t-att-value="p.id" t-out="p.name"/></select></div>
     <div class="col-md-6"><label>Expiration Date</label><input type="date" name="validity_date" class="form-control"/></div>
     <div class="col-md-6"><label>Project</label><select name="project_id" class="form-select aps-project-select"><option value="">No project</option><option t-foreach="projects" t-as="project" t-att-value="project.id" t-att-data-customer-id="project.partner_id.commercial_partner_id.id if project.partner_id else 0" t-out="project.name"/></select></div>
     <div class="col-md-6"><label>Document Type</label><select name="kind" class="form-select"><option value="standard">Standard Quotation</option><option value="technical">Technical &amp; Financial Proposal</option></select></div>
    </div><h5>Order Lines</h5><div id="aps-line-editor" t-att-data-boot="line_boot_json" t-att-data-csrf="request.csrf_token()"/><noscript>Enable JavaScript to prepare this quotation.</noscript></div>
   </div>
  </t>
 </template>
 <template id="sales_detail" name="Portal Sales Quotation Editor">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container aps-wrap py-4" t-att-data-sales-partner="order.partner_id.id"><t t-call="absar_portal_sales.sales_workspace_header"/><a t-att-href="'/my/employee/sales/monitor' if request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor') and not order.absar_portal_creator_id else '/my/employee/sales'">← Quotations</a>
    <div class="aps-head mt-3"><div><h3><t t-out="order.name"/> · <t t-out="order.partner_id.name"/></h3><span class="aps-status aps-status-sales" t-out="dict(order._fields['state'].selection).get(order.state)"/> <span t-if="order.absar_portal_creator_id" t-att-class="'aps-status aps-status-' + (order.absar_portal_review_state or 'draft')" t-out="dict(order._fields['absar_portal_review_state'].selection).get(order.absar_portal_review_state)"/><span t-else="" class="aps-muted-tag">Approval required before confirmation</span></div>
     <a t-if="not order.absar_portal_creator_id or order.absar_portal_review_state == 'approved'" t-att-href="'/my/employee/sales/%s/pdf' % order.id" class="btn btn-outline-primary" target="_blank">Print / Download PDF</a></div>
    <div class="aps-sales-actions d-flex gap-2 flex-wrap mb-3">
     <form t-if="can_submit" method="post" t-att-action="'/my/employee/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="submit"/><button class="btn btn-primary" data-aps-submit-review="1" t-att-disabled="not order.order_line and 'disabled' or None">Submit for Approval</button></form>
     <form t-if="can_request_order" method="post" t-att-action="'/my/employee/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="request_order"/><button class="btn btn-primary">Request Sales Order Approval</button></form>
     <t t-if="can_approve or can_approve_order">
      <form method="post" t-att-action="'/my/employee/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" t-att-value="'approve_order' if can_approve_order else 'approve'"/><button class="btn btn-success">Approve</button></form>
      <form method="post" t-att-action="'/my/employee/sales/%s/workflow' % order.id" class="d-flex gap-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" t-att-value="'return_order' if can_approve_order else 'return'"/><input class="form-control" name="note" placeholder="Reason for return" required="required"/><button class="btn btn-outline-danger">Return</button></form>
     </t>
    </div>
    <p t-if="order.absar_order_review_state == 'requested'" class="alert alert-info">Awaiting approval to convert this quotation into a Sales Order.</p>
    <div t-if="error or request.params.get('error')" class="alert alert-warning" t-out="error or 'The requested change could not be saved. Check the values and try again.'"/>
    <div t-if="order.absar_portal_review_note" class="alert alert-info"><strong>Reviewer note:</strong> <t t-out="order.absar_portal_review_note"/></div>
    <div class="aps-panel"><h5>Quotation Details</h5><div class="row"><div class="col-md-4"><span class="text-muted">Customer</span><p t-out="order.partner_id.name"/></div><div class="col-md-4"><span class="text-muted">Document type</span><p t-out="dict(order._fields['absar_proposal_type'].selection).get(order.absar_proposal_type)"/></div><div class="col-md-4"><span class="text-muted">Project</span><p t-out="order.construction_project_id.name or 'Not assigned'"/></div><div class="col-md-4"><span class="text-muted">Salesperson</span><p t-out="order.user_id.name or order.absar_portal_creator_id.name"/></div></div>
     <form t-if="can_edit" t-att-action="'/my/employee/sales/%s/save' % order.id" method="post" class="row g-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
      <div class="col-md-4"><label>Proposal reference (automatic)</label><input class="form-control" t-att-value="order.name" readonly="readonly"/></div>
      <div class="col-md-4"><label>Project</label><select class="form-select aps-project-select" name="project_id"><option value="">No project</option><option t-foreach="projects" t-as="project" t-att-value="project.id" t-att-data-customer-id="project.partner_id.commercial_partner_id.id if project.partner_id else 0" t-att-selected="order.construction_project_id.id == project.id and 'selected' or None" t-out="project.name"/></select></div><div class="col-md-4"><label>Expiration date</label><input class="form-control" type="date" name="validity_date" t-att-value="order.validity_date or ''"/></div>
      <div t-if="order.absar_proposal_type == 'technical'" class="col-md-4"><label>Proposal title</label><input class="form-control" name="title" t-att-value="order.absar_proposal_title or ''"/></div>
      <div class="col-12"><button class="btn btn-outline-primary">Save Details</button></div>
     </form>
    </div>
    <div class="aps-panel aps-sales-lines-panel"><h5>Order Lines</h5><div id="aps-line-editor" t-att-data-boot="line_boot_json" t-att-data-csrf="request.csrf_token()"/><noscript>Enable JavaScript to view and edit quotation lines.</noscript></div>
    <t t-if="order.absar_proposal_type == 'technical'">
     <div class="aps-panel"><h5>Technical Proposal Template</h5>
      <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/template' % order.id" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-8"><select name="template_id" class="form-select" required="required"><option value="">Choose a template</option><option t-foreach="templates" t-as="t" t-att-value="t.id" t-out="t.name"/></select></div><div class="col-md-4"><button class="btn btn-outline-primary" data-aps-confirm="Replace existing proposal sections and milestones with the selected template?">Load / Replace Template</button></div></form>
      <p t-if="not can_edit" class="text-muted" t-out="order.absar_proposal_template_id.name or 'Custom proposal'"/>
     </div>
     <div class="aps-panel"><h5>Technical Sections</h5><p t-if="can_edit" class="text-muted small">Set the Order number and save to move a section to that position.</p><div class="aps-sortable" t-att-data-reorder-url="'/my/employee/sales/%s/sections/reorder' % order.id" t-att-data-csrf="request.csrf_token()"><details t-foreach="order.absar_proposal_section_ids.sorted(key=lambda s:(s.sequence,s.id))" t-as="s" class="aps-section aps-section-compact" t-att-data-section-id="s.id"><summary class="aps-section-heading"><span class="aps-section-number" t-out="s_index + 1"/><span class="aps-section-name" t-out="s.name"/><span t-if="not s.include_in_report" class="aps-muted-tag">Hidden from PDF</span><span class="aps-section-toggle">Edit / View</span></summary><div class="aps-section-expanded">
      
      <form t-att-action="'/my/employee/sales/%s/section/%s/save' % (order.id,s.id)" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
       <div class="d-flex align-items-center gap-2 mb-2"><label class="mb-0" for="aps-section-order">Order</label><input type="number" name="position" min="1" t-att-max="len(order.absar_proposal_section_ids)" t-att-value="s_index + 1" class="form-control form-control-sm" style="width:85px"/><span class="text-muted small">Set the position, then Save Section</span></div><label>Section type</label><select name="section_type" class="form-select" t-att-disabled="not can_edit and 'disabled' or None"><option t-foreach="s._fields['section_type'].selection" t-as="opt" t-att-value="opt[0]" t-att-selected="s.section_type == opt[0] and 'selected' or None" t-out="opt[1]"/></select>
       <label class="mt-2">Section title</label><input class="form-control" name="name" t-att-value="s.name" t-att-readonly="not can_edit and 'readonly' or None"/>
       <label class="mt-2">Content</label>
       <div class="aps-editor" t-att-data-editable="can_edit and '1' or '0'">
        <div t-if="can_edit" class="aps-editor-toolbar" role="toolbar" aria-label="Format text"><button type="button" data-aps-format="bold" title="Bold"><b>B</b></button><button type="button" data-aps-format="italic" title="Italic"><i>I</i></button><button type="button" data-aps-format="underline" title="Underline"><u>U</u></button><select aria-label="Text size" class="aps-font-size"><option value="">Text size</option><option value="2">Small</option><option value="3">Normal</option><option value="4">Large</option><option value="5">Extra large</option></select><button type="button" data-aps-format="insertUnorderedList" title="Bullet list">• List</button></div>
        <div class="aps-editor-body" t-att-contenteditable="can_edit and 'true' or 'false'" role="textbox" aria-multiline="true" aria-label="Section content"><t t-if="s.content"><span t-field="s.content"/></t></div>
        <textarea name="content" hidden="hidden" t-out="s.content or ''"/>
       </div>
       <div t-if="can_edit" class="d-flex gap-3 align-items-center mt-2"><label><input type="checkbox" name="include" value="1" t-att-checked="s.include_in_report and 'checked' or None"/> Include in PDF</label><label><input type="checkbox" name="page_break" value="1" t-att-checked="s.page_break_before and 'checked' or None"/> New PDF page</label><button class="btn btn-sm btn-outline-primary">Save Section</button></div>
      </form>
      <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/section/%s/delete' % (order.id,s.id)" class="mt-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-danger" data-aps-confirm="Remove this section?">Delete Section</button></form>
     </div></details>
     </div><details t-if="can_edit" class="aps-add-section"><summary>+ Add Section</summary><form method="post" t-att-action="'/my/employee/sales/%s/section/add' % order.id" class="aps-new row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-3"><select class="form-select" name="section_type"><option t-foreach="order.env['absar.proposal.section']._fields['section_type'].selection" t-as="opt" t-att-value="opt[0]" t-out="opt[1]"/></select></div><div class="col-md-4"><input class="form-control" name="name" placeholder="New section title" required="required"/></div><div class="col-md-5"><textarea class="form-control" rows="2" name="content" placeholder="Initial text (can be formatted after adding)"/></div><div class="col-12 d-flex gap-3 align-items-center"><label>Order <input type="number" class="form-control form-control-sm" style="width:85px" name="position" min="1" t-att-max="len(order.absar_proposal_section_ids) + 1" t-att-value="len(order.absar_proposal_section_ids) + 1"/></label><label><input type="checkbox" name="page_break" value="1"/> Start on new PDF page</label><button class="btn btn-outline-primary">Save New Section</button></div></form></details>
     </div>
     <div class="aps-panel"><h5>Payment Milestones</h5><div class="table-responsive"><table class="table"><thead><tr><th>Milestone</th><th>%</th><th>Due condition</th><th/></tr></thead><tbody><tr t-foreach="order.absar_proposal_payment_ids" t-as="p"><td t-out="p.name"/><td t-out="p.percentage"/><td t-out="p.due_condition"/><td><form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/milestone/%s/delete' % (order.id,p.id)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr></tbody></table></div>
      <form t-if="can_edit" method="post" t-att-action="'/my/employee/sales/%s/milestone/add' % order.id" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-4"><input class="form-control" name="name" placeholder="Milestone" required="required"/></div><div class="col-md-2"><input class="form-control" name="percentage" type="number" step="0.01" min="0" max="100" placeholder="%" required="required"/></div><div class="col-md-4"><input class="form-control" name="due_condition" placeholder="Payment due condition"/></div><div class="col-md-2"><button class="btn btn-outline-primary">Add</button></div></form>
     </div>
    </t>
    <div class="aps-modal" id="aps-modal" hidden="hidden"><div class="aps-modal-content" role="dialog" aria-modal="true" aria-labelledby="aps-modal-title"><h5 id="aps-modal-title">Confirm action</h5><p id="aps-modal-text"/><div class="d-flex gap-2 justify-content-end"><button type="button" class="btn btn-light" id="aps-modal-cancel">Cancel</button><button type="button" class="btn btn-primary" id="aps-modal-ok">Continue</button></div></div></div>
   </div>
  </t>
 </template>
</odoo>
