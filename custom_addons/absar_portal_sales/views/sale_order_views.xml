<odoo>
 <record id="sale_order_portal_review_view" model="ir.ui.view">
  <field name="name">sale.order.absar.portal.review</field>
  <field name="model">sale.order</field>
  <field name="inherit_id" ref="sale.view_order_form"/>
  <field name="arch" type="xml">
   <xpath expr="//sheet/notebook" position="inside">
    <page string="Portal Sales Review" groups="sales_team.group_sale_manager">
     <group><group><field name="absar_portal_creator_id" readonly="1"/><field name="absar_portal_review_state" readonly="1"/></group>
     <group><field name="absar_portal_approver_id" readonly="1"/><field name="absar_portal_review_note" readonly="1"/></group></group>
    </page>
   </xpath>
  </field>
 </record>
</odoo>
