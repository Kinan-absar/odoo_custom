<odoo>
 <template id="portal_sales_nav" inherit_id="employee_portal_suite.employee_portal_layout" name="Portal Sales Navigation">
  <xpath expr="//a[@href='/my/employee/material' and contains(@class,'ep-sidebar-link')]" position="after">
   <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_creator') or request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor')"><a href="/my/employee/sales" class="ep-sidebar-link"><i class="fa fa-file-text"/>Sales &amp; Proposals</a></t>
  </xpath>
  <xpath expr="//a[@href='/my/employee/material' and contains(@class,'ep-sub-link')]" position="after">
   <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_creator') or request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor')"><a href="/my/employee/sales" class="ep-sub-link">Sales &amp; Proposals</a></t>
  </xpath>
 </template>
</odoo>
