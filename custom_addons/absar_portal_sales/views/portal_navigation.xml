<odoo>
 <template id="portal_sales_nav" inherit_id="employee_portal_suite.employee_portal_layout" name="Portal Sales Navigation">
  <!-- Dedicated Sales section immediately after Approvals in desktop sidebar. -->
  <xpath expr="//div[@id='ep-section-approvals']" position="after">
   <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_creator') or request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor') or request.env.user.has_group('absar_portal_sales.group_portal_sales_approver')">
    <div class="ep-sidebar-section" id="ep-section-sales">
     <div class="ep-sidebar-section-title">Sales</div>
     <div class="ep-sidebar-section-links">
      <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_creator')"><a href="/my/employee/sales" class="ep-sidebar-link"><i class="fa fa-file-text-o"/><t t-out="'Sales Workspace' if request.env.user.has_group('absar_portal_sales.group_portal_sales_user') else 'My Quotations'"/></a></t>
      <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor')"><a href="/my/employee/sales/monitor" class="ep-sidebar-link"><i class="fa fa-eye"/>Sales Monitoring</a></t>
      <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_approver')"><a href="/my/employee/sales/approvals" class="ep-sidebar-link"><i class="fa fa-check-square-o"/>Quotation Approvals</a></t>
     </div>
    </div>
   </t>
  </xpath>
  <!-- Matching dropdown in the portal's top navigation. -->
  <xpath expr="//div[@class='ep-dropdown-menu' and @id='app-d']/parent::div" position="after">
   <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_creator') or request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor') or request.env.user.has_group('absar_portal_sales.group_portal_sales_approver')">
    <div class="ep-dropdown">
     <button class="ep-dropdown-toggle" onclick="toggleDropdown(event, 'aps-sales-d')">Sales &#9662;</button>
     <div id="aps-sales-d" class="ep-dropdown-menu">
      <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_creator')"><a href="/my/employee/sales" class="ep-sub-link"><t t-out="'Sales Workspace' if request.env.user.has_group('absar_portal_sales.group_portal_sales_user') else 'My Quotations'"/></a></t>
      <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_monitor')"><a href="/my/employee/sales/monitor" class="ep-sub-link">Sales Monitoring</a></t>
      <t t-if="request.env.user.has_group('absar_portal_sales.group_portal_sales_approver')"><a href="/my/employee/sales/approvals" class="ep-sub-link">Quotation Approvals</a></t>
     </div>
    </div>
   </t>
  </xpath>
 </template>
</odoo>
