<odoo>
  <record id="sale_order_customer_checkbox_domain" model="ir.ui.view">
    <field name="name">sale.order.form.customer.checkbox.domain</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="attributes">
        <attribute name="domain">[('absar_is_sales_customer', '=', True)]</attribute>
      </xpath>
    </field>
  </record>
</odoo>
