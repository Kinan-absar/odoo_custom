<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="chat_home" name="Absar Chat">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#0b1220"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <meta name="apple-mobile-web-app-title" content="Absar Chat"/>
                <title>Absar Chat</title>
                <link rel="manifest" href="/chat/manifest.webmanifest"/>
                <link rel="apple-touch-icon" href="/absar_chat_pwa/static/icons/icon-192.png"/>
                <link rel="icon" href="/absar_chat_pwa/static/icons/icon-192.png"/>
                <link rel="stylesheet" href="/absar_chat_pwa/static/src/css/absar_chat_home.css?v=18.0.2.1.0"/>
                <script src="/absar_chat_pwa/static/src/js/absar_chat_home.js?v=18.0.2.1.0" defer="defer"></script>
                <script>
                    if ('serviceWorker' in navigator) {
                        window.addEventListener('load', function () {
                            navigator.serviceWorker.register('/chat/service-worker.js', {scope: '/chat/'}).catch(function () {});
                        });
                    }
                </script>
            </head>
            <body class="ac-body">
                <div class="ac-app">
                    <header class="ac-topbar">
                        <div class="ac-brand">
                            <div class="ac-logo"><img src="/absar_chat_pwa/static/icons/icon-192.png" alt="Absar Chat"/></div>
                            <div><strong>Absar Chat</strong><span>Internal Communication</span></div>
                        </div>
                        <div class="ac-top-actions">
                            <a href="/my/employee" class="ac-icon-btn" title="Employee Portal" aria-label="Employee Portal">⌂</a>
                            <button type="button" class="ac-icon-btn" id="ac-new-chat-btn" title="New conversation" aria-label="New conversation">＋</button>
                        </div>
                    </header>

                    <main class="ac-main">
                        <aside class="ac-sidebar">
                            <div class="ac-profile">
                                <div class="ac-avatar ac-avatar-lg">
                                    <img t-if="current_avatar" t-att-src="current_avatar" alt=""/>
                                    <span t-if="not current_avatar">👤</span>
                                </div>
                                <div class="ac-profile-copy">
                                    <strong t-esc="current_user.name"/>
                                    <span>Employee</span>
                                </div>
                                <span class="ac-presence-dot online"></span>
                            </div>

                            <div class="ac-search-wrap">
                                <input id="ac-thread-search" class="ac-search" type="search" placeholder="Search conversations" autocomplete="off"/>
                            </div>

                            <div class="ac-section-title"><span>Chats</span><button type="button" id="ac-new-chat-link">New</button></div>
                            <div id="ac-thread-list" class="ac-thread-list">
                                <t t-if="channels">
                                    <t t-foreach="channels" t-as="ch">
                                        <a class="ac-thread" t-att-data-name="ch['name'].lower()" t-att-href="'/chat/channel/%s' % ch['id']">
                                            <div class="ac-avatar">
                                                <img t-if="ch['avatar']" t-att-src="ch['avatar']" alt=""/>
                                                <span t-if="not ch['avatar']" t-esc="'👥' if ch['is_group'] else '👤'"/>
                                            </div>
                                            <div class="ac-thread-copy">
                                                <div class="ac-thread-title-row">
                                                    <strong t-esc="ch['name']"/>
                                                    <span t-if="ch['unread']" class="ac-unread" t-esc="ch['unread']"/>
                                                </div>
                                                <small t-if="ch['is_group']">Group conversation</small>
                                                <small t-if="not ch['is_group']"><span t-att-class="'ac-status %s' % ch['presence']"></span><t t-esc="ch['presence_label'] or 'Offline'"/></small>
                                            </div>
                                            <span class="ac-chevron">›</span>
                                        </a>
                                    </t>
                                </t>
                                <div t-if="not channels" class="ac-empty-list">
                                    <div>💬</div><strong>No conversations yet</strong><span>Start a chat with an employee.</span>
                                </div>
                            </div>
                        </aside>

                        <section class="ac-welcome">
                            <div class="ac-welcome-card">
                                <div class="ac-welcome-logo"><img src="/absar_chat_pwa/static/icons/icon-192.png" alt="Absar Chat"/></div>
                                <h1>Absar Chat</h1>
                                <p>Select a conversation from the left. Conversations open in <strong>native Odoo Discuss</strong>, so attachments, replies, reactions, calls, screen sharing and the existing RTC features stay available.</p>
                                <button type="button" class="ac-primary" id="ac-start-first">Start conversation</button>
                            </div>
                        </section>
                    </main>
                </div>

                <div id="ac-new-modal" class="ac-modal" aria-hidden="true">
                    <div class="ac-modal-backdrop" data-close-modal="1"></div>
                    <div class="ac-modal-card" role="dialog" aria-modal="true" aria-labelledby="ac-modal-title">
                        <div class="ac-modal-head">
                            <div><small>NEW CONVERSATION</small><h2 id="ac-modal-title">Employees</h2></div>
                            <button type="button" class="ac-close" data-close-modal="1">×</button>
                        </div>
                        <form action="/chat/start" method="post" class="ac-new-form">
                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                            <input id="ac-people-search" class="ac-search ac-people-search" type="search" placeholder="Search employees" autocomplete="off"/>
                            <div id="ac-people-list" class="ac-people-list">
                                <t t-foreach="employees" t-as="emp">
                                    <label class="ac-person" t-att-data-name="emp['name'].lower()">
                                        <input type="checkbox" name="participant_ids" t-att-value="emp['id']"/>
                                        <span class="ac-avatar">
                                            <img t-if="emp['avatar']" t-att-src="emp['avatar']" alt=""/>
                                            <span t-if="not emp['avatar']">👤</span>
                                        </span>
                                        <span class="ac-person-copy"><strong t-esc="emp['name']"/><small><span t-att-class="'ac-status %s' % emp['presence']"></span><t t-esc="emp['presence_label']"/></small></span>
                                        <span class="ac-check">✓</span>
                                    </label>
                                </t>
                            </div>
                            <div class="ac-group-name">
                                <label>Group name <span>(optional when selecting multiple employees)</span></label>
                                <input type="text" name="group_name" placeholder="e.g. Finance Team"/>
                            </div>
                            <button type="submit" class="ac-primary ac-full">Open conversation</button>
                        </form>
                    </div>
                </div>

                <div id="ac-call-alert" class="ac-call-alert" hidden="hidden">
                    <div class="ac-call-avatar"><img id="ac-call-avatar" alt=""/></div>
                    <div class="ac-call-copy"><strong id="ac-call-name">Incoming call</strong><span id="ac-call-type">Incoming audio call</span></div>
                    <button id="ac-call-decline" class="ac-call-decline" type="button">Decline</button>
                    <button id="ac-call-answer" class="ac-call-answer" type="button">Answer</button>
                </div>
            </body>
        </html>
    </template>

    <template id="access_denied_page" name="Absar Chat - Access Restricted">
        &lt;!DOCTYPE html&gt;
        <html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Absar Chat</title>
        <style>html,body{margin:0;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0b1220;color:#fff}.d{min-height:100vh;display:grid;place-items:center;padding:24px}.c{max-width:460px;text-align:center;background:#111b2e;border:1px solid #22314b;border-radius:20px;padding:36px}.c p{color:#9fb0c8}.c a{display:inline-block;background:#2f6fed;color:#fff;text-decoration:none;padding:11px 18px;border-radius:10px}</style></head>
        <body><div class="d"><div class="c"><h1 t-esc="title"/><p t-esc="message"/><a href="/my/employee">Employee Portal</a></div></div></body></html>
    </template>

    <!-- Make /chat/channel/<id> use the exact Employee Portal native Discuss patches. -->
    <template id="absar_chat_native_discuss_bootstrap" inherit_id="mail.discuss_public_channel_template" name="Absar Chat Native Discuss Bootstrap">
        <xpath expr="//head" position="inside">
            <meta t-if="request.httprequest.path.startswith('/chat/channel/')" name="employee-portal-discuss" content="1"/>
            <meta t-if="request.httprequest.path.startswith('/chat/channel/')" name="employee-portal-back-url" content="/chat/"/>
            <meta t-if="request.httprequest.path.startswith('/chat/channel/')" name="employee-portal-home-url" content="/my/employee"/>
            <meta t-if="request.httprequest.path.startswith('/chat/channel/')" name="theme-color" content="#0b1220"/>
            <link t-if="request.httprequest.path.startswith('/chat/channel/')" rel="manifest" href="/chat/manifest.webmanifest"/>
            <link t-if="request.httprequest.path.startswith('/chat/channel/')" rel="apple-touch-icon" href="/absar_chat_pwa/static/icons/icon-192.png"/>
            <script t-if="request.httprequest.path.startswith('/chat/channel/')" type="text/javascript">
                if ('serviceWorker' in navigator) {
                    navigator.serviceWorker.register('/chat/service-worker.js', {scope: '/chat/'}).catch(function () {});
                }
            </script>
        </xpath>
    </template>
</odoo>
