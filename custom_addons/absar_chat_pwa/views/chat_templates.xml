<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="chat_page" name="Absar Chat Application">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"/>
                <meta name="theme-color" content="#090d16"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <meta name="apple-mobile-web-app-title" content="Absar Chat"/>
                <title>Absar Chat</title>
                <link rel="manifest" href="/chat/manifest.webmanifest"/>
                <link rel="icon" type="image/png" href="/absar_chat_pwa/static/icons/icon-192.png"/>
                <link rel="apple-touch-icon" href="/absar_chat_pwa/static/icons/icon-192.png"/>
                <link rel="stylesheet" href="/absar_chat_pwa/static/src/css/absar_chat.css?v=18.0.1.0.1"/>
                <script src="/absar_chat_pwa/static/src/js/absar_chat_app.js?v=18.0.1.0.1" defer="defer"></script>
                <script type="text/javascript">
                    if ('serviceWorker' in navigator) {
                        window.addEventListener('load', function () {
                            navigator.serviceWorker.register('/chat/service-worker.js', {scope: '/chat/'})
                                .catch(function (err) { console.warn('Absar Chat SW registration failed:', err); });
                        });
                    }
                </script>
            </head>
            <body class="absar-chat-body">
                <div id="absar_chat_root">
                    <div class="absar-chat-splash">
                        <div class="splash-spinner"></div>
                        <div class="splash-text">Connecting to Absar Chat...</div>
                    </div>
                </div>
            </body>
        </html>
    </template>

    <template id="access_denied_page" name="Absar Chat - Access Restricted">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Access Restricted - Absar Chat</title>
                <style>
                    html,body{margin:0;min-height:100%;background:#090d16;color:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}.absar-denied{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box}.absar-denied-card{background:#131b2e;border:1px solid #1e293b;border-radius:16px;padding:36px 32px;max-width:440px;text-align:center;box-shadow:0 20px 25px -5px rgba(0,0,0,.5)}.absar-denied-icon{width:56px;height:56px;margin:0 auto 20px;background:rgba(239,68,68,.15);color:#ef4444;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px}.absar-denied-card h1{font-size:20px;margin:0 0 10px;color:#fff}.absar-denied-card p{font-size:14px;color:#94a3b8;line-height:1.6;margin:0 0 24px}.absar-denied-btn{display:inline-block;background:#3b82f6;color:#fff;padding:10px 20px;border-radius:8px;text-decoration:none;font-size:14px;font-weight:500}
                </style>
            </head>
            <body>
                <div class="absar-denied">
                    <div class="absar-denied-card">
                        <div class="absar-denied-icon">&#215;</div>
                        <h1 t-esc="title"/>
                        <p t-esc="message"/>
                        <a href="/web/session/logout?redirect=/web/login" class="absar-denied-btn">Log in with Employee Account</a>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
