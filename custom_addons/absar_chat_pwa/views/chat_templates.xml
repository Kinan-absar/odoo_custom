<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="chat_home" name="Chats">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#ffffff"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
                <meta name="apple-mobile-web-app-title" content="Chats"/>
                <title>Chats</title>
                <link rel="manifest" href="/chat/manifest.webmanifest"/>
                <link rel="icon" t-att-href="'/web/image/res.company/%s/logo' % request.env.company.id"/>
                <link rel="apple-touch-icon" t-att-href="'/web/image/res.company/%s/logo/192x192' % request.env.company.id"/>
                <link rel="stylesheet" href="/web/static/lib/fontawesome/css/font-awesome.css"/>
                <link rel="stylesheet" href="/absar_chat_pwa/static/src/css/absar_chat.css?v=18.0.3.9.0"/>
                <script src="/mail/static/lib/lame/lame.js"></script>
                <script src="/absar_chat_pwa/static/src/js/absar_chat.js?v=18.0.3.9.0" defer="defer"></script>
            </head>
            <body class="ac-body" data-epc-logged-in="1"
                  t-att-data-current-user-id="current_user.id"
                  t-att-data-current-user-name="current_employee.name or current_user.name"
                  t-att-data-current-avatar="current_avatar"
                  t-att-data-company-logo="'/web/image/res.company/%s/logo' % request.env.company.id">
                <div id="epc-mount-marker" class="ac-call-mount-marker"></div>
                <div id="ac-app" class="ac-app">
                    <aside class="ac-rail" aria-label="Main navigation">
                        <a href="/chat/" class="ac-brand" title="Chats">
                            <img t-att-src="'/web/image/res.company/%s/logo' % request.env.company.id" alt="Company logo"/>
                        </a>
                        <nav class="ac-rail-nav">
                            <button class="ac-rail-btn is-active" data-view="chats" title="Chats"><i class="fa fa-comments"></i><span>Chats</span><b id="ac-chat-badge" class="ac-badge is-hidden">0</b></button>
                            <button class="ac-rail-btn" data-view="calls" title="Calls"><i class="fa fa-phone"></i><span>Calls</span><b id="ac-call-badge" class="ac-badge is-hidden">0</b></button>
                            <button class="ac-rail-btn" data-view="people" title="People"><i class="fa fa-users"></i><span>People</span></button>
                            <button class="ac-rail-btn" data-view="settings" title="Settings"><i class="fa fa-cog"></i><span>Settings</span></button>
                        </nav>
                    </aside>

                    <section id="ac-sidebar" class="ac-sidebar">
                        <header class="ac-sidebar-head">
                            <div class="ac-title-row"><div><h1>Chats</h1><p>Work together, instantly.</p></div><button id="ac-new-chat" class="ac-icon-btn" title="New chat"><i class="fa fa-pencil-square-o"></i></button></div>
                            <label class="ac-search"><i class="fa fa-search"></i><input id="ac-thread-search" type="search" placeholder="Search conversations" autocomplete="off"/></label>
                        </header>
                        <div id="ac-thread-list" class="ac-thread-list"><div class="ac-loading">Loading conversations…</div></div>
                        <footer class="ac-user-card">
                            <img t-att-src="current_avatar" alt=""/>
                            <div><strong><t t-esc="current_employee.name or current_user.name"/></strong><span><t t-esc="current_employee.job_title or 'Employee'"/></span></div>
                            <span class="ac-presence-dot online" title="Online"></span>
                        </footer>
                    </section>

                    <main id="ac-main" class="ac-main">
                        <section id="ac-empty" class="ac-empty-state">
                            <img t-att-src="'/web/image/res.company/%s/logo' % request.env.company.id" alt="Company logo"/>
                            <h2>Chats</h2>
                            <p>Select a conversation or start a new one.</p>
                            <button id="ac-empty-new" class="ac-primary-btn"><i class="fa fa-plus"></i> New conversation</button>
                        </section>

                        <section id="ac-conversation" class="ac-conversation is-hidden">
                            <header class="ac-conversation-head">
                                <button id="ac-mobile-back" class="ac-icon-btn ac-mobile-only"><i class="fa fa-arrow-left"></i></button>
                                <img id="ac-chat-avatar" class="ac-avatar" t-att-src="'/web/image/res.company/%s/logo' % request.env.company.id" alt=""/>
                                <div class="ac-conversation-title"><strong id="ac-chat-title">Conversation</strong><span id="ac-chat-subtitle">Employee</span></div>
                                <div class="ac-conversation-actions">
                                    <button id="ac-audio-call" class="ac-header-action" title="Audio call" aria-label="Audio call">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.49a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.02l-2.19 2.19Z"/></svg>
                                        <span>Call</span>
                                    </button>
                                    <button id="ac-video-call" class="ac-header-action" title="Video call" aria-label="Video call">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 8v8H5V8h10m1-2H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 3.5V7l-4 3.5V7a1 1 0 0 0-1-1Z"/></svg>
                                        <span>Video</span>
                                    </button>
                                    <button id="ac-search-messages" class="ac-round-action" title="Search messages" aria-label="Search messages">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m20.4 19-4.7-4.7a7 7 0 1 0-1.4 1.4l4.7 4.7 1.4-1.4ZM5 10.5a5.5 5.5 0 1 1 11 0 5.5 5.5 0 0 1-11 0Z"/></svg>
                                    </button>
                                    <button id="ac-chat-info" class="ac-round-action" title="Conversation info" aria-label="Conversation info">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 10h2v7h-2v-7Zm0-3h2v2h-2V7Zm1-5a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z"/></svg>
                                    </button>
                                </div>
                            </header>
                            <div id="ac-message-search-bar" class="ac-message-search-bar is-hidden"><i class="fa fa-search"></i><input id="ac-message-search-input" type="search" placeholder="Search in conversation"/><button id="ac-message-search-close" class="ac-icon-btn"><i class="fa fa-times"></i></button></div>
                            <div id="ac-messages" class="ac-messages"><div class="ac-loading">Loading messages…</div></div>
                            <div id="ac-drop-overlay" class="ac-drop-overlay is-hidden"><div class="ac-drop-card"><span class="ac-drop-icon">＋</span><strong>Drop files to attach</strong><span>Images, PDFs, documents, audio and other files</span></div></div>
                            <div id="ac-typing" class="ac-typing is-hidden"></div>
                            <div id="ac-reply-bar" class="ac-reply-bar is-hidden"><div><strong id="ac-reply-author"></strong><span id="ac-reply-text"></span></div><button id="ac-reply-cancel" class="ac-icon-btn"><i class="fa fa-times"></i></button></div>
                            <div id="ac-attachment-strip" class="ac-attachment-strip is-hidden"></div>
                            <form id="ac-composer" class="ac-composer">
                                <input id="ac-file-input" type="file" multiple="multiple" hidden="hidden"/>
                                <button id="ac-attach" class="ac-compose-btn" type="button" title="Attach file" aria-label="Attach file">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 6.5 9 14a2.12 2.12 0 0 0 3 3l7.5-7.5a4.24 4.24 0 0 0-6-6L5.3 11.7a6.36 6.36 0 0 0 9 9l6.2-6.2-1.4-1.4-6.2 6.2a4.36 4.36 0 0 1-6.2-6.2l8.2-8.2a2.24 2.24 0 0 1 3.2 3.2l-7.5 7.5a.12.12 0 0 1-.2-.2l7.5-7.5-1.4-1.4Z"/></svg>
                                </button>
                                <button id="ac-emoji" class="ac-compose-btn" type="button" title="Emoji" aria-label="Emoji">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm-3.5-9.5A1.5 1.5 0 1 0 8.5 7a1.5 1.5 0 0 0 0 3.5Zm7 0A1.5 1.5 0 1 0 15.5 7a1.5 1.5 0 0 0 0 3.5ZM8 13h8a4 4 0 0 1-8 0Z"/></svg>
                                </button>
                                <div class="ac-input-shell"><textarea id="ac-message-input" rows="1" maxlength="6000" placeholder="Type a message"></textarea></div>
                                <button id="ac-voice" class="ac-compose-btn" type="button" title="Voice note" aria-label="Voice note">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21H8v2h8v-2h-3v-3.08A7 7 0 0 0 19 11h-2Z"/></svg>
                                </button>
                                <button id="ac-send" class="ac-send-btn" type="submit" title="Send" aria-label="Send">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20.5 21 12 3 3.5v6.6l12 1.9-12 1.9v6.6Z"/></svg>
                                </button>
                            </form>
                            <div id="ac-emoji-panel" class="ac-emoji-panel is-hidden"></div>
                        </section>

                        <section id="ac-calls-view" class="ac-page-view is-hidden"><div class="ac-page-head"><div><h2>Calls</h2><p>Recent voice and video calls</p></div></div><div id="ac-call-history" class="ac-card-list"><div class="ac-loading">Loading calls…</div></div></section>
                        <section id="ac-people-view" class="ac-page-view is-hidden"><div class="ac-page-head"><div><h2>People</h2><p>Company employee directory</p></div><label class="ac-search ac-page-search"><i class="fa fa-search"></i><input id="ac-people-search" type="search" placeholder="Search employees"/></label></div><div id="ac-people-list" class="ac-people-grid"><div class="ac-loading">Loading employees…</div></div></section>
                        <section id="ac-settings-view" class="ac-page-view is-hidden"><div class="ac-page-head"><div><h2>Settings</h2><p>Chats preferences</p></div></div><div class="ac-settings-card"><div class="ac-setting-row"><div><strong>Install Chats</strong><span>Add this app to your desktop or home screen.</span></div><button id="ac-install" class="ac-secondary-btn">Install app</button></div><div class="ac-setting-row"><div><strong>Desktop notifications</strong><span>Allow message and call alerts while the app is open.</span></div><button id="ac-notifications" class="ac-secondary-btn">Enable</button></div></div></section>
                    </main>

                    <aside id="ac-info-panel" class="ac-info-panel is-hidden">
                        <div class="ac-info-head"><strong>Conversation info</strong><button id="ac-info-close" class="ac-icon-btn"><i class="fa fa-times"></i></button></div>
                        <div id="ac-info-content"></div>
                    </aside>
                </div>

                <div id="ac-modal-backdrop" class="ac-modal-backdrop is-hidden"></div>
                <section id="ac-new-modal" class="ac-modal is-hidden" role="dialog" aria-modal="true">
                    <header><div><h3>New conversation</h3><p>Select one employee for a direct chat or several for a group.</p></div><button id="ac-new-close" class="ac-icon-btn"><i class="fa fa-times"></i></button></header>
                    <label class="ac-search"><i class="fa fa-search"></i><input id="ac-new-search" type="search" placeholder="Search employees"/></label>
                    <input id="ac-group-name" class="ac-group-name is-hidden" type="text" maxlength="120" placeholder="Group name (optional)"/>
                    <div id="ac-new-people" class="ac-modal-list"></div>
                    <footer><span id="ac-new-count">0 selected</span><button id="ac-new-start" class="ac-primary-btn" disabled="disabled">Start conversation</button></footer>
                </section>

                <script>
                    if ('serviceWorker' in navigator) {
                        window.addEventListener('load', function () {
                            navigator.serviceWorker.register('/chat/service-worker.js', {scope: '/chat/'}).catch(function () {});
                        });
                    }
                </script>
            </body>
        </html>
    </template>

    <template id="access_denied_page" name="Chats Access Denied">
        &lt;!DOCTYPE html&gt;
        <html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Chats</title></head>
        <body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f6f8fb;margin:0;display:grid;place-items:center;min-height:100vh;color:#172033"><div style="text-align:center;padding:36px;background:white;border:1px solid #e8edf2;border-radius:24px;max-width:420px"><h1 style="margin:0 0 10px"><t t-esc="title"/></h1><p style="color:#6b7280"><t t-esc="message"/></p></div></body></html>
    </template>
</odoo>
