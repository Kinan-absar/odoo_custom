<t t-name="l10n_gcc_invoice.arabic_english_invoice_copy_1_copy_1_copy_3">
<t t-call="web.external_layout"><t t-call="absar.report_styles"/><div class="absar-report">

        <!-- ========================= -->
        <!--  TITLE                    -->
        <!-- ========================= -->
        <div class="text-center mt-3 mb-3">
            <h2 style="color:#714B67; font-weight:400; letter-spacing:0.3px;">
                Subcontractor Payment Certificate / شهادة مستخلص مقاول
            </h2>
        </div>

        <!-- Context -->
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-set="o_sec" t-value="o.with_context(lang=o.env['res.lang']._get_code('ar_001'))"/>
        <t t-set="o" t-value="o.with_context(lang='en_US')"/>

        <!-- ========================= -->
        <!--  HEADER ROW               -->
        <!-- ========================= -->
        <div class="row align-items-start" style="margin-top:10px;">

            <!-- LEFT: SUBCONTRACTOR -->
            <div class="col-6">
                <div style="padding:8px 0;">
                    <div style="color:#714B67; font-weight:800; font-size:16px; margin-bottom:6px;">
                        Subcontractor / المقاول
                    </div>
                    <div style="font-size:13px; line-height:1.6;">
                        <div style="font-weight:700;">
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </div>
                        <div t-if="o.partner_id.city">
                            <span t-field="o.partner_id.city"/>
                        </div>
                        <div t-if="o.partner_id.country_id">
                            <span t-field="o.partner_id.country_id.name"/>
                        </div>
                        <div t-if="o.partner_id.vat">
                            <strong>VAT:</strong>
                            <span t-field="o.partner_id.vat"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: QR -->
            <div class="col-6 text-end">
                <div t-if="o.l10n_sa_qr_code_str">
                    <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=' + quote_plus(o.l10n_sa_qr_code_str) + '&amp;width=140&amp;height=140'" style="border:1px solid #ccc; padding:4px;"/>
                </div>
            </div>
        </div>
                    <div class="page mb-5">

    <style>
        table.inv-info, table.inv-info * {
          border: none !important;
          background: transparent !important;
          box-shadow: none !important;
        }
        .inv-info {
          width: 100%;
          border-collapse: collapse !important;
        }
        .inv-info tr, .inv-info td {
          padding: 3px 0 !important;
          vertical-align: middle;
        }
        .inv-info .label-left {
          text-align: left !important;
          font-weight: 600;
          color: #000;
          width: 30%;
        }
        .inv-info .value {
          text-align: center;
          border-bottom: 1px solid #444 !important;
          width: 40%;
        }
        .inv-info .label-right {
          text-align: right !important;
          direction: rtl !important;
          font-weight: 600;
          color: #000;
          width: 30%;
        }
      </style>
        <!-- ========================= -->
        <!--  CERTIFICATE INFO         -->
        <!-- ========================= -->
        <div class="row mt-4" style="font-size:12px; line-height:1.6;">
            <table class="inv-info">
                <tr>
                    <td class="label-left">Certificate No</td>
                    <td class="value"><span t-field="o.name"/></td>
                    <td class="label-right">رقم المستخلص</td>
                </tr>
                <tr>
                    <td class="label-left">Certificate Date</td>
                    <td class="value"><span t-field="o.invoice_date"/></td>
                    <td class="label-right">تاريخ المستخلص</td>
                </tr>
                <tr t-if="o.invoice_origin">
                  <td class="label-left">Source</td>
                  <td class="value"><span t-field="o.invoice_origin"/></td>
                  <td class="label-right">المصدر</td>
                </tr>
                <tr t-if="o.ref">
                    <td class="label-left">Reference</td>
                    <td class="value"><span t-field="o.ref"/></td>
                    <td class="label-right">المرجع</td>
                </tr>
            </table>
        </div>
  <div style="margin-top: 25px;"/>
        <!-- ========================= -->
        <!--  LINES TABLE              -->
        <!-- ========================= -->
        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
<t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

<table class="table table-sm table-bordered" name="invoice_line_table" style="border-color:#ccc; font-size:13px; border-collapse:collapse; width:100%; page-break-inside:auto;">

  <!-- ===== TABLE HEADER ===== -->
  <thead style="background-color:#f8f8f8; border-bottom:2px solid #714B67;">
    <tr>
      <th class="text-start" style="width:30%;">
        <strong>Description</strong><br/><span>الوصف</span>
      </th>
      <th class="text-end" style="width:8%;">
        <strong>Quantity</strong><br/><span>الكمية</span>
      </th>
      <th class="text-end" style="width:12%;">
        <strong>Unit Price</strong><br/><span>سعر الوحدة</span>
      </th>
      <th class="text-end" style="width:13%;">
        <strong>Amount</strong><br/><span>المبلغ قبل الضريبة</span>
      </th>
      <th class="text-end" style="width:12%;">
        <strong>Taxes</strong><br/><span>الضرائب</span>
      </th>
      <th class="text-end" style="width:15%;">
        <strong>Total Price</strong><br/><span>المبلغ شامل الضريبة</span>
      </th>
    </tr>
  </thead>

            <tbody class="invoice_tbody">
    <!-- Track subtotals -->
    <t t-set="current_subtotal" t-value="0"/>
    <t t-set="current_section" t-value="None"/>
    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

    <t t-foreach="lines" t-as="line" t-foreach-index="line_index" t-foreach-last="line_last">

      <!-- Regular invoice lines -->
      <t t-if="line.display_type not in ('line_note', 'line_section')">
        <t t-set="current_subtotal" t-value="current_subtotal + (line.price_subtotal or 0.0)"/>
        <tr>
          <td class="text-start">
            <t t-set="line_name" t-value="line.with_context(lang=o.partner_id.lang).product_id.display_name               if line.product_id and line.name in (                 line.with_context(lang=line.env['res.lang']._get_code('ar_001')).product_id.display_name,                 line.with_context(lang='en_US').product_id.display_name               ) else line.name"/>
            <span t-out="line_name" t-options="{'widget': 'text'}"/>
          </td>
          <td class="text-end"><span t-field="line.quantity"/></td>
          <td class="text-end"><span t-field="line.price_unit"/></td>
          <td class="text-end"><span t-field="line.price_subtotal"/></td>
          <td class="text-end">
  <span t-out="line.price_total - line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
</td>

          <td class="text-end"><span t-field="line.price_total"/></td>
        </tr>
      </t>

      <!-- Section header -->
      <t t-if="line.display_type == 'line_section'">
        <tr style="background-color:#fff7e6; font-weight:700; color:#000;">
          <td colspan="99" style="border-top:2px solid #714B67;">
            <span t-field="line.name" t-options="{'widget': 'text'}"/>
          </td>
        </tr>
        <t t-set="current_section" t-value="line"/>
        <t t-set="current_subtotal" t-value="0.0"/>
      </t>

      <!-- Note lines -->
      <t t-if="line.display_type == 'line_note'">
        <tr>
          <td colspan="99" style="font-style:italic; color:#555;">
            <span t-field="line.name" t-options="{'widget': 'text'}"/>
          </td>
        </tr>
      </t>

      <!-- Subtotal (before VAT) -->
      <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
        <tr class="is-subtotal text-end" style="background-color:#fafafa;">
          <td colspan="99">
            <strong>Subtotal (Before VAT)</strong>
            <span t-out="current_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
          </td>
        </tr>
      </t>

    </t>
  </tbody>
        </table>

        <!-- ========================= -->
        <!--  TOTALS                   -->
        <!-- ========================= -->
        <div class="row justify-content-end mt-3">
            <div class="col-6">
                <table class="table table-sm table-borderless text-end">
                    <tr>
                        <td><strong>Subtotal / الإجمالي الفرعي</strong></td>
                        <td><span t-field="o.amount_untaxed"/></td>
                    </tr>

                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                    <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                        <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                            <tr>
                                <td>
                                    <strong t-esc="tax_group['group_name']"/>
                                </td>
                                <td>
                                    <span t-out="tax_group['tax_amount_currency']" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>

                    <tr class="total-row">
                        <td><strong>Total / المجموع</strong></td>
                        <td><span t-field="o.amount_total"/></td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- ========================= -->
        <!--  NOTES                    -->
        <!-- ========================= -->
        <t t-if="o.narration">
            <div class="row mt-3">
                <div class="col-6">
                    <strong>Notes / ملاحظات</strong><br/>
                    <span t-out="o.narration"/>
                </div>
            </div>
        </t>
</div>
    </div></t></t>