<t t-name="wm_journal_entry_report.report_journal_document">
    <t t-call="absar.journal_layout">
      <t t-call="absar.report_styles"/>
      <style>
        .jv-info td { vertical-align:top; padding:5px 5px; }
        .jv-info .jv-value { border-bottom:1px solid #444; text-align:center; }
        .jv-print-footer { position:fixed; bottom:0; left:0; right:0; width:100%; font-family:'Lato','Cairo',sans-serif; font-size:10px; color:#000; border-top:1px solid #bbb; padding-top:6px; }
        .jv-print-footer td { width:33.333%; vertical-align:middle; }
        .absar-report.absar-jv-page h4 {border:0!important;padding:0!important;margin:0!important;font-weight:800!important;}
        .absar-report.absar-jv-page table.jv-info {border:0!important;background:#fff!important;font-size:12px!important;}
        .absar-report.absar-jv-page table.jv-info tr {border:0!important;background:#fff!important;}
        .absar-report.absar-jv-page table.jv-info tr:nth-child(n) td {border:0!important;background:#fff!important;padding:5px!important;font-size:12px!important;vertical-align:top!important;}
        .absar-report.absar-jv-page table.jv-info tr:nth-child(n) td.jv-value {border-bottom:1px solid #444!important;text-align:center!important;}
      </style>
      <div class="page absar-report absar-jv-page" style="font-family:'Lato','Cairo',sans-serif; font-size:11px; line-height:1.5; color:#000; padding-bottom:0;">
        <!-- HEADER: original style retained -->
        <div style="text-align:center; margin-top:10px;">
          <h4 style="color:#b28a00; font-weight:800; margin:0; border:0!important; padding:0!important;">
            Journal Voucher / قيد يومية<br/>
            <span t-if="o.name != '/'" style="color:#000; margin-left:6px;" t-field="o.name"/>
          </h4>
        </div>
        <!-- TWO-COLUMN INFO SECTION -->
        <div style="width:95%; margin:25px auto; font-size:12px;">
          <table class="jv-info" style="width:100%; border-collapse:collapse; table-layout:fixed;">
            <tr>
              <td style="width:17%; font-weight:600;">Accounting Date</td>
              <td class="jv-value" style="width:30%;"><span t-field="o.date"/></td>
              <td style="width:6%;"/>
              <td style="width:17%; font-weight:600;">Journal Type</td>
              <td class="jv-value" style="width:30%;"><span t-field="o.journal_id.name"/></td>
            </tr>
            <tr>
              <td style="font-weight:600;">Reference</td>
              <td class="jv-value"><span t-if="o.ref" t-field="o.ref"/></td>
              <td/>
              <td style="font-weight:600;">Company</td>
              <td class="jv-value"><span t-field="o.company_id.name"/></td>
            </tr>
          </table>
        </div>
        <!-- MAIN TABLE: original columns and calculations retained -->
        <table style="width:100%; border-collapse:collapse; font-size:11px;">
          <thead>
            <tr style="font-weight:600; color:#1c1f75; border-bottom:1px solid #999;">
              <th style="text-align:left; padding:6px 4px;">Account</th>
              <th style="text-align:left; padding:6px 4px;">Label</th>
              <th style="text-align:left; padding:6px 4px;">Taxes</th>
              <th style="text-align:right; padding:6px 4px;">Debit</th>
              <th style="text-align:right; padding:6px 4px;">Credit</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="o.line_ids" t-as="line">
              <tr style="border-bottom:1px solid #e0e0e0;">
                <td style="padding:6px 4px;"><span t-field="line.account_id.code"/> - <span t-field="line.account_id.name"/></td>
                <td style="padding:6px 4px;"><span t-field="line.name"/></td>
                <td style="padding:6px 4px;"><span t-out="', '.join(map(lambda x: x.name, line.tax_ids))"/></td>
                <td style="padding:6px 4px; text-align:right;"><span t-field="line.debit"/></td>
                <td style="padding:6px 4px; text-align:right;"><span t-field="line.credit"/></td>
              </tr>
            </t>
            <tr class="total-row">
              <td colspan="3" style="text-align:right; padding:8px;">Total</td>
              <td style="text-align:right; padding:8px;"><span t-esc="sum(o.line_ids.mapped('debit'))" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/></td>
              <td style="text-align:right; padding:8px;"><span t-esc="sum(o.line_ids.mapped('credit'))" t-options="{'widget':'monetary','display_currency':o.company_id.currency_id}"/></td>
            </tr>
          </tbody>
        </table>
      </div>
    </t>
</t>