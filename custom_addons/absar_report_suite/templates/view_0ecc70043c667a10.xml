<data>
  <xpath expr="/t[@t-name='purchase.report_purchaseorder_document']" position="replace" mode="inner">
    <t t-call="web.external_layout">
        <t t-call="absar.report_styles"/>
      <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
      <t t-set="address">
        <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;, &quot;vat&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
      </t>
      <t t-if="o.dest_address_id">
        <t t-set="information_block">
          <strong>Shipping address:</strong>
          <div t-if="o.dest_address_id">
            <div t-field="o.dest_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" name="purchase_shipping_address"/>
          </div>
        </t>
      </t>
      <div class="page absar-report absar-purchase-page">
         <div class="oe_structure"/>
        <div class="margin-top:0;">
     <div class="row col-12 mb-2">
  <!-- Request for Quotation -->
  <div class="col-6" t-if="o.state in ['draft', 'sent', 'to approve']">
    <h4 class="text-warning" style="font-size:16px; margin:0;">
      Request for Quotation #<span t-field="o.name"/>
      <t t-if="o.revision &gt; 0"> (R-<t t-esc="o.revision"/>)</t>
    </h4>
  </div>

 <!-- Purchase Order -->
<div class="col-6" t-if="o.state in ['purchase', 'done']">
  <h4 class="text-warning" style="font-size:16px; margin:0;">
    Purchase Order #
    <span t-field="o.name"/>
    <t t-if="o.revision &gt; 0"> (R-<t t-esc="o.revision"/>)</t>
  </h4>
</div>

  <!-- Cancelled Purchase Order -->
  <div class="col-6" t-if="o.state == 'cancel'">
    <h4 class="text-warning" style="font-size:16px; margin:0;">
      Cancelled Purchase Order #<span t-field="o.name"/>
      <t t-if="o.revision &gt; 0"> (R-<t t-esc="o.revision"/>)</t>
    </h4>
  </div>

  <!-- Project (always on the right if exists) -->
<div class="col-6 text-end" t-if="o.project_id">
    <h4 class="text-warning" style="font-size:14px;  margin:0;">
      <strong>Project:</strong>
      <span t-field="o.project_id"/>
    </h4>
  </div>

</div>

        </div>
        <div id="informations" class="row ">
          <div t-if="o.partner_id" class="col-6 bm-2">
  <div style="font-size:11px; line-height:1.3;">
    <div><strong>Supplier:</strong></div>
    <div class="absar-partner-name" style="font-weight:700;white-space:normal;overflow-wrap:break-word;">
  <span t-field="o.partner_id.name"/>
</div>
    <div>
      <span t-field="o.partner_id.street"/>
      <t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t>
    </div>
    <div>
      <span t-field="o.partner_id.city"/>
      <t t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></t>
      <t t-if="o.partner_id.zip"> <span t-field="o.partner_id.zip"/></t>
    </div>
    <div t-if="o.partner_id.country_id">
      <span t-field="o.partner_id.country_id.name"/>
    </div>
    <t t-if="o.partner_id.phone">
      <div>📞 <span t-field="o.partner_id.phone"/></div>
    </t>
    <t t-if="o.partner_id.vat">
      <div><strong>VAT:</strong> <span t-field="o.partner_id.vat"/></div>
    </t>
  </div>
</div>
<!-- Vendor Reference + MR Reference (same column) -->
<div t-if="o.partner_ref or o.material_request_id" class="col-3 bm-2">
    <div style="font-size:11px; line-height:1.3;">
        <strong>Vendor Ref:</strong>
        <span t-field="o.partner_ref"/>

        <t t-if="o.material_request_id">
            <br/>
            <div style="margin-top:2px;">
                <strong>MR Ref:</strong>
                <span t-field="o.material_request_id.name"/>
            </div>
        </t>
    </div>
</div>

<!-- Order Date -->
<div t-if="o.state in ['purchase','done'] and o.date_approve" class="col-3 bm-2">
  <div style="font-size:11px; line-height:1.3;">
    <div><strong>Order Date:</strong></div>
    <div style="font-weight:600;">
      <span t-field="o.date_approve" t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
    </div>
  </div>
</div>

<!-- Order Deadline -->
<div t-elif="o.date_order" class="col-3 bm-2">
  <div style="font-size:11px; line-height:1.3;">
    <div><strong>Order Deadline:</strong></div>
    <div style="font-weight:600;">
      <span t-field="o.date_order" t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
    </div>
  </div>
</div>


        </div>
     <table class="table table-sm o_main_table mt-4 mb-4" t-attf-style="font-size:11px; line-height:1.3; border-collapse:collapse; width:100%; border:1px solid black;">
  <t t-set="display_discount" t-value="any(l.discount for l in o.order_line)"/><thead style="display: table-row-group">
    <tr>
      <th style="border:1px solid black; padding:3px; background-color:#d9edf7; font-weight:bold;">Description</th>
      <th style="border:1px solid black; padding:3px; text-align:right; background-color:#d9edf7; font-weight:bold;">Taxes</th>
      <th style="border:1px solid black; padding:3px; text-align:right; background-color:#d9edf7; font-weight:bold;">Qty</th>
      <th style="border:1px solid black; padding:3px; text-align:right; background-color:#d9edf7; font-weight:bold;">Unit Price</th>
      <th t-if="display_discount" class="text-end">Disc.%</th><th class="text-end">Amount</th>
    </tr>
  </thead>
  <tbody>
    <t t-set="display_discount" t-value="any(l.discount for l in o.order_line)"/><t t-set="current_section" t-value="None"/><t t-set="current_subtotal" t-value="0"/>
    <t t-foreach="o.order_line" t-as="line">
      <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
      <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
        <t t-if="not line.display_type">
          <td t-attf-style="border:1px solid black; padding:3px; vertical-align:middle;">
            <span t-field="line.name"/>
          </td>
          <td t-attf-style="border:1px solid black; padding:3px; vertical-align:middle; text-align:right; white-space:nowrap;">
            <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.taxes_id])"/>
            <span t-out="taxes"/>
          </td>
          <td t-attf-style="border:1px solid black; padding:3px; vertical-align:middle; text-align:right;">
            <span t-field="line.product_uom_qty"/>
            <span t-field="line.product_uom"/>
            <span t-if="line.product_packaging_id">
              (<span t-field="line.product_packaging_qty" t-options="{&quot;widget&quot;: &quot;integer&quot;}"/>
              <span t-field="line.product_packaging_id"/>)
            </span>
          </td>
          <td t-attf-style="border:1px solid black; padding:3px; vertical-align:middle; text-align:right;">
            <span t-field="line.price_unit" t-options="{&quot;widget&quot;:&quot;float&quot;,&quot;precision&quot;:2}"/>
          </td>
          <td t-if="display_discount" class="text-end"><span t-field="line.discount"/>%</td><td t-attf-style="border:1px solid black; padding:3px; vertical-align:middle; text-align:right;">
            <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;:&quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
          </td>
        </t>
        <t t-if="line.display_type == 'line_section'">
          <td colspan="99" id="section" t-attf-style="border:1px solid black; padding:3px; vertical-align:middle;">
            <span t-field="line.name"/>
          </td>
          <t t-set="current_section" t-value="line"/>
          <t t-set="current_subtotal" t-value="0"/>
        </t>
        <t t-if="line.display_type == 'line_note'">
          <td colspan="99" id="note" t-attf-style="border:1px solid black; padding:3px; vertical-align:middle;">
            <span t-field="line.name"/>
          </td>
        </t>
      </tr>
      <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
        <tr class="is-subtotal text-end">
          <td colspan="99" id="subtotal" t-attf-style="border:1px solid black; padding:3px; text-align:right;">
            <strong class="mr16">Subtotal</strong>
            <span t-esc="current_subtotal" t-options="{&quot;widget&quot;:&quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
          </td>
        </tr>
      </t>
    </t>
  </tbody>
</table>

<div id="total" style="width: 100%;">
  <div style="width: 40%; margin-left: auto; font-size:11px; line-height:1.3;">
    <table class="table table-sm table">
      <t t-set="tax_totals" t-value="o.tax_totals"/>
      <t t-call="purchase.document_tax_totals_copy_4"/>
    </table>
  </div>
</div>
        <p t-field="o.notes" class="mt-3"/>
        <div class="oe_structure">
          <div class="container o_text_columns absar-signatures">
            <div class="row">
              <div class="col-6">
                
                <h5 style="font-size:16px;">Projects Director</h5>
              </div>
              <div class="col-6 text-end">
                
                <h5 style="font-size:16px;">Chief Executive Officer</h5></div>
            </div><div style="text-align:center;page-break-inside:avoid;margin:8px 0 0;"><img t-att-src="image_data_uri(env.ref('absar_report_suite.stamp_image').sudo().datas)" alt="Company stamp" style="width:120px;display:inline-block;"/></div>
          </div>
        </div>
      </div>
    </t>
  </xpath>
</data>