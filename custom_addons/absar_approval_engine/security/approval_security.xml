<odoo>
    <record id="module_category_absar_approvals" model="ir.module.category">
        <field name="name">Absar Approvals</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">Approval User</field>
        <field name="category_id" ref="module_category_absar_approvals"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_auditor" model="res.groups">
        <field name="name">Approval Auditor</field>
        <field name="category_id" ref="module_category_absar_approvals"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Approval Manager</field>
        <field name="category_id" ref="module_category_absar_approvals"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_auditor'))]"/>
    </record>

    <record id="rule_approval_request_user" model="ir.rule">
        <field name="name">Approval requests: involved users</field>
        <field name="model_id" ref="model_absar_approval_request"/>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('line_ids.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_approval_request_manager" model="ir.rule">
        <field name="name">Approval requests: managers all</field>
        <field name="model_id" ref="model_absar_approval_request"/>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_approval_line_user" model="ir.rule">
        <field name="name">Approval lines: involved users</field>
        <field name="model_id" ref="model_absar_approval_request_line"/>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_approval_line_manager" model="ir.rule">
        <field name="name">Approval lines: managers all</field>
        <field name="model_id" ref="model_absar_approval_request_line"/>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_approval_audit_user" model="ir.rule">
        <field name="name">Approval audit: involved users</field>
        <field name="model_id" ref="model_absar_approval_audit"/>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
        <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('request_id.line_ids.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_approval_audit_auditor" model="ir.rule">
        <field name="name">Approval audit: auditors all</field>
        <field name="model_id" ref="model_absar_approval_audit"/>
        <field name="groups" eval="[(4, ref('group_approval_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_delegation_owner" model="ir.rule">
        <field name="name">Delegations: owner or delegate</field>
        <field name="model_id" ref="model_absar_approval_delegation"/>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
        <field name="domain_force">['|', ('delegator_id', '=', user.id), ('delegate_id', '=', user.id)]</field>
    </record>

    <record id="rule_delegation_manager" model="ir.rule">
        <field name="name">Delegations: managers all</field>
        <field name="model_id" ref="model_absar_approval_delegation"/>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_workflow_company" model="ir.rule">
        <field name="name">Approval workflows: company</field>
        <field name="model_id" ref="model_absar_approval_workflow"/>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
