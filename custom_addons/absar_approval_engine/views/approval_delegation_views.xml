<odoo>
    <record id="view_absar_approval_delegation_list" model="ir.ui.view">
        <field name="name">absar.approval.delegation.list</field>
        <field name="model">absar.approval.delegation</field>
        <field name="arch" type="xml">
            <list string="Approval Delegations">
                <field name="delegator_id" domain="[('active', '=', True), ('share', '=', False)]" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="delegate_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="workflow_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_absar_approval_delegation_form" model="ir.ui.view">
        <field name="name">absar.approval.delegation.form</field>
        <field name="model">absar.approval.delegation</field>
        <field name="arch" type="xml">
            <form string="Approval Delegation">
                <sheet>
                    <group>
                        <group>
                            <field name="delegator_id" domain="[('active', '=', True), ('share', '=', False)]" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="delegate_id" domain="[('id', '!=', delegator_id), ('active', '=', True), ('share', '=', False)]" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="workflow_ids" widget="many2many_tags"/>
                    <field name="reason" placeholder="Reason for delegation..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_absar_approval_delegations" model="ir.actions.act_window">
        <field name="name">Delegations</field>
        <field name="res_model">absar.approval.delegation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
