<odoo>
    <record id="view_absar_approval_request_search" model="ir.ui.view">
        <field name="name">absar.approval.request.search</field>
        <field name="model">absar.approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="name"/>
                <field name="reference"/>
                <field name="workflow_id"/>
                <field name="requester_id"/>
                <field name="stage_id"/>
                <filter name="my_approvals" string="My Approvals" domain="[('current_approver_ids', 'in', uid)]"/>
                <filter name="my_requests" string="My Requests" domain="[('requester_id', '=', uid)]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="group_workflow" string="Workflow" context="{'group_by': 'workflow_id'}"/>
                <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_absar_approval_request_list" model="ir.ui.view">
        <field name="name">absar.approval.request.list</field>
        <field name="model">absar.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" decoration-danger="is_overdue" decoration-success="state == 'approved'" decoration-muted="state in ('cancelled', 'withdrawn')">
                <field name="name"/>
                <field name="reference"/>
                <field name="workflow_id"/>
                <field name="requester_id"/>
                <field name="stage_id"/>
                <field name="current_approver_ids" widget="many2many_tags"/>
                <field name="deadline"/>
                <field name="is_overdue" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_absar_approval_request_form" model="ir.ui.view">
        <field name="name">absar.approval.request.form</field>
        <field name="model">absar.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request" create="0" delete="0">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="not can_current_user_approve"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="not can_current_user_reject"/>
                    <button name="action_withdraw" type="object" string="Withdraw" invisible="not can_current_user_withdraw"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="absar_approval_engine.group_approval_manager" invisible="state in ('approved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,approved,rejected"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_target" type="object" class="oe_stat_button" icon="fa-external-link">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_text">Open Document</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="workflow_id"/>
                            <field name="stage_id"/>
                            <field name="requester_id"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="deadline"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Your Comment" invisible="not can_current_user_approve and not can_current_user_reject">
                        <field name="comment" placeholder="Approval comment or rejection reason..."/>
                    </group>
                    <notebook>
                        <page string="Approvers">
                            <field name="line_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="stage_id"/>
                                    <field name="user_id"/>
                                    <field name="delegated_from_id" optional="show"/>
                                    <field name="state" widget="badge"/>
                                    <field name="action_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audit History">
                            <field name="audit_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="action_date"/>
                                    <field name="action" widget="badge"/>
                                    <field name="stage_id"/>
                                    <field name="user_id"/>
                                    <field name="delegated_from_id" optional="show"/>
                                    <field name="old_state" optional="hide"/>
                                    <field name="new_state" optional="hide"/>
                                    <field name="comment"/>
                                    <field name="source" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_absar_my_approvals" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">absar.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_absar_approval_request_search"/>
        <field name="domain">[('current_approver_ids', 'in', uid), ('state', '=', 'in_progress')]</field>
    </record>

    <record id="action_absar_my_requests" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">absar.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_absar_approval_request_search"/>
        <field name="domain">[('requester_id', '=', uid)]</field>
    </record>

    <record id="action_absar_all_requests" model="ir.actions.act_window">
        <field name="name">All Approval Requests</field>
        <field name="res_model">absar.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_absar_approval_request_search"/>
    </record>
</odoo>
