<odoo>
    <record id="view_absar_approval_audit_list" model="ir.ui.view">
        <field name="name">absar.approval.audit.list</field>
        <field name="model">absar.approval.audit</field>
        <field name="arch" type="xml">
            <list string="Approval Audit Log" create="0" edit="0" delete="0">
                <field name="action_date"/>
                <field name="request_id"/>
                <field name="workflow_id"/>
                <field name="stage_id"/>
                <field name="action" widget="badge"/>
                <field name="user_id"/>
                <field name="delegated_from_id" optional="show"/>
                <field name="comment"/>
                <field name="source"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_absar_approval_audit" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">absar.approval.audit</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
