<odoo>
    <record id="view_absar_approval_workflow_list" model="ir.ui.view">
        <field name="name">absar.approval.workflow.list</field>
        <field name="model">absar.approval.workflow</field>
        <field name="arch" type="xml">
            <list string="Approval Workflows">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="stage_count"/>
                <field name="auto_start"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_absar_approval_workflow_form" model="ir.ui.view">
        <field name="name">absar.approval.workflow.form</field>
        <field name="model">absar.approval.workflow</field>
        <field name="arch" type="xml">
            <form string="Approval Workflow">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Example: Purchase Order Approval"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="auto_start"/>
                            <field name="requester_can_approve"/>
                            <field name="allow_withdraw"/>
                            <field name="restart_policy"/>
                        </group>
                    </group>
                    <group string="Applicability">
                        <field name="domain" widget="domain" options="{'model': 'model'}"/>
                        <field name="model" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Approval Stages">
                            <field name="stage_ids" context="{'default_workflow_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_source"/>
                                    <field name="approval_mode"/>
                                    <field name="minimum_approvals" invisible="approval_mode != 'count'"/>
                                    <field name="deadline_days"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                                <form string="Approval Stage">
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="active"/>
                                            <field name="deadline_days"/>
                                        </group>
                                        <group>
                                            <field name="approval_mode"/>
                                            <field name="minimum_approvals" invisible="approval_mode != 'count'"/>
                                            <field name="can_reject"/>
                                            <field name="notify_requester"/>
                                        </group>
                                    </group>
                                    <group string="Approvers">
                                        <field name="approver_source"/>
                                        <field name="user_ids" widget="many2many_tags" invisible="approver_source != 'users'"/>
                                        <field name="group_ids" widget="many2many_tags" invisible="approver_source != 'groups'"/>
                                        <field name="approver_field_id" invisible="approver_source != 'field'" options="{'no_create': True}"/>
                                    </group>
                                    <group string="Comments">
                                        <field name="require_approval_comment"/>
                                        <field name="require_rejection_comment"/>
                                    </group>
                                    <field name="description"/>
                                </form>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_absar_approval_workflows" model="ir.actions.act_window">
        <field name="name">Approval Workflows</field>
        <field name="res_model">absar.approval.workflow</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
