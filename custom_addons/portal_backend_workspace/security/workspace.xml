<odoo>
<record id="module_category_workspace" model="ir.module.category"><field name="name">Portal Backend Workspace</field><field name="sequence">37</field></record>
<record id="group_workspace_access" model="res.groups"><field name="name">Workspace Access</field><field name="category_id" ref="module_category_workspace"/><field name="comment">Workspace navigation only. Assign each operational role separately; no backend access is granted.</field></record>
<record id="rule_notification_own" model="ir.rule"><field name="name">Workspace notifications: own allowed companies</field><field name="model_id" ref="model_pbw_workspace_notification"/><field name="domain_force">[('user_id','=',user.id),('company_id','in',user.company_ids.ids)]</field><field name="groups" eval="[(4,ref('group_workspace_access'))]"/></record>
<record id="rule_seen_own" model="ir.rule"><field name="name">Workspace notification markers: own</field><field name="model_id" ref="model_pbw_notification_seen"/><field name="domain_force">[('user_id','=',user.id)]</field><field name="groups" eval="[(4,ref('group_workspace_access'))]"/></record>
</odoo>