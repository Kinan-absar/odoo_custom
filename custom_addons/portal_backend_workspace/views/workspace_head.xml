<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="workspace_head" inherit_id="web.layout" name="Workspace display scale">
        <xpath expr="//head" position="inside">
            <!-- Local to this shell, never to Employee Portal Suite or backend pages. -->
            <t t-if="pbw_portal_compact_desktop">
                <style data-pbw-desktop-density="1">
/* Original approved desktop compactness, applied before first paint. */
@media screen and (min-width:769px){
    html{zoom:.8}
    html :is(.pbw-purchase-options[popover],.pbw-accounting-options[popover]){zoom:1.25}
}
@media print{html{zoom:1}}
                </style>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
            </t>
        </xpath>
    </template>
</odoo>
