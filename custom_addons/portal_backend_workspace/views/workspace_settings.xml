<odoo>
<record id="hr_employee_portal_user" model="ir.ui.view"><field name="name">hr.employee.workspace.portal.user</field><field name="model">hr.employee</field><field name="inherit_id" ref="hr.view_employee_form"/><field name="arch" type="xml"><xpath expr="//field[@name='user_id']" position="attributes"><attribute name="domain">[('active','=',True),('company_ids','in',company_id)]</attribute></xpath></field></record>
<record id="action_workspace_users" model="ir.actions.act_window"><field name="name">Workspace Users</field><field name="res_model">res.users</field><field name="view_mode">list,form</field><field name="domain" eval="[('groups_id','in',[ref('group_workspace_access')])]"/><field name="context">{'active_test':False}</field></record>
<menuitem id="menu_workspace_config" name="Portal Backend Workspace" parent="base.menu_administration" sequence="80" groups="base.group_system"/>
<menuitem id="menu_workspace_users" name="Workspace Users" parent="menu_workspace_config" action="action_workspace_users" sequence="10" groups="base.group_system"/>

<!-- Retire the redundant Settings menu. Preserve IDs for existing installations. -->
<record id="menu_workspace_users" model="ir.ui.menu">
    <field name="active" eval="False"/>
</record>
<record id="menu_workspace_config" model="ir.ui.menu">
    <field name="active" eval="False"/>
</record>
</odoo>