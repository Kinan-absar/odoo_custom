<odoo>
 <template id="sales__sales_workspace_header"><header class="pbw-sales-workspace-header"><div class="pbw-sales-workspace-brand"><span class="pbw-sales-workspace-icon"><i class="fa fa-line-chart" aria-hidden="true"/></span><div><strong>Sales</strong><small t-out="request.env.company.name"/></div></div><nav class="pbw-sales-app-nav" aria-label="Sales workspace"><a t-if="request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_creator')" href="/my/workspace/sales/updates">Review Updates</a><a href="/my/workspace/sales" t-att-class="'active' if request.httprequest.path.rstrip('/') == '/my/workspace/sales' else ''"><t t-out="'Quotations &amp; Sales Orders' if request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_user') else 'My Quotations'"/></a><a t-if="request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_monitor')" href="/my/workspace/sales/monitor">Monitoring</a><a t-if="request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_approver')" href="/my/workspace/sales/approvals">Approvals</a></nav></header></template>

 <template id="sales__sales_list" name="Workspace Sales List">
  <t t-call="portal_backend_workspace.workspace_layout">
   <div class="container pbw-sales-wrap py-4"><t t-call="portal_backend_workspace.sales__sales_workspace_header"/>
    <div class="pbw-sales-head"><h3 t-out="'Sales Review Updates' if updates_only else 'Sales Monitoring' if monitoring else ('Pending Approvals' if queue_only else ('Quotations &amp; Sales Orders' if request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_user') else 'My Quotations'))"/><a t-if="can_create and not monitoring and not queue_only and not updates_only" class="btn btn-primary" href="/my/workspace/sales/new">+ New Quotation</a></div>
    <p class="text-muted" t-if="monitoring">Read-only visibility across your allowed companies. Backend quotations and confirmed Sales Orders can be filtered separately.</p>
    <form class="pbw-sales-monitor-filters" t-att-action="'/my/workspace/sales/updates' if updates_only else '/my/workspace/sales/monitor' if monitoring else ('/my/workspace/sales/approvals' if queue_only else '/my/workspace/sales')" method="get">
     <input class="form-control" name="q" type="search" t-att-value="q" placeholder="Search quotation, customer, project, salesperson"/>
     <select t-if="monitoring or request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_user')" name="source" class="form-select" aria-label="Source"><option value="all">All sources</option><option value="portal" t-att-selected="source == 'portal' and 'selected' or None">Portal</option><option value="backend" t-att-selected="source == 'backend' and 'selected' or None">Backend</option></select>
     <select t-if="monitoring or request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_user')" name="sales_state" class="form-select" aria-label="Sales status"><option value="all">All sales statuses</option><option value="quotation" t-att-selected="sales_state == 'quotation' and 'selected' or None">Quotations</option><option value="order" t-att-selected="sales_state == 'order' and 'selected' or None">Sales Orders</option><option value="cancel" t-att-selected="sales_state == 'cancel' and 'selected' or None">Cancelled</option></select>
     <select t-if="monitoring or request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_user')" name="review" class="form-select" aria-label="Internal review"><option value="all">All review statuses</option><option value="na" t-att-selected="review == 'na' and 'selected' or None">Not applicable (backend)</option><option value="draft" t-att-selected="review == 'draft' and 'selected' or None">Portal draft</option><option value="submitted" t-att-selected="review == 'submitted' and 'selected' or None">Awaiting approval</option><option value="approved" t-att-selected="review == 'approved' and 'selected' or None">Approved</option><option value="returned" t-att-selected="review == 'returned' and 'selected' or None">Returned</option></select>
     <button class="btn btn-outline-primary" type="submit">Filter</button>
    </form>
    <p class="pbw-sales-result-count"><t t-out="total_count"/> matching records · Page <t t-out="page"/> of <t t-out="pages"/></p>
    <div class="pbw-record-list pbw-column-list pbw-layout-sales" aria-label="Sales quotations and orders">
     <div class="pbw-list-header" aria-hidden="true"><span>Number</span><span>Customer</span><span>Project</span><span>Salesperson</span><span>Date</span><span>Total (incl. VAT)</span><span>Status</span><span>Approval</span></div><article t-foreach="orders" t-as="o" class="pbw-record-card" tabindex="0" role="link" t-att-data-record-href="'/my/workspace/sales/%s' % o.id" t-att-aria-label="'Open ' + o.name"><div class="pbw-list-cell" data-mobile-label="Number" t-att-title="o.name"><a class="pbw-record-number" t-att-href="'/my/workspace/sales/%s' % o.id" t-out="o.name"/></div><div class="pbw-list-cell" data-mobile-label="Customer" t-att-title="o.partner_id.name"><div class="pbw-record-party" t-out="o.partner_id.name"/>
       </div><div class="pbw-list-cell" data-mobile-label="Project"><span><t t-out="o.pbw_project_id.name or 'Not assigned'"/></span></div><div class="pbw-list-cell" data-mobile-label="Salesperson"><span><t t-out="o.user_id.name or '—'"/></span></div><div class="pbw-list-cell" data-mobile-label="Date"><span><span t-field="o.date_order" t-options="{'widget':'date'}"/></span></div><div class="pbw-list-cell pbw-list-money" data-mobile-label="Total (incl. VAT)"><strong class="pbw-record-value"><t t-out="'{:,.2f}'.format(o.amount_total)"/> <t t-out="o.currency_id.name"/></strong>
       </div><div class="pbw-list-cell" data-mobile-label="Status" t-att-title="dict(o._fields['state'].selection).get(o.state)"><span class="pbw-record-badge" t-out="dict(o._fields['state'].selection).get(o.state)"/></div><div class="pbw-list-cell" data-mobile-label="Approval" t-att-title="dict(o._fields['pbw_order_review_state'].selection).get(o.pbw_order_review_state) if o.pbw_order_review_state != 'none' else dict(o._fields['pbw_portal_review_state'].selection).get(o.pbw_portal_review_state)"><span t-if="o.pbw_portal_creator_id" class="pbw-record-badge" t-out="dict(o._fields['pbw_order_review_state'].selection).get(o.pbw_order_review_state) if o.pbw_order_review_state != 'none' else dict(o._fields['pbw_portal_review_state'].selection).get(o.pbw_portal_review_state)"/>
      </div></article><div t-if="not orders" class="pbw-record-empty">No quotations match these filters.</div>
    </div>
    <nav class="pbw-sales-pagination" aria-label="Quotation pages"><a t-if="page &gt; 1" class="btn btn-outline-secondary" t-att-href="previous_url">← Previous</a><span>Page <t t-out="page"/> / <t t-out="pages"/></span><a t-if="page &lt; pages" class="btn btn-outline-secondary" t-att-href="next_url">Next →</a></nav>
   </div>
  </t>
 </template>
 <template id="sales__sales_new" name="New Portal Sales Quotation">
  <t t-call="portal_backend_workspace.workspace_layout">
   <div class="container pbw-sales-wrap py-4"><t t-call="portal_backend_workspace.sales__sales_workspace_header"/><a href="/my/workspace/sales">← Quotations</a>
    <div class="pbw-sales-head mt-3"><div><h3>New Quotation</h3><span class="pbw-sales-status">Draft</span></div></div>
    <div class="pbw-sales-sales-actions pbw-document-actions mb-3"><button type="button" class="btn btn-primary" data-sales-save="1">Save Draft</button><a class="btn btn-outline-secondary" href="/my/workspace/sales" data-draft-cancel="1">Cancel</a></div>
    <div t-if="error" class="alert alert-danger" t-out="error"/>
    <div class="pbw-sales-panel"><div id="pbw-sales-new-details" class="row g-3 mb-4">
     <div class="col-md-6"><label>Customer</label><select name="partner_id" class="form-select pbw-sales-customer-select" required="required"><option value="">Select customer</option><option t-foreach="partners" t-as="p" t-att-data-commercial-id="p.commercial_partner_id.id" t-att-value="p.id" t-out="p.name"/></select></div>
     <div class="col-md-6"><label>Quotation / Order Date</label><input type="datetime-local" name="date_order" class="form-control" step="1" required="required" t-att-value="date_order_local"/></div><div class="col-md-6"><label>Expiration Date</label><input type="date" name="validity_date" class="form-control"/></div>
     <div class="col-md-6"><label>Project</label><select name="project_id" class="form-select pbw-sales-project-select"><option value="">No project</option><option t-foreach="projects" t-as="project" t-att-value="project.id" t-att-data-customer-id="project.partner_id.commercial_partner_id.id if project.partner_id else 0" t-out="project.name"/></select></div>
     <div class="col-md-6"><label>Document Type</label><select name="kind" class="form-select"><option value="standard">Standard Quotation</option></select></div>
    </div><h5>Order Lines</h5><div id="pbw-sales-line-editor" t-att-data-boot="line_boot_json" t-att-data-csrf="request.csrf_token()"/><noscript>Enable JavaScript to prepare this quotation.</noscript></div>
   </div>
  </t>
 </template>
 <template id="sales__sales_detail" name="Portal Sales Quotation Editor">
  <t t-call="portal_backend_workspace.workspace_layout">
   <div class="container pbw-sales-wrap py-4" t-att-data-sales-partner="order.partner_id.id"><t t-call="portal_backend_workspace.sales__sales_workspace_header"/><a t-att-href="'/my/workspace/sales/monitor' if request.env.user.has_group('portal_backend_workspace.sales__group_portal_sales_monitor') and not order.pbw_portal_creator_id else '/my/workspace/sales'">← Quotations</a>
    <div class="pbw-sales-head mt-3"><div><h3><t t-out="order.name"/> · <t t-out="order.partner_id.name"/></h3><span class="pbw-sales-status pbw-sales-status-sales" t-out="dict(order._fields['state'].selection).get(order.state)"/> <span t-if="order.pbw_portal_creator_id" t-att-class="'pbw-sales-status pbw-sales-status-' + (order.pbw_portal_review_state or 'draft')" t-out="dict(order._fields['pbw_portal_review_state'].selection).get(order.pbw_portal_review_state)"/><span t-else="" class="pbw-sales-muted-tag">Approval required before confirmation</span></div>
     <a t-if="can_print" t-att-href="'/my/workspace/sales/%s/pdf' % order.id" class="btn btn-outline-primary" target="_blank">Print / Download PDF</a></div>
    <div class="pbw-sales-sales-actions pbw-document-actions d-flex gap-2 flex-wrap mb-3">
     <button t-if="can_edit" type="button" class="btn btn-primary" data-sales-save="1">Save Draft</button><a class="btn btn-outline-secondary" href="/my/workspace/sales" data-draft-cancel="1">Cancel</a>
     <form t-if="can_submit" method="post" t-att-action="'/my/workspace/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="submit"/><button class="btn btn-primary" data-pbw-sales-submit-review="1" t-att-disabled="not order.order_line and 'disabled' or None">Submit for Approval</button></form>
     <form t-if="can_request_order" method="post" t-att-action="'/my/workspace/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="request_order"/><button class="btn btn-primary">Request Sales Order Approval</button></form>
     <t t-if="can_approve or can_return or can_approve_order">
      <form t-if="can_approve or can_approve_order" method="post" t-att-action="'/my/workspace/sales/%s/workflow' % order.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" t-att-value="'approve_order' if can_approve_order else 'approve'"/><button class="btn btn-success">Approve</button></form>
      <form t-if="can_return or can_approve_order" method="post" t-att-action="'/my/workspace/sales/%s/workflow' % order.id" class="d-flex gap-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" t-att-value="'return_order' if can_approve_order else 'return'"/><input class="form-control" name="note" placeholder="Reason for return" required="required"/><button class="btn btn-outline-danger">Return for Correction</button></form>
     </t>
    </div>
    <p t-if="order.pbw_order_review_state == 'requested'" class="alert alert-info">Awaiting approval to convert this quotation into a Sales Order.</p>
    <div t-if="error or request.params.get('error')" class="alert alert-warning" t-out="error or 'The requested change could not be saved. Check the values and try again.'"/>
    <div t-if="order.pbw_portal_review_note" class="alert alert-info"><strong>Reviewer note:</strong> <t t-out="order.pbw_portal_review_note"/></div>
    <div class="pbw-sales-panel"><h5>Quotation Details</h5><div class="row"><div class="col-md-4"><span class="text-muted">Customer</span><p t-out="order.partner_id.name"/></div><div t-if="not can_edit" class="col-md-4"><span class="text-muted">Quotation / Order Date</span><p><span t-field="order.date_order"/></p></div><div class="col-md-4"><span class="text-muted">Document type</span><p t-out="'Standard Quotation'"/></div><div t-if="not can_edit" class="col-md-4"><span class="text-muted">Project</span><p t-out="order.pbw_project_id.name or 'Not assigned'"/></div><div t-if="not can_edit and order.validity_date" class="col-md-4"><span class="text-muted">Expiration Date</span><p><span t-field="order.validity_date"/></p></div><div class="col-md-4"><span class="text-muted">Salesperson</span><p t-out="order.user_id.name or order.pbw_portal_creator_id.name"/></div></div>
     <form id="pbw-sales-order-details" t-if="can_edit" t-att-action="'/my/workspace/sales/%s/save' % order.id" method="post" class="row g-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
      <div class="col-md-4"><label>Quotation reference (automatic)</label><input class="form-control" t-att-value="order.name" readonly="readonly"/></div>
      <div class="col-md-4"><label>Project</label><select class="form-select pbw-sales-project-select" name="project_id"><option value="">No project</option><option t-foreach="projects" t-as="project" t-att-value="project.id" t-att-data-customer-id="project.partner_id.commercial_partner_id.id if project.partner_id else 0" t-att-selected="order.pbw_project_id.id == project.id and 'selected' or None" t-out="project.name"/></select></div><div class="col-md-4"><label>Quotation / Order Date</label><input class="form-control" type="datetime-local" name="date_order" step="1" required="required" t-att-value="date_order_local"/></div><div class="col-md-4"><label>Expiration date</label><input class="form-control" type="date" name="validity_date" t-att-value="order.validity_date or ''"/></div>
      </form>
    </div>
    <div class="pbw-sales-panel pbw-sales-sales-lines-panel"><h5>Order Lines</h5><div id="pbw-sales-line-editor" t-att-data-boot="line_boot_json" t-att-data-csrf="request.csrf_token()"/><noscript>Enable JavaScript to view and edit quotation lines.</noscript></div>
    <div class="pbw-sales-modal" id="pbw-sales-modal" hidden="hidden"><div class="pbw-sales-modal-content" role="dialog" aria-modal="true" aria-labelledby="pbw-sales-modal-title"><h5 id="pbw-sales-modal-title">Confirm action</h5><p id="pbw-sales-modal-text"/><div class="d-flex gap-2 justify-content-end"><button type="button" class="btn btn-light" id="pbw-sales-modal-cancel">Cancel</button><button type="button" class="btn btn-primary" id="pbw-sales-modal-ok">Continue</button></div></div></div>
   </div>
  </t>
 </template>
</odoo>
