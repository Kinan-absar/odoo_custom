<odoo>
 <template id="purchase__purchase_approval_list" name="Purchase Approvals — Monitoring List Design">
  <t t-call="portal_backend_workspace.workspace_layout">
   <div class="container pbw-monitor-shell my-4">
    <t t-if="not approval" t-call="portal_backend_workspace.purchase__purchase_workspace_nav"/><div class="pbw-monitor-title"><div><h2 t-out="'Purchase Approvals' if approval else 'Purchase Orders'"/><p t-out="'Review purchase orders awaiting approval' if approval else 'Draft purchase orders and approval status'"/></div><span class="pbw-monitor-count"><t t-out="total"/> requests</span><a t-if="not approval" href="/my/workspace/purchase/new" class="btn btn-primary">New Purchase Order</a></div>
    <form class="pbw-monitor-filter" method="get"><input class="form-control pbw-purchase-search" name="q" t-att-value="q" placeholder="Search PO, vendor, MR or reference" aria-label="Search Purchase Orders"/>
    <select t-if="not orders_only" name="review" class="form-select" aria-label="Review status"><option value="all" t-att-selected="review == 'all'">All review statuses</option><option value="draft" t-att-selected="review == 'draft'">Draft</option><option value="submitted" t-att-selected="review == 'submitted'">Awaiting Approval</option><option value="approved" t-att-selected="review == 'approved'">Approved</option><option value="returned" t-att-selected="review == 'returned'">Returned</option></select>
    <select name="sort" class="form-select" aria-label="Sort"><option value="newest">Newest</option><option value="reference" t-att-selected="sort == 'reference'">Reference</option><option value="vendor" t-att-selected="sort == 'vendor'">Vendor</option><option value="amount" t-att-selected="sort == 'amount'">Highest amount</option><option value="date" t-att-selected="sort == 'date'">Order date</option></select><select name="group_by" class="form-select" aria-label="Group by"><option value="">No grouping</option><option value="vendor" t-att-selected="group_by == 'vendor'">Group by Vendor</option><option value="project" t-att-selected="group_by == 'project'">Group by Project</option><option value="buyer" t-att-selected="group_by == 'buyer'">Group by Buyer</option><option value="company" t-att-selected="group_by == 'company'">Group by Company</option><option value="review" t-att-selected="group_by == 'review'">Group by Review</option></select><button class="btn btn-primary">Search</button><a t-att-href="'/my/workspace/purchase/orders' if orders_only else '/my/workspace/purchase/confirmations' if confirmations else '/my/workspace/purchase/approvals' if approval else '/my/workspace/purchase'" class="btn btn-light">Clear</a>
   </form>
    <p t-if="group_by" class="pbw-monitor-note">A group can continue onto the next page.</p>
    <div class="pbw-record-list pbw-column-list pbw-layout-purchase" aria-label="Purchase orders">
     <div class="pbw-list-header" aria-hidden="true"><span>Number</span><span>Vendor</span><span>Project</span><span>Buyer</span><span>Date</span><span>Total (incl. VAT)</span><span>Approval</span><span>Status</span><span>Company</span></div><t t-set="last_group" t-value="False"/><t t-foreach="orders" t-as="po">
      <h4 t-if="group_by and group_labels.get(po.id) != last_group" class="pbw-record-group" t-out="group_labels.get(po.id)"/><t t-set="last_group" t-value="group_labels.get(po.id)"/>
      <article class="pbw-record-card" role="link" tabindex="0" t-att-data-record-href="'/my/workspace/purchase/%s' % po.id" t-att-aria-label="'Open ' + po.name"><div class="pbw-list-cell" t-att-title="po.name"><a class="pbw-record-number" t-att-href="'/my/workspace/purchase/%s' % po.id" t-out="po.name"/></div><div class="pbw-list-cell" t-att-title="po.partner_id.name"><div class="pbw-record-party" t-out="po.partner_id.name"/>
        </div><div class="pbw-list-cell"><span><t t-out="po.project_id.display_name if 'project_id' in po._fields else po.pbw_portal_project_id.display_name or '—'"/></span></div><div class="pbw-list-cell"><span><t t-out="po.pbw_portal_preparer_id.name or po.user_id.name or '—'"/></span></div><div class="pbw-list-cell" t-att-title="po.date_order.date() if po.date_order else ''"><span t-out="po.date_order.date() if po.date_order else ''"/></div><div class="pbw-list-cell pbw-list-money"><strong class="pbw-record-value"><t t-out="'{:,.2f}'.format(po.amount_total)"/> <t t-out="po.currency_id.name"/></strong>
        </div><div class="pbw-list-cell" t-att-title="dict(po._fields['pbw_portal_review_state']._description_selection(po.env)).get(po.pbw_portal_review_state, 'Draft')"><span class="pbw-record-badge" t-out="dict(po._fields['pbw_portal_review_state']._description_selection(po.env)).get(po.pbw_portal_review_state, 'Draft')"/>
        </div><div class="pbw-list-cell" t-att-title="{'draft':'Draft PO','sent':'Draft PO Sent','purchase':'Purchase Order','done':'Locked','cancel':'Cancelled'}.get(po.state,po.state)"><span class="pbw-record-badge" t-out="{'draft':'Draft PO','sent':'Draft PO Sent','purchase':'Purchase Order','done':'Locked','cancel':'Cancelled'}.get(po.state,po.state)"/>
       </div><div class="pbw-list-cell" t-att-title="po.company_id.name"><span t-out="po.company_id.name"/></div></article>
     </t><div t-if="not orders" class="pbw-record-empty">No purchase requests match these filters.</div>
    </div>
    <div class="pbw-monitor-footer"><p t-out="'Review a request to approve or return it for correction.' if approval else 'Open a request to prepare it or follow its approval status.'"/><div class="pbw-monitor-pages"><a t-if="page &gt; 1" t-att-href="previous_url">← Previous</a><span>Page <t t-out="page"/> of <t t-out="pages"/></span><a t-if="page &lt; pages" t-att-href="next_url">Next →</a></div></div>
   </div>
  </t>
 </template>
</odoo>
