<odoo>
 <template id="purchase__purchase_workspace_nav" name="Purchase Portal Navigation">
  <header class="pbw-purchase-workspace-header" t-if="request.env.user.has_group('portal_backend_workspace.purchase__group_portal_purchase_preparer')"><div class="pbw-purchase-workspace-brand"><span class="pbw-purchase-workspace-icon"><i class="fa fa-shopping-cart" aria-hidden="true"/></span><div><strong>Purchase</strong><small t-out="request.env.company.name"/></div></div><nav class="pbw-purchase-app-nav" aria-label="Purchase workspace">
   <a t-if="request.env.user.has_group('portal_backend_workspace.purchase__group_portal_purchase_preparer')" href="/my/workspace/purchase" t-att-class="'active' if request.httprequest.path in ['/my/workspace/purchase', '/my/workspace/purchase/new'] else ''">Draft Purchase Orders</a>
   <a t-att-class="'active' if request.httprequest.path.endswith('/orders') else ''" t-att-href="'/my/workspace/purchase-monitor' if request.env.user.has_group('portal_backend_workspace.purchase__group_portal_purchase_monitor') else '/my/workspace/purchase/orders'" t-if="request.env.user.has_group('portal_backend_workspace.purchase__group_portal_purchase_preparer')">Purchase Orders</a>
   <a href="/my/workspace/purchase/products" t-att-class="'active' if request.httprequest.path.endswith('/products') else ''" t-if="request.env.user.has_group('portal_backend_workspace.purchase__group_portal_purchase_preparer')">Products</a>
   <a t-if="request.env.user.has_group('portal_backend_workspace.purchase__group_portal_purchase_approver')" href="/my/workspace/purchase/approvals">Approvals</a>
   </nav>
 </header></template>
 <template id="purchase__purchase_product_directory" name="Portal Purchasing Products">
  <t t-call="portal_backend_workspace.workspace_layout"><section class="pbw-purchase-shell" id="pbw-purchase-products" t-att-data-company-id="company.id">
   <t t-call="portal_backend_workspace.purchase__purchase_workspace_nav"/>
   <div class="pbw-purchase-heading"><div><p class="pbw-purchase-eyebrow">Purchase / Products</p><h2>Products</h2><p>Purchasing products available to your company</p></div><button t-if="can_create" type="button" class="btn btn-primary" data-product-new="1">New Product</button></div>
   <div role="alert" class="alert alert-danger" hidden="hidden"/>
   <form class="pbw-purchase-toolbar" method="get"><input name="q" class="form-control pbw-purchase-search" placeholder="Search product or internal reference" aria-label="Search products" t-att-value="q"/>
    <select name="company_id" class="form-select" aria-label="Company"><t t-foreach="companies" t-as="c"><option t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/></t></select><button class="btn btn-primary">Search</button><a href="/my/workspace/purchase/products" class="btn btn-light">Clear</a></form>
   <div class="pbw-record-list pbw-column-list pbw-layout-products" aria-label="Products"><div class="pbw-list-header" aria-hidden="true"><span>Product</span><span>Internal Reference</span><span>Type</span><span>Purchase Unit</span><span>Company</span></div><article t-foreach="records" t-as="product" class="pbw-record-card" role="button" tabindex="0" t-att-data-product-open="product.id" t-att-aria-label="'Open ' + product.name"><div class="pbw-list-cell" data-mobile-label="Product" t-att-title="product.name"><strong class="pbw-record-number" t-out="product.name" t-att-title="product.description_purchase or product.name"/></div><div class="pbw-list-cell" data-mobile-label="Internal Reference"><span><t t-out="product.default_code or '—'"/></span></div><div class="pbw-list-cell" data-mobile-label="Type" t-att-title="'Service' if product.type == 'service' else 'Goods'"><span class="pbw-record-badge" t-out="'Service' if product.type == 'service' else 'Goods'"/></div><div class="pbw-list-cell" data-mobile-label="Purchase Unit"><span><t t-out="product.uom_po_id.display_name"/></span></div><div class="pbw-list-cell" data-mobile-label="Company" t-att-title="product.company_id.name or 'Shared'"><span t-out="product.company_id.name or 'Shared'"/></div></article><div t-if="not records" class="pbw-record-empty">No products match your search.</div></div><t t-call="portal_backend_workspace.purchase__purchase_pager"/>
   <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
  </section></t>
 </template>
 </odoo>
