<odoo>
 <template id="purchase__purchase_monitor_list" name="Purchase Monitoring List">
  <t t-call="portal_backend_workspace.workspace_layout">
   <div class="container pbw-monitor-shell my-4">
    <t t-if="show_workspace" t-call="portal_backend_workspace.purchase__purchase_workspace_nav"/><div class="pbw-monitor-title"><div><h2 t-out="title"/><p t-out="description"/></div><span class="pbw-monitor-count"><t t-out="total"/> POs</span></div>
    <form method="get" class="pbw-monitor-filter" t-att-action="list_url">
     <input type="search" name="q" t-att-value="q" placeholder="Search PO, supplier, or origin..." class="form-control"/>
     <select name="status" class="form-select">
      <option value="all" t-att-selected="status == 'all'">All confirmed</option>
      <option value="purchase" t-att-selected="status == 'purchase'">Purchase orders</option>
      <option value="done" t-att-selected="status == 'done'">Locked / Done</option>
     </select>
     <button type="submit" class="btn btn-primary">Search</button>
     <a class="btn btn-light" t-att-href="list_url">Clear</a>
    </form>
    <div class="pbw-record-list pbw-column-list pbw-layout-monitor" aria-label="Purchase orders">
     <div class="pbw-list-header" aria-hidden="true"><span>Number</span><span>Vendor</span><span>Project</span><span>Buyer</span><span>Date</span><span>Total (incl. VAT)</span><span>Invoiced</span><span>Settled</span><span>Balance Due</span></div><article t-foreach="rows" t-as="r" class="pbw-record-card" role="link" tabindex="0" t-att-data-record-href="'%s/%d' % (detail_base_url,r['po'].id)" t-att-aria-label="'Open ' + r['po'].name"><div class="pbw-list-cell" data-mobile-label="Number" t-att-title="r['po'].name"><span class="pbw-record-number" t-out="r['po'].name"/></div><div class="pbw-list-cell" data-mobile-label="Vendor" t-att-title="r['po'].partner_id.name"><div class="pbw-record-party" t-out="r['po'].partner_id.name"/>
       </div><div class="pbw-list-cell" data-mobile-label="Project"><span><t t-out="r['project']"/></span></div><div class="pbw-list-cell" data-mobile-label="Buyer"><span><t t-out="(r['po'].pbw_portal_preparer_id or r['po'].user_id).name or '—'"/></span></div><div class="pbw-list-cell" data-mobile-label="Date" t-att-title="r['po'].date_order.date() if r['po'].date_order else ''"><span t-out="r['po'].date_order.date() if r['po'].date_order else ''"/></div><div class="pbw-list-cell pbw-list-money" data-mobile-label="Total (incl. VAT)"><strong class="pbw-record-value"><t t-out="'{:,.2f}'.format(r['po'].amount_total)"/> <t t-out="r['po'].currency_id.name"/></strong></div><div class="pbw-list-cell pbw-list-money" data-mobile-label="Invoiced" t-att-title="'{:,.2f}'.format(r['billed'])"><strong t-out="'{:,.2f}'.format(r['billed'])"/></div><div class="pbw-list-cell pbw-list-money" data-mobile-label="Settled" t-att-title="'{:,.2f}'.format(r['settled'])"><strong t-out="'{:,.2f}'.format(r['settled'])"/></div><div class="pbw-list-cell pbw-list-money" data-mobile-label="Balance Due" t-att-title="'{:,.2f}'.format(r['due'])"><strong t-out="'{:,.2f}'.format(r['due'])"/></div></article><div t-if="not rows" class="pbw-record-empty">No confirmed purchase orders match these filters.</div>
    </div>
    <div class="pbw-monitor-footer"><p>* Paid and due are derived from posted vendor bills; shared-bill payments are proportionally estimated. Figures include VAT and may differ from payment-voucher allocations.</p>
     <div class="pbw-monitor-pages"><a t-if="page &gt; 1" t-att-href="previous_url">← Previous</a><span>Page <t t-out="page"/> of <t t-out="pages"/></span><a t-if="page &lt; pages" t-att-href="next_url">Next →</a></div>
    </div>
   </div>
  </t>
 </template>
 <template id="purchase__purchase_monitor_detail" name="Purchase Monitoring Detail">
  <t t-call="portal_backend_workspace.workspace_layout">
   <div class="container pbw-monitor-shell my-4">
    <a href="/my/workspace/purchase-monitor" class="pbw-monitor-back">← Purchase Monitoring</a>
    <div class="pbw-monitor-title"><div><h2 t-out="row['po'].name"/><p t-out="row['po'].partner_id.name"/></div></div>
    <div class="pbw-monitor-cards">
     <div><label>PO Value (incl. VAT)</label><strong t-out="'%.2f' % row['po'].amount_total"/></div>
     <div><label>Invoiced (posted)</label><strong t-out="'%.2f' % row['billed']"/></div>
     <div><label>Bill Settlement (allocated)*</label><strong t-out="'%.2f' % row['settled']"/></div>
     <div><label>Balance Due (allocated)*</label><strong t-out="'%.2f' % row['due']"/></div>
    </div>
    <div class="pbw-monitor-info"><div><label>Buyer</label><span t-out="(row['po'].pbw_portal_preparer_id or row['po'].user_id).name or '—'"/></div><div t-if="row['paid'] is not None"><label>PO-linked Paid</label><span t-out="'%.2f' % row['paid']"/></div><div><label>Project</label><span t-out="row['project']"/></div><div><label>PO Status</label><span t-out="row['po'].state"/></div><div><label>Not Yet Invoiced (approx.)</label><span t-out="'%.2f' % row['unbilled']"/></div><div><label>Currency</label><span t-out="row['po'].currency_id.name"/></div></div>
    <h3 class="pbw-monitor-subtitle">Order Lines</h3>
    <div class="pbw-monitor-table-wrap"><table class="pbw-monitor-table"><thead><tr><th>Description</th><th class="pbw-monitor-num">Qty</th><th class="pbw-monitor-num">Unit Price</th><th class="pbw-monitor-num">Subtotal</th></tr></thead><tbody>
     <t t-foreach="row['po'].order_line" t-as="l"><tr t-if="l.display_type"><td colspan="4" t-out="l.name"/></tr><tr t-if="not l.display_type"><td t-out="l.name"/><td class="pbw-monitor-num" t-out="'%.2f' % l.product_qty"/><td class="pbw-monitor-num" t-out="'%.2f' % l.price_unit"/><td class="pbw-monitor-num" t-out="'%.2f' % l.price_subtotal"/></tr></t>
    </tbody></table></div>
    <p class="pbw-monitor-note">* Payment amounts use bill-level settlement ratios, so a vendor bill covering multiple POs results in estimated PO allocations. No approval or PO modification actions are available here.</p>
   </div>
  </t>
 </template>
<template id="purchase__purchase_pager"><div class="pbw-purchase-pager"><span><t t-out="total"/> records · Page <t t-out="page"/> / <t t-out="pages"/></span><div><a t-if="page &gt; 1" t-att-href="previous_url" class="btn btn-light">Previous</a><a t-if="page &lt; pages" t-att-href="next_url" class="btn btn-light">Next</a></div></div></template>
 </odoo>
