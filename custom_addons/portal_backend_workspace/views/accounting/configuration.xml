<odoo>
    <record id="accounting__company_pbw_accounting" model="ir.ui.view">
        <field name="active" eval="False"/>
        <field name="name">res.company.portal.accounting</field><field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Portal Accounting" groups="base.group_system">
                    <group>
                        <field name="pbw_accounting_journal_ids" widget="many2many_tags" domain="[('company_id', '=', id)]" options="{'no_create': True}"/>
                    </group>
                    <p>Assign Accounting Preparer, Accounting Approver or Accounting Monitor on the user. Only journals selected here are available. Portal roles do not grant internal accounting permissions.</p>
                </page>
            </xpath>
        </field>
    </record>
    <record id="accounting__settings_pbw_accounting" model="ir.ui.view">
        <field name="name">res.config.settings.portal.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Workspace Accounting" name="employee_pbw_accounting" groups="base.group_system">
                    <setting id="pbw_accounting_journals" string="Portal Journals" company_dependent="1" help="Choose which journals the employee accounting workspace may use in this company. Leaving this empty disables the workspace.">
                        <field name="pbw_accounting_journal_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    <record id="accounting__move_portal_review" model="ir.ui.view">
        <field name="name">account.move.portal.review</field><field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="pbw_accounting_requires_review" invisible="1"/>
                <button name="action_pbw_accounting_submit" type="object" string="Submit for Approval" class="oe_highlight" groups="portal_backend_workspace.accounting__group_preparer" invisible="not pbw_accounting_requires_review or pbw_accounting_review in ('submitted','approved')"/>
                <field name="pbw_accounting_can_review" invisible="1"/>
                <button name="action_pbw_accounting_approve" type="object" string="Approve &amp; Post" groups="portal_backend_workspace.accounting__group_approver" invisible="not pbw_accounting_can_review" class="oe_highlight"/>
                <button name="action_pbw_accounting_return" type="object" string="Return for Correction" groups="portal_backend_workspace.accounting__group_approver" invisible="not pbw_accounting_can_review"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible" add="(pbw_accounting_requires_review and pbw_accounting_review != 'approved')" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_post' and not(contains(@invisible, 'pbw_accounting_requires_review'))]" position="attributes">
                <attribute name="invisible" add="(pbw_accounting_requires_review and pbw_accounting_review != 'approved')" separator=" or "/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Accounting Review / Reset Requests" invisible="not pbw_accounting_review_required and not pbw_accounting_reset_pending">
                    <group>
                        <field name="pbw_accounting_issuer_id"/>
                        <field name="pbw_accounting_review"/>
                        <field name="pbw_accounting_reviewer_id"/>
                        <field name="pbw_accounting_comment" readonly="not pbw_accounting_can_review" string="Review / Return Reason"/>
                    </group>
                    <field name="pbw_accounting_review_required" invisible="1"/>
                    <field name="pbw_accounting_reset_pending"/>
                    <field name="pbw_accounting_reset_requested_by"/>
                    <field name="pbw_accounting_reset_reason"/>
                    <div class="text-muted" invisible="not pbw_accounting_reset_pending">Reset requested. Review the reason and use the existing native Reset to Draft button and its approval rules. The portal does not reset this document.</div>
                </page>
            </xpath>
        </field>
    </record>
    </odoo>
