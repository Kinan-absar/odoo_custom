<odoo>
 <template id="accounting__invoice_source_links" inherit_id="portal_backend_workspace.accounting__header"><xpath expr="//nav" position="inside"><t t-if="roles.get('customer_invoicing')"><a t-att-href="'/my/workspace/accounting/invoice-sources/sales-orders?company_id=%s' % company.id">Invoice Sales Orders</a></t></xpath></template>
 <template id="accounting__invoice_sources"><t t-call="portal_backend_workspace.workspace_layout"><section class="pbw-accounting"><t t-call="portal_backend_workspace.accounting__header"/><h2>Invoice Sales Orders</h2><div t-if="message" class="pbw-accounting-alert" t-out="message"/><form class="pbw-accounting-filters" method="get"><input type="hidden" name="company_id" t-att-value="company.id"/><input name="q" t-att-value="q" placeholder="Search reference…"/><button>Search</button></form><div class="pbw-accounting-panel"><table class="table"><thead><tr><th>Reference</th><th>Customer</th><th>Status</th><th>Invoice</th></tr></thead><tbody><tr t-foreach="records" t-as="source"><td t-out="source.display_name"/><td t-out="source.partner_id.display_name"/><td t-out="source.state"/><td><form t-if="roles['preparer'] and source.invoice_status == 'to invoice'" method="post" t-att-action="'/my/workspace/accounting/invoice-sources/%s/%s/create' % (kind,source.id)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="company_id" t-att-value="company.id"/><input type="hidden" name="version" t-att-value="str(source.write_date)"/><button class="pbw-accounting-primary">Create Invoice</button></form></td></tr><tr t-if="not records"><td colspan="4">No sources found.</td></tr></tbody></table></div><div class="pbw-accounting-pager"><a t-if="page &gt; 1" t-att-href="'?' + urlencode(dict(company_id=company.id,page=page-1,q=q))">Previous</a><span>Page <t t-out="page"/></span><a t-if="page * 40 &lt; total" t-att-href="'?' + urlencode(dict(company_id=company.id,page=page+1,q=q))">Next</a></div></section></t></template>
</odoo>
