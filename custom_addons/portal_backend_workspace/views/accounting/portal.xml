<odoo>
    <template id="accounting__header">
        <header class="pbw-accounting-workspace-header">
            <div class="pbw-accounting-workspace-brand"><span class="pbw-accounting-workspace-icon"><i class="fa fa-book" aria-hidden="true"/></span><div><a t-att-href="'/my/workspace/accounting?company_id=%s' % company.id">Accounting</a><span t-out="company.name"/></div></div>
            <form class="pbw-accounting-company-switch" method="get" t-if="len(companies) &gt; 1"><label>Company <select name="company_id" onchange="this.form.submit()">
                <option t-foreach="companies" t-as="c" t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/>
            </select></label></form>
            <nav class="pbw-accounting-nav" aria-label="Accounting workspace">
                <a t-att-href="'/my/workspace/accounting?company_id=%s' % company.id" t-att-class="'is-active' if request.httprequest.path.rstrip('/') == '/my/workspace/accounting' else ''">Overview</a>
                <t t-foreach="kinds.items()" t-as="area"><a t-att-href="'/my/workspace/accounting/%s?company_id=%s' % (area[0], company.id)" t-att-class="'is-active' if request.httprequest.path.startswith('/my/workspace/accounting/' + area[0] + '/') or request.httprequest.path.rstrip('/') == '/my/workspace/accounting/' + area[0] else ''" t-out="area[1][1]"/></t>
            </nav>
        </header>
        <div class="pbw-accounting-alert" t-if="not configured"><t t-if="kind in ('invoices', 'sales-orders')">An administrator must configure an active Sales journal for this company.</t><t t-else="">An administrator must select the available journals under Accounting → Configuration → Settings → Workspace Accounting before this workspace can be used.</t></div>
    </template>
    <template id="accounting__home">
        <t t-call="portal_backend_workspace.workspace_layout"><section class="pbw-accounting">
            <t t-call="portal_backend_workspace.accounting__header"/>
            <h2>Accounting Workspace</h2><p>Prepare, review and monitor your accounting documents.</p>
            <div class="pbw-accounting-cards"><a t-foreach="kinds.items()" t-as="area" class="pbw-accounting-card" t-att-data-area="area[0]" t-att-style="'--card-order:%s' % area_index" t-att-href="'/my/workspace/accounting/%s?company_id=%s' % (area[0], company.id)">
                <div class="pbw-accounting-card-top"><span class="pbw-accounting-card-icon" aria-hidden="true"><i t-att-class="'fa ' + {'invoices':'fa-file-text-o','bills':'fa-file-text-o','refunds':'fa-undo','journals':'fa-book'}[area[0]]"/></span><span class="pbw-accounting-card-arrow" aria-hidden="true">↗</span></div>
                <span class="pbw-accounting-card-name" t-out="area[1][1]"/><div class="pbw-accounting-card-bottom"><span class="pbw-accounting-card-open">Open workspace <span aria-hidden="true">→</span></span></div>
            </a></div>
        </section></t>
    </template>
    <template id="accounting__listing">
        <t t-call="portal_backend_workspace.workspace_layout"><section class="pbw-accounting">
            <t t-call="portal_backend_workspace.accounting__header"/>
            <div class="pbw-accounting-title"><h2 t-out="title"/>
                <a class="pbw-accounting-primary" t-if="roles['preparer'] and configured" t-att-href="'/my/workspace/accounting/%s/new?company_id=%s' % (kind, company.id)">New</a>
            </div>
            <div class="pbw-accounting-alert" t-if="message" t-out="message"/>
            <form class="pbw-accounting-filters" method="get"><input type="hidden" name="company_id" t-att-value="company.id"/>
                <input name="q" placeholder="Search number, reference or partner…" t-att-value="q" aria-label="Search accounting documents"/>
                <select name="status" aria-label="Document status"><option value="">All statuses</option>
                    <t><option t-foreach="[('draft','Draft'),('submitted','Awaiting Approval'),('posted','Posted'),('cancel','Cancelled')]" t-as="s" t-att-value="s[0]" t-att-selected="status == s[0]" t-out="s[1]"/></t>
                </select><button>Search</button>
                <a t-att-href="'/my/workspace/accounting/%s?company_id=%s' % (kind, company.id)">Clear</a>
                <span class="pbw-accounting-record-count"><t t-out="count"/> records</span>
            </form>
            <div aria-label="Accounting documents" class="pbw-record-list pbw-column-list pbw-layout-accounting">
             <div class="pbw-list-header" aria-hidden="true"><span>Number</span><span>Partner / Reference</span><span>Date</span><span>Journal</span><span>Amount</span><span>Status</span><span>Review</span><span>Prepared By</span></div><article t-foreach="rows" t-as="row" class="pbw-record-card" tabindex="0" role="link" t-att-data-record-href="'/my/workspace/accounting/%s/%s?company_id=%s' % (kind,row['id'],company.id)" t-att-aria-label="'Open ' + row['name']"><div class="pbw-list-cell" data-mobile-label="Number" t-att-title="row['name']"><a class="pbw-record-number" t-att-href="'/my/workspace/accounting/%s/%s?company_id=%s' % (kind,row['id'],company.id)" t-out="row['name']"/></div><div class="pbw-list-cell" data-mobile-label="Partner / Reference" t-att-title="row['partner'] or '—'"><div class="pbw-record-party" t-out="row['partner'] or '—'"/></div><div class="pbw-list-cell" data-mobile-label="Date" t-att-title="row['date']"><span t-out="row['date']"/></div><div class="pbw-list-cell" data-mobile-label="Journal"><span><t t-out="row['journal'] or '—'"/></span></div><div class="pbw-list-cell pbw-list-money" data-mobile-label="Amount"><strong class="pbw-record-value"><t t-out="'{:,.2f}'.format(row['amount'])"/> <t t-out="row['currency']"/></strong></div><div class="pbw-list-cell" data-mobile-label="Status" t-att-title="row['state'].replace('_',' ').title()"><span class="pbw-record-badge" t-out="row['state'].replace('_',' ').title()"/></div><div class="pbw-list-cell" data-mobile-label="Review" t-att-title="row['review'].replace('_',' ').title()"><span class="pbw-record-badge" t-out="row['review'].replace('_',' ').title()"/></div><div class="pbw-list-cell" data-mobile-label="Prepared By"><span><t t-out="row['issuer'] or '—'"/></span></div></article><div t-if="not rows" class="pbw-record-empty">No documents found.</div>
            </div><div class="pbw-accounting-pager">
                <a t-if="page &gt; 1" t-att-href="'?company_id=%s&amp;page=%s&amp;q=%s&amp;status=%s' % (company.id,page-1,quote_plus(q),status)">Previous</a>
                <span>Page <t t-out="page"/></span>
                <a t-if="page * 40 &lt; count" t-att-href="'?company_id=%s&amp;page=%s&amp;q=%s&amp;status=%s' % (company.id,page+1,quote_plus(q),status)">Next</a>
            </div>
        </section></t>
    </template>
    <template id="accounting__detail">
        <t t-call="portal_backend_workspace.workspace_layout"><section class="pbw-accounting">
            <t t-call="portal_backend_workspace.accounting__header"/>
            <a t-att-href="'/my/workspace/accounting/%s?company_id=%s' % (kind, company.id)" t-out="title"/>
            <div id="pbw-accounting-editor" t-att-data-boot="boot_json" t-att-data-csrf="request.csrf_token()"/>
            <noscript>Enable JavaScript to use the accounting form.</noscript>
        </section></t>
    </template>
</odoo>
