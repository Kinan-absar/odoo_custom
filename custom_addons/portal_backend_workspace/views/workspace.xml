<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="workspace_layout" name="Portal Backend Workspace Layout">
  <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
   <div class="pbw-shell"><aside class="pbw-sidebar">
    <a href="/my/workspace" class="pbw-logo"><span class="pbw-mark">W</span><span>Portal Backend<br/>Workspace</span></a>
    <div class="pbw-caption">WORKSPACES</div><nav class="pbw-menu">
     <a href="/my/workspace" t-att-class="'pbw-link active' if active_section == 'home' else 'pbw-link'"><i class="fa fa-home"/> Overview</a>
     <t t-foreach="sections" t-as="item"><a t-att-href="'/my/workspace/'+item['key']" t-att-class="'pbw-link active' if active_section == item['key'] else 'pbw-link'"><i t-att-class="'fa '+item['icon']"/> <t t-out="item['title']"/></a></t>
    </nav><div class="pbw-bottom"><t t-if="has_employee_portal"><a class="pbw-link" href="/my/employee"><i class="fa fa-exchange"/> Employee Portal</a></t><div class="pbw-profile"><i class="fa fa-user-circle"/> <t t-out="request.env.user.name"/></div></div>
   </aside><main class="pbw-main"><header class="pbw-top"><div class="pbw-top-company" t-out="company_name"/><div class="pbw-top-right"><span class="pbw-pill">Portal access</span><a href="/web/session/logout?redirect=/web/login" title="Log out"><i class="fa fa-sign-out"/></a></div></header>
    <div class="pbw-mobile-nav"><label for="pbw-nav">Workspace</label><select id="pbw-nav" onchange="if(this.value)window.location.href=this.value"><option value="/my/workspace">Overview</option><t t-foreach="sections" t-as="item"><option t-att-value="'/my/workspace/'+item['key']" t-att-selected="active_section == item['key'] and 'selected' or None" t-out="item['title']"/></t><t t-if="has_employee_portal"><option value="/my/employee">Employee Portal</option></t></select></div>
    <div class="pbw-content"><t t-out="0"/></div>
   </main></div>
  </t>
 </template>
 <template id="workspace_dashboard" name="Workspace Dashboard"><t t-call="portal_backend_workspace.workspace_layout">
  <div class="pbw-eyebrow">OPERATIONS</div><h1>My Workspace</h1><p class="pbw-lead">Your authorized workspaces in one place.</p><div class="pbw-grid"><t t-foreach="sections" t-as="item"><a t-att-href="'/my/workspace/'+item['key']" class="pbw-card"><div class="pbw-card-icon"><i t-att-class="'fa '+item['icon']"/></div><h2 t-out="item['title']"/><p t-out="item['description']"/><span>Open workspace <i class="fa fa-arrow-right"/></span></a></t></div>
 </t></template>
 <template id="workspace_records" name="Workspace Records"><t t-call="portal_backend_workspace.workspace_layout">
  <div class="pbw-eyebrow">WORKSPACE</div><div class="pbw-section-head"><div><h1 t-out="section['title']"/><p class="pbw-lead" t-out="section['description']"/></div><a t-att-href="'/my/workspace/'+section['key']+'/new'" class="pbw-action">+ New</a></div>
  <div class="pbw-table-wrap"><table class="pbw-table"><thead><tr><t t-foreach="columns" t-as="column"><th t-out="column"/></t></tr></thead><tbody><t t-foreach="items" t-as="item"><tr t-att-data-url="'/my/workspace/'+section['key']+'/record/'+str(item['id'])"><t t-foreach="item['cells']" t-as="cell"><td><a t-att-href="'/my/workspace/'+section['key']+'/record/'+str(item['id'])" t-out="cell"/></td></t></tr></t><t t-if="not items"><tr><td t-att-colspan="len(columns)">No records found in your company.</td></tr></t></tbody></table></div><p class="pbw-footnote">Showing up to 50 recent records from your company. Advanced workflows are still being migrated.</p>
 </t></template>
 <template id="workspace_record" name="Workspace Record"><t t-call="portal_backend_workspace.workspace_layout">
  <a class="pbw-back" t-att-href="'/my/workspace/'+section['key']"><i class="fa fa-arrow-left"/> Back to <t t-out="section['title']"/></a><h1 t-out="record_title"/><div class="pbw-table-wrap"><table class="pbw-table"><tbody><t t-foreach="properties" t-as="prop"><tr><th t-out="prop['label']"/><td t-out="prop['value']"/></tr></t></tbody></table></div><p class="pbw-footnote">Read-only detail view in this development build.</p>
 </t></template>
 <template id="workspace_new" name="New Workspace Document"><t t-call="portal_backend_workspace.workspace_layout">
  <a class="pbw-back" t-att-href="'/my/workspace/'+section['key']"><i class="fa fa-arrow-left"/> Back to <t t-out="section['title']"/></a><h1>Create <t t-out="section['title']"/> record</h1><div class="pbw-form-wrap"><form t-att-action="'/my/workspace/'+section['key']+'/create'" method="POST"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
  <t t-if="section['key'] == 'hr'"><label>Employee name *</label><input type="text" name="name" required="required" maxlength="200"/><label>Work email</label><input type="email" name="work_email"/></t>
  <t t-else=""><label t-out="'Customer *' if section['key']=='sales' else 'Vendor / Partner *'"/><select name="partner_id" required="required"><option value="">Select partner</option><t t-foreach="partners" t-as="partner"><option t-att-value="partner.id" t-out="partner.name"/></t></select><t t-if="section['key']=='accounting'"><label>Document type *</label><select name="move_type" required="required"><option value="in_invoice">Vendor bill</option><option value="out_invoice">Customer invoice</option></select></t></t>
  <p class="pbw-footnote">Creates a draft record only. Product lines, posting, approvals and advanced document editing are not included in this development build.</p><button type="submit" class="pbw-action">Create draft</button></form></div>
 </t></template>
</odoo>
