<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Allow HR administrators to link an existing Portal user to an Employee.
         This does not change the account into an internal user. -->
    <record id="view_employee_form_allow_portal_related_user" model="ir.ui.view">
        <field name="name">hr.employee.form.allow.portal.related.user.pbw</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']//field[@name='user_id']" position="replace">
                <field name="user_id"
                       string="Related User"
                       widget="many2one_avatar_user"
                       domain="[]"
                       context="{'default_create_employee_id': id}"/>
            </xpath>
        </field>
    </record>
</odoo>
