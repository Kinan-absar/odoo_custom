<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
 <t t-name="portal_backend_workspace.foundation__MaterialRequestListView" t-inherit="web.ListView" t-inherit-mode="primary">
  <xpath expr="//Layout/t[@t-component]" position="before"><MaterialRequestDashboard context="props.context" baseDomain="props.domain" revision="cardRevision"/></xpath>
 </t>
 <t t-name="portal_backend_workspace.foundation__MaterialRequestDashboard"><section class="absar-backend-filter-bar" aria-label="List filters">
  <div class="absar-filter-cards">
    <button t-foreach="data.cards" t-as="card" t-key="card.key" type="button"
      t-att-class="'absar-filter-card absar-color-' + (card.style || 'neutral') + ' ' + (isActive(card) ? 'is-active' : '')"
      t-att-aria-pressed="isActive(card) ? 'true' : 'false'" t-on-click="() => this.selectCard(card)"><span t-out="card.label"/><span class="absar-filter-count" t-out="card.count === null ? '…' : card.count"/></button>
  </div>
  <div class="absar-filter-inputs">
    <label t-foreach="inputs" t-as="input" t-key="input.key"><t t-out="input.label"/>
      <input class="form-control" t-att-type="input.type || 'search'" t-att-placeholder="input.placeholder || input.label"
        t-att-value="inputValue(input.key)" t-on-change="ev => this.applyInput(input, ev.target.value)"/>
    </label>
  </div>
</section></t>
</templates>
