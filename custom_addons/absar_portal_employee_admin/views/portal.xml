<odoo>
 <template id="navigation" inherit_id="employee_portal_suite.employee_portal_layout" name="Employee Admin Navigation">
  <xpath expr="//div[@id='ep-section-approvals']" position="after">
   <div t-if="(request.env.user.has_group('employee_portal_suite.group_employee_portal_admin') or request.env.user.has_group('employee_portal_suite.group_employee_portal_superadmin')) and (request.env.user.has_group('absar_portal_employee_admin.group_employee_admin') or request.env.user.has_group('absar_portal_employee_admin.group_payroll_admin'))" class="ep-sidebar-section" id="ep-section-employee-admin"><div class="ep-sidebar-section-title">Employee Admin</div><div class="ep-sidebar-section-links"><a href="/my/employee/admin" class="ep-sidebar-link"><i class="fa fa-users"/> Employee Admin</a></div></div>
  </xpath>
  <xpath expr="//div[@class='ep-dropdown-menu' and @id='app-d']/parent::div" position="after">
   <a t-if="(request.env.user.has_group('employee_portal_suite.group_employee_portal_admin') or request.env.user.has_group('employee_portal_suite.group_employee_portal_superadmin')) and (request.env.user.has_group('absar_portal_employee_admin.group_employee_admin') or request.env.user.has_group('absar_portal_employee_admin.group_payroll_admin'))" class="ep-sub-link" href="/my/employee/admin">Employee Admin</a>
  </xpath>
 </template>
 <template id="header"><header class="aea-header"><div class="aea-workspace-brand"><span class="aea-workspace-icon"><i class="fa fa-users" aria-hidden="true"/></span><div><strong>Employee Admin</strong><small t-out="company.name"/></div></div><nav aria-label="Employee Admin"><a t-att-class="'active' if not kind else ''" t-att-href="base + '?company_id=%s' % company.id">Overview</a><a t-foreach="nav" t-as="item" t-att-class="'active' if item[0] == kind else ''" t-att-href="base + '/' + item[0] + '?company_id=%s' % company.id" t-out="item[1]"/></nav></header></template>
 <template id="tokens"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="company_id" t-att-value="company.id"/><input type="hidden" name="version" t-att-value="version"/></template>
 <template id="home" name="Employee Admin Dashboard"><t t-call="employee_portal_suite.employee_portal_layout"><section class="aea"><t t-call="absar_portal_employee_admin.header"/><div class="aea-heading"><div><h2>Employee Administration</h2><p>Manage your team, attendance and payroll from one workspace.</p></div><form method="get"><select name="company_id" class="form-select" aria-label="Company"><option t-foreach="companies" t-as="c" t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/></select><button class="btn btn-primary">Switch Company</button></form></div><div class="aea-cards"><a t-foreach="cards" t-as="card" t-att-href="card['url']"><span t-out="card['title']"/><strong t-out="card['count']"/><small>Open →</small></a></div></section></t></template>
 <template id="listing" name="Employee Admin List"><t t-call="employee_portal_suite.employee_portal_layout"><section class="aea"><t t-call="absar_portal_employee_admin.header"/><div class="aea-heading"><h2 t-out="title"/><a class="btn btn-primary" t-att-href="base + '/' + kind + '/new?company_id=%s' % company.id">New</a></div>
  <form class="aea-filters" method="get"><input type="search" name="q" class="form-control" t-att-value="q" placeholder="Search…" aria-label="Search records"/><select name="company_id" class="form-select" aria-label="Company"><option t-foreach="companies" t-as="c" t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/></select><select name="state" class="form-select" aria-label="Status"><option value="">All statuses</option><option t-foreach="states" t-as="st" t-att-value="st[0]" t-att-selected="state == st[0]" t-out="st[1]"/></select><label t-if="kind != 'employees'" class="aea-date-filter">From<input type="date" class="form-control" name="date_from" t-att-value="date_from"/></label><label t-if="kind != 'employees'" class="aea-date-filter">To<input type="date" class="form-control" name="date_to" t-att-value="date_to"/></label><button class="btn btn-primary">Apply</button><a class="btn btn-outline-secondary" t-att-href="base + '/' + kind + '?company_id=%s' % company.id">Clear</a></form>
  <p class="aea-help"><t t-out="total"/> records · Page <t t-out="page"/> of <t t-out="pages"/></p>
  <div class="aea-list" t-att-style="'--aea-columns:%s' % len(headers)"><div class="aea-list-head"><span t-foreach="headers" t-as="head" t-out="head"/></div><a t-foreach="rows" t-as="row" class="aea-record" t-att-href="row['url']"><span t-foreach="row['cells']" t-as="cell" t-att-title="cell" t-att-data-label="headers[cell_index]" t-out="cell"/></a><p t-if="not rows" class="aea-empty">No records match these filters.</p></div>
  <nav class="aea-pager"><a t-if="page &gt; 1" t-att-href="previous_url">← Previous</a><span>Page <t t-out="page"/> / <t t-out="pages"/></span><a t-if="page &lt; pages" t-att-href="next_url">Next →</a></nav>
 </section></t></template>
 <template id="field"><div t-att-class="'aea-field aea-field-' + item['name']"><label t-att-for="'aea-' + item['name']" t-out="item['label']"/>
  <input t-if="item['type'] == 'boolean'" type="checkbox" value="1" t-att-name="item['name']" t-att-id="'aea-' + item['name']" t-att-checked="item['value']"/>
  <details t-elif="item['type'] == 'many2many'" class="aea-multiselect" data-aea-picker="1"><summary class="form-select" t-att-id="'aea-' + item['name']" t-att-aria-label="item['label']"><span data-aea-selection="1"><t t-out="', '.join(str(opt[1]) for opt in item['options'] if opt[0] in item['value']) or 'Select…'"/></span></summary><div class="aea-picker-menu"><input type="search" class="form-control aea-picker-search" placeholder="Search…" t-att-aria-label="'Search ' + item['label']"/><div class="aea-picker-options"><label t-foreach="item['options']" t-as="opt" class="aea-picker-option"><input type="checkbox" t-att-name="item['name']" t-att-value="opt[0]" t-att-checked="opt[0] in item['value']"/><span t-out="opt[1]"/></label><p t-if="not item['options']" class="aea-help">No options available.</p></div></div></details>
  <select t-elif="item['type'] in ('many2one','selection')" class="form-select" t-att-name="item['name']" t-att-id="'aea-' + item['name']" t-att-required="item['required']"><option value="">Select…</option><option t-foreach="item['options']" t-as="opt" t-att-value="opt[0]" t-att-selected="str(opt[0]) == str(item['value'])" t-out="opt[1]"/></select>
  <textarea t-elif="item['type'] in ('text','html')" class="form-control" rows="3" t-att-name="item['name']" t-att-id="'aea-' + item['name']" t-att-required="item['required']" t-out="item['value']"/>
  <input t-else="" class="form-control" t-att-type="'datetime-local' if item['type'] == 'datetime' else 'date' if item['type'] == 'date' else 'number' if item['type'] in ('float','monetary','integer') else 'text'" t-att-step="'1' if item['type'] in ('datetime','integer') else 'any'" t-att-name="item['name']" t-att-id="'aea-' + item['name']" t-att-value="item['value']" t-att-required="item['required']"/>
 </div></template>
 <template id="operation"><form class="aea-operation" method="post" t-att-action="record_url + '/action'" t-att-data-confirm="confirm_text or None"><t t-call="absar_portal_employee_admin.tokens"/><input type="hidden" name="operation" t-att-value="operation"/><t t-if="operation == 'validate' and kind == 'payslips' or operation == 'validate-batch'"><label class="aea-check"><input type="checkbox" name="confirm_action" value="1" required="required"/> I reviewed the payslip(s) and approve validation.</label></t><button class="btn btn-outline-primary" t-out="label"/></form></template>
 <template id="detail" name="Employee Admin Detail"><t t-call="employee_portal_suite.employee_portal_layout"><section class="aea"><t t-call="absar_portal_employee_admin.header"/><a t-att-href="back_url" data-aea-discard="1">← Back to List</a><div class="aea-heading"><h2><t t-out="rec.name if rec and 'name' in rec._fields else title"/><t t-if="not rec"> · New</t></h2><span t-if="rec and 'state' in rec._fields" class="aea-badge" t-out="rec.state"/></div>
  <p t-if="notice" class="alert alert-info" role="status" t-out="notice"/>
  <div t-if="rec" class="aea-actions">
   <a t-if="kind in ('payslips','salary-reports')" class="btn btn-outline-secondary" t-att-href="record_url + '/print?company_id=%s' % company.id" target="_blank" rel="noopener">Print PDF</a>
   <a t-if="kind == 'salary-reports'" class="btn btn-outline-secondary" t-att-href="record_url + '/xlsx?company_id=%s' % company.id">Export Excel</a>
   <a t-if="kind == 'batches' and admin_can_edit" class="btn btn-primary" t-att-href="base + '/payslips/new?company_id=%s&amp;batch_id=%s' % (company.id,rec.id)">Add Payslip</a>
   <t t-if="kind == 'batches' and rec.state in ('draft','verify')"><t t-foreach="[('compute-batch','Compute Payslips'),('validate-batch','Validate Payslips')]" t-as="op"><t t-set="operation" t-value="op[0]"/><t t-set="label" t-value="op[1]"/><t t-set="confirm_text" t-value="'Process all editable payslips in this batch?'"/><t t-call="absar_portal_employee_admin.operation"/></t></t>
   <t t-if="kind == 'attendance' and rec.attendance_exception_state == 'pending' and (rec.auto_checked_out or rec.checkout_outside_location)"><t t-set="operation" t-value="'resolve'"/><t t-set="label" t-value="'Mark Exception Resolved'"/><t t-set="confirm_text" t-value="''"/><t t-call="absar_portal_employee_admin.operation"/></t>
   <t t-if="kind == 'contracts' and rec.state in ('draft','open')"><t t-set="operation" t-value="'start' if rec.state == 'draft' else 'close'"/><t t-set="label" t-value="'Start Contract' if rec.state == 'draft' else 'Close Contract'"/><t t-set="confirm_text" t-value="'Change the contract status?'"/><t t-call="absar_portal_employee_admin.operation"/></t>
   <t t-if="kind == 'work-entries' and admin_can_edit"><t t-set="operation" t-value="'validate'"/><t t-set="label" t-value="'Validate Work Entry'"/><t t-set="confirm_text" t-value="''"/><t t-call="absar_portal_employee_admin.operation"/></t>
   <t t-if="kind == 'payslips' and admin_can_edit"><t t-foreach="[('compute','Compute Sheet'),('cancel','Cancel Payslip')]" t-as="op"><t t-set="operation" t-value="op[0]"/><t t-set="label" t-value="op[1]"/><t t-set="confirm_text" t-value="'Cancel this unfinalized payslip?' if op[0] == 'cancel' else ''"/><t t-call="absar_portal_employee_admin.operation"/></t><t t-if="rec.state == 'verify'"><t t-set="operation" t-value="'validate'"/><t t-set="label" t-value="'Validate Payslip'"/><t t-set="confirm_text" t-value="'Validate this reviewed payslip using the native payroll workflow?'"/><t t-call="absar_portal_employee_admin.operation"/></t></t>
   <t t-if="kind == 'salary-reports' and admin_can_edit"><t t-set="operation" t-value="'create-batch' if rec.line_ids else 'generate'"/><t t-set="label" t-value="'Create Payroll Batch' if rec.line_ids else 'Generate Report'"/><t t-set="confirm_text" t-value="'Create computed payslips for this report? Review their inputs before validation.' if rec.line_ids else ''"/><t t-call="absar_portal_employee_admin.operation"/></t>
  </div>
  <form class="aea-edit-form" method="post" t-att-action="form_url" data-aea-edit="1" t-att-data-aea-kind="kind"><t t-call="absar_portal_employee_admin.tokens"/><div class="aea-actions"><button t-if="admin_can_edit and not (kind == 'salary-reports' and rec and rec.line_ids)" class="btn btn-primary">Save</button><a class="btn btn-outline-secondary" t-att-href="back_url" data-aea-discard="1">Cancel</a></div><fieldset t-att-disabled="not admin_can_edit or kind == 'salary-reports' and rec and rec.line_ids"><div class="aea-form-sheet"><section t-if="groups" class="aea-form-overview"><h3 t-out="groups[0][0]"/><div class="aea-fields"><t t-foreach="groups[0][1]" t-as="item"><t t-call="absar_portal_employee_admin.field"/></t></div></section><div t-if="len(groups) &gt; 1" class="aea-notebook" data-aea-notebook="1"><div class="aea-form-tabs" role="tablist" aria-label="Form sections" hidden="hidden"><button t-foreach="groups[1:]" t-as="group" type="button" role="tab" t-att-id="'aea-tab-%s' % group_index" t-att-data-aea-tab="'aea-panel-%s' % group_index" t-att-aria-controls="'aea-panel-%s' % group_index" t-out="group[0]"/></div><section t-foreach="groups[1:]" t-as="group" class="aea-tab-panel" role="tabpanel" t-att-id="'aea-panel-%s' % group_index" t-att-aria-labelledby="'aea-tab-%s' % group_index"><h3 t-out="group[0]"/><div class="aea-fields"><t t-foreach="group[1]" t-as="item"><t t-call="absar_portal_employee_admin.field"/></t></div></section></div></div><section t-if="kind == 'attendance' and admin_can_edit" class="aea-sheet"><label for="aea-reason">Reason for this entry or correction</label><textarea id="aea-reason" class="form-control" name="reason" rows="2" required="required"/></section></fieldset></form>
  <p t-if="kind in ('attendance','work-entries')" class="aea-help">Dates and times use your user timezone: <t t-out="tz"/>. Existing geolocation history is retained.</p>
  <section t-if="attendance_info" class="aea-sheet"><h3>Recorded Attendance Information</h3><dl class="aea-facts"><div t-foreach="attendance_info" t-as="fact"><dt t-out="fact[0]"/><dd t-out="fact[1]"/></div></dl></section>
  <section t-if="totals" class="aea-sheet"><h3>Calculated Totals</h3><dl class="aea-facts"><div t-foreach="totals" t-as="total"><dt t-out="total[0]"/><dd t-out="total[1]"/></div></dl></section>
  <section t-foreach="tables" t-as="table" class="aea-sheet"><h3 t-out="table['title']"/><div class="aea-table-wrap"><table class="aea-table"><thead><tr><th t-foreach="table['headers']" t-as="head" t-out="head"/></tr></thead><tbody><tr t-foreach="table['rows']" t-as="row"><td t-foreach="row" t-as="cell" t-att-data-label="table['headers'][cell_index]" t-out="cell"/></tr></tbody></table></div></section>
  <section t-if="rec and kind == 'payslips'" class="aea-sheet"><h3>Other Inputs</h3><p class="aea-help">After saving an input, use Compute Sheet to update the salary rules and totals.</p><t t-foreach="adjustments" t-as="line"><form class="aea-adjustment" method="post" t-att-action="record_url + '/line'"><t t-call="absar_portal_employee_admin.tokens"/><input type="hidden" name="line_id" t-att-value="line['id']"/><select name="input_type_id" class="form-select" aria-label="Input Type" t-att-disabled="not admin_can_edit"><option t-foreach="input_types" t-as="typ" t-att-value="typ.id" t-att-selected="typ.id == line['input_type_id']" t-out="typ.name"/></select><input name="name" class="form-control" aria-label="Description" t-att-value="line['name']" t-att-disabled="not admin_can_edit"/><input name="amount" type="number" step="any" class="form-control" aria-label="Amount" t-att-value="line['amount']" t-att-disabled="not admin_can_edit"/><button t-if="admin_can_edit" class="btn btn-outline-primary">Save Input</button></form></t>
   <form t-if="admin_can_edit" class="aea-adjustment" method="post" t-att-action="record_url + '/line'"><t t-call="absar_portal_employee_admin.tokens"/><select name="input_type_id" required="required" class="form-select" aria-label="New Input Type"><option value="">Select input type…</option><option t-foreach="input_types" t-as="typ" t-att-value="typ.id" t-out="typ.name"/></select><input name="name" class="form-control" aria-label="New Input Description" placeholder="Description"/><input name="amount" type="number" step="any" class="form-control" required="required" aria-label="New Input Amount" placeholder="Amount"/><button class="btn btn-primary">Add Input</button></form>
  </section>
  <section t-if="rec and kind == 'salary-reports'" class="aea-sheet"><h3>Salary Report Adjustments</h3><p class="aea-help">These are attendance-based estimates. Payroll payslips follow the configured salary rules; review their inputs before validation.</p><form t-foreach="adjustments" t-as="line" class="aea-report-adjustment" method="post" t-att-action="record_url + '/line'"><t t-call="absar_portal_employee_admin.tokens"/><input type="hidden" name="line_id" t-att-value="line['id']"/><strong t-out="line['name']"/><label>Manual Absent Days<input class="form-control" name="manual_absent_days" type="number" min="0" step="any" t-att-value="line['manual_absent_days']" t-att-disabled="not admin_can_edit"/></label><label>Other Deductions<input class="form-control" name="other_deductions" type="number" min="0" step="any" t-att-value="line['other_deductions']" t-att-disabled="not admin_can_edit"/></label><label>Reimbursements<input class="form-control" name="reimbursements" type="number" min="0" step="any" t-att-value="line['reimbursements']" t-att-disabled="not admin_can_edit"/></label><button t-if="admin_can_edit" class="btn btn-outline-primary">Save Adjustment</button></form><a t-if="rec.employee_admin_batch_id" t-att-href="base + '/batches/%s?company_id=%s' % (rec.employee_admin_batch_id.id,company.id)">Open Payroll Batch →</a></section>
  <section t-if="rec and kind == 'batches'" class="aea-sheet"><h3>Batch Payslips</h3><a class="aea-slip-link" t-foreach="slips" t-as="slip" t-att-href="slip['url']"><strong t-out="slip['cells'][1]"/><span t-out="slip['cells'][0]"/><span t-out="slip['cells'][5]"/><span t-out="slip['cells'][6]"/></a><p t-if="not slips" class="aea-help">No payslips yet. Add a payslip or generate a batch from a salary report.</p></section>
  <section t-if="audit" class="aea-sheet"><h3>Administration History</h3><article t-foreach="audit" t-as="entry" class="aea-audit"><strong t-out="entry.actor_id.name"/> · <span t-out="entry.create_date"/> · <span t-out="entry.operation"/><p t-out="entry.detail or ''"/></article></section>
 </section></t></template>
</odoo>
