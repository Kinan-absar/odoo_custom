<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="purchase_form_native_presentation" model="ir.ui.view">
    <field name="name">purchase.order.form.portal.native.presentation</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <!--Presentation groups are adapted on the resolved native architecture; no numbered or group-dependent XPath.--><xpath expr="//form" position="attributes"><attribute name="class" add="absar_native_purchase_form" separator=" "/></xpath></field>
  </record>
  <record id="material_request_list_native_purchase" model="ir.ui.view">
    <field name="name">material.request.list.portal.purchase</field>
    <field name="model">material.request</field>
    <field name="inherit_id" ref="employee_portal_suite.view_material_request_list"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="can_create_po" column_invisible="True"/>
        <button name="action_create_po" type="object" string="Create PO" groups="absar_portal_purchase_monitor.group_portal_purchase_native,absar_portal_purchase_monitor.group_portal_purchase_preparer" invisible="not can_create_po"/>
      </xpath>
    </field>
  </record>
<record id="product_form_native_presentation" model="ir.ui.view"><field name="name">product.template.form.portal.native.presentation</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_form_view"/><field name="arch" type="xml"><!--Presentation groups are adapted on the resolved native architecture; no numbered or group-dependent XPath.--><xpath expr="//form" position="attributes"><attribute name="class" add="absar_native_product_form" separator=" "/></xpath></field></record></odoo>
