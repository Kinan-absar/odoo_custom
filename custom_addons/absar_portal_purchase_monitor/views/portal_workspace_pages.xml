<odoo>
 <template id="purchase_workspace_nav" name="Purchase Portal Navigation">
  <header class="apw-workspace-header" t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer') or request.env.user.has_group('customer_vendor_portal.group_vendor_invoice_reviewer')"><div class="apw-workspace-brand"><span class="apw-workspace-icon"><i class="fa fa-shopping-cart" aria-hidden="true"/></span><div><strong>Purchase</strong><small t-out="request.env.company.name"/></div></div><nav class="apw-app-nav" aria-label="Purchase workspace">
   <a t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')" href="/my/employee/purchase" t-att-class="'active' if request.httprequest.path in ['/my/employee/purchase', '/my/employee/purchase/new'] else ''">Draft Purchase Orders</a>
   <a t-att-class="'active' if request.httprequest.path.endswith('/orders') else ''" t-att-href="'/my/employee/purchase-monitor' if request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_monitor') else '/my/employee/purchase/orders'" t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')">Purchase Orders</a>
   <a href="/my/employee/purchase/products" t-att-class="'active' if request.httprequest.path.endswith('/products') else ''" t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')">Products</a>
   <a t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_approver')" href="/my/employee/purchase/approvals">Approvals</a>
   <a t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_admin') or request.env.user.has_group('employee_portal_suite.group_employee_portal_superadmin')" href="/my/employee/purchase/request-control">ER &amp; MR Admin Control</a>
   <a href="/my/employee/purchase/vendor-invoices" t-if="request.env.user.has_group('customer_vendor_portal.group_vendor_invoice_reviewer')" t-att-class="'active' if request.httprequest.path.startswith('/my/employee/purchase/vendor-invoices') else ''">Vendor Invoice Review</a></nav>
 </header></template>
 <template id="purchase_product_directory" name="Portal Purchasing Products">
  <t t-call="employee_portal_suite.employee_portal_layout"><section class="apw-shell" id="apw-products" t-att-data-company-id="company.id">
   <t t-call="absar_portal_purchase_monitor.purchase_workspace_nav"/>
   <div class="apw-heading"><div><p class="apw-eyebrow">Purchase / Products</p><h2>Products</h2><p>Purchasing products available to your company</p></div><button t-if="can_create" type="button" class="btn btn-primary" data-product-new="1">New Product</button></div>
   <div role="alert" class="alert alert-danger" hidden="hidden"/>
   <form class="apw-toolbar" method="get"><input name="q" class="form-control apw-search" placeholder="Search product or internal reference" aria-label="Search products" t-att-value="q"/>
    <select name="company_id" class="form-select" aria-label="Company"><t t-foreach="companies" t-as="c"><option t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/></t></select><button class="btn btn-primary">Search</button><a href="/my/employee/purchase/products" class="btn btn-light">Clear</a></form>
   <div class="absar-record-list absar-column-list absar-layout-products" aria-label="Products"><div class="absar-list-header" aria-hidden="true"><span>Product</span><span>Internal Reference</span><span>Type</span><span>Purchase Unit</span><span>Company</span></div><article t-foreach="records" t-as="product" class="absar-record-card" role="button" tabindex="0" t-att-data-product-open="product.id" t-att-aria-label="'Open ' + product.name"><div class="absar-list-cell" data-mobile-label="Product" t-att-title="product.name"><strong class="absar-record-number" t-out="product.name" t-att-title="product.description_purchase or product.name"/></div><div class="absar-list-cell" data-mobile-label="Internal Reference"><span><t t-out="product.default_code or '—'"/></span></div><div class="absar-list-cell" data-mobile-label="Type" t-att-title="'Service' if product.type == 'service' else 'Goods'"><span class="absar-record-badge" t-out="'Service' if product.type == 'service' else 'Goods'"/></div><div class="absar-list-cell" data-mobile-label="Purchase Unit"><span><t t-out="product.uom_po_id.display_name"/></span></div><div class="absar-list-cell" data-mobile-label="Company" t-att-title="product.company_id.name or 'Shared'"><span t-out="product.company_id.name or 'Shared'"/></div></article><div t-if="not records" class="absar-record-empty">No products match your search.</div></div><t t-call="absar_portal_purchase_monitor.purchase_pager"/>
   <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
  </section></t>
 </template>
 <template id="purchase_mr_directory" name="Material Requests Moved to Control">
  <t t-call="employee_portal_suite.employee_portal_layout"><section class="apw-shell"><a href="/my/employee/purchase/request-control/mr">Open ER &amp; MR Admin Control</a></section></t>
 </template>
</odoo>
