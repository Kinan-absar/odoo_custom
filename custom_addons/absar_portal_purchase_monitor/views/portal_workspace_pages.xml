<odoo>
 <template id="purchase_workspace_nav" name="Purchase Portal Navigation">
  <header class="apw-workspace-header" t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')"><div class="apw-workspace-brand"><span class="apw-workspace-icon"><i class="fa fa-shopping-cart" aria-hidden="true"/></span><div><strong>Purchase</strong><small t-out="request.env.company.name"/></div></div><nav class="apw-app-nav" aria-label="Purchase workspace">
   <a t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')" href="/my/employee/purchase" t-att-class="'active' if request.httprequest.path in ['/my/employee/purchase', '/my/employee/purchase/new'] else ''">Draft Purchase Orders</a>
   <a t-att-class="'active' if request.httprequest.path.endswith('/orders') else ''" t-att-href="'/my/employee/purchase-monitor' if request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_monitor') else '/my/employee/purchase/orders'">Purchase Orders</a>
   <a href="/my/employee/purchase/products" t-att-class="'active' if request.httprequest.path.endswith('/products') else ''">Products</a>
   <a t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')" href="/my/employee/purchase/material-requests" t-att-class="'active' if request.httprequest.path.endswith('/material-requests') else ''">Material Requests</a>
   <a t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_approver')" href="/my/employee/purchase/approvals">Approvals</a>
   </nav>
 </header></template>
 <template id="purchase_product_directory" name="Portal Purchasing Products">
  <t t-call="employee_portal_suite.employee_portal_layout"><section class="apw-shell" id="apw-products" t-att-data-company-id="company.id">
   <t t-call="absar_portal_purchase_monitor.purchase_workspace_nav"/>
   <div class="apw-heading"><div><p class="apw-eyebrow">Purchase / Products</p><h2>Products</h2><p>Purchasing products available to your company</p></div><button t-if="can_create" type="button" class="btn btn-primary" data-product-new="1">New Product</button></div>
   <div role="alert" class="alert alert-danger" hidden="hidden"/>
   <form class="apw-toolbar" method="get"><input name="q" class="form-control apw-search" placeholder="Search product or internal reference" aria-label="Search products" t-att-value="q"/>
    <select name="company_id" class="form-select" aria-label="Company"><t t-foreach="companies" t-as="c"><option t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/></t></select><button class="btn btn-primary">Search</button><a href="/my/employee/purchase/products" class="btn btn-light">Clear</a></form>
   <div class="absar-record-list" aria-label="Products"><article t-foreach="records" t-as="product" class="absar-record-card" role="button" tabindex="0" t-att-data-product-open="product.id" t-att-aria-label="'Open ' + product.name"><div class="absar-record-main"><strong class="absar-record-number" t-out="product.name"/><span t-if="product.description_purchase" t-out="product.description_purchase"/><div class="absar-record-meta"><span>Reference: <t t-out="product.default_code or '—'"/></span><span>Purchase Unit: <t t-out="product.uom_po_id.display_name"/></span><span t-out="product.company_id.name or 'Shared'"/></div></div><div class="absar-record-side"><span class="absar-record-badge" t-out="'Service' if product.type == 'service' else 'Goods'"/></div></article><div t-if="not records" class="absar-record-empty">No products match your search.</div></div><t t-call="absar_portal_purchase_monitor.purchase_pager"/>
   <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
  </section></t>
 </template>
 <template id="purchase_mr_directory" name="Approved Material Requests for Purchasing">
  <t t-call="employee_portal_suite.employee_portal_layout"><section class="apw-shell">
   <t t-call="absar_portal_purchase_monitor.purchase_workspace_nav"/>
   <div class="apw-heading"><div><p class="apw-eyebrow">Purchase / Material Requests</p><h2>Material Requests</h2><p>Approved requests requiring a PO, in the selected company</p></div></div>
   <form class="apw-toolbar" method="get"><input class="form-control apw-search" name="q" t-att-value="q" placeholder="Search MR or project" aria-label="Search Material Requests"/>
    <select name="company_id" class="form-select" aria-label="Company"><t t-foreach="companies" t-as="c"><option t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/></t></select><button class="btn btn-primary">Search</button><a href="/my/employee/purchase/material-requests" class="btn btn-light">Clear</a></form>
   <div class="absar-record-list" aria-label="Material requests"><article t-foreach="records" t-as="mr" class="absar-record-card" role="link" tabindex="0" t-att-data-record-href="'/my/employee/purchase/new?mr_id=%s' % mr.id" t-att-aria-label="'Prepare Purchase Order from ' + mr.name"><div class="absar-record-main"><strong class="absar-record-number" t-out="mr.name"/><div class="absar-record-party" t-out="mr.project_id.display_name"/><div class="absar-record-meta"><span>Requested by: <t t-out="mr.employee_id.name"/></span><span>Required: <t t-out="mr.delivery_date or '—'"/></span><span>Existing POs: <t t-out="mr.po_name or '—'"/></span></div><details><summary t-out="'%s materials' % len(mr.line_ids)"/><ul class="apw-mr-materials"><li t-foreach="mr.line_ids" t-as="line"><span t-out="line.item_name"/> · <strong t-out="line.qty_required"/> <t t-out="line.uom_id.display_name or ''"/></li></ul></details></div><div class="absar-record-side"><span class="absar-record-badge">Prepare Purchase Order</span></div></article><div t-if="not records" class="absar-record-empty">No approved Material Requests are available in this company.</div></div><t t-call="absar_portal_purchase_monitor.purchase_pager"/>
  </section></t>
 </template>
</odoo>
