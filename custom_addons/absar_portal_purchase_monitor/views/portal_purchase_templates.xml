<odoo>
 <template id="purchase_monitor_list" name="Purchase Monitoring List">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container apm-shell my-4">
    <t t-if="show_workspace" t-call="absar_portal_purchase_monitor.purchase_workspace_nav"/><div class="apm-title"><div><h2 t-out="title"/><p t-out="description"/></div><span class="apm-count"><t t-out="total"/> POs</span></div>
    <form method="get" class="apm-filter" t-att-action="list_url">
     <input type="search" name="q" t-att-value="q" placeholder="Search PO, supplier, or origin..." class="form-control"/>
     <select name="status" class="form-select">
      <option value="all" t-att-selected="status == 'all'">All confirmed</option>
      <option value="purchase" t-att-selected="status == 'purchase'">Purchase orders</option>
      <option value="done" t-att-selected="status == 'done'">Locked / Done</option>
     </select>
     <button type="submit" class="btn btn-primary">Search</button>
     <a class="btn btn-light" t-att-href="list_url">Clear</a>
    </form>
    <div class="absar-record-list" aria-label="Purchase orders">
     <article t-foreach="rows" t-as="r" class="absar-record-card" role="link" tabindex="0" t-att-data-record-href="'%s/%d' % (detail_base_url,r['po'].id)" t-att-aria-label="'Open ' + r['po'].name">
      <div class="absar-record-main"><span class="absar-record-number" t-out="r['po'].name"/><div class="absar-record-party" t-out="r['po'].partner_id.name"/>
       <div class="absar-record-meta"><span>Project: <t t-out="r['project']"/></span><span>MR: <t t-out="r['mr']"/></span><span>Buyer: <t t-out="(r['po'].absar_portal_preparer_id or r['po'].user_id).name or '—'"/></span><span t-out="r['po'].date_order.date() if r['po'].date_order else ''"/></div>
       <div class="absar-record-metrics"><div class="absar-record-metric"><span class="absar-record-caption">Invoiced</span><strong t-out="'{:,.2f}'.format(r['billed'])"/></div><div class="absar-record-metric"><span class="absar-record-caption">Bill Settlement*</span><strong t-out="'{:,.2f}'.format(r['settled'])"/></div><div class="absar-record-metric"><span class="absar-record-caption">Balance Due*</span><strong t-out="'{:,.2f}'.format(r['due'])"/></div></div>
      </div><div class="absar-record-side"><span class="absar-record-caption">Total including VAT</span><strong class="absar-record-value"><t t-out="'{:,.2f}'.format(r['po'].amount_total)"/> <t t-out="r['po'].currency_id.name"/></strong><span class="absar-record-badge" t-out="r['signature']"/></div>
     </article><div t-if="not rows" class="absar-record-empty">No confirmed purchase orders match these filters.</div>
    </div>
    <div class="apm-footer"><p>* Paid and due are derived from posted vendor bills; shared-bill payments are proportionally estimated. Figures include VAT and may differ from payment-voucher allocations.</p>
     <div class="apm-pages"><a t-if="page &gt; 1" t-att-href="previous_url">← Previous</a><span>Page <t t-out="page"/> of <t t-out="pages"/></span><a t-if="page &lt; pages" t-att-href="next_url">Next →</a></div>
    </div>
   </div>
  </t>
 </template>
 <template id="purchase_monitor_detail" name="Purchase Monitoring Detail">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container apm-shell my-4">
    <a href="/my/employee/purchase-monitor" class="apm-back">← Purchase Monitoring</a>
    <div class="apm-title"><div><h2 t-out="row['po'].name"/><p t-out="row['po'].partner_id.name"/></div><span class="apm-pill" t-out="row['signature']"/></div>
    <div class="apm-cards">
     <div><label>PO Value (incl. VAT)</label><strong t-out="'%.2f' % row['po'].amount_total"/></div>
     <div><label>Invoiced (posted)</label><strong t-out="'%.2f' % row['billed']"/></div>
     <div><label>Bill Settlement (allocated)*</label><strong t-out="'%.2f' % row['settled']"/></div>
     <div><label>Balance Due (allocated)*</label><strong t-out="'%.2f' % row['due']"/></div>
    </div>
    <div class="apm-info"><div><label>Buyer</label><span t-out="(row['po'].absar_portal_preparer_id or row['po'].user_id).name or '—'"/></div><div t-if="row['paid'] is not None"><label>PO-linked Paid</label><span t-out="'%.2f' % row['paid']"/></div><div><label>Project</label><span t-out="row['project']"/></div><div><label>Related Material Request</label><span t-out="row['mr']"/></div><div><label>PO Status</label><span t-out="row['po'].state"/></div><div><label>Signing Status</label><span t-out="row['signature']"/></div><div><label>Not Yet Invoiced (approx.)</label><span t-out="'%.2f' % row['unbilled']"/></div><div><label>Currency</label><span t-out="row['po'].currency_id.name"/></div></div>
    <h3 class="apm-subtitle">Order Lines</h3>
    <div class="apm-table-wrap"><table class="apm-table"><thead><tr><th>Description</th><th class="apm-num">Qty</th><th class="apm-num">Unit Price</th><th class="apm-num">Subtotal</th></tr></thead><tbody>
     <t t-foreach="row['po'].order_line" t-as="l"><tr t-if="l.display_type"><td colspan="4" t-out="l.name"/></tr><tr t-if="not l.display_type"><td t-out="l.name"/><td class="apm-num" t-out="'%.2f' % l.product_qty"/><td class="apm-num" t-out="'%.2f' % l.price_unit"/><td class="apm-num" t-out="'%.2f' % l.price_subtotal"/></tr></t>
    </tbody></table></div>
    <p class="apm-note">* Payment amounts use bill-level settlement ratios, so a vendor bill covering multiple POs results in estimated PO allocations. No approval or PO modification actions are available here.</p>
   </div>
  </t>
 </template>
<template id="purchase_pager"><div class="apw-pager"><span><t t-out="total"/> records · Page <t t-out="page"/> / <t t-out="pages"/></span><div><a t-if="page &gt; 1" t-att-href="previous_url" class="btn btn-light">Previous</a><a t-if="page &lt; pages" t-att-href="next_url" class="btn btn-light">Next</a></div></div></template>
 </odoo>