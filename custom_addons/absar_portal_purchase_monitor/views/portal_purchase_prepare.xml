<odoo>
 <template id="purchase_prepare_list" name="Portal Purchase RFQs">
  <t t-call="employee_portal_suite.employee_portal_layout"><main class="apw-shell">
   <div class="apw-heading"><div><h2 t-out="'Purchase Confirmations' if confirmations else 'Purchase Approvals' if approval else 'My Purchase RFQs'"/><p t-out="'Confirm independently approved RFQs through the native purchase workflow' if confirmations else 'Review submitted RFQs without changing their contents' if approval else 'Prepare, save and submit your purchase RFQs'"/></div><a t-if="not approval and not confirmations" href="/my/employee/purchase/new" class="btn btn-primary">New RFQ</a></div>
   <form class="apw-toolbar" method="get"><input class="form-control apw-search" name="q" t-att-value="q" placeholder="Search RFQ, vendor, MR or reference" aria-label="Search RFQs"/>
    <select name="review" class="form-select" aria-label="Review status"><option value="all" t-att-selected="review == 'all'">All review statuses</option><option value="draft" t-att-selected="review == 'draft'">Draft</option><option value="submitted" t-att-selected="review == 'submitted'">Awaiting Approval</option><option value="approved" t-att-selected="review == 'approved'">Approved</option><option value="returned" t-att-selected="review == 'returned'">Returned</option></select>
    <select name="sort" class="form-select" aria-label="Sort"><option value="newest">Newest</option><option value="reference" t-att-selected="sort == 'reference'">Reference</option><option value="vendor" t-att-selected="sort == 'vendor'">Vendor</option><option value="amount" t-att-selected="sort == 'amount'">Highest amount</option><option value="date" t-att-selected="sort == 'date'">Order date</option></select><select name="group_by" class="form-select" aria-label="Group by"><option value="">No grouping</option><option value="vendor" t-att-selected="group_by == 'vendor'">Group by Vendor</option><option value="project" t-att-selected="group_by == 'project'">Group by Project</option><option value="buyer" t-att-selected="group_by == 'buyer'">Group by Buyer</option><option value="company" t-att-selected="group_by == 'company'">Group by Company</option><option value="review" t-att-selected="group_by == 'review'">Group by Review</option></select><button class="btn btn-primary">Search</button><a t-att-href="'/my/employee/purchase/confirmations' if confirmations else '/my/employee/purchase/approvals' if approval else '/my/employee/purchase'" class="btn btn-light">Clear</a>
   </form>
   <p class="apw-help" t-if="group_by">Groups follow the selected sort across the result set. A group can continue onto the next page.</p><div class="apw-table-scroll"><table class="apw-table"><thead><tr><th>Reference</th><th>Vendor</th><th>Project</th><th>MR</th><th>Buyer</th><th>Company</th><th>Review</th><th>Purchase status</th><th>Currency</th><th class="num">Total</th></tr></thead><tbody>
    <t t-set="last_group" t-value="False"/><t t-foreach="orders" t-as="po"><tr t-if="group_by and group_labels.get(po.id) != last_group"><td colspan="10" class="apw-section" t-out="group_labels.get(po.id)"/></tr><t t-set="last_group" t-value="group_labels.get(po.id)"/><tr><td><a t-att-href="'/my/employee/purchase/%s' % po.id" t-out="po.name"/></td><td t-out="po.partner_id.name"/><td t-out="po.project_id.display_name if 'project_id' in po._fields else po.absar_portal_project_id.display_name or '—'"/><td t-out="po.material_request_id.name or '—'"/><td t-out="po.user_id.name or '—'"/><td t-out="po.company_id.name"/><td><span class="apw-badge" t-out="dict(po._fields['absar_portal_review_state']._description_selection(po.env)).get(po.absar_portal_review_state, 'Draft')"/></td><td t-out="dict(po._fields['state']._description_selection(po.env)).get(po.state)"/><td t-out="po.currency_id.name"/><td class="num" t-out="'%.2f' % po.amount_total"/></tr>
    </t><tr t-if="not orders"><td colspan="10" class="apw-empty">No RFQs match your search.</td></tr>
   </tbody></table></div><t t-call="absar_portal_purchase_monitor.purchase_pager"/>
  </main></t>
 </template>
 <template id="purchase_prepare_detail" name="Purchase Workspace Editor">
  <t t-call="employee_portal_suite.employee_portal_layout"><main id="apw-root" class="apw-shell">
   <a t-att-href="boot['back_url']">← Purchase workspace</a>
   <div class="apw-heading"><div><h2 t-out="boot['name']"/><p t-out="boot['company_name']"/></div><div><span class="apw-badge" t-out="boot['review']"/> <span class="apw-badge" t-out="boot['state']"/></div></div>
   <p t-if="not boot['project_integration']" class="alert alert-warning">The backend Project integration addon is not installed. Project selection requires that addon.</p>
   <p t-if="boot['note']" class="alert alert-info"><strong>Review note: </strong><t t-out="boot['note']"/></p>
   <div id="apw-error" class="alert alert-danger" role="alert" hidden="hidden"/>
   <div id="apw-status" role="status" aria-live="polite"/>
   <div class="apw-actions">
    <t t-if="not boot['readonly']"><button class="btn btn-primary" type="button" data-action="save">Save Draft</button><button class="btn btn-outline-primary" type="button" data-action="submit">Submit for Approval</button></t>
    <t t-if="boot['can_review']"><button t-if="boot['review'] == 'submitted'" class="btn btn-primary" type="button" data-action="approve">Approve RFQ</button><button class="btn btn-outline-secondary" type="button" data-action="return">Return for Correction</button></t>
    <button t-if="boot['can_confirm']" type="button" class="btn btn-primary" data-action="confirm">Confirm PO</button>
    <span t-if="boot['readonly']" class="apw-help">Read-only · Purchase approval and signature status are separate.</span>
   </div>
   <div class="apw-sheet">
    <div class="apw-form-grid" id="apw-header"/>
    <div class="apw-tabs" role="tablist" aria-label="Purchase information"><button type="button" role="tab" aria-selected="true" data-tab="products">Products</button><button type="button" role="tab" aria-selected="false" data-tab="other">Other Information</button><button type="button" role="tab" aria-selected="false" data-tab="payments">Payments</button><button type="button" role="tab" aria-selected="false" data-tab="signing">Signing Package</button></div>
    <section data-panel="products" role="tabpanel"><div class="apw-table-scroll"><table class="apw-table apw-lines"><thead><tr><th>Product / Description</th><th>Analytic Distribution</th><th class="num">Quantity</th><th>UoM</th><th class="num">Unit Price</th><th class="num">Disc.%</th><th>Taxes</th><th class="num">Amount</th><th>Actions</th></tr></thead><tbody id="apw-lines"/></table></div>
     <div t-if="not boot['readonly']" class="apw-line-actions"><button type="button" class="btn btn-link" data-action="add">Add a product</button><button type="button" class="btn btn-link" data-action="section">Add a section</button><button type="button" class="btn btn-link" data-action="note">Add a note</button><button type="button" class="btn btn-outline-primary" data-action="catalog">Catalog</button><button t-if="boot['can_create_product']" type="button" class="btn btn-outline-secondary" data-action="product">Create Product</button></div>
     <div class="apw-footer-grid"><div><label for="apw-notes">Terms and Conditions</label><textarea id="apw-notes" class="form-control" rows="5" t-att-disabled="boot['readonly']"/><p class="apw-help">Times use <t t-out="boot['timezone']"/>. Save Draft saves the complete form and all lines.</p></div><div class="apw-totals" id="apw-totals"><p>Use Recalculate to load native tax totals.</p></div></div>
     <button t-if="not boot['readonly']" type="button" class="btn btn-light" data-action="recalculate">Recalculate totals</button>
    </section>
    <section data-panel="other" role="tabpanel" hidden="hidden"><div id="apw-other" class="apw-form-grid"/></section>
    <section data-panel="payments" role="tabpanel" hidden="hidden"><p>Financial records are read-only in this workspace.</p><t t-if="po and po.state in ('purchase', 'done')"><p t-if="'amount_paid' in po._fields">Paid (PO linked): <strong t-field="po.amount_paid"/></p><a t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_monitor')" t-att-href="'/my/employee/purchase-monitor/%s' % po.id">Open purchase monitoring details</a></t><p t-else="">Payment monitoring becomes available after purchase confirmation.</p></section>
    <section data-panel="signing" role="tabpanel" hidden="hidden"><p t-if="po and 'signature_status_text' in po._fields"><strong t-field="po.signature_status_text"/></p><p>Signing package order: Purchase Order → supplier quotation PDF(s) → linked Material Request.</p><p>Signature requests and quotation attachments continue through the installed backend Send-to-Sign workflow.</p><p t-if="po and 'quotation_attachment_ids' in po._fields"><t t-foreach="po.quotation_attachment_ids" t-as="attachment"><span class="apw-badge" t-out="attachment.name"/> </t></p></section>
   </div>
   <input id="apw-csrf" type="hidden" t-att-value="request.csrf_token()"/>
   <pre id="apw-boot" hidden="hidden" t-out="boot_json"/>
   <noscript><p class="alert alert-warning">Enable JavaScript to use the purchase editor.</p></noscript>
  </main></t>
 </template>
 <!-- Keep old XML identifiers on upgrade. Old mutation routes are removed. -->
 <template id="purchase_prepare_new"><t t-call="absar_portal_purchase_monitor.purchase_prepare_detail"/></template>
 <template id="purchase_approval_list"><t t-call="absar_portal_purchase_monitor.purchase_prepare_list"/></template>
</odoo>