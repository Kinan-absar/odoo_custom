<odoo>
 <template id="purchase_prepare_list" name="My Purchase RFQs">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container apm-shell my-4"><div class="apm-title"><div><h2>My Purchase RFQs</h2><p>Prepare and submit purchase requests for approval</p></div><a href="/my/employee/purchase/new" class="btn btn-primary">+ New RFQ</a></div>
    <div class="apm-table-wrap"><table class="apm-table"><thead><tr><th>RFQ</th><th>Supplier</th><th>Status</th><th class="apm-num">Total</th></tr></thead><tbody>
     <t t-foreach="orders" t-as="po"><tr class="apm-clickrow" t-att-data-href="'/my/employee/purchase/%d' % po.id" onclick="window.location.href=this.dataset.href"><td><strong t-out="po.name"/></td><td t-out="po.partner_id.name"/><td t-out="dict(po._fields['absar_portal_review_state'].selection).get(po.absar_portal_review_state)"/><td class="apm-num" t-out="'%.2f' % po.amount_total"/></tr></t>
     <tr t-if="not orders"><td colspan="4">No RFQs yet.</td></tr>
    </tbody></table></div>
   </div>
  </t>
 </template>
 <template id="purchase_prepare_new" name="New Purchase RFQ">
  <t t-call="employee_portal_suite.employee_portal_layout"><div class="container apm-shell my-4">
   <a class="apm-back" href="/my/employee/purchase">&#8592; My Purchase RFQs</a><h2>Create Request for Quotation</h2>
   <div class="apm-editor-card"><form method="post" action="/my/employee/purchase/new"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
    <div class="apm-form-grid"><div><label>Vendor *</label><select name="partner_id" required="required" class="form-select"><option value="">Select vendor</option><t t-foreach="suppliers" t-as="vendor"><option t-att-value="vendor.id" t-out="vendor.display_name"/></t></select></div><div><label>Source / Reference</label><input class="form-control" name="origin" placeholder="MR or project reference"/></div><div><label>Project</label><select name="project_id" class="form-select"><option value="">No project</option><t t-foreach="projects" t-as="project"><option t-att-value="project.id" t-out="project.display_name"/></t></select></div></div>
    <div class="apm-form-actions"><button type="submit" class="btn btn-primary">Create Draft RFQ</button></div>
   </form></div>
  </div></t>
 </template>
 <template id="purchase_prepare_detail" name="Purchase RFQ Editor">
  <t t-call="employee_portal_suite.employee_portal_layout"><div class="container apm-shell my-4">
   <a class="apm-back" href="/my/employee/purchase">&#8592; My Purchase RFQs</a>
   <div class="apm-title"><div><h2><t t-out="po.name"/> <small>Purchase RFQ</small></h2><p><t t-out="po.partner_id.name"/> · <t t-out="po.company_id.name"/></p></div><span class="apm-pill" t-out="dict(po._fields['absar_portal_review_state'].selection).get(po.absar_portal_review_state)"/></div>
   <div class="apm-info"><div><label>RFQ Date</label><span t-out="po.date_order.date() if po.date_order else ''"/></div><div><label>Vendor</label><span t-out="po.partner_id.display_name"/></div><div><label>Project</label><span t-out="po.absar_portal_project_id.display_name or '—'"/></div><div><label>Reference / MR</label><span t-out="po.origin or '—'"/></div><div><label>Total</label><span t-out="'%.2f %s' % (po.amount_total, po.currency_id.name)"/></div></div>
   <h3 class="apm-subtitle">Order Lines</h3><div class="apm-table-wrap"><table class="apm-table"><thead><tr><th>Product / Description</th><th>Expense Account</th><th>Analytic Distribution</th><th class="apm-num">Qty</th><th class="apm-num">Rate</th><th class="apm-num">Subtotal</th></tr></thead><tbody>
    <t t-foreach="po.order_line" t-as="line"><tr t-if="not line.display_type"><td><strong t-out="line.product_id.display_name"/><small t-out="line.name"/></td><td t-out="line.absar_expense_account_id.display_name or 'Automatic'"/><td t-out="line.analytic_distribution or '—'"/><td class="apm-num" t-out="'%.2f' % line.product_qty"/><td class="apm-num" t-out="'%.2f' % line.price_unit"/><td class="apm-num" t-out="'%.2f' % line.price_subtotal"/></tr></t>
    <tr t-if="not po.order_line"><td colspan="6" class="apm-empty">No items added yet.</td></tr></tbody></table></div>
   <t t-if="editable"><details class="apm-editor-card"><summary>+ Add Product / Order Line</summary>
    <form t-att-action="'/my/employee/purchase/%d/line' % po.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
     <div class="apm-form-grid"><div><label>Product</label><select required="required" name="product_id" class="form-select"><option value="">Select product</option><t t-foreach="products" t-as="p"><option t-att-value="p.id" t-out="p.display_name"/></t></select></div><div><label>Description (optional)</label><input name="description" class="form-control"/></div><div><label>Quantity</label><input required="required" type="number" min="0.00001" step="any" name="qty" value="1" class="form-control"/></div><div><label>Unit Price</label><input required="required" type="number" min="0" step="any" name="price" value="0" class="form-control"/></div><div><label>Expense Account</label><select name="account_id" class="form-select"><option value="">Automatic (from product)</option><t t-foreach="accounts" t-as="a"><option t-att-value="a.id" t-out="a.display_name"/></t></select></div><div><label>Analytic Account</label><select name="analytic_id" class="form-select"><option value="">No analytic</option><t t-foreach="analytics" t-as="a"><option t-att-value="a.id" t-out="a.display_name"/></t></select></div><div><label>Analytic %</label><input name="analytic_percent" value="100" type="number" min="0" max="100" step="any" class="form-control"/></div></div>
     <div class="apm-form-actions"><button type="submit" class="btn btn-primary">Add Line</button></div>
    </form></details>
    <details class="apm-editor-card"><summary>+ Create New Product</summary><form t-att-action="'/my/employee/purchase/%d/product' % po.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="apm-form-grid"><div><label>Product Name</label><input required="required" name="name" maxlength="150" class="form-control"/></div></div><div class="apm-form-actions"><button type="submit" class="btn btn-primary">Create Product</button></div></form></details>
    <form t-att-action="'/my/employee/purchase/%d/submit' % po.id" method="post" class="apm-form-actions"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="btn btn-primary">Submit for Approval</button><small>Submission will not automatically confirm the PO.</small></form>
   </t><t t-else=""><p class="apm-note">This RFQ is read-only while awaiting approval or after confirmation.</p></t>
  </div></t>
 </template>
 <template id="purchase_approval_list" name="Purchase RFQ Approvals">
  <t t-call="employee_portal_suite.employee_portal_layout"><div class="container apm-shell my-4"><h2>Purchase RFQ Approvals</h2><p>Submitted portal RFQs awaiting your decision.</p>
   <t t-foreach="orders" t-as="po"><div class="apm-editor-card"><div class="apm-title"><div><h3 t-out="po.name"/><p><t t-out="po.partner_id.display_name"/> · Prepared by <t t-out="po.absar_portal_preparer_id.name"/></p></div><strong t-out="'%.2f %s' % (po.amount_total,po.currency_id.name)"/></div>
   <p><strong>Project:</strong> <t t-out="po.absar_portal_project_id.display_name or '—'"/></p><ul><t t-foreach="po.order_line" t-as="line"><li t-if="not line.display_type"><t t-out="line.name"/> — <t t-out="line.product_qty"/> × <t t-out="line.price_unit"/></li></t></ul>
   <form class="apm-form-actions" t-att-action="'/my/employee/purchase/approvals/%d/approve' % po.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-primary" type="submit">Approve &amp; Confirm PO</button></form>
   <form t-att-action="'/my/employee/purchase/approvals/%d/return' % po.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Correction note</label><input class="form-control" name="note" maxlength="500"/><button class="btn btn-light mt-2" type="submit">Return for Correction</button></form>
   </div></t><p t-if="not orders">No pending RFQs.</p></div></t>
 </template>
</odoo>
