<odoo>
 <template id="native_purchase_shell" name="Native Portal Purchase Workspace">
  <t t-call="web.layout">
   <t t-set="head">
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <script type="text/javascript">
     odoo.__session_info__ = <t t-out="session_json"/>;
     odoo.absarPurchase = <t t-out="workspace_json"/>;
     odoo.reloadMenus = () => Promise.resolve({root: {id: 'root', name: 'Purchase', children: []}});
     odoo.loadMenusPromise = odoo.reloadMenus();
    </script>
    <t t-call-assets="absar_portal_purchase_monitor.assets_native"/>
   </t>
   <t t-set="body_classname" t-value="'o_web_client absar_native_purchase'"/>
   <div id="absar-native-purchase-root"><div class="p-4" role="status">Loading Purchase…</div></div>
  </t>
 </template>
</odoo>
