<odoo>
 <template id="purchase_approval_list" name="Purchase Approvals — Monitoring List Design">
  <t t-call="employee_portal_suite.employee_portal_layout">
   <div class="container apm-shell my-4">
    <t t-if="not approval" t-call="absar_portal_purchase_monitor.purchase_workspace_nav"/><div class="apm-title"><div><h2 t-out="'Purchase Approvals' if approval else 'Purchase Orders'"/><p t-out="'Review purchase orders awaiting approval' if approval else 'Draft purchase orders and approval status'"/></div><span class="apm-count"><t t-out="total"/> requests</span><a t-if="not approval" href="/my/employee/purchase/new" class="btn btn-primary">New Purchase Order</a></div>
    <form class="apm-filter" method="get"><input class="form-control apw-search" name="q" t-att-value="q" placeholder="Search PO, vendor, MR or reference" aria-label="Search Purchase Orders"/>
    <select t-if="not orders_only" name="review" class="form-select" aria-label="Review status"><option value="all" t-att-selected="review == 'all'">All review statuses</option><option value="draft" t-att-selected="review == 'draft'">Draft</option><option value="submitted" t-att-selected="review == 'submitted'">Awaiting Approval</option><option value="approved" t-att-selected="review == 'approved'">Approved</option><option value="returned" t-att-selected="review == 'returned'">Returned</option></select>
    <select name="sort" class="form-select" aria-label="Sort"><option value="newest">Newest</option><option value="reference" t-att-selected="sort == 'reference'">Reference</option><option value="vendor" t-att-selected="sort == 'vendor'">Vendor</option><option value="amount" t-att-selected="sort == 'amount'">Highest amount</option><option value="date" t-att-selected="sort == 'date'">Order date</option></select><select name="group_by" class="form-select" aria-label="Group by"><option value="">No grouping</option><option value="vendor" t-att-selected="group_by == 'vendor'">Group by Vendor</option><option value="project" t-att-selected="group_by == 'project'">Group by Project</option><option value="buyer" t-att-selected="group_by == 'buyer'">Group by Buyer</option><option value="company" t-att-selected="group_by == 'company'">Group by Company</option><option value="review" t-att-selected="group_by == 'review'">Group by Review</option></select><button class="btn btn-primary">Search</button><a t-att-href="'/my/employee/purchase/orders' if orders_only else '/my/employee/purchase/confirmations' if confirmations else '/my/employee/purchase/approvals' if approval else '/my/employee/purchase'" class="btn btn-light">Clear</a>
   </form>
    <p t-if="group_by" class="apm-note">A group can continue onto the next page.</p>
    <div class="absar-record-list" aria-label="Purchase orders">
     <t t-set="last_group" t-value="False"/><t t-foreach="orders" t-as="po">
      <h4 t-if="group_by and group_labels.get(po.id) != last_group" class="absar-record-group" t-out="group_labels.get(po.id)"/><t t-set="last_group" t-value="group_labels.get(po.id)"/>
      <article class="absar-record-card" role="link" tabindex="0" t-att-data-record-href="'/my/employee/purchase/%s' % po.id" t-att-aria-label="'Open ' + po.name">
       <div class="absar-record-main"><a class="absar-record-number" t-att-href="'/my/employee/purchase/%s' % po.id" t-out="po.name"/><div class="absar-record-party" t-out="po.partner_id.name"/>
        <div class="absar-record-meta"><span>Project: <t t-out="po.project_id.display_name if 'project_id' in po._fields else po.absar_portal_project_id.display_name or '—'"/></span><span>MR: <t t-out="po.material_request_id.name or '—'"/></span><span>Buyer: <t t-out="po.absar_portal_preparer_id.name or po.user_id.name or '—'"/></span><span t-out="po.date_order.date() if po.date_order else ''"/><span t-out="po.company_id.name"/></div>
       </div><div class="absar-record-side"><span class="absar-record-caption">Total including VAT</span><strong class="absar-record-value"><t t-out="'{:,.2f}'.format(po.amount_total)"/> <t t-out="po.currency_id.name"/></strong>
        <span class="absar-record-badge" t-out="dict(po._fields['absar_portal_review_state']._description_selection(po.env)).get(po.absar_portal_review_state, 'Draft')"/>
        <span class="absar-record-badge" t-out="{'draft':'Draft PO','sent':'Draft PO Sent','purchase':'Purchase Order','done':'Locked','cancel':'Cancelled'}.get(po.state,po.state)"/>
       </div>
      </article>
     </t><div t-if="not orders" class="absar-record-empty">No purchase requests match these filters.</div>
    </div>
    <div class="apm-footer"><p t-out="'Review a request to approve or return it for correction.' if approval else 'Open a request to prepare it or follow its approval status.'"/><div class="apm-pages"><a t-if="page &gt; 1" t-att-href="previous_url">← Previous</a><span>Page <t t-out="page"/> of <t t-out="pages"/></span><a t-if="page &lt; pages" t-att-href="next_url">Next →</a></div></div>
   </div>
  </t>
 </template>
</odoo>