<odoo>
 <record id="vendor_invoice_company" model="ir.ui.view"><field name="name">portal.vendor.invoice.company.review</field><field name="model">portal.vendor.invoice</field><field name="inherit_id" ref="customer_vendor_portal.view_vendor_invoice_form"/><field name="arch" type="xml"><xpath expr="//field[@name='vendor_invoice_number']" position="after"><field name="company_id" domain="[('id','in',context.get('allowed_company_ids', []))]" options="{'no_create':True}"/></xpath></field></record>
 <template id="vendor_invoice_navigation" inherit_id="absar_portal_purchase_monitor.purchase_monitor_nav">
  <xpath expr="//t[div[@id='ep-section-purchase-monitor']]" position="attributes"><attribute name="t-if" add="request.env.user.has_group('customer_vendor_portal.group_vendor_invoice_reviewer')" separator=" or "/></xpath>
  <xpath expr="//div[@id='ep-section-purchase-monitor']/div[@class='ep-sidebar-section-links']" position="inside"><a t-if="request.env.user.has_group('customer_vendor_portal.group_vendor_invoice_reviewer')" href="/my/employee/purchase/vendor-invoices" class="ep-sidebar-link"><i class="fa fa-file-pdf-o"/> Vendor Invoice Review</a></xpath>
 </template>
 <template id="vendor_invoice_header"><header class="apw-header"><h2>Vendor Invoice Review</h2><a href="/my/employee">Employee Portal</a></header></template>
 <template id="vendor_invoice_listing"><t t-call="employee_portal_suite.employee_portal_layout"><section class="container py-4"><t t-call="absar_portal_purchase_monitor.vendor_invoice_header"/><form method="get" class="d-flex gap-2 my-3 flex-wrap"><select name="company_id" class="form-select w-auto"><option t-foreach="companies" t-as="item" t-att-value="item.id" t-att-selected="item==company" t-out="item.name"/></select><input class="form-control w-auto" name="q" t-att-value="q" placeholder="Reference or vendor invoice number…"/><select class="form-select w-auto" name="state"><option value="">All statuses</option><option t-foreach="[('submitted','Submitted'),('review','Under Review'),('approved','Approved'),('rejected','Rejected')]" t-as="item" t-att-value="item[0]" t-att-selected="state==item[0]" t-out="item[1]"/></select><button class="btn btn-primary">Search</button></form><div class="card p-3"><table class="table"><thead><tr><th>Reference</th><th>Vendor</th><th>Vendor Invoice</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead><tbody><tr t-foreach="records" t-as="invoice"><td><a t-att-href="'/my/employee/purchase/vendor-invoices/%s?company_id=%s' % (invoice.id,company.id)" t-out="invoice.name"/></td><td t-out="invoice.partner_id.display_name"/><td t-out="invoice.vendor_invoice_number or ''"/><td t-field="invoice.invoice_date"/><td><span t-field="invoice.amount_total" t-options="{'widget':'monetary','display_currency':invoice.currency_id}"/></td><td t-out="invoice.state"/></tr><tr t-if="not records"><td colspan="6">No vendor submissions found.</td></tr></tbody></table></div><div class="d-flex justify-content-between my-3"><a t-if="page &gt; 1" t-att-href="'?' + urlencode(dict(company_id=company.id,q=q,state=state,page=page-1))">Previous</a><span>Page <t t-out="page"/></span><a t-if="page * 40 &lt; count" t-att-href="'?' + urlencode(dict(company_id=company.id,q=q,state=state,page=page+1))">Next</a></div></section></t></template>
 <template id="vendor_invoice_detail"><t t-call="employee_portal_suite.employee_portal_layout"><section class="container py-4"><t t-call="absar_portal_purchase_monitor.vendor_invoice_header"/><a t-att-href="'/my/employee/purchase/vendor-invoices?company_id=%s' % company.id">Back to Submissions</a><h3 class="my-3" t-out="record.name"/><div t-if="message" class="alert alert-info" t-out="message"/><div class="card p-4"><p><strong>Vendor: </strong><span t-field="record.partner_id"/></p><p><strong>Vendor Invoice: </strong><span t-out="record.vendor_invoice_number or ''"/></p><p><strong>Purchase Order: </strong><span t-field="record.po_id"/></p><p><strong>Status: </strong><span t-out="record.state"/></p><p t-out="record.notes or ''"/><a t-if="record.attachment_id" class="btn btn-outline-primary" t-att-href="'/my/employee/purchase/vendor-invoices/%s/document?company_id=%s' % (record.id,company.id)">Download Vendor Invoice</a><form t-if="record.state in ('submitted','review')" class="my-3" method="post" t-att-action="'/my/employee/purchase/vendor-invoices/%s/review' % record.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="company_id" t-att-value="company.id"/><input type="hidden" name="version" t-att-value="str(record.write_date)"/><label>Comment for Vendor<textarea class="form-control my-2" name="comment" rows="3" t-out="record.review_comment or ''"/></label><div class="d-flex gap-2 flex-wrap"><button t-if="record.state == 'submitted'" class="btn btn-primary" name="operation" value="review">Under Review</button><button t-if="record.state == 'review'" class="btn btn-success" name="operation" value="approved">Approve</button><button t-if="record.state == 'review'" class="btn btn-outline-danger" name="operation" value="rejected">Reject</button></div></form><p t-else="" t-out="record.review_comment or ''"/></div></section></t></template>
</odoo>
