<odoo>
 <template id="purchase_monitor_nav" inherit_id="employee_portal_suite.employee_portal_layout" name="Purchase Workspace Navigation">
  <xpath expr="//div[@id='ep-section-approvals']" position="after">
   <t t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_monitor') or request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer') or (not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_approver')) or (not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_confirmer'))">
    <div class="ep-sidebar-section" id="ep-section-purchase-monitor"><div class="ep-sidebar-section-title">Purchase</div><div class="ep-sidebar-section-links"><a t-if="(not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_confirmer'))" href="/my/employee/purchase/confirmations" class="ep-sidebar-link"><i class="fa fa-check"/> Purchase Confirmations</a>
     <t t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')"><a href="/my/employee/purchase" class="ep-sidebar-link"><i class="fa fa-file-text-o"/> My Purchase RFQs</a></t>
     <t t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_monitor')"><a href="/my/employee/purchase-monitor" class="ep-sidebar-link"><i class="fa fa-shopping-cart"/> Purchase Monitoring</a></t>
     <t t-if="(not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_approver'))"><a href="/my/employee/purchase/approvals" class="ep-sidebar-link"><i class="fa fa-check-square-o"/> Purchase Approvals</a></t>
    </div></div>
   </t>
  </xpath>
  <xpath expr="//div[@class='ep-dropdown-menu' and @id='app-d']/parent::div" position="after">
   <t t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_monitor') or request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer') or (not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_approver')) or (not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_confirmer'))"><div class="ep-dropdown"><button class="ep-dropdown-toggle" onclick="toggleDropdown(event, 'apm-purchase-d')">Purchase &#9662;</button><div id="apm-purchase-d" class="ep-dropdown-menu"><a t-if="(not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_confirmer'))" href="/my/employee/purchase/confirmations" class="ep-sub-link">Purchase Confirmations</a>
    <t t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_preparer')"><a href="/my/employee/purchase" class="ep-sub-link">My Purchase RFQs</a></t>
    <t t-if="request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_monitor')"><a href="/my/employee/purchase-monitor" class="ep-sub-link">Purchase Monitoring</a></t>
    <t t-if="(not request.env.user.share and request.env.user.has_group('purchase.group_purchase_manager') and request.env.user.has_group('absar_portal_purchase_monitor.group_portal_purchase_approver'))"><a href="/my/employee/purchase/approvals" class="ep-sub-link">Purchase Approvals</a></t>
   </div></div></t>
  </xpath>
 </template>
</odoo>
