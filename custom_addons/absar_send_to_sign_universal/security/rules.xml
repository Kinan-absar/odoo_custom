<odoo>
    <record id="document_company_rule" model="ir.rule">
        <field name="name">Universal signing history: allowed companies</field>
        <field name="model_id" ref="model_absar_sign_universal_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="document_owner_rule" model="ir.rule">
        <field name="name">Universal signing history: own preparations</field>
        <field name="model_id" ref="model_absar_sign_universal_document"/>
        <field name="groups" eval="[(4, ref('sign.group_sign_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="document_admin_rule" model="ir.rule">
        <field name="name">Universal signing history: administrator</field>
        <field name="model_id" ref="model_absar_sign_universal_document"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
