<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         The actual snippet markup. Everything here is droppable on a
         page and freely editable by the website editor (text, icons,
         images) since it lives inside the standard editable area.
         ============================================================ -->
    <template id="s_aurora_feature_cards" name="Feature Cards">
        <section class="s_aurora_feature_cards pt-5 pb-5" data-snippet="s_aurora_feature_cards">
            <div class="container">
                <div class="row justify-content-center mb-5">
                    <div class="col-lg-7 text-center">
                        <h2 class="o_aurora_animate">Why choose us</h2>
                        <p class="text-muted o_aurora_animate">
                            A short line explaining the three things you do best.
                        </p>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="o_feature_card o_aurora_animate">
                            <div class="o_feature_icon">
                                <i class="fa fa-bolt"/>
                            </div>
                            <h4>Fast</h4>
                            <p>Describe your first key benefit here in one or two lines.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="o_feature_card o_aurora_animate">
                            <div class="o_feature_icon">
                                <i class="fa fa-shield"/>
                            </div>
                            <h4>Reliable</h4>
                            <p>Describe your second key benefit here in one or two lines.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="o_feature_card o_aurora_animate">
                            <div class="o_feature_icon">
                                <i class="fa fa-heart"/>
                            </div>
                            <h4>Loved</h4>
                            <p>Describe your third key benefit here in one or two lines.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- ============================================================
         Register the snippet in the "Structure" section of the
         website builder's Add Building Block panel.
         ============================================================ -->
    <template id="s_aurora_feature_cards_snippet_entry" inherit_id="website.snippets" name="Feature Cards Entry">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_mytheme.s_aurora_feature_cards" t-thumbnail="/theme_mytheme/static/src/img/s_feature_cards_thumb.svg"/>
        </xpath>
    </template>

</odoo>
