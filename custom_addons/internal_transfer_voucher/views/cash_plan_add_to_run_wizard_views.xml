<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cash_plan_add_to_run_wizard_form" model="ir.ui.view">
    <field name="name">cash.plan.add.to.run.wizard.form</field>
    <field name="model">cash.plan.add.to.run.wizard</field>
    <field name="arch" type="xml">
      <form string="Add to Weekly Plan">
        <group>
          <field name="line_id"/>
          <field name="company_id" invisible="1"/>
          <field name="run_id" options="{'no_create': True, 'no_create_edit': True}"/>
        </group>
        <div class="alert alert-info" role="alert">
          The plan covering today is selected automatically when available. You may choose another open plan before confirming.
        </div>
        <footer>
          <button name="action_confirm" type="object" string="Add to Plan" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
