<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cash_plan_review_list" model="ir.ui.view">
        <field name="name">cash.plan.review.list</field>
        <field name="model">cash.plan.review</field>
        <field name="arch" type="xml">
            <list create="0">
                <header>
                    <button name="action_run_payment_review_agent" type="object" string="Run Payment Review" class="btn-primary"/>
                </header>
                <field name="review_date"/>
                <field name="name"/>
                <field name="keep_count"/>
                <field name="add_count"/>
                <field name="update_count"/>
                <field name="remove_count"/>
                <field name="review_count"/>
                <field name="safe_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cash_plan_review_form" model="ir.ui.view">
        <field name="name">cash.plan.review.form</field>
        <field name="model">cash.plan.review</field>
        <field name="arch" type="xml">
            <form string="Payment Review Agent">
                <header>
                    <button name="action_refresh_review" type="object" string="Run / Refresh Review" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_select_all_safe" type="object" string="Select All Safe" class="btn-secondary" invisible="state == 'applied' or safe_count == 0"/>
                    <button name="action_clear_selection" type="object" string="Clear Selection" class="btn-secondary" invisible="selected_count == 0"/>
                    <button name="action_apply_selected" type="object" string="Apply Selected Safe Changes" class="btn-primary" invisible="state == 'applied' or selected_count == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,partial,applied"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="alert">
                        The review reads live Odoo data. It checks all active supplier payment plans, all confirmed Nothing-to-Bill POs, and live posted non-retention payables. Safe changes can be selected and applied; payments and CEO approvals are never executed by the agent.
                    </div>
                    <group>
                        <group>
                            <field name="review_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="keep_count"/>
                            <field name="add_count"/>
                            <field name="update_count"/>
                            <field name="remove_count"/>
                            <field name="review_count"/>
                            <field name="safe_count"/>
                            <field name="selected_count"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="action == 'keep'"
                              decoration-warning="action in ('update','convert','review')"
                              decoration-danger="action == 'remove'">
                            <field name="apply" readonly="not can_apply or applied"/>
                            <field name="can_apply" column_invisible="True"/>
                            <field name="source_type" readonly="1" optional="show"/>
                            <field name="action" widget="badge" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="plan_line_id" readonly="1" optional="show"/>
                            <field name="target_plan_line_id" readonly="1" optional="hide"/>
                            <field name="purchase_order_id" readonly="1" optional="show"/>
                            <field name="current_amount" readonly="1"/>
                            <field name="proposed_amount" readonly="1"/>
                            <field name="oldest_due_date" readonly="1" optional="show"/>
                            <field name="aging_summary" readonly="1" optional="show"/>
                            <field name="reason" readonly="1"/>
                            <field name="applied" widget="boolean_toggle" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cash_plan_review" model="ir.actions.act_window">
        <field name="name">Payment Reviews</field>
        <field name="res_model">cash.plan.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cash_plan_line_list_agent" model="ir.ui.view">
        <field name="name">cash.plan.line.list.payment.agent</field>
        <field name="model">cash.plan.line</field>
        <field name="inherit_id" ref="internal_transfer_voucher.view_cash_plan_line_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_run_payment_review_agent" type="object" string="Payment Review" class="btn-primary"
                            groups="internal_transfer_voucher.group_weekly_payment_plan_manager,internal_transfer_voucher.group_payment_execution_manager"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
