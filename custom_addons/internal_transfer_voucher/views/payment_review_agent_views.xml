<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cash_plan_review_list" model="ir.ui.view">
        <field name="name">cash.plan.review.list</field><field name="model">cash.plan.review</field>
        <field name="arch" type="xml"><list><field name="review_date"/><field name="name"/><field name="keep_count"/><field name="add_count"/><field name="update_count"/><field name="remove_count"/><field name="review_count"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_cash_plan_review_form" model="ir.ui.view">
        <field name="name">cash.plan.review.form</field><field name="model">cash.plan.review</field>
        <field name="arch" type="xml">
            <form string="Payment Review Agent">
                <header><button name="action_apply_selected" type="object" string="Apply Selected Safe Changes" class="btn-primary" invisible="state == 'applied'"/><field name="state" widget="statusbar"/></header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="alert">This first version is a controlled review agent. It reads live Odoo data and recommends actions. Only explicitly selected safe changes are applied; payments and approvals are never executed by the agent.</div>
                    <group><group><field name="review_date"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="keep_count"/><field name="add_count"/><field name="update_count"/><field name="remove_count"/><field name="review_count"/></group></group>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0" decoration-success="action == 'keep'" decoration-warning="action in ('update','convert','review')" decoration-danger="action == 'remove'">
                            <field name="apply"/><field name="can_apply" column_invisible="True"/><field name="action" widget="badge"/><field name="partner_id"/><field name="plan_line_id"/><field name="purchase_order_id"/><field name="current_amount"/><field name="proposed_amount"/><field name="reason"/><field name="applied" widget="boolean_toggle" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cash_plan_review" model="ir.actions.act_window"><field name="name">Payment Reviews</field><field name="res_model">cash.plan.review</field><field name="view_mode">list,form</field></record>
    <record id="view_cash_plan_line_list_agent" model="ir.ui.view">
        <field name="name">cash.plan.line.list.payment.agent</field><field name="model">cash.plan.line</field><field name="inherit_id" ref="internal_transfer_voucher.view_cash_plan_line_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><header><button name="action_run_payment_review_agent" type="object" string="Payment Review" class="btn-primary" groups="internal_transfer_voucher.group_weekly_payment_plan_manager,internal_transfer_voucher.group_payment_execution_manager"/></header></xpath></field>
    </record>
</odoo>
