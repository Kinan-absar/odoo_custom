<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_link_payment_voucher_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.link.payment.voucher.wizard.form</field>
        <field name="model">purchase.order.link.payment.voucher.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Existing Payment">
                <group>
                    <field name="purchase_order_id"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="commercial_partner_id" invisible="1"/>
                    <field name="payment_source" widget="radio"/>
                    <field name="voucher_id"
                           invisible="payment_source != 'voucher'"
                           required="payment_source == 'voucher'"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="payment_id"
                           invisible="payment_source != 'odoo'"
                           required="payment_source == 'odoo'"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <group string="Payment Allocation" invisible="not voucher_id and not payment_id">
                    <field name="currency_id" invisible="1"/>
                    <field name="payment_amount"/>
                    <field name="already_allocated"/>
                    <field name="available_to_allocate"/>
                    <field name="amount"/>
                </group>
                <div class="alert alert-info" role="alert">
                    This links the selected posted payment to the Purchase Order for tracking and reporting only. The posted accounting entry is not changed.
                </div>
                <footer>
                    <button name="action_link_payment" type="object" string="Link Payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_order_link_payment_voucher_wizard" model="ir.actions.act_window">
        <field name="name">Link Existing Payment</field>
        <field name="res_model">purchase.order.link.payment.voucher.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
