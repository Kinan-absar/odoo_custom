<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_custom_voucher_pay" model="ir.ui.view">
        <field name="name">account.move.form.custom.voucher.pay</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Replace Odoo's standard Register Payment/Pay action with our voucher action. -->
            <xpath expr="//button[@name='action_register_payment']" position="replace">
                <button name="action_open_voucher_payment"
                        string="Pay"
                        type="object"
                        class="oe_highlight"
                        invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or payment_state not in ('not_paid', 'partial')"/>
            </xpath>
        </field>
    </record>
</odoo>
