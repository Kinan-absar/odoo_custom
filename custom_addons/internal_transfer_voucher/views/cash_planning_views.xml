<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_cash_plan_run_list" model="ir.ui.view"><field name="name">cash.plan.run.list</field><field name="model">cash.plan.run</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-info="state in ('approved','in_progress')"><field name="name"/><field name="date_from"/><field name="date_to"/><field name="opening_balance" sum="Opening"/><field name="forecast_inflow" sum="Inflows"/><field name="forecast_outflow" sum="Outflows"/><field name="forecast_closing" sum="Closing"/><field name="actual_closing"/><field name="forecast_variance"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_cash_plan_run_form" model="ir.ui.view"><field name="name">cash.plan.run.form</field><field name="model">cash.plan.run</field><field name="arch" type="xml"><form string="Weekly Cash Plan"><header><button name="action_start" type="object" string="Start Week" class="btn-primary" invisible="state != 'draft'"/><button name="action_done" type="object" string="Complete" class="btn-primary" invisible="state != 'in_progress'"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancel')"/><button name="action_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state not in ('done', 'cancel')"/><field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancel"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="date_from"/><field name="date_to"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="opening_balance"/><field name="budget_amount"/><field name="budget_remaining" readonly="1"/></group></group><group string="Forecast Summary" col="4"><field name="forecast_inflow" readonly="1"/><field name="forecast_outflow" readonly="1"/><field name="forecast_net" readonly="1"/><field name="forecast_closing" readonly="1"/></group><group string="Payment Approval Summary" col="4"><field name="approved_inflow" readonly="1"/><field name="approved_outflow" readonly="1"/><field name="approved_net" readonly="1"/><field name="approved_closing" readonly="1"/><field name="ceo_pending_count" readonly="1"/><field name="ceo_approved_count" readonly="1"/><field name="ceo_rejected_count" readonly="1"/><field name="ceo_held_count" readonly="1"/><field name="ceo_reviewed_by" readonly="1"/></group><group string="Actual and Variance" col="4"><field name="actual_inflow" readonly="1"/><field name="actual_outflow" readonly="1"/><field name="actual_net" readonly="1"/><field name="actual_closing" readonly="1"/><field name="forecast_variance" readonly="1"/></group><notebook><page string="Planned Cash Movements"><field name="line_ids" context="{'default_planned_date': date_from}"><list editable="bottom"><field name="planned_date"/><field name="flow_type"/><field name="category_id"/><field name="transaction_type"/><field name="name"/><field name="is_unplanned" string="Unplanned" optional="show"/><field name="partner_id"/><field name="project_id" optional="show"/><field name="forecast_amount" sum="Total Forecast"/><field name="approved_amount" sum="Total CEO Approved" readonly="1"/><field name="ceo_decision" widget="badge" readonly="1"/><field name="actual_amount" sum="Total Actual" readonly="1"/><field name="variance_amount" sum="Total Variance" readonly="1"/><field name="priority" widget="priority"/><field name="funding_status" widget="badge"/><field name="state" widget="badge"/></list></field></page><page string="Weekly Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="view_cash_plan_line_list" model="ir.ui.view"><field name="name">cash.plan.line.list</field><field name="model">cash.plan.line</field><field name="arch" type="xml"><list js_class="cash_plan_line_dashboard_list" decoration-success="state == 'executed'" decoration-danger="funding_status == 'unfunded'"><field name="planned_date"/><field name="company_id" optional="hide"/><field name="run_id" optional="show"/><field name="is_in_weekly_plan" string="In Plan" widget="boolean_toggle" readonly="1" optional="show"/><field name="added_to_plan_on" optional="hide"/><field name="added_to_plan_by" optional="hide"/><field name="flow_type"/><field name="category_id"/><field name="name"/><field name="is_unplanned" string="Unplanned" widget="boolean_toggle" readonly="1"/><field name="partner_id"/><field name="project_id" optional="show"/><field name="forecast_amount" sum="Total Forecast"/><field name="approved_amount" sum="Total CEO Approved"/><field name="ceo_decision" widget="badge"/><field name="actual_amount" sum="Total Actual"/><field name="variance_amount" sum="Total Variance"/><field name="priority" widget="priority"/><field name="funding_status" widget="badge"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_cash_plan_line_form" model="ir.ui.view"><field name="name">cash.plan.line.form</field><field name="model">cash.plan.line</field><field name="arch" type="xml"><form><header><button name="action_add_to_plan" type="object" string="Add to Plan" class="btn-secondary" groups="internal_transfer_voucher.group_payment_execution_manager" invisible="run_id or state == 'cancel'"/><button name="action_remove_from_plan" type="object" string="Remove from Plan" class="btn-secondary" groups="internal_transfer_voucher.group_payment_execution_manager" invisible="not run_id or state == 'cancel'"/><button name="action_submit_to_ceo" type="object" string="Submit to CEO" class="btn-primary" invisible="flow_type != 'out' or ceo_decision != 'not_sent' or state == 'executed'"/><button name="action_approve" type="object" string="Approve Payment" class="btn-success" groups="internal_transfer_voucher.group_payment_execution_manager" invisible="flow_type != 'out' or ceo_decision not in ('pending','held') or state in ('executed','cancel')"/><button name="action_mark_as_paid" type="object" string="Mark as Paid" class="btn-primary" groups="internal_transfer_voucher.group_payment_execution_manager" invisible="flow_type != 'out' or state in ('executed','cancel') or ceo_decision not in ('approved','adjusted')"/><button name="action_create_payment_voucher" type="object" string="Create Payment Voucher" class="btn-primary" invisible="flow_type != 'out' or state != 'executed' or payment_voucher_id"/><button name="action_create_receipt_voucher" type="object" string="Create Receipt Voucher" class="btn-primary" groups="internal_transfer_voucher.group_payment_execution_manager,internal_transfer_voucher.group_weekly_payment_plan_manager" invisible="flow_type != 'in' or state in ('executed','cancel') or receipt_voucher_id or not run_id"/><button name="action_reset_receipt_to_draft" type="object" string="Reset to Draft" class="btn-secondary" groups="internal_transfer_voucher.group_payment_execution_manager,internal_transfer_voucher.group_weekly_payment_plan_manager" invisible="flow_type != 'in' or state != 'executed' or not receipt_voucher_id or receipt_voucher_state != 'draft'"/><button name="action_execute" type="object" string="Execute Transfer" class="btn-primary" groups="internal_transfer_voucher.group_weekly_payment_plan_manager" invisible="transaction_type != 'transfer' or state in ('executed','cancel')"/><button name="action_link_existing_voucher" type="object" string="Link Existing Voucher" class="btn-secondary" groups="internal_transfer_voucher.group_weekly_payment_plan_manager,internal_transfer_voucher.group_payment_execution_manager" invisible="state == 'cancel' or payment_voucher_id or receipt_voucher_id or internal_transfer_id"/><button name="action_open_document" type="object" string="Open Executed Document" invisible="state != 'executed' or (not payment_voucher_id and not receipt_voucher_id and not internal_transfer_id)"/><button name="action_reset_to_draft" type="object" string="Request Reset to Draft" class="btn-secondary" groups="internal_transfer_voucher.group_weekly_payment_plan_manager" invisible="state == 'executed' or reset_request_pending or (state == 'planned' and ceo_decision in ('not_sent','not_required'))"/><button name="action_approve_reset_to_draft" type="object" string="Approve Reset to Draft" class="btn-primary" groups="internal_transfer_voucher.group_payment_execution_manager" invisible="not reset_request_pending"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('executed','cancel')"/><field name="state" widget="statusbar" statusbar_visible="planned,approved,executed,cancel"/></header><sheet><field name="is_locked" invisible="1"/><field name="reset_request_pending" invisible="1"/><field name="is_unplanned" invisible="1"/><field name="receipt_voucher_state" invisible="1"/><div class="alert alert-warning" role="alert" invisible="not is_unplanned">This is an Unplanned Actual created from a voucher raised directly by the Accountant. Its voucher date selects the matching weekly plan automatically; an authorized user can still add, move, or remove it as needed.</div><div class="oe_title"><h1><field name="name" readonly="is_locked"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company" readonly="is_locked or run_id"/><field name="run_id" readonly="1" placeholder="Not added to a weekly plan"/><field name="planned_date" readonly="1"/><field name="added_to_plan_on" readonly="1" invisible="not added_to_plan_on"/><field name="added_to_plan_by" readonly="1" invisible="not added_to_plan_by"/><field name="flow_type" readonly="is_locked"/><field name="transaction_type" readonly="is_locked"/><field name="category_id" readonly="is_locked"/><field name="priority" widget="priority" readonly="is_locked"/><field name="funding_status" readonly="is_locked"/></group><group><field name="partner_id" readonly="is_locked"/><field name="purchase_order_ids" string="Purchase Order(s) to Pay (Optional)" required="0" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" placeholder="Select the exact PO(s) covered by this payment..." readonly="is_locked" invisible="flow_type != 'out' or transaction_type != 'supplier'"/><field name="po_amount_paid" readonly="1" invisible="flow_type != 'out' or transaction_type != 'supplier'"/><field name="po_balance_due" readonly="1" invisible="flow_type != 'out' or transaction_type != 'supplier'"/><field name="project_id" readonly="is_locked"/><field name="forecast_amount" readonly="is_locked"/><field name="approved_amount" readonly="1" invisible="flow_type != 'out'"/><field name="execution_amount" readonly="1"/><field name="payment_marked_by" readonly="1" invisible="flow_type != 'out' or not payment_marked_by"/><field name="payment_marked_date" readonly="1" invisible="flow_type != 'out' or not payment_marked_date"/><field name="ceo_decision" widget="badge" readonly="1" invisible="flow_type != 'out'"/><field name="ceo_approved_by" readonly="1" invisible="flow_type != 'out'"/><field name="ceo_approved_date" readonly="1" invisible="flow_type != 'out'"/><field name="actual_amount" readonly="1" sum="Total Actual"/><field name="variance_amount" readonly="1" sum="Total Variance"/><field name="journal_id" readonly="is_locked"/><field name="destination_journal_id" readonly="is_locked" invisible="transaction_type != 'transfer'"/><field name="account_id" readonly="is_locked" invisible="transaction_type == 'transfer'"/></group></group><notebook><page string="Documents"><group><field name="bill_ids" widget="many2many_tags" readonly="is_locked" invisible="flow_type != 'out'"/><field name="invoice_ids" widget="many2many_tags" readonly="is_locked" invisible="flow_type != 'in'"/></group></page><page string="Notes"><field name="description" readonly="is_locked"/><group string="CEO Review"><field name="ceo_comment" readonly="1"/></group><group string="Reset to Draft Approval" invisible="not reset_requested_on"><field name="reset_requested_by" readonly="1"/><field name="reset_requested_on" readonly="1"/><field name="reset_approved_by" readonly="1" invisible="not reset_approved_by"/><field name="reset_approved_on" readonly="1" invisible="not reset_approved_on"/></group></page><page string="Execution"><group><field name="payment_voucher_id"/><field name="receipt_voucher_id"/><field name="internal_transfer_id"/></group></page></notebook></sheet><chatter/></form></field></record>
  <record id="view_cash_plan_line_calendar" model="ir.ui.view"><field name="name">cash.plan.line.calendar</field><field name="model">cash.plan.line</field><field name="arch" type="xml"><calendar string="Treasury Calendar" date_start="planned_date" color="flow_type" mode="month"><field name="name"/><field name="partner_id"/><field name="forecast_amount"/><field name="category_id"/></calendar></field></record>
  <record id="view_cash_plan_line_pivot" model="ir.ui.view"><field name="name">cash.plan.line.pivot</field><field name="model">cash.plan.line</field><field name="arch" type="xml"><pivot string="Cash Forecast Analysis"><field name="planned_date" type="row" interval="week"/><field name="flow_type" type="col"/><field name="category_id" type="row"/><field name="forecast_amount" type="measure"/><field name="actual_amount" type="measure"/><field name="variance_amount" type="measure"/></pivot></field></record>
  <record id="view_cash_plan_line_graph" model="ir.ui.view"><field name="name">cash.plan.line.graph</field><field name="model">cash.plan.line</field><field name="arch" type="xml"><graph string="Forecast vs Actual" type="bar"><field name="planned_date" interval="week"/><field name="forecast_amount" type="measure"/><field name="actual_amount" type="measure"/></graph></field></record>
  <record id="action_cash_plan_run" model="ir.actions.act_window"><field name="name">Weekly Planner</field><field name="res_model">cash.plan.run</field><field name="view_mode">list,form</field></record>
  <record id="action_cash_plan_line" model="ir.actions.act_window"><field name="name">Planned Payments &amp; Receipts</field><field name="res_model">cash.plan.line</field><field name="view_mode">list,calendar,pivot,graph,form</field></record>
  <record id="action_cash_plan_payments" model="ir.actions.act_window"><field name="name">Planned Payments</field><field name="res_model">cash.plan.line</field><field name="view_mode">list,calendar,pivot,graph,form</field><field name="view_id" ref="view_cash_plan_line_list"/><field name="domain">[('flow_type','=','out')]</field><field name="context">{'default_flow_type':'out'}</field></record>
  <record id="action_cash_plan_receipts" model="ir.actions.act_window"><field name="name">Planned Receipts</field><field name="res_model">cash.plan.line</field><field name="view_mode">list,calendar,pivot,graph,form</field><field name="domain">[('flow_type','=','in')]</field><field name="context">{'default_flow_type':'in'}</field></record>
  <record id="action_cash_plan_category" model="ir.actions.act_window"><field name="name">Cash Planning Categories</field><field name="res_model">cash.plan.category</field><field name="view_mode">list,form</field></record>
</odoo>
