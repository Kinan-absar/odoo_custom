<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
 <t t-name="internal_transfer_voucher.ReceiptVoucherListView" t-inherit="web.ListView" t-inherit-mode="primary">
  <xpath expr="//Layout/t[@t-component]" position="before"><ReceiptVoucherDashboard context="props.context"/></xpath>
 </t>
 <t t-name="internal_transfer_voucher.ReceiptVoucherDashboard"><section class="absar-backend-filter-bar" aria-label="List filters">
  <div class="absar-filter-cards">
    <button t-foreach="data.cards" t-as="card" t-key="card.key" type="button"
      t-att-class="'absar-filter-card ' + (isActive(card) ? 'is-active' : '')"
      t-att-aria-pressed="isActive(card) ? 'true' : 'false'" t-on-click="() => this.selectCard(card)"><span t-out="card.label"/></button>
  </div>
  <div class="absar-filter-inputs">
    <label t-foreach="inputs" t-as="input" t-key="input.key"><t t-out="input.label"/>
      <input class="form-control" t-att-type="input.type || 'search'" t-att-placeholder="input.placeholder || input.label"
        t-att-value="inputValue(input.key)" t-on-change="ev => this.applyInput(input, ev.target.value)"/>
    </label>
  </div>
</section></t>
</templates>
