<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="employee_portal_dashboard_construction" inherit_id="employee_portal_suite.employee_portal_dashboard">
        <xpath expr="//div[hasclass('st-workspace-grid')]" position="inside">
            <t t-if="show_construction_cards">
                <a href="/my/employee/contracts" class="st-module-card">
                    <div class="st-module-icon"><i class="fa fa-file-text-o"/></div>
                    <div><div class="st-module-title">Contracts</div><div class="st-module-meta"><t t-esc="contract_count or 0"/> contracts available</div></div>
                    <i class="fa fa-angle-right st-module-arrow"/>
                </a>
                <a href="/my/employee/ipcs" class="st-module-card">
                    <div class="st-module-icon"><i class="fa fa-money"/></div>
                    <div><div class="st-module-title">IPCs</div><div class="st-module-meta"><t t-esc="ipc_count or 0"/> certificates available</div></div>
                    <i class="fa fa-angle-right st-module-arrow"/>
                </a>
                <a href="/my/employee/variations" class="st-module-card">
                    <div class="st-module-icon"><i class="fa fa-exchange"/></div>
                    <div><div class="st-module-title">Variations</div><div class="st-module-meta"><t t-esc="variation_count or 0"/> variation records</div></div>
                    <i class="fa fa-angle-right st-module-arrow"/>
                </a>
                <a href="/my/employee/measurements" class="st-module-card">
                    <div class="st-module-icon"><i class="fa fa-bar-chart"/></div>
                    <div><div class="st-module-title">Measurements</div><div class="st-module-meta"><t t-esc="measurement_count or 0"/> measurement records</div></div>
                    <i class="fa fa-angle-right st-module-arrow"/>
                </a>
            </t>
        </xpath>
    </template>
</odoo>
