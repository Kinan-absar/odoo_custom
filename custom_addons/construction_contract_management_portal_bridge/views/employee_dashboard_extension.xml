<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="employee_portal_dashboard_construction" inherit_id="employee_portal_suite.employee_portal_dashboard">
        <!--
            The Employee Portal dashboard was redesigned and no longer contains
            the old `st-dashboard-body` wrapper. Insert the construction cards
            directly into the current dashboard grid instead.
        -->
        <xpath expr="//div[hasclass('row') and hasclass('mt-4') and hasclass('g-3')]" position="inside">
            <t t-if="show_construction_cards">
                <!-- Contracts -->
                <div class="col-6 col-md-6">
                    <a href="/my/employee/contracts" class="dashboard-link">
                        <div class="dashboard-card">
                            <div class="card-top">
                                <div class="card-icon bg-primary-soft">
                                    <i class="fa fa-file-text-o"></i>
                                </div>
                                <span class="card-title">Contracts</span>
                            </div>
                            <div class="card-bottom">
                                <div class="card-bottom-number-row">
                                    <span class="card-number"><t t-esc="contract_count or 0"/></span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- IPCs -->
                <div class="col-6 col-md-6">
                    <a href="/my/employee/ipcs" class="dashboard-link">
                        <div class="dashboard-card">
                            <div class="card-top">
                                <div class="card-icon bg-success-soft">
                                    <i class="fa fa-money"></i>
                                </div>
                                <span class="card-title">IPCs</span>
                            </div>
                            <div class="card-bottom">
                                <div class="card-bottom-number-row">
                                    <span class="card-number"><t t-esc="ipc_count or 0"/></span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Variations -->
                <div class="col-6 col-md-6">
                    <a href="/my/employee/variations" class="dashboard-link">
                        <div class="dashboard-card">
                            <div class="card-top">
                                <div class="card-icon bg-warning-soft">
                                    <i class="fa fa-exchange"></i>
                                </div>
                                <span class="card-title">Variations</span>
                            </div>
                            <div class="card-bottom">
                                <div class="card-bottom-number-row">
                                    <span class="card-number"><t t-esc="variation_count or 0"/></span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Measurements -->
                <div class="col-6 col-md-6">
                    <a href="/my/employee/measurements" class="dashboard-link">
                        <div class="dashboard-card">
                            <div class="card-top">
                                <div class="card-icon bg-indigo-soft">
                                    <i class="fa fa-bar-chart"></i>
                                </div>
                                <span class="card-title">Measurements</span>
                            </div>
                            <div class="card-bottom">
                                <div class="card-bottom-number-row">
                                    <span class="card-number"><t t-esc="measurement_count or 0"/></span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
