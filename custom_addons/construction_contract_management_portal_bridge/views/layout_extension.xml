<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="employee_portal_layout_construction" inherit_id="employee_portal_suite.employee_portal_layout">
        <xpath expr="//a[@href='/my/employee/material'][hasclass('stitch-nav-link')]" position="after">
            <t t-if="request.env.user.has_group('construction_contract_management.group_construction_portal')">
                <div class="stitch-nav-section">Construction</div>
                <a href="/my/employee/contracts" t-att-class="'stitch-nav-link active' if request.httprequest.path.startswith('/my/employee/contract') else 'stitch-nav-link'"><i class="fa fa-file-text-o"/><span>Contracts</span></a>
                <a href="/my/employee/ipcs" t-att-class="'stitch-nav-link active' if request.httprequest.path.startswith('/my/employee/ipc') else 'stitch-nav-link'"><i class="fa fa-money"/><span>IPCs</span></a>
                <a href="/my/employee/variations" t-att-class="'stitch-nav-link active' if request.httprequest.path.startswith('/my/employee/variation') else 'stitch-nav-link'"><i class="fa fa-exchange"/><span>Variations</span></a>
                <a href="/my/employee/measurements" t-att-class="'stitch-nav-link active' if request.httprequest.path.startswith('/my/employee/measurement') else 'stitch-nav-link'"><i class="fa fa-bar-chart"/><span>Measurements</span></a>
            </t>
        </xpath>
        <xpath expr="//div[@id='fabMenu']/a[last()]" position="after">
            <t t-if="request.env.user.has_group('construction_contract_management.group_construction_portal')">
                <a href="/my/employee/contracts" class="fab-item"><i class="fa fa-file-text-o"/><span>Contracts</span></a>
                <a href="/my/employee/ipcs" class="fab-item"><i class="fa fa-money"/><span>IPCs</span></a>
                <a href="/my/employee/variations" class="fab-item"><i class="fa fa-exchange"/><span>Variations</span></a>
                <a href="/my/employee/measurements" class="fab-item"><i class="fa fa-bar-chart"/><span>Measurements</span></a>
            </t>
        </xpath>
    </template>
</odoo>
