<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="petty_cash_management.FilterList">
        <section class="pc-filter-bar" aria-label="Petty cash workflow filters">
            <div class="pc-filter-cards">
                <button t-foreach="cards" t-as="card" t-key="card.key" type="button"
                        t-att-class="'pc-filter-card ' + (activeCard === card.key ? 'is-active' : '')"
                        t-att-aria-pressed="activeCard === card.key ? 'true' : 'false'"
                        t-on-click="() => this.selectCard(card)">
                    <span t-esc="card.label"/>
                </button>
            </div>
            <div class="pc-filter-inputs">
                <label>Submitted By<input type="search" class="form-control" placeholder="Employee name" t-att-value="dimensionValue('submitter')" t-on-change="ev => this.applyDimension('submitter', 'Submitted By', ev.target.value)"/></label>
                <label>Project / Zone<input type="search" class="form-control" placeholder="Project or zone" t-att-value="dimensionValue('project')" t-on-change="ev => this.applyDimension('project', 'Project / Zone', ev.target.value)"/></label>
                <label>Date From<input type="date" class="form-control" t-att-value="dimensionValue('from')" t-on-change="ev => this.applyDimension('from', 'Date From', ev.target.value)"/></label>
                <label>Date To<input type="date" class="form-control" t-att-value="dimensionValue('to')" t-on-change="ev => this.applyDimension('to', 'Date To', ev.target.value)"/></label>
            </div>
        </section>
        <t t-call="web.ListRenderer"/>
    </t>
</templates>
