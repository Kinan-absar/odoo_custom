<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">Petty Cash User</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_petty_cash_accountant" model="res.groups">
        <field name="name">Petty Cash Accountant</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_portal_petty_cash_user" model="res.groups">
        <field name="name">Portal Petty Cash User</field>
        <field name="category_id" ref="base.module_category_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_portal_petty_cash_approver" model="res.groups">
        <field name="name">Portal Petty Cash Approver</field>
        <field name="category_id" ref="base.module_category_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="petty_cash_portal_rule" model="ir.rule">
        <field name="name">Portal Petty Cash Own Records</field>
        <field name="model_id" ref="model_petty_cash"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('petty_cash_management.group_portal_petty_cash_user'))]"/>
    </record>

    <record id="petty_cash_line_portal_rule" model="ir.rule">
        <field name="name">Portal Petty Cash Own Lines</field>
        <field name="model_id" ref="model_petty_cash_line"/>
        <field name="domain_force">[('petty_cash_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('petty_cash_management.group_portal_petty_cash_user'))]"/>
    </record>

    <record id="petty_cash_portal_approver_rule" model="ir.rule">
        <field name="name">Portal Petty Cash Approver - Non Draft Reports</field>
        <field name="model_id" ref="model_petty_cash"/>
        <field name="domain_force">[('state','!=','draft')]</field>
        <field name="groups" eval="[(4, ref('petty_cash_management.group_portal_petty_cash_approver'))]"/>
    </record>

    <record id="petty_cash_line_portal_approver_rule" model="ir.rule">
        <field name="name">Portal Petty Cash Line Approver - Non Draft Reports</field>
        <field name="model_id" ref="model_petty_cash_line"/>
        <field name="domain_force">[('petty_cash_id.state','!=','draft')]</field>
        <field name="groups" eval="[(4, ref('petty_cash_management.group_portal_petty_cash_approver'))]"/>
    </record>
</odoo>
