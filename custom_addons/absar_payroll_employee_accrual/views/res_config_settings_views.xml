<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_absar_payroll_accrual" model="ir.ui.view">
        <field name="name">res.config.settings.form.absar.payroll.accrual</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_payroll']" position="inside">
                <block title="Payroll Accounting" name="absar_payroll_employee_accrual" groups="base.group_system">
                    <setting id="absar_employee_accrued_salary"
                             string="Employee Accrued Salary"
                             company_dependent="1"
                             help="Choose the accrued salary liability account that must remain split by employee partner inside the single batched payroll journal entry.">
                        <field name="payroll_accrued_salary_account_id"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
