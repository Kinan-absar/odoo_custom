<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_absar_payroll_accrual" model="ir.ui.view">
        <field name="name">res.company.form.absar.payroll.accrual</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Payroll Accounting" name="absar_payroll_accounting">
                    <group>
                        <field name="payroll_accrued_salary_account_id"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <div class="text-muted">
                        Keep Payroll &gt; Settings &gt; Batch Account Move Lines enabled.
                        This account will be split by employee partner inside the single payroll journal entry.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
