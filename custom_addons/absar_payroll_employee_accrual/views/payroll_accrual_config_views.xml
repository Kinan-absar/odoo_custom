<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_absar_payroll_accrual_form" model="ir.ui.view">
        <field name="name">absar.payroll.accrual.config.form</field>
        <field name="model">absar.payroll.accrual.config</field>
        <field name="arch" type="xml">
            <form string="Employee Accrued Salary">
                <sheet>
                    <div class="oe_title">
                        <h1>Employee Accrued Salary</h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="accrued_salary_account_id"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <div class="text-muted mt16">
                        Keep Batch Account Move Lines enabled. The selected liability account
                        remains in one payroll journal entry while its balance is split into
                        one line per employee partner.
                    </div>
                </sheet>
                <footer>
                    <button string="Save" name="action_save" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_absar_payroll_accrual_settings" model="ir.actions.act_window">
        <field name="name">Employee Accrued Salary</field>
        <field name="res_model">absar.payroll.accrual.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_res_config_settings_absar_payroll_accrual_form"/>
        <field name="target">current</field>
    </record>

    <function model="res.config.settings" name="_absar_ensure_payroll_config_menu"/>
</odoo>
