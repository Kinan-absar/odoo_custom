<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sharepoint_archive_config_list" model="ir.ui.view">
        <field name="name">sharepoint.archive.config.list</field>
        <field name="model">sharepoint.archive.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="hostname"/>
                <field name="site_path"/>
                <field name="drive_name"/>
                <field name="auto_archive"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sharepoint_archive_config_form" model="ir.ui.view">
        <field name="name">sharepoint.archive.config.form</field>
        <field name="model">sharepoint.archive.config</field>
        <field name="arch" type="xml">
            <form string="SharePoint Accounting Archive">
                <header>
                    <button name="action_test_connection" type="object" string="Test &amp; Resolve Connection" class="btn-primary"/>
                    <button name="%(action_sharepoint_historical_archive_wizard)d" type="action" string="Archive Historical Documents" class="btn-secondary" groups="account.group_account_manager"/>
                </header>
                <sheet>
                    <group>
                        <group string="Microsoft Entra ID">
                            <field name="company_id"/>
                            <field name="tenant_id" password="True"/>
                            <field name="client_id" password="True"/>
                            <field name="client_secret" password="True" groups="base.group_system"/>
                        </group>
                        <group string="SharePoint">
                            <field name="hostname" placeholder="contoso.sharepoint.com"/>
                            <field name="site_path" placeholder="/sites/Finance"/>
                            <field name="drive_name"/>
                            <field name="root_folder"/>
                            <field name="site_id"/>
                            <field name="drive_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Automation">
                            <field name="auto_archive"/>
                            <field name="archive_entries"/>
                            <field name="archive_vendor_bills"/>
                            <field name="archive_customer_invoices"/>
                            <field name="include_attachments"/>
                            <field name="active"/>
                        </group>
                        <group string="Connection Status">
                            <field name="last_test_at"/>
                            <field name="last_test_message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sharepoint_archive_config" model="ir.actions.act_window">
        <field name="name">SharePoint Archive</field>
        <field name="res_model">sharepoint.archive.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sharepoint_archive_config"
              name="SharePoint Archive"
              parent="account.menu_finance_configuration"
              action="action_sharepoint_archive_config"
              sequence="95"
              groups="base.group_system"/>
</odoo>
