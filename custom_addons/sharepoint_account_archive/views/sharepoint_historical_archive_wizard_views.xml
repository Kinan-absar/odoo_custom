<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sharepoint_historical_archive_wizard_form" model="ir.ui.view">
        <field name="name">sharepoint.historical.archive.wizard.form</field>
        <field name="model">sharepoint.historical.archive.wizard</field>
        <field name="arch" type="xml">
            <form string="Archive Historical Journal Vouchers">
                <group>
                    <field name="company_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="journal_id" options="{'no_create': True}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Only posted Journal Entries / JVs are queued. Entries already archived in SharePoint are skipped. The scheduled archive job processes the queue in batches.
                </div>
                <footer>
                    <button name="action_queue_archive" type="object" string="Queue for SharePoint Archive" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sharepoint_historical_archive_wizard" model="ir.actions.act_window">
        <field name="name">Archive Historical JVs</field>
        <field name="res_model">sharepoint.historical.archive.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
