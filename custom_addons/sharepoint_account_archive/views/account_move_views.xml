<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sharepoint_archive" model="ir.ui.view">
        <field name="name">account.move.form.sharepoint.archive</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sharepoint_archive_now"
                        type="object"
                        string="Archive to SharePoint"
                        class="btn-secondary"
                        groups="account.group_account_manager"
                        invisible="state != 'posted' or sharepoint_archive_state == 'archived'"/>
                <button name="action_sharepoint_retry"
                        type="object"
                        string="Retry SharePoint"
                        groups="account.group_account_manager"
                        invisible="sharepoint_archive_state != 'failed'"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="SharePoint Archive" groups="account.group_account_manager">
                    <field name="sharepoint_archive_state" widget="badge"/>
                    <field name="sharepoint_archived_at" invisible="sharepoint_archive_state != 'archived'"/>
                    <field name="sharepoint_attempts"/>
                    <field name="sharepoint_web_url" widget="url" invisible="not sharepoint_web_url"/>
                    <field name="sharepoint_error" invisible="sharepoint_archive_state != 'failed'"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_sharepoint_archive" model="ir.ui.view">
        <field name="name">account.move.list.sharepoint.archive</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="sharepoint_archive_state" optional="hide" widget="badge"/>
            </xpath>
        </field>
    </record>
</odoo>
