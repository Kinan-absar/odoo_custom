<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_journal_voucher" model="ir.actions.report">
        <field name="name">Accounting Archive Copy</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sharepoint_account_archive.report_journal_voucher_document</field>
        <field name="report_file">sharepoint_account_archive.report_journal_voucher_document</field>
        <field name="print_report_name">'Archive - %s' % (object.name or 'Journal Entry')</field>
    </record>

    <template id="report_journal_voucher_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Accounting Archive Copy</h2>
                        <table class="table table-sm table-borderless mb-3">
                            <tbody>
                                <tr><td><strong>Number</strong></td><td><span t-field="o.name"/></td></tr>
                                <tr><td><strong>Date</strong></td><td><span t-field="o.date"/></td></tr>
                                <tr><td><strong>Journal</strong></td><td><span t-field="o.journal_id"/></td></tr>
                                <tr t-if="o.partner_id"><td><strong>Partner</strong></td><td><span t-field="o.partner_id"/></td></tr>
                                <tr t-if="o.ref"><td><strong>Reference</strong></td><td><span t-field="o.ref"/></td></tr>
                            </tbody>
                        </table>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th>Partner</th>
                                    <th>Label</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.account_id"/></td>
                                    <td><span t-field="line.partner_id"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.debit"/></td>
                                    <td class="text-end"><span t-field="line.credit"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total</strong></td>
                                    <td class="text-end"><strong><span t-esc="sum(o.line_ids.mapped('debit'))" t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'/></strong></td>
                                    <td class="text-end"><strong><span t-esc="sum(o.line_ids.mapped('credit'))" t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'/></strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p class="text-muted mt-3">Generated automatically from Odoo for external accounting archive purposes.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
