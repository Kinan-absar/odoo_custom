<odoo>
 <record id="station_form" model="ir.ui.view"><field name="name">absar.print.station.form</field><field name="model">absar.print.station</field><field name="arch" type="xml"><form><header><button name="action_pair" type="object" string="Pair / Renew Key" class="btn-primary" groups="absar_direct_print.group_print_manager"/><button name="action_revoke" type="object" string="Revoke Key" confirm="Disconnect this station?" groups="absar_direct_print.group_print_manager"/></header><sheet><group><field name="name"/><field name="active"/><field name="company_id"/><field name="printer_name"/><field name="allowed_user_ids" widget="many2many_tags"/></group><group string="Windows app"><field name="last_seen"/><field name="client_printers"/></group></sheet></form></field></record>
 <record id="station_list" model="ir.ui.view"><field name="name">absar.print.station.list</field><field name="model">absar.print.station</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="printer_name"/><field name="last_seen"/><field name="active"/></list></field></record>
 <record id="pair_form" model="ir.ui.view"><field name="name">absar.print.pair.form</field><field name="model">absar.print.pair</field><field name="arch" type="xml"><form string="Connect the Windows App"><p>Copy the URL and pairing key into the Windows app. Treat the key like a password. Renewing it disconnects the previous key.</p><group><field name="station_id"/><field name="url"/><field name="token"/></group><footer><button string="Close" special="cancel"/></footer></form></field></record>
 <record id="wizard_form" model="ir.ui.view">
  <field name="name">absar.print.wizard.form</field><field name="model">absar.print.wizard</field>
  <field name="arch" type="xml"><form string="Print">
   <field name="payload" invisible="1"/><field name="available_report_ids" invisible="1"/>
   <group><field name="report_id" string="Report" domain="[('id', 'in', available_report_ids)]" options="{'no_create': True, 'no_open': True}"/>
    <field name="station_id" string="Office printer" required="1" options="{'no_create': True, 'no_open': True}"/><field name="copies"/></group>
   <footer><button name="action_office" type="object" string="Print" icon="fa-print" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer>
  </form></field>
 </record>
 <record id="job_list" model="ir.ui.view"><field name="name">absar.print.job.list</field><field name="model">absar.print.job</field><field name="arch" type="xml"><list create="0" decoration-danger="state in ('failed','uncertain')" decoration-success="state == 'submitted'"><field name="create_date"/><field name="name"/><field name="station_id"/><field name="user_id"/><field name="copies"/><field name="state" widget="badge"/><field name="message"/></list></field></record>
 <record id="job_form" model="ir.ui.view"><field name="name">absar.print.job.form</field><field name="model">absar.print.job</field><field name="arch" type="xml"><form create="0" edit="0"><header><button name="action_cancel" type="object" string="Cancel" invisible="state != 'queued'"/><button name="action_retry" type="object" string="Retry" groups="absar_direct_print.group_print_manager" invisible="state not in ('failed','uncertain')" confirm="Check the printer first. Retrying can print another copy if the previous job already printed."/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="station_id"/><field name="user_id"/><field name="create_date"/><field name="copies"/><field name="printer_name"/><field name="claimed_at"/><field name="finished_at"/><field name="message"/></group><p>Sent to Windows means the PDF was handed to the Windows print system. It does not confirm that paper has physically printed.</p></sheet></form></field></record>
 <record id="user_print_preferences" model="ir.ui.view"><field name="name">res.users.print.preferences</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form_simple_modif"/><field name="arch" type="xml"><xpath expr="//form" position="inside"><group string="Direct Print" groups="absar_direct_print.group_print_user"><field name="absar_print_station_id" options="{'no_create': True}"/></group></xpath></field></record>
 <record id="user_print_admin" model="ir.ui.view"><field name="name">res.users.print.admin</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Direct Print"><field name="absar_print_station_id" options="{'no_create': True}"/></group></xpath></field></record>
 <record id="action_stations" model="ir.actions.act_window"><field name="name">Office Stations</field><field name="res_model">absar.print.station</field><field name="view_mode">list,form</field></record>
 <record id="action_jobs" model="ir.actions.act_window"><field name="name">Print Jobs</field><field name="res_model">absar.print.job</field><field name="view_mode">list,form</field></record>
 <menuitem id="print_root" name="Direct Print" parent="base.menu_administration" sequence="80" groups="absar_direct_print.group_print_user"/>
 <menuitem id="print_jobs" name="Print Jobs" parent="print_root" action="action_jobs" sequence="10"/>
 <menuitem id="print_stations" name="Office Stations" parent="print_root" action="action_stations" sequence="20" groups="absar_direct_print.group_print_manager"/>
 <record id="cron_cleanup" model="ir.cron"><field name="name">Direct Print: expire documents</field><field name="model_id" ref="model_absar_print_job"/><field name="state">code</field><field name="code">model._gc_jobs()</field><field name="interval_number">1</field><field name="interval_type">days</field></record>
</odoo>