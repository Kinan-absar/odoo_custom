<odoo>
 <record id="group_print_user" model="res.groups"><field name="name">Direct Print User</field><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
 <record id="group_print_manager" model="res.groups"><field name="name">Direct Print Manager</field><field name="implied_ids" eval="[(4, ref('group_print_user'))]"/><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
 <record id="station_company_rule" model="ir.rule"><field name="name">Print stations: companies</field><field name="model_id" ref="model_absar_print_station"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="job_company_rule" model="ir.rule"><field name="name">Print jobs: companies</field><field name="model_id" ref="model_absar_print_job"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
 <record id="job_user_rule" model="ir.rule"><field name="name">Print jobs: own</field><field name="model_id" ref="model_absar_print_job"/><field name="groups" eval="[(4,ref('group_print_user'))]"/><field name="domain_force">[('user_id','=',user.id)]</field></record>
 <record id="job_manager_rule" model="ir.rule"><field name="name">Print jobs: managers</field><field name="model_id" ref="model_absar_print_job"/><field name="groups" eval="[(4,ref('group_print_manager'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
</odoo>