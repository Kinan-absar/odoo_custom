        <field name="model_id" ref="model_material_request_line"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- PORTAL REPORTS: portal users only see reports shared with one of their groups -->
    <record id="portal_report_document_group_rule" model="ir.rule">
        <field name="name">Portal Reports: Visible Portal Groups Only</field>
        <field name="model_id" ref="model_portal_report_document"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_employee')])]"/>
        <field name="domain_force">[('active', '=', True), ('allowed_group_ids', 'in', user.groups_id.ids)]</field>
    </record>

    <record id="portal_report_document_manager_rule" model="ir.rule">
        <field name="name">Portal Reports: Manager All Records</field>
        <field name="model_id" ref="model_portal_report_document"/>
        <field name="groups" eval="[(4, ref('employee_portal_suite.group_portal_report_uploader'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- PORTAL REPORT SEEN MARKERS: every user (incl. portal) can only access their own marker rows -->
    <record id="portal_report_seen_own_rule" model="ir.rule">
        <field name="name">Portal Report Seen: Own Records Only</field>
        <field name="model_id" ref="model_portal_report_seen"/>
        <field name="groups" eval="[]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- CALLING: users (portal or internal) only ever see call sessions they are part of -->
    <record id="portal_call_session_participant_rule" model="ir.rule">
        <field name="name">Portal Call Session: Participants Only</field>
        <field name="model_id" ref="model_portal_call_session"/>
        <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('employee_portal_suite.group_employee_portal'))]"/>
        <field name="domain_force">[('participant_ids', 'in', [user.id])]</field>
    </record>

    <!-- CALLING: Employee Portal Administrators can inspect full call history. -->
    <record id="portal_call_session_admin_rule" model="ir.rule">
        <field name="name">Portal Call Session: Super Administrator Full Read Access</field>
        <field name="model_id" ref="model_portal_call_session"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_superadmin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- CALLING: signals are only ever visible to their intended recipient -->
    <record id="portal_call_signal_recipient_rule" model="ir.rule">
        <field name="name">Portal Call Signal: Recipient Only</field>
        <field name="model_id" ref="model_portal_call_signal"/>
        <field name="groups" eval="[]"/>
        <field name="domain_force">[('recipient_id', '=', user.id)]</field>
    </record>

    <!-- CALLING: portal users only see contact entries where they are the portal side -->
    <record id="portal_call_contact_portal_rule" model="ir.rule">
        <field name="name">Portal Call Contact: Portal Side Only</field>
        <field name="model_id" ref="model_portal_call_contact"/>
        <field name="groups" eval="[(4, ref('employee_portal_suite.group_employee_portal'))]"/>
        <field name="domain_force">[('portal_user_id', '=', user.id)]</field>
    </record>

    <!-- CALLING: internal users only see contact entries where they are the internal side,
         except admins who manage the full allow-list -->
    <record id="portal_call_contact_internal_rule" model="ir.rule">
        <field name="name">Portal Call Contact: Internal Side Only</field>
        <field name="model_id" ref="model_portal_call_contact"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('internal_user_id', '=', user.id)]</field>
    </record>

    <record id="portal_call_contact_admin_rule" model="ir.rule">
        <field name="name">Portal Call Contact: Admin Full Access</field>
        <field name="model_id" ref="model_portal_call_contact"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- EMPLOYEE CHAT: users can only read conversations they participate in. -->
    <record id="portal_chat_thread_participant_rule" model="ir.rule">
        <field name="name">Employee Chat: Participants Only</field>
        <field name="model_id" ref="model_portal_chat_thread"/>
        <field name="groups" eval="[]"/>
        <field name="domain_force">[('participant_ids', 'in', [user.id])]</field>
    </record>

    <record id="portal_chat_read_own_rule" model="ir.rule">
        <field name="name">Employee Chat Read State: Own Only</field>
        <field name="model_id" ref="model_portal_chat_read"/>
        <field name="groups" eval="[]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- EMPLOYEE PORTAL CHANNELS: selected portal members may read portal-enabled Odoo Channels.
         This supplements Odoo's standard channel rule (which normally restricts Channels to internal groups). -->
    <record id="portal_discuss_channel_member_access_rule" model="ir.rule">
        <field name="name">Employee Portal: Read Selected Discuss Channels</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('channel_type', '=', 'channel'), ('employee_portal_access', 'in', ('read_only', 'read_write')), ('is_member', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_discuss_channel_member_rows_rule" model="ir.rule">
        <field name="name">Employee Portal: Read Members of Selected Discuss Channels</field>
        <field name="model_id" ref="mail.model_discuss_channel_member"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('channel_id.channel_type', '=', 'channel'), ('channel_id.employee_portal_access', 'in', ('read_only', 'read_write')), ('channel_id.is_member', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- CONFIGURATION: Super Admins may manage only this suite's own roles from the dedicated page. -->
    <record id="employee_portal_superadmin_groups_rule" model="ir.rule">
        <field name="name">Employee Portal Groups: Legacy Direct Access Disabled</field>
        <field name="model_id" ref="base.model_res_groups"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_superadmin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="active" eval="False"/>
    </record>


