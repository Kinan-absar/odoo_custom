        <field name="domain_force">[(1, '=', 1)] if user.has_group('employee_portal_suite.group_employee_portal_admin') else [('request_id.employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="material_request_line_purchase_rule" model="ir.rule">
