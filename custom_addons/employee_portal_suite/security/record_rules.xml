        <field name="domain_force">[('material_request_id.store_manager_user_id', '=', user.id)]</field>
    </record>

    <record id="workflow_approval_line_mr_project_rule" model="ir.rule">
        <field name="name">Workflow Approval Line: Project Manager Scope</field>
        <field name="model_id" ref="model_employee_portal_workflow_approval_line"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_mr_project_manager')])]"/>
        <field name="domain_force">[('material_request_id.project_manager_user_id', '=', user.id)]</field>
    </record>

    <record id="workflow_approval_line_mr_purchase_rule" model="ir.rule">
        <field name="name">Workflow Approval Line: Purchase Representative All MR</field>
        <field name="model_id" ref="model_employee_portal_workflow_approval_line"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_mr_purchase_rep')])]"/>
        <field name="domain_force">[('material_request_id', '!=', False)]</field>
    </record>

    <record id="workflow_approval_line_mr_director_rule" model="ir.rule">
        <field name="name">Workflow Approval Line: Projects Director All MR</field>
        <field name="model_id" ref="model_employee_portal_workflow_approval_line"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_mr_projects_director')])]"/>
        <field name="domain_force">[('material_request_id', '!=', False)]</field>
    </record>

    <record id="workflow_approval_line_ceo_rule" model="ir.rule">
        <field name="name">Workflow Approval Line: CEO All Requests</field>
        <field name="model_id" ref="model_employee_portal_workflow_approval_line"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_ceo')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="workflow_approval_line_admin_rule" model="ir.rule">
        <field name="name">Workflow Approval Line: Administrator All Requests</field>
        <field name="model_id" ref="model_employee_portal_workflow_approval_line"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_admin')])]"/>
