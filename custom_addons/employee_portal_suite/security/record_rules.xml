        <field name="name">Material Request: CEO All Records</field>
        <field name="model_id" ref="model_material_request"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_ceo')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="material_request_superadmin_rule" model="ir.rule">
