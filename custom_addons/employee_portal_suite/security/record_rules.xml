<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- EMPLOYEE REQUESTS: role scopes are ADDITIVE (group rules OR) -->
    <!-- ========================================================= -->
    <record id="employee_request_portal_rule" model="ir.rule">
        <field name="name">Employee Request: Employee Own Records</field>
        <field name="model_id" ref="model_employee_request"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_employee')])]"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('employee_portal_suite.group_employee_portal_admin') else [('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="employee_request_manager_rule" model="ir.rule">
        <field name="name">Employee Request: Manager Own + Subordinates</field>
        <field name="model_id" ref="model_employee_request"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('employee_portal_suite.group_employee_portal_admin') else ['|', ('manager_id.user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
    </record>

    <!-- Broad functional roles widen visibility even when the same user is also Manager/Employee. -->
    <record id="employee_request_hr_rule" model="ir.rule">
        <field name="name">Employee Request: HR All Records</field>
        <field name="model_id" ref="model_employee_request"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_hr')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="employee_request_finance_rule" model="ir.rule">
        <field name="name">Employee Request: Finance All Records</field>
        <field name="model_id" ref="model_employee_request"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_finance')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="employee_request_ceo_rule" model="ir.rule">
        <field name="name">Employee Request: CEO All Records</field>
        <field name="model_id" ref="model_employee_request"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_ceo')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="employee_request_admin_rule" model="ir.rule">
        <field name="name">Employee Request: Administrator All Records</field>
        <field name="model_id" ref="model_employee_request"/>
        <field name="groups" eval="[(6, 0, [ref('employee_portal_suite.group_employee_portal_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

