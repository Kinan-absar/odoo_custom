<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_employee_portal_suite" model="ir.module.category">
        <field name="name">Employee Portal Suite</field>
        <field name="description">Employee Portal Suite roles and permissions</field>
        <field name="sequence">45</field>
    </record>

    <!-- ============================= -->
    <!-- EMPLOYEE PORTAL GROUPS        -->
    <!-- ============================= -->

    <record id="group_employee_portal" model="res.groups">
        <field name="name">Employee Portal: Technical Base Access</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
        <field name="comment">Technical group. Automatically assigned from Employee → Related User; do not manage manually.</field>
         
    </record>

    <record id="group_employee_portal_employee" model="res.groups">
        <field name="name">Employee Portal: Technical Employee Access</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
        <field name="comment">Technical baseline employee-access group. Automatically assigned from Employee → Related User; do not manage manually.</field>
         
    </record>

    <record id="group_employee_portal_manager" model="res.groups">
        <field name="name">Employee Portal: Manager</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_employee_portal_hr" model="res.groups">
        <field name="name">Employee Portal: HR</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_employee_portal_finance" model="res.groups">
        <field name="name">Employee Portal: Finance</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_employee_portal_ceo" model="res.groups">
        <field name="name">Employee Portal: CEO</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_employee_portal_admin" model="res.groups">
        <field name="name">Employee Portal: Administrator</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_employee_portal_superadmin" model="res.groups">
        <field name="name">Employee Portal: Super Administrator</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
        <field name="implied_ids" eval="[(4, ref('employee_portal_suite.group_employee_portal_admin'))]"/>
        <field name="comment">Sensitive Employee Portal administration: Roles &amp; Permissions and protected configuration.</field>
    </record>


    <!-- ============================= -->
    <!-- MATERIAL REQUEST APPROVER ROLES -->
    <!-- ============================= -->

    <record id="group_mr_purchase_rep" model="res.groups">
        <field name="name">Material Request: Purchase Representative</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_mr_store_manager" model="res.groups">
        <field name="name">Material Request: Store Manager</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_mr_project_manager" model="res.groups">
        <field name="name">Material Request: Project Manager</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <record id="group_mr_projects_director" model="res.groups">
        <field name="name">Material Request: Projects Director</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>
    <record id="group_employee_portal_announcement_manager" model="res.groups">
        <field name="name">Employee Portal: Announcement Manager</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
         
    </record>

    <!-- Attendance-only users: can check in/out via the portal, nothing else -->
    <record id="group_attendance_only" model="res.groups">
        <field name="name">Employee Portal: Attendance Only</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
    </record>

    <!-- Controls which portal employees can access the attendance check-in/out page -->
    <record id="group_portal_attendance_user" model="res.groups">
        <field name="name">Employee Portal: Attendance User</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
    </record>



    <!-- Can view the Instant Salary Report in read-only mode -->
    <record id="group_salary_report_viewer" model="res.groups">
        <field name="name">Employee Portal: Salary Report Viewer</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
    </record>


    <!-- Can upload PDF reports that are visible to selected portal groups -->
    <record id="group_portal_report_uploader" model="res.groups">
        <field name="name">Employee Portal: Portal Reports Manager</field>
        <field name="category_id" ref="employee_portal_suite.module_category_employee_portal_suite"/>
    </record>

</odoo>
