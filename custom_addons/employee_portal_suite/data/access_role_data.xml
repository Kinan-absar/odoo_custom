<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Feature access: group first -> select users -->
    <record id="access_role_employee_portal" model="employee.portal.access.role">
        <field name="name">Employee Portal</field>
        <field name="section">feature</field>
        <field name="sequence">10</field>
        <field name="group_id" ref="employee_portal_suite.group_employee_portal_employee"/>
        <field name="notes">Users who can use the main Employee Portal features.</field>
    </record>
    <record id="access_role_attendance" model="employee.portal.access.role">
        <field name="name">Attendance</field>
        <field name="section">feature</field>
        <field name="sequence">20</field>
        <field name="group_id" ref="employee_portal_suite.group_portal_attendance_user"/>
        <field name="notes">Users allowed to check in/out and access portal attendance.</field>
    </record>
    <record id="access_role_attendance_only" model="employee.portal.access.role">
        <field name="name">Attendance Only</field>
        <field name="section">feature</field>
        <field name="sequence">25</field>
        <field name="group_id" ref="employee_portal_suite.group_attendance_only"/>
        <field name="notes">Restricted portal users who should only use attendance.</field>
    </record>
    <record id="access_role_salary_viewer" model="employee.portal.access.role">
        <field name="name">Salary Report Viewer</field>
        <field name="section">feature</field>
        <field name="sequence">30</field>
        <field name="group_id" ref="employee_portal_suite.group_salary_report_viewer"/>
    </record>

    <!-- Global approval roles -->
    <record id="access_role_request_manager" model="employee.portal.access.role">
        <field name="name">Employee Request - Manager Approver</field>
        <field name="section">approval</field>
        <field name="sequence">10</field>
        <field name="group_id" ref="employee_portal_suite.group_employee_portal_manager"/>
    </record>
    <record id="access_role_hr" model="employee.portal.access.role">
        <field name="name">HR Approver</field>
        <field name="section">approval</field>
        <field name="sequence">20</field>
        <field name="group_id" ref="employee_portal_suite.group_employee_portal_hr"/>
    </record>
    <record id="access_role_finance" model="employee.portal.access.role">
        <field name="name">Finance Approver</field>
        <field name="section">approval</field>
        <field name="sequence">30</field>
        <field name="group_id" ref="employee_portal_suite.group_employee_portal_finance"/>
    </record>
    <record id="access_role_ceo" model="employee.portal.access.role">
        <field name="name">CEO Approver</field>
        <field name="section">approval</field>
        <field name="sequence">40</field>
        <field name="group_id" ref="employee_portal_suite.group_employee_portal_ceo"/>
    </record>
    <record id="access_role_purchase_rep" model="employee.portal.access.role">
        <field name="name">Material Request - Purchase Representative</field>
        <field name="section">approval</field>
        <field name="sequence">50</field>
        <field name="group_id" ref="employee_portal_suite.group_mr_purchase_rep"/>
    </record>
    <record id="access_role_projects_director" model="employee.portal.access.role">
        <field name="name">Material Request - Projects Director</field>
        <field name="section">approval</field>
        <field name="sequence">60</field>
        <field name="group_id" ref="employee_portal_suite.group_mr_projects_director"/>
    </record>

    <!-- Administration/reporting roles -->
    <record id="access_role_announcement_manager" model="employee.portal.access.role">
        <field name="name">Announcement Manager</field>
        <field name="section">admin</field>
        <field name="sequence">10</field>
        <field name="group_id" ref="employee_portal_suite.group_employee_portal_announcement_manager"/>
    </record>
    <record id="access_role_report_uploader" model="employee.portal.access.role">
        <field name="name">Portal Report Uploader</field>
        <field name="section">admin</field>
        <field name="sequence">20</field>
        <field name="group_id" ref="employee_portal_suite.group_portal_report_uploader"/>
    </record>
    <record id="access_role_portal_admin" model="employee.portal.access.role">
        <field name="name">Employee Portal Administrator</field>
        <field name="section">admin</field>
        <field name="sequence">30</field>
        <field name="group_id" ref="employee_portal_suite.group_employee_portal_admin"/>
    </record>
</odoo>
