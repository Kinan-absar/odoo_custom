<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <template id="material_request_pdf_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page eps-print"><t t-call="employee_portal_suite.request_report_styles"/>
<table class="eps-title"><colgroup><col style="width:60%"/><col style="width:40%"/></colgroup><tr><td><h2>Material Request</h2><div class="eps-subtitle">Procurement and delivery</div></td><td class="eps-right"><div class="eps-number" t-field="o.name"/><span class="eps-status" t-out="o.display_state"/></td></tr></table>
<div class="eps-card"><h3>Request Summary</h3><table class="eps-summary"><tbody><tr><td><span class="eps-label">Requested by</span><span class="eps-value" t-field="o.employee_id"/></td><td><span class="eps-label">Request date</span><span class="eps-value" t-field="o.request_date"/></td></tr><tr><td><span class="eps-label">Project</span><span class="eps-value" t-field="o.project_id"/></td><td><span class="eps-label">Required delivery</span><span class="eps-value" t-field="o.delivery_date"/></td></tr><tr><td><span class="eps-label">Worksite</span><span class="eps-value" t-field="o.worksite"/></td><td><span class="eps-label">Expense account</span><span class="eps-value" t-if="o.expense_account_id" t-field="o.expense_account_id"/><span t-else="">-</span></td></tr></tbody></table>
</div><div class="eps-card"><h3>Requested Materials</h3><table class="eps-table"><colgroup><col style="width:7%"/><col style="width:65%"/><col style="width:15%"/><col style="width:13%"/></colgroup><thead><tr><th class="eps-center">#</th><th>Material / description</th><th class="eps-right">Quantity</th><th>Unit</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td class="eps-center" t-out="line_index + 1"/><td class="eps-description"><span t-field="line.item_name"/></td><td class="eps-right"><span t-field="line.qty_required" t-options="{'widget':'float','precision':2}"/></td><td><span t-field="line.uom_id"/></td></tr><tr t-if="not o.line_ids"><td colspan="4" class="eps-muted">No material lines recorded.</td></tr></tbody></table>
</div><t t-set="legacy_steps" t-value="[('Purchase Representative', 'purchase', o.purchase_approved_by, o.purchase_approved_date, o.purchase_comment), ('Store Manager', 'store', o.store_approved_by, o.store_approved_date, o.store_comment), ('Project Manager', 'project_manager', o.project_manager_approved_by, o.project_manager_approved_date, o.project_manager_comment), ('Projects Director', 'director', o.director_approved_by, o.director_approved_date, o.director_comment), ('CEO', 'ceo', o.ceo_approved_by, o.ceo_approved_date, o.ceo_comment)]"/><t t-call="employee_portal_suite.request_report_approval_table"/>
</div>
        </t>
      </t>
    </t>
  </template>
</odoo>
