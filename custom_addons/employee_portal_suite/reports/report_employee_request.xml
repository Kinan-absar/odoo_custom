<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <template id="report_employee_request_document">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page eps-print"><t t-call="employee_portal_suite.request_report_styles"/>
<table class="eps-title"><colgroup><col style="width:60%"/><col style="width:40%"/></colgroup><tr><td><h2>Employee Request</h2><div class="eps-subtitle">Employee services</div></td><td class="eps-right"><div class="eps-number" t-field="o.name"/><span class="eps-status" t-out="o.approval_status_label"/></td></tr></table>
<table class="eps-summary"><tbody><tr><td><span class="eps-label">Requested by</span><span class="eps-value" t-field="o.employee_id"/></td><td><span class="eps-label">Request date</span><span class="eps-value" t-field="o.request_date"/></td></tr><tr><td><span class="eps-label">Project</span><span class="eps-value" t-field="o.project_id"/></td><td><span class="eps-label">Direct manager</span><span class="eps-value" t-field="o.manager_id"/></td></tr><tr><td colspan="2"><span class="eps-label">Request type</span><span class="eps-value" t-out="o.get_request_type_display()"/></td></tr><tr t-if="o.request_type == 'leave'"><td><span class="eps-label">Leave from</span><span class="eps-value" t-field="o.leave_from"/></td><td><span class="eps-label">Leave to</span><span class="eps-value" t-field="o.leave_to"/></td></tr><tr t-if="o.request_type == 'leave' and o.time_off_type_id"><td colspan="2"><span class="eps-label">Time off type</span><span class="eps-value" t-field="o.time_off_type_id"/></td></tr></tbody></table>
<h3>Request Details</h3><div class="eps-notes" t-if="o.description" t-field="o.description"/><div class="eps-notes eps-muted" t-else="">No description provided.</div>
<t t-set="legacy_steps" t-value="[('Direct Manager', 'manager', o.manager_approved_by, o.manager_approved_date, o.manager_comment), ('HR', 'hr', o.hr_approved_by, o.hr_approved_date, o.hr_comment), ('Finance', 'finance', o.finance_approved_by, o.finance_approved_date, o.finance_comment), ('CEO', 'ceo', o.ceo_approved_by, o.ceo_approved_date, o.ceo_comment)]"/><t t-call="employee_portal_suite.request_report_approval_table"/>
</div>
        </t>
      </t>
    </t>
  </template>
</odoo>
