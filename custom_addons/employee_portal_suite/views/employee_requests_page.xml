<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="employee_requests_page" name="Employee Requests Page">
        <t t-call="employee_portal_suite.employee_portal_layout">

            <div class="container mt-4">

                <div class="card shadow-sm border-0 eps-list-page-card">
                    <div class="card-body">

                        <!-- Header -->
                        <div class="material-header">

                            <!-- Top Row -->
                            <div class="material-header-top">
                                <h4 class="mb-0 fw-semibold">Employee Requests</h4>

                                <a href="/my/employee/requests/new" class="btn btn-primary btn-sm">
                                    + Create New Request
                                </a>
                            </div>

                            <!-- Search Below -->
                            <form method="get" class="material-search-form">
                                <div class="position-relative">
                                    <input type="text" id="employeeSearchInput" name="search" t-att-value="search or ''" placeholder="Search request #" class="form-control mobile-search"/>

                                    <button type="submit" class="search-btn">
                                        <i class="fa fa-search"/>
                                    </button>

                                    <t t-if="search">
                                        <a href="/my/employee/requests" class="clear-search">
                                            <i class="fa fa-times"/>
                                        </a>
                                    </t>
                                </div>
                            </form>

                        </div>


                        <!-- Requests Table -->
                        <t t-if="requests">

                            <div class="table-responsive d-none d-md-block eps-list-scroll">
                                <table class="table table-hover table-sm align-middle mb-0 eps-compact-list" style="--eps-list-width:600px">

                                    <colgroup><col style="width:125px"/><col style="width:125px"/><col style="width:150px"/><col style="width:115px"/></colgroup><thead class="table-light">
                                        <tr>
                                            <th>Request</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                            </tr>
                                    </thead>

                                    <tbody>
                                        <t t-foreach="requests" t-as="req">
                                            <tr t-att-data-eps-record-href="'/my/employee/requests/%s' % req.id" tabindex="0" role="link" class="eps-record-row">

                                                <td class="fw-semibold"><a class="eps-record-reference" t-att-href="'/my/employee/requests/%s' % req.id">
                                                    <t t-out="req.name"/>
                                                </a></td>

                                                <td>
                                                    <t t-out="req.get_request_type_display()"/>
                                                </td>

                                                <td>
                                                    <t t-out="status_badge(req)"/>
                                                </td>

                                                <td>
                                                    <small class="text-muted">
                                                        <t t-out="req.request_date"/>
                                                    </small>
                                                </td>

                                                </tr>
                                        </t>
                                    </tbody>

                                </table>
                            </div>
                         <!-- MOBILE CARD LIST -->
                            <div class="d-md-none">
                                <t t-foreach="requests" t-as="req">
                                    <a t-att-href="'/my/employee/requests/%s' % req.id" class="mobile-request-card">

                                        <div class="mobile-request-top">
                                            <div>
                                                <div class="mobile-request-id">
                                                    <t t-out="req.name"/>
                                                </div>
                                                <div class="mobile-request-date">
                                                    <t t-out="req.request_date"/>
                                                </div>
                                            </div>

                                            <div>
                                                <t t-out="status_badge(req)"/>
                                            </div>
                                        </div>

                                        <div class="mobile-request-body">
                                            <div>
                                                <span class="label">Type</span>
                                                <div>
                                                    <t t-out="req.get_request_type_display()"/>
                                                </div>
                                            </div>
                                        </div>

                                    </a>
                                </t>
                            </div>


                        </t>

                        <!-- Empty State -->
                        <t t-if="not requests">
                            <div class="text-center text-muted py-4">
                                No requests found.
                            </div>
                        </t>

                    </div>
                </div>

            </div>
        <script>
        document.addEventListener("DOMContentLoaded", function() {

            const input = document.getElementById("employeeSearchInput");
            if (!input) return;

            input.addEventListener("input", function() {
                if (this.value.trim() === "") {
                    window.location.href = "/my/employee/requests";
                }
            });

        });
        </script>

        </t>
    </template>

</odoo>
