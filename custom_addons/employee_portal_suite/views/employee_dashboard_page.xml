<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="employee_portal_dashboard" name="Employee Dashboard">
        <t t-call="employee_portal_suite.employee_portal_layout">
            <div class="st-dashboard">
                <t t-if="not request.env.user.telegram_connected and request.env['employee.portal.telegram.config'].sudo().search_count([('active','=',True),('enabled','=',True)]) &gt; 0">
                    <div class="telegram-connect-banner d-flex align-items-center justify-content-between gap-3 p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="st-module-icon"><i class="fa fa-paper-plane"/></div>
                            <div>
                                <div class="fw-bold">Connect to Telegram</div>
                                <div class="text-muted small">Receive approval alerts, attendance reminders and request updates.</div>
                            </div>
                        </div>
                        <a href="/my/employee/telegram/connect" class="btn btn-primary"><i class="fa fa-paper-plane me-1"/> Connect</a>
                    </div>
                </t>

                <section class="st-dashboard-head">
                    <h1>Good morning, <t t-esc="request.env.user.partner_id.name.split(' ')[0]"/>.</h1>
                    <p>Here's what needs your attention today.</p>
                </section>

                <section>
                    <div class="st-section-label">Needs your attention</div>
                    <div class="st-attention-grid">
                        <t t-if="employee_pending_count &gt; 0 and (request.env.user.has_group('employee_portal_suite.group_employee_portal_manager') or request.env.user.has_group('employee_portal_suite.group_employee_portal_hr') or request.env.user.has_group('employee_portal_suite.group_employee_portal_finance') or request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo'))">
                            <a href="/my/employee/approvals" class="st-attention-card">
                                <div class="st-attention-top"><div class="st-attention-icon danger"><i class="fa fa-check-square-o"/></div><span class="badge bg-danger">Action required</span></div>
                                <h3><t t-esc="employee_pending_count"/> Employee Request<t t-if="employee_pending_count != 1">s</t></h3>
                                <p>Waiting for your review in the employee approval workflow.</p>
                                <div class="st-card-action">Review Requests</div>
                            </a>
                        </t>
                        <t t-if="material_pending_count &gt; 0 and (request.env.user.has_group('employee_portal_suite.group_mr_purchase_rep') or request.env.user.has_group('employee_portal_suite.group_mr_store_manager') or request.env.user.has_group('employee_portal_suite.group_mr_project_manager') or request.env.user.has_group('employee_portal_suite.group_mr_projects_director') or request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo'))">
                            <a href="/my/employee/material/approvals" class="st-attention-card">
                                <div class="st-attention-top"><div class="st-attention-icon warn"><i class="fa fa-clipboard"/></div><span class="badge bg-warning">Pending</span></div>
                                <h3><t t-esc="material_pending_count"/> Material Request<t t-if="material_pending_count != 1">s</t></h3>
                                <p>Material requests are waiting for your approval stage.</p>
                                <div class="st-card-action">Review Materials</div>
                            </a>
                        </t>
                        <t t-if="pending_sign_count &gt; 0">
                            <a href="/my/employee/sign" class="st-attention-card">
                                <div class="st-attention-top"><div class="st-attention-icon warn"><i class="fa fa-pencil-square-o"/></div><span class="badge bg-warning">Signature</span></div>
                                <h3><t t-esc="pending_sign_count"/> Document<t t-if="pending_sign_count != 1">s</t></h3>
                                <p>Documents require your digital signature.</p>
                                <div class="st-card-action">Open Signatures</div>
                            </a>
                        </t>
                        <t t-if="can_use_attendance">
                            <a href="/my/employee/attendance" class="st-attention-card">
                                <div class="st-attention-top">
                                    <div class="st-attention-icon"><i class="fa fa-clock-o"/></div>
                                    <span t-att-class="'badge bg-success' if attendance_checked_in else 'badge bg-secondary'"><t t-if="attendance_checked_in">Active</t><t t-else="">Not checked in</t></span>
                                </div>
                                <h3>Attendance</h3>
                                <p><t t-if="attendance_checked_in">You are currently checked in.</t><t t-else="">Start your workday from the attendance screen.</t></p>
                                <div t-att-class="'st-card-action primary' if attendance_checked_in else 'st-card-action'"><t t-if="attendance_checked_in">Open Attendance</t><t t-else="">Check In</t></div>
                            </a>
                        </t>
                        <t t-if="employee_pending_count == 0 and material_pending_count == 0 and pending_sign_count == 0 and not can_use_attendance">
                            <div class="st-attention-card">
                                <div class="st-attention-top"><div class="st-attention-icon"><i class="fa fa-check"/></div><span class="badge bg-success">Clear</span></div>
                                <h3>You're all caught up</h3>
                                <p>There are no pending approvals or signature actions assigned to you.</p>
                                <div class="st-card-action">No action needed</div>
                            </div>
                        </t>
                    </div>
                </section>

                <div class="st-dashboard-body">
                    <section>
                        <div class="st-section-label">Workspace</div>
                        <div class="st-workspace-grid">
                            <a href="/my/employee/requests" class="st-module-card"><div class="st-module-icon"><i class="fa fa-user-plus"/></div><div><div class="st-module-title">Employee Requests</div><div class="st-module-meta"><t t-esc="my_request_count"/> total requests</div></div><i class="fa fa-angle-right st-module-arrow"/></a>
                            <a href="/my/employee/material" class="st-module-card"><div class="st-module-icon"><i class="fa fa-clipboard"/></div><div><div class="st-module-title">Material Requests</div><div class="st-module-meta"><t t-esc="my_material_count"/> total requests</div></div><i class="fa fa-angle-right st-module-arrow"/></a>
                            <t t-if="request.env.user.has_group('petty_cash_management.group_portal_petty_cash_user')"><a href="/my/employee/petty-cash" class="st-module-card"><div class="st-module-icon"><i class="fa fa-money"/></div><div><div class="st-module-title">Petty Cash</div><div class="st-module-meta">Open petty cash workspace</div></div><i class="fa fa-angle-right st-module-arrow"/></a></t>
                            <t t-if="request.env.user.has_group('employee_portal_suite.group_salary_report_viewer')"><a href="/my/employee/salary-reports" class="st-module-card"><div class="st-module-icon"><i class="fa fa-id-card-o"/></div><div><div class="st-module-title">Salary Reports</div><div class="st-module-meta"><t t-esc="salary_report_count"/> reports available</div></div><i class="fa fa-angle-right st-module-arrow"/></a></t>
                            <a href="/my/employee/sign" class="st-module-card"><div class="st-module-icon"><i class="fa fa-pencil-square-o"/></div><div><div class="st-module-title">Signatures</div><div class="st-module-meta"><t t-esc="pending_sign_count"/> awaiting signature</div></div><i class="fa fa-angle-right st-module-arrow"/></a>
                            <t t-if="portal_report_count &gt; 0"><a href="/my/employee/reports" class="st-module-card"><div class="st-module-icon"><i class="fa fa-file-text-o"/></div><div><div class="st-module-title">Reports</div><div class="st-module-meta"><t t-esc="portal_report_count"/> reports available</div></div><i class="fa fa-angle-right st-module-arrow"/></a></t>
                            <t t-if="can_use_attendance"><a href="/my/employee/attendance" class="st-module-card"><div class="st-module-icon"><i class="fa fa-calendar-check-o"/></div><div><div class="st-module-title">Attendance</div><div class="st-module-meta"><t t-if="attendance_checked_in">Currently checked in</t><t t-else="">Ready to check in</t></div></div><i class="fa fa-angle-right st-module-arrow"/></a></t>
                            <t t-if="request.env.user.has_group('employee_portal_suite.group_employee_portal_manager') or request.env.user.has_group('employee_portal_suite.group_employee_portal_hr') or request.env.user.has_group('employee_portal_suite.group_employee_portal_finance') or request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')"><a href="/my/employee/approvals" class="st-module-card"><div class="st-module-icon"><i class="fa fa-check-square-o"/></div><div><div class="st-module-title">Employee Approvals</div><div class="st-module-meta"><t t-esc="employee_pending_count"/> waiting</div></div><i class="fa fa-angle-right st-module-arrow"/></a></t>
                            <t t-if="request.env.user.has_group('employee_portal_suite.group_mr_purchase_rep') or request.env.user.has_group('employee_portal_suite.group_mr_store_manager') or request.env.user.has_group('employee_portal_suite.group_mr_project_manager') or request.env.user.has_group('employee_portal_suite.group_mr_projects_director') or request.env.user.has_group('employee_portal_suite.group_employee_portal_ceo')"><a href="/my/employee/material/approvals" class="st-module-card"><div class="st-module-icon"><i class="fa fa-tasks"/></div><div><div class="st-module-title">Material Approvals</div><div class="st-module-meta"><t t-esc="material_pending_count"/> waiting</div></div><i class="fa fa-angle-right st-module-arrow"/></a></t>
                        </div>
                        <!-- Backward-compatible extension host for installed bridge modules.
                             Existing bridge templates inherit the dashboard through //div[hasclass('row')]. -->
                        <div class="row st-legacy-bridge-grid"></div>
                    </section>

                    <section>
                        <div class="d-flex justify-content-between align-items-center"><div class="st-section-label">Recent activity</div></div>
                        <div class="st-activity-panel">
                            <t t-if="recent_activities">
                                <t t-foreach="recent_activities" t-as="act">
                                    <a t-att-href="'/my/employee/requests/%s' % act.id if act._name == 'employee.request' else '/my/employee/material/%s' % act.id" class="st-activity-item">
                                        <div class="st-activity-time"><t t-esc="act.create_date.strftime('%d %b')"/><br/><t t-esc="act.create_date.strftime('%H:%M')"/></div>
                                        <div class="st-activity-dot"><i t-att-class="'fa fa-file-text-o' if act._name == 'employee.request' else 'fa fa-clipboard'"/></div>
                                        <div class="st-activity-copy"><strong><t t-esc="act.name"/> · <t t-esc="act.state.replace('_',' ').title()"/></strong><span><t t-if="act._name == 'employee.request'">Employee Request</t><t t-else="">Material Request</t></span></div>
                                    </a>
                                </t>
                            </t>
                            <t t-else=""><div class="st-empty">No recent activity yet.</div></t>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>
</odoo>
