<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_portal_call_contact_list" model="ir.ui.view">
        <field name="name">portal.call.contact.list</field>
        <field name="model">portal.call.contact</field>
        <field name="arch" type="xml">
            <tree>
                <field name="portal_user_id"/>
                <field name="internal_user_id"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_portal_call_contact_form" model="ir.ui.view">
        <field name="name">portal.call.contact.form</field>
        <field name="model">portal.call.contact</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="portal_user_id"/>
                        <field name="internal_user_id"/>
                        <field name="note"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_portal_call_contact" model="ir.actions.act_window">
        <field name="name">Call Contacts</field>
        <field name="res_model">portal.call.contact</field>
        <field name="view_mode">list,form</field>
        <field name="help">Define which portal users are allowed to call, and be called by, which internal users.</field>
    </record>

    <record id="view_portal_call_session_list" model="ir.ui.view">
        <field name="name">portal.call.session.list</field>
        <field name="model">portal.call.session</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="caller_id"/>
                <field name="callee_id"/>
                <field name="call_type"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="answered_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <record id="action_portal_call_session" model="ir.actions.act_window">
        <field name="name">Call History</field>
        <field name="res_model">portal.call.session</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_portal_call_contact"
              name="Call Contacts"
              parent="menu_employee_portal_root"
              action="action_portal_call_contact"
              sequence="40"
              groups="employee_portal_suite.group_employee_portal_admin"/>

    <menuitem id="menu_portal_call_session"
              name="Call History"
              parent="menu_employee_portal_root"
              action="action_portal_call_session"
              sequence="41"
              groups="employee_portal_suite.group_employee_portal_admin"/>

</odoo>
