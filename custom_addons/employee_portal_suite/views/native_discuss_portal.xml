<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="ep_native_communication_actions">
        <div class="ep-native-comm-actions" t-if="not request.env.user.has_group('employee_portal_suite.group_attendance_only')">
            <a class="ep-native-comm-btn ep-native-message-btn" href="/my/employee/discuss" target="_blank" rel="noopener noreferrer" title="Open Chats" aria-label="Open Chats">
                <i class="fa fa-comments" aria-hidden="true"/>
                <span class="ep-native-unread-badge" style="display:none" aria-live="polite">0</span>
            </a>
        </div>
    </template>

    <template id="employee_native_discuss_hub" name="Chats Home">
        <t t-call="web.layout">
            <t t-set="title">Chats</t>
            <div class="ep-chats-shell" data-ep-chats-shell="1">
                <aside class="ep-chats-list-pane" data-ep-chats-list-pane="1">
                    <div class="ep-chats-list-head">
                        <div class="ep-chats-list-title">
                            <span>Chats</span>
                            <div class="ep-chats-list-actions">
                                <button type="button" class="ep-chats-icon-action" data-ep-discuss-install="1" title="Install Chats" aria-label="Install Chats">
                                    <i class="fa fa-download" aria-hidden="true"/>
                                </button>
                                <button type="button" class="ep-chats-icon-action ep-chats-icon-action-primary" data-ep-new-chat-toggle="1" title="New chat" aria-label="Start a new chat" aria-expanded="false" aria-controls="ep-native-new-chat">
                                    <i class="fa fa-plus" aria-hidden="true"/>
                                </button>
                            </div>
                        </div>
                        <div class="ep-chats-search">
                            <i class="fa fa-search" aria-hidden="true"/>
                            <input type="search" placeholder="Search chats" autocomplete="off" data-ep-chat-search="1" aria-label="Search chats"/>
                        </div>
                    </div>

                    <div id="ep-native-new-chat" class="ep-native-new-chat" role="dialog" aria-modal="false" aria-labelledby="ep-native-new-chat-title">
                        <div class="ep-native-new-chat-head">
                            <div>
                                <strong id="ep-native-new-chat-title">New chat</strong>
                                <small>Pick one or more coworkers to start a conversation</small>
                            </div>
                            <button type="button" class="ep-native-icon-btn" data-ep-new-chat-close="1" aria-label="Close new chat">&#215;</button>
                        </div>
                        <form action="/my/employee/discuss/start" method="post" data-ep-new-chat-form="1">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="ep-native-new-chat-search-wrap">
                                <i class="fa fa-search" aria-hidden="true"/>
                                <input type="text" placeholder="Search people" autocomplete="off" data-ep-people-search="1" aria-label="Search people"/>
                            </div>
                            <div class="ep-native-people-grid" data-ep-people-list="1">
                                <t t-foreach="employees" t-as="emp_user">
                                    <label class="ep-native-person-option" t-att-data-search="(emp_user['name'] or '').lower()">
                                        <input type="checkbox" name="participant_ids" t-att-value="emp_user['id']" data-ep-people-checkbox="1"/>
                                        <img t-if="emp_user['avatar']" t-att-src="emp_user['avatar']" alt=""/>
                                        <span t-if="not emp_user['avatar']" class="ep-native-avatar-fallback" t-esc="(emp_user['name'] or '?')[0:1].upper()"/>
                                        <span class="ep-native-person-copy">
                                            <span t-esc="emp_user['name']"/>
                                            <small t-att-class="'ep-native-presence ep-native-presence-%s' % emp_user['presence']"><span class="ep-native-presence-dot"/><t t-esc="emp_user['presence_label']"/></small>
                                        </span>
                                    </label>
                                </t>
                                <div t-if="not employees" class="ep-native-empty ep-native-empty-compact">
                                    <i class="fa fa-users" aria-hidden="true"/>
                                    <strong>No coworkers found</strong>
                                </div>
                                <div class="ep-native-empty ep-native-empty-compact d-none" data-ep-people-empty="1">
                                    <strong>No matching people</strong>
                                </div>
                            </div>
                            <div class="ep-native-new-chat-footer">
                                <input class="form-control ep-native-group-name d-none" type="text" name="group_name" placeholder="Group name (optional)" data-ep-group-name="1"/>
                                <div class="ep-native-new-chat-actions">
                                    <button type="button" class="btn btn-light" data-ep-new-chat-close="1">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Start chat</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="ep-chats-thread-list" data-ep-thread-list="1">
                        <t t-foreach="channels" t-as="ch">
                            <a class="ep-chats-thread" data-ep-thread="1" t-att-data-search="(ch['name'] or '').lower()" t-att-href="'/my/employee/discuss/channel/%s?embedded=1' % ch['id']">
                                <div class="ep-chats-avatar">
                                    <img t-if="ch['avatar']" t-att-src="ch['avatar']" alt=""/>
                                    <span t-if="not ch['avatar']" class="ep-chats-avatar-fallback" t-esc="(ch['name'] or '?')[0:1].upper()"/>
                                </div>
                                <div class="ep-chats-thread-copy">
                                    <strong t-esc="ch['name']"/>
                                    <small t-if="ch['is_group']">Group conversation</small>
                                    <small t-if="not ch['is_group']" t-att-class="'ep-native-presence ep-native-presence-%s' % ch['presence']"><span class="ep-native-presence-dot"/><t t-esc="ch['presence_label']"/></small>
                                </div>
                                <span t-if="ch['unread']" class="ep-native-thread-unread" t-esc="ch['unread'] if ch['unread'] &lt;= 99 else '99+'"/>
                            </a>
                        </t>
                        <div t-if="not channels" class="ep-native-empty">
                            <i class="fa fa-comments-o" aria-hidden="true"/>
                            <strong>No conversations yet</strong>
                            <span>Start a conversation with a coworker.</span>
                        </div>
                        <div class="ep-native-empty d-none" data-ep-search-empty="1">
                            <i class="fa fa-search" aria-hidden="true"/>
                            <strong>No matching chats</strong>
                        </div>
                    </div>
                </aside>

                <section class="ep-chats-conversation-pane" data-ep-chat-pane="1">
                    <div class="ep-chats-mobile-bar">
                        <button type="button" class="ep-chats-back" data-ep-chat-back="1" aria-label="Back to chats"><i class="fa fa-chevron-left" aria-hidden="true"/> <span>Chats</span></button>
                    </div>
                    <div class="ep-chats-empty-state" data-ep-chat-empty="1">
                        <i class="fa fa-comments-o" aria-hidden="true"/>
                        <h3>Chats</h3>
                        <p>Select a conversation to start messaging.</p>
                    </div>
                    <iframe name="ep_discuss_frame" class="ep-chats-frame" data-ep-discuss-frame="1" title="Conversation" allow="camera; microphone; display-capture; autoplay; clipboard-read; clipboard-write"/>
                </section>
            </div>
        </t>
    </template>

    <template id="employee_native_discuss_pwa_web_head" inherit_id="web.layout" name="Employee Discuss PWA Head">
        <xpath expr="//head" position="inside">
            <t t-if="request.httprequest.path.startswith('/my/employee/discuss')">
                <link rel="manifest" href="/my/employee/discuss/manifest.webmanifest" crossorigin="use-credentials" data-employee-discuss-pwa="1"/>
                <meta name="theme-color" content="#ffffff" data-employee-discuss-pwa="1"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
                <meta name="apple-mobile-web-app-title" content="Chats"/>
                <meta name="application-name" content="Chats"/>
                <link rel="apple-touch-icon" t-att-href="'/web/image/res.company/%s/logo/192x192' % request.env.company.id"/>
                <link rel="icon" type="image/png" t-att-href="'/web/image/res.company/%s/logo_web' % request.env.company.id"/>
            </t>
        </xpath>
    </template>

    <template id="employee_native_discuss_public_bootstrap" inherit_id="mail.discuss_public_channel_template" name="Employee Native Discuss Bootstrap">
        <xpath expr="//head" position="inside">
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss/channel/')" name="employee-portal-discuss" content="1"/>
            <meta t-if="request.params.get('embedded')" name="employee-portal-discuss-embedded" content="1"/>
            <meta t-if="request.httprequest.path == '/my/employee/discuss'" name="employee-portal-discuss-home" content="1"/>
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss')" name="employee-portal-back-url" content="/my/employee/discuss"/>
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss')" name="employee-portal-home-url" content="/my/employee"/>
            <link t-if="request.httprequest.path.startswith('/my/employee/discuss')" rel="manifest" href="/my/employee/discuss/manifest.webmanifest" crossorigin="use-credentials" data-employee-discuss-pwa="1"/>
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss')" name="theme-color" content="#ffffff" data-employee-discuss-pwa="1"/>
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss')" name="apple-mobile-web-app-capable" content="yes"/>
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss')" name="apple-mobile-web-app-title" content="Chats"/>
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss')" name="application-name" content="Chats"/>
            <link t-if="request.httprequest.path.startswith('/my/employee/discuss')" rel="apple-touch-icon" t-att-href="'/web/image/res.company/%s/logo/192x192' % request.env.company.id"/>
            <link t-if="request.httprequest.path.startswith('/my/employee/discuss')" rel="icon" type="image/png" t-att-href="'/web/image/res.company/%s/logo_web' % request.env.company.id"/>
            <meta t-if="request.httprequest.path.startswith('/my/employee/discuss')" name="employee-discuss-company-logo" t-att-content="'/web/image/res.company/%s/logo_web' % request.env.company.id"/>
        </xpath>
    </template>

</odoo>
