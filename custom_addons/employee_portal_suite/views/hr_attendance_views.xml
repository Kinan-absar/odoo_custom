<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         HR ATTENDANCE — Standalone views for HR/Admin
    ============================================================ -->

    <record id="view_hr_attendance_flag_list" model="ir.ui.view">
        <field name="name">hr.attendance.flag.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance Records"
                  decoration-danger="checkout_outside_location == True"
                  decoration-warning="auto_checked_out == True">
                <field name="employee_id"              string="Employee"/>
                <field name="check_in"                 string="Check In"/>
                <field name="check_out"                string="Check Out"/>
                <field name="check_in_work_location_id" string="Work Location" optional="show"/>
                <field name="check_in_project_id"      string="Check-in Project" optional="show"/>
                <field name="check_out_project_id"     string="Check-out Project" optional="hide"/>
                <field name="worked_hours"             string="Worked Hours" widget="float_time"/>
                <field name="auto_checked_out"         string="Auto Checkout"/>
                <field name="checkout_outside_location" string="Outside Location"/>
                <field name="attendance_exception_state" string="Status"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_flag_form" model="ir.ui.view">
        <field name="name">hr.attendance.flag.form</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
            <header>
                <button name="action_resolve_attendance_exception"
                        string="Mark as Resolved"
                        type="object"
                        class="btn-primary"
                        invisible="attendance_exception_state == 'resolved'"/>
                <field name="attendance_exception_state"
                    widget="statusbar"
                    statusbar_visible="pending,resolved"/>
            </header>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="check_in"/>
                        <field name="check_out"/>
                        <field name="check_in_work_location_id"/>
                        <field name="check_in_project_id"/>
                        <field name="check_in_project_location_id"/>
                        <field name="check_in_project_distance"/>
                        <field name="check_out_work_location_id"/>
                        <field name="check_out_project_id"/>
                        <field name="check_out_project_location_id"/>
                        <field name="check_out_project_distance"/>
                        <field name="worked_hours" widget="float_time"/>
                        <field name="auto_checked_out"
                               string="Automatically Checked Out"
                               readonly="1"/>
                        <field name="checkout_outside_location"
                               string="Checked Out Outside Location"
                               readonly="1"/>
                        <field name="attendance_exception_state" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_attendance_flag_search" model="ir.ui.view">
        <field name="name">hr.attendance.flag.search</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="employee_id" string="Employee"/>
                <field name="check_in_project_id" string="Project"/>
                <separator/>
                <filter string="Auto Checked Out"
                        name="auto_checked_out"
                        domain="[('auto_checked_out','=',True)]"/>
                <filter string="Outside Location Check-outs"
                        name="checkout_outside_location"
                        domain="[('checkout_outside_location','=',True)]"/>
                <group>
                    <filter string="Employee"       name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'check_in_project_id'}"/>
                    <filter string="Check-In Date"  name="group_date"     context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Actions
    ============================================================ -->

    <record id="action_attendance_auto_checkout" model="ir.actions.act_window">
        <field name="name">Auto Checked-Out Records</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('auto_checked_out', '=', True), ('attendance_exception_state', '=', 'pending')]</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id':ref('view_hr_attendance_flag_list')}),
            (0,0,{'view_mode':'form','view_id':ref('view_hr_attendance_flag_form')}),
        ]"/>
        <field name="search_view_id" ref="view_hr_attendance_flag_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No auto check-outs recorded yet.</p>
            <p>Records appear here when Odoo's automatic checkout closed an attendance
               because the employee forgot to check out manually.</p>
        </field>
    </record>

    <record id="action_attendance_outside_location" model="ir.actions.act_window">
        <field name="name">Outside Location Check-outs</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('checkout_outside_location', '=', True), ('attendance_exception_state', '=', 'pending')]</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id':ref('view_hr_attendance_flag_list')}),
            (0,0,{'view_mode':'form','view_id':ref('view_hr_attendance_flag_form')}),
        ]"/>
        <field name="search_view_id" ref="view_hr_attendance_flag_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No outside-location check-outs recorded yet.</p>
            <p>This list shows every check-out where the employee was outside their work location geofence.</p>
        </field>
    </record>

    <!-- ============================================================
         Menus
    ============================================================ -->

    <menuitem id="menu_employee_portal_attendance_root"
              name="Attendance"
              parent="menu_employee_portal_root"
              sequence="40"
              groups="employee_portal_suite.group_employee_portal_hr,employee_portal_suite.group_employee_portal_admin"/>

    <menuitem id="menu_attendance_auto_checkout"
              name="Auto Checked-Out"
              parent="menu_employee_portal_attendance_root"
              action="action_attendance_auto_checkout"
              sequence="20"
              groups="employee_portal_suite.group_employee_portal_hr,employee_portal_suite.group_employee_portal_admin"/>

    <menuitem id="menu_attendance_outside_location"
              name="Outside Location Check-outs"
              parent="menu_employee_portal_attendance_root"
              action="action_attendance_outside_location"
              sequence="30"
              groups="employee_portal_suite.group_employee_portal_hr,employee_portal_suite.group_employee_portal_admin"/>


    <!-- Add detected project information to Odoo's standard Attendance views. -->
    <record id="view_hr_attendance_project_standard_form" model="ir.ui.view">
        <field name="name">hr.attendance.project.standard.form</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="check_in_work_location_id" readonly="1"/>
                        <field name="check_in_project_id" readonly="1"/>
            </xpath>
            <xpath expr="//group[@name='check_in_group']" position="inside">
                <group string="Detected Project">
                    <field name="check_in_project_location_id" readonly="1"/>
                    <field name="check_in_project_distance" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='check_out_group']" position="inside">
                <group string="Detected Project">
                    <field name="check_out_work_location_id" readonly="1"/>
                        <field name="check_out_project_id" readonly="1"/>
                    <field name="check_out_project_location_id" readonly="1"/>
                    <field name="check_out_project_distance" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_hr_attendance_project_standard_list" model="ir.ui.view">
        <field name="name">hr.attendance.project.standard.list</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="check_in_work_location_id" string="Work Location" optional="show"/>
                <field name="check_in_project_id" string="Project" optional="show"/>
                <field name="check_out_project_id" string="Check-out Project" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_attendance_project_standard_search" model="ir.ui.view">
        <field name="name">hr.attendance.project.standard.search</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="check_in_project_id" string="Project"/>
            </xpath>
            <xpath expr="//filter[@name='employee']" position="after">
                <filter string="Project" name="project" context="{'group_by': 'check_in_project_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
