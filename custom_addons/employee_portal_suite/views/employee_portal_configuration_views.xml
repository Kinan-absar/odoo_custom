<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Central place to manage the REAL security groups used by the suite. -->
    <record id="view_employee_portal_suite_groups_list" model="ir.ui.view">
        <field name="name">employee.portal.suite.groups.list</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <list string="Employee Portal Roles" create="0" delete="0">
                <field name="name"/>
                <field name="users" widget="many2many_tags"/>
                <field name="comment" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_employee_portal_suite_roles" model="ir.actions.act_window">
        <field name="name">Roles &amp; Permissions</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_employee_portal_suite_groups_list"/>
        <field name="domain" eval="[('category_id', '=', ref('employee_portal_suite.module_category_employee_portal_suite'))]"/>
        <field name="context" eval="{'default_category_id': ref('employee_portal_suite.module_category_employee_portal_suite')}"/>
        <field name="help" type="html">
            <p>Manage Employee Portal Suite role membership here. Roles are additive: assigning an additional role widens access according to that role instead of being blocked by a narrower role.</p>
        </field>
    </record>

    <menuitem id="menu_employee_portal_configuration"
              name="Configuration"
              parent="employee_portal_suite.menu_employee_portal_root"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_employee_portal_roles_permissions"
              name="Roles &amp; Permissions"
              parent="menu_employee_portal_configuration"
              action="action_employee_portal_suite_roles"
              sequence="10"
              groups="base.group_system"/>
</odoo>
