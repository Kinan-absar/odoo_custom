<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_leave_view_form_employee_request_link" model="ir.ui.view">
        <field name="name">hr.leave.form.employee.request.link</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="employee_request_id"
                       string="Employee Request"
                       readonly="1"
                       invisible="not employee_request_id"/>
            </xpath>
        </field>
    </record>
</odoo>
