<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_portal_request_filter_card_list" model="ir.ui.view">
        <field name="name">employee.portal.request.filter.card.list</field>
        <field name="model">employee.portal.request.filter.card</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="request_area,sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="request_area"/>
                <field name="name"/>
                <field name="filter_key" options="{'no_create': True}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_employee_portal_request_filter_card_form" model="ir.ui.view">
        <field name="name">employee.portal.request.filter.card.form</field>
        <field name="model">employee.portal.request.filter.card</field>
        <field name="arch" type="xml">
            <form string="Request Filter Card">
                <sheet>
                    <group>
                        <field name="request_area"/>
                        <field name="filter_key"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <div class="alert alert-info" role="alert">Choose which filter cards appear in the Employee Request and Material Request approval lists. You can rename them, reorder them, or switch them off without changing the approval workflow.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_employee_portal_request_filter_cards" model="ir.actions.act_window">
        <field name="name">Request Filter Cards</field>
        <field name="res_model">employee.portal.request.filter.card</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_employee_portal_request_filter_cards" name="Request Filter Cards" parent="employee_portal_suite.menu_employee_portal_configuration" action="action_employee_portal_request_filter_cards" sequence="50" groups="employee_portal_suite.group_employee_portal_superadmin"/>
</odoo>
