<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="project_project_form_inherit_responsibles" model="ir.ui.view">
        <field name="name">project.project.form.inherit.responsibles</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Approvers">
                    <field name="store_manager_employee_id"/>
                    <field name="project_manager_employee_id"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="workflow_roles" string="Workflow Roles" groups="employee_portal_suite.group_employee_portal_superadmin">
                    <field name="approval_role_assignment_ids" context="{'default_project_id': id}">
                        <list editable="bottom">
                            <field name="approval_role_id" domain="[('company_id','=',parent.company_id),('active','=',True)]"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="note" optional="show"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
