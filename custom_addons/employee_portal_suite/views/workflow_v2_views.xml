<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Workflow definition V2 controls -->
    <record id="view_employee_portal_workflow_form_v2" model="ir.ui.view">
        <field name="name">employee.portal.workflow.form.v2</field>
        <field name="model">employee.portal.workflow</field>
        <field name="inherit_id" ref="employee_portal_suite.view_employee_portal_workflow_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_validate_workflow" type="object" string="Validate" class="btn-primary" icon="fa-check-circle"/>
                    <button name="action_open_test_wizard" type="object" string="Test / Preview" icon="fa-flask"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='step_count']" position="after">
                <field name="validation_state" widget="badge" readonly="1"/>
                <field name="validated_on" readonly="1" invisible="not validated_on"/>
                <field name="validated_by" readonly="1" invisible="not validated_by"/>
            </xpath>
            <xpath expr="//field[@name='step_ids']/list/field[@name='description']" position="after">
                <field name="condition_domain" string="Condition" optional="show"/>
                <field name="sla_hours" string="SLA Hours" optional="show"/>
            </xpath>
            <xpath expr="//div[contains(@class,'alert-info')]" position="before">
                <group invisible="not validation_message">
                    <field name="validation_message" readonly="1" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Test wizard -->
    <record id="view_employee_portal_workflow_test_wizard_form" model="ir.ui.view">
        <field name="name">employee.portal.workflow.test.wizard.form</field>
        <field name="model">employee.portal.workflow.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Test Workflow">
                <group>
                    <field name="workflow_id"/>
                    <field name="applies_to" invisible="1"/>
                    <field name="project_id"/>
                    <field name="employee_id"/>
                    <field name="request_type" invisible="applies_to != 'employee_request'"/>
                </group>
                <group string="Resolved Route" invisible="not result">
                    <field name="result" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_test" type="object" string="Run Test" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Delegation -->
    <record id="view_employee_portal_approval_delegation_list" model="ir.ui.view">
        <field name="name">employee.portal.approval.delegation.list</field>
        <field name="model">employee.portal.approval.delegation</field>
        <field name="arch" type="xml">
            <list string="Approval Delegations" default_order="date_from desc">
                <field name="active" widget="boolean_toggle"/>
                <field name="user_id"/>
                <field name="delegate_user_id"/>
                <field name="approval_role_id" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_employee_portal_approval_delegation_form" model="ir.ui.view">
        <field name="name">employee.portal.approval.delegation.form</field>
        <field name="model">employee.portal.approval.delegation</field>
        <field name="arch" type="xml">
            <form string="Approval Delegation">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                            <field name="delegate_user_id"/>
                        </group>
                        <group>
                            <field name="approval_role_id" domain="[('company_id','=',company_id)]"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_employee_portal_approval_delegations" model="ir.actions.act_window">
        <field name="name">Approval Delegations</field>
        <field name="res_model">employee.portal.approval.delegation</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_employee_portal_approval_delegations" name="Approval Delegations"
              parent="employee_portal_suite.menu_employee_portal_configuration"
              action="action_employee_portal_approval_delegations" sequence="35"
              groups="employee_portal_suite.group_employee_portal_superadmin"/>

    <!-- Return / override wizards -->
    <record id="view_employee_portal_workflow_return_wizard_form" model="ir.ui.view">
        <field name="name">employee.portal.workflow.return.wizard.form</field>
        <field name="model">employee.portal.workflow.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return for Correction">
                <group>
                    <field name="reason" placeholder="Explain what must be corrected before resubmission..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Return for Correction" class="btn-warning"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_employee_portal_workflow_override_wizard_form" model="ir.ui.view">
        <field name="name">employee.portal.workflow.override.wizard.form</field>
        <field name="model">employee.portal.workflow.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Super Admin Override">
                <div class="alert alert-warning" role="alert">This approval bypasses the assigned approver. The reason will be permanently recorded.</div>
                <group>
                    <field name="reason" placeholder="Mandatory reason for overriding this approval stage..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Override &amp; Approve" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Workflow reporting -->
    <record id="view_workflow_approval_line_report_list" model="ir.ui.view">
        <field name="name">employee.portal.workflow.approval.line.report.list</field>
        <field name="model">employee.portal.workflow.approval.line</field>
        <field name="arch" type="xml">
            <list string="Workflow Performance" create="0" edit="0" delete="0">
                <field name="request_model_label" widget="badge"/>
                <field name="request_name"/>
                <field name="project_id"/>
                <field name="name" string="Step"/>
                <field name="role_name"/>
                <field name="state" widget="badge"/>
                <field name="pending_date"/>
                <field name="due_date"/>
                <field name="is_overdue"/>
                <field name="duration_hours" sum="Total Hours"/>
                <field name="approved_by" optional="show"/>
                <field name="override_by" optional="show"/>
                <field name="override_reason" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_workflow_approval_line_report_pivot" model="ir.ui.view">
        <field name="name">employee.portal.workflow.approval.line.report.pivot</field>
        <field name="model">employee.portal.workflow.approval.line</field>
        <field name="arch" type="xml">
            <pivot string="Workflow Performance">
                <field name="duration_hours" type="measure"/>
                <field name="project_id" type="row"/>
                <field name="name" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="view_workflow_approval_line_report_graph" model="ir.ui.view">
        <field name="name">employee.portal.workflow.approval.line.report.graph</field>
        <field name="model">employee.portal.workflow.approval.line</field>
        <field name="arch" type="xml">
            <graph string="Average Approval Time" type="bar">
                <field name="name"/>
                <field name="duration_hours" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_workflow_approval_line_report_search" model="ir.ui.view">
        <field name="name">employee.portal.workflow.approval.line.report.search</field>
        <field name="model">employee.portal.workflow.approval.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_name"/>
                <field name="project_id"/>
                <field name="name" string="Step"/>
                <field name="approved_by"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <filter name="overrides" string="Overrides" domain="[('override_by','!=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                    <filter name="group_step" string="Step" context="{'group_by':'name'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_approver" string="Approver" context="{'group_by':'approved_by'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_employee_portal_workflow_reports" model="ir.actions.act_window">
        <field name="name">Workflow Reports</field>
        <field name="res_model">employee.portal.workflow.approval.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_workflow_approval_line_report_search"/>
    </record>
    <menuitem id="menu_employee_portal_workflow_reports" name="Workflow Reports"
              parent="employee_portal_suite.menu_employee_portal_configuration"
              action="action_employee_portal_workflow_reports" sequence="50"
              groups="employee_portal_suite.group_employee_portal_superadmin"/>

    <!-- Project workflow management -->
    <record id="project_project_form_workflow_v2" model="ir.ui.view">
        <field name="name">project.project.form.workflow.v2</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="employee_portal_suite.project_project_form_inherit_responsibles"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@string='Workflow Roles']" position="after">
                <page string="Approval Workflows" groups="employee_portal_suite.group_employee_portal_superadmin">
                    <field name="employee_portal_workflow_ids" context="{'default_project_id': id, 'default_company_id': company_id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="applies_to"/>
                            <field name="employee_request_type" optional="show"/>
                            <field name="step_count" readonly="1"/>
                            <field name="validation_state" widget="badge" optional="show"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Employee Request workflow UX -->
    <record id="view_employee_request_form_workflow_v2" model="ir.ui.view">
        <field name="name">employee.request.form.workflow.v2</field>
        <field name="model">employee.request</field>
        <field name="inherit_id" ref="employee_portal_suite.view_employee_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_workflow_reject']" position="before">
                <button name="action_workflow_return" type="object" string="Return for Correction" class="btn-warning" invisible="state != 'workflow'"/>
            </xpath>
            <xpath expr="//header/button[@name='action_submit']" position="after">
                <button name="action_workflow_resubmit" type="object" string="Resubmit Corrections" class="btn-primary" invisible="state != 'returned'"/>
            </xpath>
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,returned,workflow,manager,hr,finance,ceo,approved,rejected</attribute>
            </xpath>
            <xpath expr="//page[@string='Workflow']/group" position="before">
                <field name="workflow_progress_html" widget="html" nolabel="1" readonly="1"/>
            </xpath>
            <xpath expr="//page[@string='Workflow']//field[@name='approval_line_ids']/list/field[@name='state']" position="after">
                <field name="pending_date" optional="show"/>
                <field name="due_date" optional="show"/>
                <field name="is_overdue" optional="show"/>
                <field name="duration_hours" optional="hide"/>
                <field name="returned_by" optional="hide"/>
                <field name="return_reason" optional="hide"/>
                <field name="delegated_from_user_id" optional="hide"/>
                <field name="override_by" optional="hide"/>
                <field name="override_reason" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Material Request workflow UX -->
    <record id="view_material_request_form_workflow_v2" model="ir.ui.view">
        <field name="name">material.request.form.workflow.v2</field>
        <field name="model">material.request</field>
        <field name="inherit_id" ref="employee_portal_suite.view_material_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_workflow_reject']" position="before">
                <button name="action_workflow_return" type="object" string="Return for Correction" class="btn-warning" invisible="state != 'workflow'"/>
            </xpath>
            <xpath expr="//header/button[@name='action_submit']" position="after">
                <button name="action_workflow_resubmit" type="object" string="Resubmit Corrections" class="btn-primary" invisible="state != 'returned'"/>
            </xpath>
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,returned,workflow,purchase,store,project_manager,director,ceo,approved,rejected</attribute>
            </xpath>
            <xpath expr="//page[@string='Workflow']/group" position="before">
                <field name="workflow_progress_html" widget="html" nolabel="1" readonly="1"/>
            </xpath>
            <xpath expr="//page[@string='Workflow']//field[@name='approval_line_ids']/list/field[@name='state']" position="after">
                <field name="pending_date" optional="show"/>
                <field name="due_date" optional="show"/>
                <field name="is_overdue" optional="show"/>
                <field name="duration_hours" optional="hide"/>
                <field name="returned_by" optional="hide"/>
                <field name="return_reason" optional="hide"/>
                <field name="delegated_from_user_id" optional="hide"/>
                <field name="override_by" optional="hide"/>
                <field name="override_reason" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
