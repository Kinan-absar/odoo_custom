<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ============================= -->
    <!-- TREE VIEW -->
    <!-- ============================= -->
    <record id="view_portal_announcement_list" model="ir.ui.view">
        <field name="name">portal.announcement.list</field>
        <field name="model">portal.announcement</field>
        <field name="arch" type="xml">
            <list class="eps_compact_list">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="target"/>
                <field name="attachment_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ============================= -->
    <!-- FORM VIEW -->
    <!-- ============================= -->
    <record id="view_portal_announcement_form" model="ir.ui.view">
        <field name="name">portal.announcement.form</field>
        <field name="model">portal.announcement</field>
        <field name="arch" type="xml">
            <form string="Portal Announcement" class="eps_compact_form">
                <sheet>
                    <group class="eps_compact_section">
                        <field name="name"/>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="target"/>
                    </group>

                    <group class="eps_compact_section">
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="color"/>
                    </group>

                    <group class="eps_compact_section">
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>

                    <group class="eps_compact_section">
                        <field name="message" widget="html"/>
                    </group>

                    <group string="Attachments" class="eps_compact_section">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" context="{'default_res_model': 'portal.announcement'}"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>