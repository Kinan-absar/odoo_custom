<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="employee_portal_attendance" name="Employee Portal - Attendance">
        <t t-call="employee_portal_suite.employee_portal_layout">
            <style>
            /* ================================================================
               ATTENDANCE PAGE STYLES
            ================================================================ */

            .attendance-hero {
                border-radius: 26px;
                padding: 28px 24px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                position: relative;
                overflow: hidden;
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
                margin-bottom: 20px;
            }

            .attendance-hero.checked-in {
                background: linear-gradient(135deg, #10B981 0%, #059669 100%);
                color: white;
            }

            .attendance-hero.checked-out {
                background: linear-gradient(135deg, #159398 0%, #087f83 100%);
                color: white;
            }

            .attendance-hero::before {
                content: '';
                position: absolute;
                top: -40%;
                right: -20%;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(255,255,255,0.2), transparent 70%);
                pointer-events: none;
            }

            .status-icon {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                background: rgba(255,255,255,0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 30px;
                margin-bottom: 16px;
            }

            .status-title {
                font-size: 20px;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .status-sub {
                font-size: 13px;
                opacity: 0.88;
                margin-bottom: 20px;
            }

            .attendance-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 13px 32px;
                border-radius: 50px;
                font-weight: 700;
                font-size: 15px;
                border: none;
                cursor: pointer;
                transition: transform 0.2s cubic-bezier(.34,1.56,.64,1), box-shadow 0.2s ease;
                text-decoration: none !important;
            }

            .btn-checkin {
                background: white;
                color: #087f83;
                box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            }

            .btn-checkout {
                background: white;
                color: #059669;
                box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            }

            .attendance-btn:hover {
                transform: scale(1.04);
                box-shadow: 0 14px 30px rgba(0,0,0,0.2);
            }

            .attendance-btn:active {
                transform: scale(0.97);
            }

            /* Today Stats */
            .today-stats {
                display: flex;
                gap: 12px;
                margin-bottom: 20px;
            }

            .stat-card {
                flex: 1;
                background: white;
                border-radius: 18px;
                padding: 16px;
                text-align: center;
                box-shadow: 0 4px 14px rgba(0,0,0,0.06);
            }

            .stat-value {
                font-size: 22px;
                font-weight: 700;
                color: #1F2937;
            }

            .stat-label {
                font-size: 11px;
                color: #6B7280;
                font-weight: 600;
                margin-top: 2px;
            }

            /* History */
            .attendance-history {
                background: white;
                border-radius: 22px;
                padding: 18px;
                box-shadow: 0 4px 14px rgba(0,0,0,0.06);
            }

            .history-row {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 12px;
                border-radius: 14px;
                transition: background 0.15s ease;
            }

            .history-row + .history-row {
                border-top: 1px solid rgba(0,0,0,0.04);
            }

            .history-row:hover {
                background: rgba(8,127,131,0.04);
            }

            .history-icon {
                width: 36px;
                height: 36px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                flex-shrink: 0;
            }

            .history-icon.complete {
                background: rgba(16,185,129,0.12);
                color: #059669;
            }

            .history-icon.open {
                background: rgba(245,158,11,0.12);
                color: #D97706;
            }

            .history-content { flex: 1; }

            .history-date {
                font-size: 13px;
                font-weight: 600;
                color: #1F2937;
            }

            .history-times {
                font-size: 11px;
                color: #6B7280;
                margin-top: 2px;
            }

            .history-hours {
                font-size: 13px;
                font-weight: 700;
                color: #087f83;
            }

            /* Alert messages */
            .portal-alert {
                border-radius: 14px;
                padding: 12px 16px;
                font-size: 13px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 16px;
            }

            .portal-alert.success {
                background: rgba(16,185,129,0.12);
                color: #065F46;
            }

            .portal-alert.error {
                background: rgba(239,68,68,0.1);
                color: #991B1B;
            }

            .eps-offline-alert {
                background: rgba(245,158,11,0.13);
                color: #92400E;
            }

            .eps-sync-alert {
                background: rgba(8,127,131,0.10);
                color: #065F63;
            }

            .eps-attendance-sync-state {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 28px;
                padding: 5px 10px;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 700;
                background: rgba(255,255,255,0.20);
                color: white;
                margin-bottom: 12px;
            }

            .eps-attendance-sync-state[data-state="online"] { background: rgba(255,255,255,0.16); }
            .eps-attendance-sync-state[data-state="offline"] { background: rgba(245,158,11,0.28); }
            .eps-attendance-sync-state[data-state="syncing"] { background: rgba(59,130,246,0.25); }
            .eps-attendance-sync-state[data-state="failed"] { background: rgba(239,68,68,0.28); }

            .section-title {
                font-weight: 700;
                font-size: 14px;
                color: #374151;
                margin-bottom: 12px;
            }
            </style>

            <div class="mt-4" data-eps-attendance-root="1"
                 t-att-data-server-checked-in="'1' if is_checked_in else '0'"
                 t-att-data-geo-enforce="'1' if geo_enforce else '0'"
                 t-att-data-server-check-in-iso="server_check_in_iso or ''"
                 t-att-data-user-id="request.env.user.id"
                 t-att-data-device-token="trusted_device_token or ''"
                 t-att-data-device-state="trusted_device_state or 'unknown'">

                <div id="eps-attendance-offline-banner" class="portal-alert eps-offline-alert" hidden="hidden"></div>

                <!-- SUCCESS / ERROR MESSAGES -->
                <t t-if="success_message == 'checked_in'">
                    <div class="portal-alert success">
                        <i class="fa fa-check-circle"/>
                        You have successfully checked in.
                    </div>
                </t>
                <t t-if="success_message == 'checked_out'">
                    <div class="portal-alert success">
                        <i class="fa fa-check-circle"/>
                        You have successfully checked out.
                    </div>
                </t>
                <t t-if="success_message == 'checked_out' and request.params.get('warn') == 'outside_location'">
                    <div class="portal-alert error">
                        <i class="fa fa-map-marker"/>
                        Note: Your check-out was recorded outside your designated work location and has been flagged for HR review.
                    </div>
                </t>
                <t t-if="error_message == 'already_checked_in'">
                    <div class="portal-alert error">
                        <i class="fa fa-exclamation-circle"/>
                        You are already checked in. Please check out first.
                    </div>
                </t>
                <t t-if="error_message == 'not_checked_in'">
                    <div class="portal-alert error">
                        <i class="fa fa-exclamation-circle"/>
                        You are not currently checked in.
                    </div>
                </t>
                <t t-if="error_message == 'check_in_failed' or error_message == 'check_out_failed'">
                    <div class="portal-alert error">
                        <i class="fa fa-exclamation-circle"/>
                        An error occurred. Please try again or contact HR.
                    </div>
                </t>
                <t t-if="error_message == 'geo_required'">
                    <div class="portal-alert error">
                        <i class="fa fa-map-marker"/>
                        Location access is required to check in at your assigned work location.
                        Please allow location access in your browser and try again.
                    </div>
                </t>
                <t t-if="error_message == 'geo_out_of_range'">
                    <div class="portal-alert error">
                        <i class="fa fa-map-marker"/>
                        You are outside the allowed check-in zone for your work location.
                        Please move closer and try again.
                    </div>
                </t>

                <t t-if="error_message == 'device_not_trusted'">
                    <div class="portal-alert error">
                        <i class="fa fa-mobile"/>
                        Attendance is blocked on this phone because it is not the employee's trusted attendance device.
                        Select Request Device Change to ask the Attendance Manager to approve this device.
                    </div>
                </t>

                <!-- Device changes are requested explicitly. Opening this page
                     on an additional phone never creates a pending record. -->
                <t t-if="trusted_device_state in ('unregistered', 'revoked')">
                    <div class="portal-alert eps-attendance-device-change" id="eps-attendance-device-change">
                        <i class="fa fa-mobile" aria-hidden="true"/>
                        <span>
                            <strong>Attendance is not enabled on this device.</strong>
                            Your existing approved device remains active.
                            To switch phones, request approval from the Attendance Manager.
                        </span>
                        <form action="/my/employee/attendance/device/request_change" method="post" class="mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary">Request Device Change</button>
                        </form>
                    </div>
                </t>
                <t t-if="trusted_device_state == 'pending'">
                    <div class="portal-alert eps-attendance-device-change" id="eps-attendance-device-pending">
                        <i class="fa fa-clock-o" aria-hidden="true"/>
                        <span>Your device change request is awaiting Attendance Manager approval. Your previous approved device remains active.</span>
                    </div>
                </t>
                <t t-if="success_message == 'device_request_submitted'">
                    <div class="portal-alert success">Device change request submitted to the Attendance Manager.</div>
                </t>
                <t t-if="success_message == 'device_already_trusted'">
                    <div class="portal-alert success">This device is already approved for attendance.</div>
                </t>
                <t t-if="error_message in ('device_cookie_missing', 'device_request_failed')">
                    <div class="portal-alert error">Could not submit the device change request. Reload Attendance online and try again.</div>
                </t>

                <!-- STATUS HERO CARDS -->
                <!-- Both states remain in the cached attendance page. The offline
                     controller toggles them locally while disconnected. -->
                <div id="eps-attendance-checked-in" class="attendance-hero checked-in" t-att-style="'' if is_checked_in else 'display:none;'">
                    <div class="eps-attendance-sync-state" t-att-data-state="'syncing' if trusted_device_state == 'trusted' else 'failed'"><t t-out="'Online' if trusted_device_state == 'trusted' else 'Device approval needed'"/></div>
                    <div class="status-icon">
                        <i class="fa fa-clock-o"/>
                    </div>
                    <div class="status-title">You're Clocked In</div>
                    <div class="status-sub">
                        <t t-if="is_checked_in">
                            Since <t t-out="fmt_dt(open_attendance.check_in, '%I:%M %p')"/>
                            · <t t-out="fmt_dt(open_attendance.check_in, '%d %b %Y')"/>
                        </t>
                        <t t-if="not is_checked_in">
                            Since <span id="eps-offline-checkin-since"></span>
                        </t>
                    </div>
                    <form action="/my/employee/attendance/check_out" method="post" id="checkout-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="geo_lat" value=""/>
                        <input type="hidden" name="geo_lon" value=""/>
                        <input type="hidden" name="trusted_device_token" t-att-value="trusted_device_token or ''"/>
                        <button type="submit" id="checkout-btn" class="attendance-btn btn-checkout" t-att-disabled="'disabled' if trusted_device_state != 'trusted' else None" t-att-data-geo-enforce="'1' if geo_enforce else '0'">
                            <i class="fa fa-sign-out"/>
                            Check Out
                        </button>
                    </form>
                </div>

                <div id="eps-attendance-checked-out" class="attendance-hero checked-out" t-att-style="'display:none;' if is_checked_in else ''">
                    <div class="eps-attendance-sync-state" t-att-data-state="'syncing' if trusted_device_state == 'trusted' else 'failed'"><t t-out="'Online' if trusted_device_state == 'trusted' else 'Device approval needed'"/></div>
                    <div class="status-icon">
                        <i class="fa fa-user-o"/>
                    </div>
                    <div class="status-title">Not Checked In</div>
                    <div class="status-sub">Tap below to start your work session</div>
                    <form id="checkin-form" action="/my/employee/attendance/check_in" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="geo_lat" value=""/>
                        <input type="hidden" name="geo_lon" value=""/>
                        <input type="hidden" name="trusted_device_token" t-att-value="trusted_device_token or ''"/>
                        <button id="checkin-btn" type="submit" class="attendance-btn btn-checkin" t-att-disabled="'disabled' if trusted_device_state != 'trusted' else None" t-att-data-geo-enforce="'1' if geo_enforce else '0'">
                            <i class="fa fa-sign-in"/>
                            Check In
                        </button>
                    </form>
                </div>

                <!-- TODAY STATS -->
                <div class="today-stats">
                    <div class="stat-card">
                        <div class="stat-value">
                            <t t-out="'%dh %dm' % (int(today_hours), int((today_hours % 1) * 60))"/>
                        </div>
                        <div class="stat-label">Today's Hours</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">
                            <span id="eps-attendance-current-status"><t t-out="'Active' if is_checked_in else 'Inactive'"/></span>
                        </div>
                        <div class="stat-label">Current Status</div>
                    </div>
                </div>

                <!-- RECENT HISTORY -->
                <div class="attendance-history">
                    <div class="section-title">
                        <i class="fa fa-history me-1"/> Recent Attendance
                    </div>

                    <t t-if="recent_attendances">
                        <t t-foreach="recent_attendances" t-as="att">
                            <div class="history-row eps-attendance-row">

                                <div t-att-class="'history-icon ' + ('open' if not att.check_out else 'complete')">
                                    <i t-att-class="'fa ' + ('fa-clock-o' if not att.check_out else 'fa-check')"/>
                                </div>

                                <div class="history-date">
                                        <t t-out="fmt_dt(att.check_in, '%A, %d %b %Y')"/>
                                        <!-- Outside-location checkout flag -->
                                        <t t-if="att.checkout_outside_location">
                                            <span style="                                                 display:inline-flex;align-items:center;gap:4px;                                                 background:rgba(239,68,68,0.12);color:#991B1B;                                                 font-size:10px;font-weight:700;border-radius:6px;                                                 padding:2px 7px;margin-left:6px;vertical-align:middle;">
                                                <i class="fa fa-map-marker"/> Outside Location
                                            </span>
                                        </t>
                                    </div>
                                    <div class="history-times">
                                        <t t-if="att.check_in_project_id">
                                            <span style="font-weight:700;color:#087f83;">
                                                <i class="fa fa-map-marker me-1"/>
                                                <t t-out="att.check_in_project_id.display_name"/>
                                            </span>
                                            &amp;nbsp;·&amp;nbsp;
                                        </t>
                                        In: <t t-out="fmt_dt(att.check_in, '%I:%M %p')"/>
                                        <t t-if="att.check_out">
                                            &amp;nbsp;·&amp;nbsp; Out: <t t-out="fmt_dt(att.check_out, '%I:%M %p')"/>
                                        </t>
                                        <t t-if="not att.check_out">
                                            &amp;nbsp;·&amp;nbsp; <span style="color:#D97706;">Still active</span>
                                        </t>
                                    </div>
                                <div class="history-hours">
                                    <t t-if="att.check_out">
                                        <t t-out="'%dh %dm' % (int(att.worked_hours), int((att.worked_hours % 1) * 60))"/>
                                    </t>
                                    <t t-if="not att.check_out">
                                        <span style="color:#D97706;">—</span>
                                    </t>
                                </div>

                            </div>
                        </t>
                    </t>

                    <t t-if="not recent_attendances">
                        <div class="text-muted small py-2">No attendance records found.</div>
                    </t>

                </div>

            </div>

            <!-- Load the attendance controller directly as a versioned static asset.
                 This deliberately bypasses stale Odoo frontend bundles on PWA/mobile
                 upgrades. The controller has its own duplicate-load guard. -->
            <script type="text/javascript" src="/employee_portal_suite/static/src/js/attendance_offline.js?v=133"></script>
        </t>
    </template>

</odoo>
