<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_mr_clarification_wizard" model="ir.ui.view">
    <field name="name">employee.portal.mr.clarification.wizard.form</field>
    <field name="model">employee.portal.mr.clarification.wizard</field>
    <field name="arch" type="xml">
      <form string="Clarification">
        <field name="operation" invisible="1"/>
        <group><field name="request_id"/><field name="question" invisible="operation != 'reply'"/>
          <field name="text" placeholder="Write a clear question or reply…"/></group>
        <footer><button name="action_send" type="object" string="Send" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>
  <record id="view_material_request_clarification" model="ir.ui.view">
    <field name="name">material.request.clarification.actions</field>
    <field name="model">material.request</field>
    <field name="inherit_id" ref="employee_portal_suite.view_material_request_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_workflow_reject']" position="before">
        <button name="action_request_clarification" type="object" string="Request Clarification" class="btn-secondary rounded-pill" invisible="not can_toggle_clarification or (needs_clarification and clarification_question)"/>
        <button name="action_reply_clarification" type="object" string="Reply to Clarification" class="btn-primary rounded-pill" invisible="not can_reply_clarification"/>
      </xpath>
      <xpath expr="//div[@invisible='not can_toggle_clarification']" position="replace">
        <field name="needs_clarification" invisible="1"/>
        <field name="can_reply_clarification" invisible="1"/>
        <field name="can_toggle_clarification" invisible="1"/>
      </xpath>
      <xpath expr="//sheet/notebook" position="before">
        <div class="border rounded-3 p-3 mb-3" invisible="not needs_clarification and not clarification_question">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <strong><i class="fa fa-commenting-o me-2"/>Clarification</strong>
            <span class="badge rounded-pill text-bg-warning" invisible="not needs_clarification or not clarification_question">Awaiting requester reply</span>
            <span class="badge rounded-pill text-bg-warning" invisible="not needs_clarification or clarification_question">Question required</span><span class="badge rounded-pill text-bg-success" invisible="needs_clarification">Reply received</span>
          </div>
          <div class="alert alert-warning mb-2" invisible="clarification_question">Clarification has not been sent yet. Choose Request Clarification and enter your question.</div>
          <group invisible="not clarification_question">
            <group><field name="clarification_step_name" string="Approval step"/><field name="clarification_requested_by" string="Requested by"/><field name="clarification_requested_on" string="Requested on"/></group>
            <group><field name="clarification_question" string="Question"/><field name="clarification_reply" string="Requester reply"/><field name="clarification_replied_on" string="Replied on" invisible="not clarification_reply"/></group>
          </group>
        </div>
      </xpath>
    <xpath expr="//header/button[@name='action_purchase']" position="attributes"><attribute name="invisible">state != 'purchase' or needs_clarification</attribute></xpath><xpath expr="//header/button[@name='action_store']" position="attributes"><attribute name="invisible">state != 'store' or needs_clarification</attribute></xpath><xpath expr="//header/button[@name='action_project_manager']" position="attributes"><attribute name="invisible">state != 'project_manager' or needs_clarification</attribute></xpath><xpath expr="//header/button[@name='action_director']" position="attributes"><attribute name="invisible">state != 'director' or needs_clarification</attribute></xpath><xpath expr="//header/button[@name='action_ceo']" position="attributes"><attribute name="invisible">state != 'ceo' or needs_clarification</attribute></xpath><xpath expr="//header/button[@name='action_workflow_approve']" position="attributes"><attribute name="invisible">state != 'workflow' or needs_clarification</attribute></xpath></field>
  </record>
  <template id="portal_mr_clarification_panel" name="Material Request Clarification Conversation">
    <t t-if="request.params.get('clarification_error')"><div class="alert alert-danger" role="alert"><t t-out="request.params.get('clarification_error')"/></div></t>
    <t t-if="request.params.get('clarification_sent')"><div class="alert alert-success" role="status">Your message was sent.</div></t>
    <section t-if="request_rec.needs_clarification or request_rec.clarification_question" class="eps-clarification-panel mb-3" aria-label="Clarification">
      <div class="eps-clarification-heading">
        <div><span class="eps-clarification-icon"><i class="fa fa-commenting-o" aria-hidden="true"/></span><strong>Clarification</strong></div>
        <span t-if="request_rec.needs_clarification and request_rec.clarification_question" class="eps-clarification-state"><t t-if="request_rec.can_reply_clarification">Awaiting your reply</t><t t-else="">Awaiting requester reply</t></span>
        <span t-elif="request_rec.needs_clarification" class="eps-clarification-state">Question required</span><span t-else="" class="eps-clarification-state is-replied">Reply received</span>
      </div>
      <t t-if="request_rec.clarification_question">
        <div class="eps-clarification-meta"><t t-out="request_rec.clarification_requested_by.name"/> · <t t-out="request_rec.clarification_step_name"/> · <span t-field="request_rec.clarification_requested_on"/></div>
        <p class="eps-clarification-message"><t t-out="request_rec.clarification_question"/></p>
        <div t-if="request_rec.clarification_reply" class="eps-clarification-reply">
          <strong><t t-out="request_rec.employee_id.name"/> replied</strong>
          <p class="eps-clarification-message mb-0"><t t-out="request_rec.clarification_reply"/></p>
        </div>
        <a t-if="request_rec.can_reply_clarification" class="btn btn-primary rounded-pill mt-2" href="#eps-mr-chatter">Reply in Conversation</a><p t-if="request_rec.needs_clarification and not request_rec.can_reply_clarification" class="text-muted small mb-0">Approval is paused at this step until the requester replies.</p>
      </t>
      <p t-else="" class="mb-0 text-muted">Clarification has not been sent yet. Choose Request Clarification and enter your question.</p>
    </section>
  </template>
</odoo>
