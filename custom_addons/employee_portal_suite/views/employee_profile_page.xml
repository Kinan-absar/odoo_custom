<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<template id="employee_profile_edit" name="Employee Profile">
<t t-call="employee_portal_suite.employee_portal_layout">
<style>
.ep-profile-page{max-width:820px;margin:0 auto}.ep-profile-card{background:#fff;border:1px solid #e8eaf2;border-radius:22px;padding:28px;box-shadow:0 10px 30px rgba(15,23,42,.06)}.ep-profile-head{display:flex;align-items:center;gap:16px;margin-bottom:28px}.ep-profile-head img{width:72px;height:72px;border-radius:20px;object-fit:cover}.ep-profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.ep-profile-field label{display:block;font-size:12px;font-weight:700;color:#64748b;margin-bottom:7px}.ep-profile-field input{width:100%;height:46px;border:1px solid #dfe3ec;border-radius:12px;padding:0 13px}.ep-profile-readonly{background:#f8fafc}.ep-profile-actions{display:flex;justify-content:flex-end;margin-top:24px}.ep-profile-save{border:0;border-radius:12px;background:#4f46e5;color:#fff;padding:12px 22px;font-weight:700}@media(max-width:768px){.ep-profile-grid{grid-template-columns:1fr}.ep-profile-card{padding:20px;border-radius:18px}}
</style>
<div class="ep-profile-page">
<div class="ep-profile-card">
<div class="ep-profile-head"><img t-att-src="image_data_uri(request.env.user.partner_id.avatar_128)"/><div><h3 class="mb-1"><t t-esc="employee.name"/></h3><div class="text-muted"><t t-esc="employee.job_title or 'Employee'"/></div></div></div>
<t t-if="saved"><div class="alert alert-success">Your information has been updated.</div></t>
<form method="post" action="/my/employee/profile"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<div class="ep-profile-grid">
<div class="ep-profile-field"><label>Full name</label><input class="ep-profile-readonly" t-att-value="employee.name" readonly="readonly"/></div>
<div class="ep-profile-field"><label>Department</label><input class="ep-profile-readonly" t-att-value="employee.department_id.name or ''" readonly="readonly"/></div>
<div class="ep-profile-field"><label>Work email</label><input type="email" name="work_email" t-att-value="employee.work_email or request.env.user.partner_id.email or ''"/></div>
<div class="ep-profile-field"><label>Work phone</label><input name="work_phone" t-att-value="employee.work_phone or request.env.user.partner_id.phone or ''"/></div>
<div class="ep-profile-field"><label>Mobile phone</label><input name="mobile_phone" t-att-value="employee.mobile_phone or request.env.user.partner_id.mobile or ''"/></div>
<div class="ep-profile-field"><label>Job title</label><input class="ep-profile-readonly" t-att-value="employee.job_title or ''" readonly="readonly"/></div>
</div><div class="ep-profile-actions"><button class="ep-profile-save" type="submit">Save changes</button></div></form>
</div></div>
</t></template>
</odoo>
