<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<template id="employee_profile_edit" name="Employee Profile">
<t t-call="employee_portal_suite.employee_portal_layout">
<style>
.ep-profile-page{max-width:1040px;margin:22px auto 0}.ep-profile-card{background:#fff;border:1px solid #e8eaf2;border-radius:22px;padding:28px;box-shadow:0 10px 30px rgba(15,23,42,.06)}.ep-profile-head{display:flex;align-items:center;gap:16px;margin-bottom:26px;padding-bottom:22px;border-bottom:1px solid #eef0f5}.ep-profile-head img{width:72px;height:72px;border-radius:20px;object-fit:cover}.ep-profile-title{margin:0;font-size:24px;font-weight:800}.ep-profile-role{color:#64748b;margin-top:3px}.ep-profile-section{margin-top:28px}.ep-profile-section:first-of-type{margin-top:0}.ep-profile-section-title{font-size:12px;font-weight:800;letter-spacing:.06em;color:#475569;text-transform:uppercase;padding-bottom:9px;border-bottom:1px solid #e8eaf2;margin-bottom:16px}.ep-profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 20px}.ep-profile-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.ep-profile-field label{display:block;font-size:12px;font-weight:700;color:#64748b;margin-bottom:7px}.ep-profile-field input,.ep-profile-field select{width:100%;height:44px;border:1px solid #dfe3ec;border-radius:11px;padding:0 12px;background:#fff;color:#111827}.ep-profile-field input:focus,.ep-profile-field select:focus{outline:0;border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.09)}.ep-profile-readonly{background:#f8fafc!important;color:#64748b!important;cursor:not-allowed}.ep-profile-hint{font-size:11px;color:#94a3b8;margin-top:5px}.ep-profile-actions{display:flex;justify-content:flex-end;margin-top:26px;padding-top:20px;border-top:1px solid #eef0f5}.ep-profile-save{border:0;border-radius:12px;background:#4f46e5;color:#fff;padding:12px 22px;font-weight:700}.ep-profile-check{height:auto!important;width:auto!important;margin-right:7px}.ep-profile-bank{height:44px;display:flex;align-items:center;padding:0 12px;border-radius:11px;background:#f8fafc;color:#64748b;border:1px solid #dfe3ec}@media(max-width:768px){.ep-profile-page{margin-top:10px}.ep-profile-grid,.ep-profile-grid.three{grid-template-columns:1fr}.ep-profile-card{padding:20px;border-radius:18px}.ep-profile-head img{width:60px;height:60px;border-radius:16px}}
</style>
<div class="ep-profile-page">
<div class="ep-profile-card">
<div class="ep-profile-head"><img t-att-src="image_data_uri(request.env.user.partner_id.avatar_128)"/><div><h2 class="ep-profile-title"><t t-esc="employee.name"/></h2><div class="ep-profile-role"><t t-esc="employee.job_title or 'Employee'"/><t t-if="employee.department_id"> · <t t-esc="employee.department_id.name"/></t></div></div></div>
<t t-if="saved"><div class="alert alert-success">Your information has been updated.</div></t>
<form method="post" action="/my/employee/profile"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<div class="ep-profile-section"><div class="ep-profile-section-title">Work information</div><div class="ep-profile-grid">
<div class="ep-profile-field"><label>Full name</label><input class="ep-profile-readonly" t-att-value="employee.name" readonly="readonly"/></div>
<div class="ep-profile-field"><label>Department</label><input class="ep-profile-readonly" t-att-value="employee.department_id.name or ''" readonly="readonly"/></div>
<div class="ep-profile-field"><label>Email / Login</label><input class="ep-profile-readonly" type="email" t-att-value="login_email" readonly="readonly"/><div class="ep-profile-hint">Contact Administration to change your login email.</div></div>
<div class="ep-profile-field"><label>Job title</label><input class="ep-profile-readonly" t-att-value="employee.job_title or ''" readonly="readonly"/></div>
<div class="ep-profile-field"><label>Work phone</label><input name="work_phone" t-att-value="employee.work_phone or request.env.user.partner_id.phone or ''"/></div>
<div class="ep-profile-field"><label>Mobile phone</label><input name="mobile_phone" t-att-value="employee.mobile_phone or request.env.user.partner_id.mobile or ''"/></div>
</div></div>

<div class="ep-profile-section"><div class="ep-profile-section-title">Private contact</div><div class="ep-profile-grid">
<t t-if="'private_street' in employee._fields"><div class="ep-profile-field"><label>Private Address - Street</label><input name="private_street" t-att-value="employee.private_street or ''"/></div></t>
<t t-if="'private_street2' in employee._fields"><div class="ep-profile-field"><label>Street 2</label><input name="private_street2" t-att-value="employee.private_street2 or ''"/></div></t>
<t t-if="'private_city' in employee._fields"><div class="ep-profile-field"><label>City</label><input name="private_city" t-att-value="employee.private_city or ''"/></div></t>
<t t-if="'private_state_id' in employee._fields"><div class="ep-profile-field"><label>State</label><select name="private_state_id"><option value="">-</option><t t-foreach="states" t-as="st"><option t-att-value="st.id" t-att-selected="employee.private_state_id.id == st.id"><t t-esc="st.name"/></option></t></select></div></t>
<t t-if="'private_zip' in employee._fields"><div class="ep-profile-field"><label>ZIP</label><input name="private_zip" t-att-value="employee.private_zip or ''"/></div></t>
<t t-if="'private_country_id' in employee._fields"><div class="ep-profile-field"><label>Country</label><select name="private_country_id"><option value="">-</option><t t-foreach="countries" t-as="c"><option t-att-value="c.id" t-att-selected="employee.private_country_id.id == c.id"><t t-esc="c.name"/></option></t></select></div></t>
<t t-if="'private_email' in employee._fields"><div class="ep-profile-field"><label>Private Email</label><input type="email" name="private_email" t-att-value="employee.private_email or ''"/></div></t>
<t t-if="'private_phone' in employee._fields"><div class="ep-profile-field"><label>Private Phone</label><input name="private_phone" t-att-value="employee.private_phone or ''"/></div></t>
<t t-if="'bank_account_id' in employee._fields"><div class="ep-profile-field"><label>Bank Account</label><div class="ep-profile-bank"><t t-esc="employee.bank_account_id.acc_number or '-'"/></div></div></t>
<t t-if="'km_home_work' in employee._fields"><div class="ep-profile-field"><label>Home-Work Distance (km)</label><input type="number" min="0" name="km_home_work" t-att-value="employee.km_home_work or 0"/></div></t>
<t t-if="'private_car_plate' in employee._fields"><div class="ep-profile-field"><label>Private Car Plate</label><input name="private_car_plate" t-att-value="employee.private_car_plate or ''"/></div></t>
</div></div>

<div class="ep-profile-section"><div class="ep-profile-section-title">Emergency</div><div class="ep-profile-grid">
<t t-if="'emergency_contact' in employee._fields"><div class="ep-profile-field"><label>Contact Name</label><input name="emergency_contact" t-att-value="employee.emergency_contact or ''"/></div></t>
<t t-if="'emergency_phone' in employee._fields"><div class="ep-profile-field"><label>Contact Phone</label><input name="emergency_phone" t-att-value="employee.emergency_phone or ''"/></div></t>
</div></div>

<div class="ep-profile-section"><div class="ep-profile-section-title">Family status</div><div class="ep-profile-grid">
<t t-if="'marital' in employee._fields"><div class="ep-profile-field"><label>Marital Status</label><select name="marital"><option value="">-</option><t t-foreach="employee._fields['marital']._description_selection(request.env)" t-as="opt"><option t-att-value="opt[0]" t-att-selected="employee.marital == opt[0]"><t t-esc="opt[1]"/></option></t></select></div></t>
<t t-if="'spouse_complete_name' in employee._fields"><div class="ep-profile-field"><label>Spouse Complete Name</label><input name="spouse_complete_name" t-att-value="employee.spouse_complete_name or ''"/></div></t>
<t t-if="'spouse_birthdate' in employee._fields"><div class="ep-profile-field"><label>Spouse Birthdate</label><input type="date" name="spouse_birthdate" t-att-value="employee.spouse_birthdate or ''"/></div></t>
<t t-if="'children' in employee._fields"><div class="ep-profile-field"><label>Number of Dependent Children</label><input type="number" min="0" name="children" t-att-value="employee.children or 0"/></div></t>
</div></div>

<div class="ep-profile-section"><div class="ep-profile-section-title">Citizenship &amp; identification</div><div class="ep-profile-grid">
<t t-if="'country_id' in employee._fields"><div class="ep-profile-field"><label>Nationality (Country)</label><select name="country_id"><option value="">-</option><t t-foreach="countries" t-as="c"><option t-att-value="c.id" t-att-selected="employee.country_id.id == c.id"><t t-esc="c.name"/></option></t></select></div></t>
<t t-if="'identification_id' in employee._fields"><div class="ep-profile-field"><label>Identification No</label><input name="identification_id" t-att-value="employee.identification_id or ''"/></div></t>
<t t-if="'ssnid' in employee._fields"><div class="ep-profile-field"><label>SSN No</label><input name="ssnid" t-att-value="employee.ssnid or ''"/></div></t>
<t t-if="'passport_id' in employee._fields"><div class="ep-profile-field"><label>Passport No</label><input name="passport_id" t-att-value="employee.passport_id or ''"/></div></t>
<t t-if="'gender' in employee._fields"><div class="ep-profile-field"><label>Gender</label><select name="gender"><option value="">-</option><t t-foreach="employee._fields['gender']._description_selection(request.env)" t-as="opt"><option t-att-value="opt[0]" t-att-selected="employee.gender == opt[0]"><t t-esc="opt[1]"/></option></t></select></div></t>
<t t-if="'birthday' in employee._fields"><div class="ep-profile-field"><label>Date of Birth</label><input type="date" name="birthday" t-att-value="employee.birthday or ''"/></div></t>
<t t-if="'place_of_birth' in employee._fields"><div class="ep-profile-field"><label>Place of Birth</label><input name="place_of_birth" t-att-value="employee.place_of_birth or ''"/></div></t>
<t t-if="'country_of_birth' in employee._fields"><div class="ep-profile-field"><label>Country of Birth</label><select name="country_of_birth"><option value="">-</option><t t-foreach="countries" t-as="c"><option t-att-value="c.id" t-att-selected="employee.country_of_birth.id == c.id"><t t-esc="c.name"/></option></t></select></div></t>
<t t-if="'is_non_resident' in employee._fields"><div class="ep-profile-field"><label>Non-resident</label><label><input class="ep-profile-check" type="checkbox" name="is_non_resident" t-att-checked="employee.is_non_resident"/> Yes</label></div></t>
</div></div>

<div class="ep-profile-section"><div class="ep-profile-section-title">Education</div><div class="ep-profile-grid">
<t t-if="'certificate' in employee._fields"><div class="ep-profile-field"><label>Certificate Level</label><select name="certificate"><option value="">-</option><t t-foreach="employee._fields['certificate']._description_selection(request.env)" t-as="opt"><option t-att-value="opt[0]" t-att-selected="employee.certificate == opt[0]"><t t-esc="opt[1]"/></option></t></select></div></t>
<t t-if="'study_field' in employee._fields"><div class="ep-profile-field"><label>Field of Study</label><input name="study_field" t-att-value="employee.study_field or ''"/></div></t>
<t t-if="'study_school' in employee._fields"><div class="ep-profile-field"><label>School</label><input name="study_school" t-att-value="employee.study_school or ''"/></div></t>
</div></div>

<div class="ep-profile-section"><div class="ep-profile-section-title">Work permit</div><div class="ep-profile-grid">
<t t-if="'iqama_no' in employee._fields"><div class="ep-profile-field"><label>Iqama No</label><input name="iqama_no" t-att-value="employee.iqama_no or ''"/></div></t>
<t t-if="'iqama_number' in employee._fields"><div class="ep-profile-field"><label>Iqama No</label><input name="iqama_number" t-att-value="employee.iqama_number or ''"/></div></t>
<t t-if="'visa_no' in employee._fields"><div class="ep-profile-field"><label>Work Permit No</label><input name="visa_no" t-att-value="employee.visa_no or ''"/></div></t>
<t t-if="'permit_no' in employee._fields"><div class="ep-profile-field"><label>Permit No</label><input name="permit_no" t-att-value="employee.permit_no or ''"/></div></t>
<t t-if="'iqama_expiration_date' in employee._fields"><div class="ep-profile-field"><label>Iqama Expiration Date</label><input type="date" name="iqama_expiration_date" t-att-value="employee.iqama_expiration_date or ''"/></div></t>
<t t-if="'visa_expire' in employee._fields"><div class="ep-profile-field"><label>Visa Expiration Date</label><input type="date" name="visa_expire" t-att-value="employee.visa_expire or ''"/></div></t>
<t t-if="'work_permit_expiration_date' in employee._fields"><div class="ep-profile-field"><label>Work Permit Expiration Date</label><input type="date" name="work_permit_expiration_date" t-att-value="employee.work_permit_expiration_date or ''"/></div></t>
</div></div>

<div class="ep-profile-actions"><button class="ep-profile-save" type="submit">Save changes</button></div></form>
</div></div>
</t></template>
</odoo>
