<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_form_material_projects" model="ir.ui.view">
        <field name="name">hr.employee.form.material.projects.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_manage_material_projects"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sitemap"
                        groups="hr.group_hr_user">
                    <field name="material_project_count" widget="statinfo" string="Assigned Projects"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_project_assignment_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.project.assignment.wizard.form</field>
        <field name="model">hr.employee.project.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Projects">
                <group>
                    <field name="employee_id"/>
                    <field name="available_project_ids" invisible="1"/>
                    <field name="project_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"
                           placeholder="Select one or more projects"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Only this employee is affected. Projects are not copied from the Work Location and other employees are not changed.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
