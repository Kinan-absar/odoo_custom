<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_form_material_projects" model="ir.ui.view">
        <field name="name">hr.employee.form.multi.work.locations</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_location_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='work_location_id']" position="after">
                <field name="work_location_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="material_project_ids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
