<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <menuitem id="menu_employee_portal_root"
              name="Employee Portal"
              sequence="10"
              web_icon="employee_portal_suite,static/description/icon.png"/>

    <!-- Business menus are role-driven; Administrator has operational overview access. -->
    <menuitem id="menu_employee_request_items"
              name="Employee Requests"
              parent="menu_employee_portal_root"
              action="action_employee_request"
              sequence="10"
              groups="employee_portal_suite.group_employee_portal_manager,employee_portal_suite.group_employee_portal_hr,employee_portal_suite.group_employee_portal_finance,employee_portal_suite.group_employee_portal_ceo,employee_portal_suite.group_employee_portal_admin,employee_portal_suite.group_employee_portal_superadmin"/>

    <menuitem id="menu_material_request_items"
              name="Material Requests"
              parent="menu_employee_portal_root"
              action="action_material_request"
              sequence="20"
              groups="employee_portal_suite.group_mr_purchase_rep,employee_portal_suite.group_mr_store_manager,employee_portal_suite.group_mr_project_manager,employee_portal_suite.group_mr_projects_director,employee_portal_suite.group_employee_portal_ceo,employee_portal_suite.group_employee_portal_admin,employee_portal_suite.group_employee_portal_superadmin"/>

    <record id="action_portal_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">portal.announcement</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_portal_announcements"
              name="Announcements"
              parent="menu_employee_portal_root"
              action="action_portal_announcement"
              sequence="30"
              groups="employee_portal_suite.group_employee_portal_announcement_manager"/>
</odoo>
