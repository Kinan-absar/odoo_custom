<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<template id="portal_sign_documents_page">
    <t t-call="employee_portal_suite.employee_portal_layout">
        <style>
            .eps-sign-wrap { max-width: 1480px; margin: 0 auto; padding: 24px 18px 42px; }
            .eps-sign-head { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:18px; }
            .eps-sign-title { margin:0; font-size:30px; line-height:1.1; font-weight:700; color:#202536; }
            .eps-sign-subtitle { margin-top:6px; color:#7c8598; font-size:14px; }
            .eps-sign-tabs { display:inline-flex; gap:4px; padding:4px; border:1px solid #e3e6ec; border-radius:14px; background:#fff; box-shadow:0 4px 16px rgba(31,38,55,.05); }
            .eps-sign-tabs .btn { border:0 !important; border-radius:10px !important; min-width:96px; padding:9px 16px; font-weight:600; background:transparent; color:#626b7e; box-shadow:none !important; }
            .eps-sign-tabs .eps-active-pending { background:#714b67; color:#fff; }
            .eps-sign-tabs .eps-active-signed { background:#169c51; color:#fff; }
            .eps-sign-tabs .eps-active-rejected { background:#d94b57; color:#fff; }
            .eps-sign-search { position:relative; margin-bottom:18px; }
            .eps-sign-search input { height:48px; border:1px solid #e2e5eb; border-radius:14px; padding:0 86px 0 16px; background:#fff; box-shadow:0 4px 16px rgba(31,38,55,.04); font-size:15px; }
            .eps-sign-search input:focus { border-color:#9b7d94; box-shadow:0 0 0 3px rgba(113,75,103,.10); }
            .eps-sign-search .search-btn, .eps-sign-search .clear-search { position:absolute; top:50%; transform:translateY(-50%); border:0; background:transparent; color:#8a93a5; height:34px; width:34px; display:flex; align-items:center; justify-content:center; border-radius:9px; text-decoration:none; }
            .eps-sign-search .search-btn { right:8px; }
            .eps-sign-search .clear-search { right:44px; }
            .eps-sign-search .search-btn:hover, .eps-sign-search .clear-search:hover { background:#f3f1f3; color:#714b67; }
            .eps-sign-panel { border:1px solid #e4e7ec; border-radius:16px; background:#fff; overflow:hidden; box-shadow:0 8px 28px rgba(31,38,55,.05); }
            .eps-sign-table { margin:0; width:100%; table-layout:fixed; }
            .eps-sign-table thead th { padding:13px 16px; border:0; border-bottom:1px solid #eceef2; background:#fafbfc; color:#747e91; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
            .eps-sign-table tbody td { padding:14px 16px; border-color:#eef0f3; vertical-align:middle; color:#31394a; font-size:14px; }
            .eps-sign-table tbody tr:last-child td { border-bottom:0; }
            .eps-sign-table tbody tr:hover { background:#fcfbfc; }
            .eps-doc-name { font-weight:600; color:#242b3b; line-height:1.35; word-break:break-word; }
            .eps-date { color:#788297; white-space:nowrap; }
            .eps-badge { display:inline-flex; align-items:center; padding:5px 10px; border-radius:999px; font-size:12px; font-weight:700; line-height:1; }
            .eps-badge-pending { background:#fff1c9; color:#8d6100; }
            .eps-badge-signed { background:#def5e7; color:#13713a; }
            .eps-badge-rejected { background:#fde2e5; color:#a92f3b; }
            .eps-workflow { color:#596276; line-height:1.3; }
            .eps-action { display:flex; justify-content:flex-end; align-items:center; gap:8px; }
            .eps-action .btn { border-radius:9px; padding:7px 12px; font-weight:600; font-size:13px; }
            .eps-action .btn-primary { background:#714b67; border-color:#714b67; }
            .eps-empty { padding:56px 20px; text-align:center; color:#8a93a5; }
            .eps-mobile-card { border:1px solid #e5e8ed; border-radius:14px; background:#fff; padding:15px; margin-bottom:12px; box-shadow:0 5px 18px rgba(31,38,55,.04); }
            .eps-mobile-meta { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin:10px 0 12px; color:#788297; font-size:12px; }
            @media (max-width: 767.98px) {
                .eps-sign-wrap { padding:16px 12px 30px; }
                .eps-sign-head { display:block; }
                .eps-sign-title { font-size:25px; }
                .eps-sign-tabs { margin-top:14px; width:100%; }
                .eps-sign-tabs .btn { flex:1; min-width:0; padding:8px 10px; }
            }
        </style>

        <div class="eps-sign-wrap">
            <div class="eps-sign-head">
                <div>
                    <h3 class="eps-sign-title">Documents to Sign</h3>
                    <div class="eps-sign-subtitle">Your signature requests and completed documents</div>
                </div>
                <div class="eps-sign-tabs">
                    <a href="/my/employee/sign?filter=pending" t-att-class="'btn ' + ('eps-active-pending' if current_filter=='pending' else '')">Pending</a>
                    <a href="/my/employee/sign?filter=signed" t-att-class="'btn ' + ('eps-active-signed' if current_filter=='signed' else '')">Signed</a>
                    <a href="/my/employee/sign?filter=rejected" t-att-class="'btn ' + ('eps-active-rejected' if current_filter=='rejected' else '')">Rejected</a>
                </div>
            </div>

            <form method="get" class="eps-sign-search">
                <input type="hidden" name="filter" t-att-value="current_filter"/>
                <input type="text" id="signSearchInput" name="search" t-att-value="search or ''" placeholder="Search documents..." class="form-control"/>
                <t t-if="search">
                    <a t-att-href="'/my/employee/sign?filter=%s' % current_filter" class="clear-search" title="Clear search"><i class="fa fa-times"/></a>
                </t>
                <button type="submit" class="search-btn" title="Search"><i class="fa fa-search"/></button>
            </form>

            <t t-if="not documents">
                <div class="eps-sign-panel eps-empty">
                    <i class="fa fa-file-signature fa-2x mb-3"/>
                    <div class="fw-semibold">No documents found</div>
                </div>
            </t>

            <t t-if="documents">
                <div class="eps-sign-panel d-none d-md-block">
                    <table class="table eps-sign-table">
                        <colgroup>
                            <col style="width:55%"/>
                            <col style="width:11%"/>
                            <col style="width:12%"/>
                            <col style="width:14%"/>
                            <col style="width:8%"/>
                        </colgroup>
                        <thead><tr><th>Document</th><th>Date</th><th>Your Status</th><th>Workflow</th><th class="text-end">Action</th></tr></thead>
                        <tbody>
                            <t t-foreach="documents" t-as="doc">
                                <t t-set="item" t-value="doc['item']"/>
                                <t t-set="your_status" t-value="doc['your_status']"/>
                                <t t-set="workflow_status" t-value="doc['workflow_status']"/>
                                <tr>
                                    <td><div class="eps-doc-name"><t t-out="doc['filename']"/></div></td>
                                    <td><span class="eps-date"><t t-out="doc['date']"/></span></td>
                                    <td>
                                        <t t-if="'🟢' in your_status"><span class="eps-badge eps-badge-signed">Signed</span></t>
                                        <t t-elif="'🟡' in your_status"><span class="eps-badge eps-badge-pending">Pending</span></t>
                                        <t t-elif="'🔴' in your_status"><span class="eps-badge eps-badge-rejected">Rejected</span></t>
                                    </td>
                                    <td><div class="eps-workflow"><t t-out="workflow_status"/></div></td>
                                    <td><div class="eps-action">
                                        <t t-if="'🔴' in workflow_status"><span class="eps-badge eps-badge-rejected">Rejected</span></t>
                                        <t t-elif="'🟡' in your_status">
                                            <a class="btn btn-sm btn-primary" t-att-href="doc['sign_url']"><i class="fa fa-pencil me-1"/>Sign</a>
                                        </t>
                                        <t t-if="item.sign_request_id.state == 'signed'">
                                            <a class="btn btn-sm btn-outline-secondary" t-attf-href="/sign/download/{{ item.sign_request_id.id }}/{{ item.sign_request_id.access_token }}/completed" target="_blank" title="Download signed PDF"><i class="fa fa-download"/></a>
                                        </t>
                                    </div></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="d-md-none">
                    <t t-foreach="documents" t-as="doc">
                        <t t-set="item" t-value="doc['item']"/>
                        <t t-set="your_status" t-value="doc['your_status']"/>
                        <t t-set="workflow_status" t-value="doc['workflow_status']"/>
                        <div class="eps-mobile-card">
                            <div class="d-flex justify-content-between gap-2 align-items-start">
                                <div class="eps-doc-name"><t t-out="doc['filename']"/></div>
                                <t t-if="'🟢' in your_status"><span class="eps-badge eps-badge-signed">Signed</span></t>
                                <t t-elif="'🟡' in your_status"><span class="eps-badge eps-badge-pending">Pending</span></t>
                                <t t-elif="'🔴' in your_status"><span class="eps-badge eps-badge-rejected">Rejected</span></t>
                            </div>
                            <div class="eps-mobile-meta"><span><i class="fa fa-calendar-o me-1"/><t t-out="doc['date']"/></span><span><t t-out="workflow_status"/></span></div>
                            <div class="eps-action">
                                <t t-if="'🔴' in workflow_status"><span class="eps-badge eps-badge-rejected">Rejected</span></t>
                                <t t-elif="'🟡' in your_status"><a class="btn btn-sm btn-primary" t-att-href="doc['sign_url']"><i class="fa fa-pencil me-1"/>Sign</a></t>
                                <t t-if="item.sign_request_id.state == 'signed'"><a class="btn btn-sm btn-outline-secondary" t-attf-href="/sign/download/{{ item.sign_request_id.id }}/{{ item.sign_request_id.access_token }}/completed" target="_blank"><i class="fa fa-download me-1"/>Download</a></t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </div>

        <script>
        document.addEventListener("DOMContentLoaded", function() {
            const input = document.getElementById("signSearchInput");
            if (!input) return;
            input.addEventListener("input", function() {
                if (this.value.trim() === "") {
                    const filter = new URLSearchParams(window.location.search).get('filter') || 'pending';
                    window.location.href = "/my/employee/sign?filter=" + encodeURIComponent(filter);
                }
            });
        });
        </script>
    </t>
</template>
</odoo>
