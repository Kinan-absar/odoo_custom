<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="portal_employee_profile" name="Employee Portal - Profile">
        <t t-call="employee_portal_suite.employee_portal_layout">
            <style>
            .profile-header {
                display: flex;
                align-items: center;
                gap: 18px;
                margin-bottom: 26px;
            }
            .profile-avatar {
                width: 72px;
                height: 72px;
                border-radius: 18px;
                object-fit: cover;
                box-shadow: 0 6px 16px rgba(79,70,229,0.20);
            }
            .profile-header h1 {
                margin: 0;
                font-size: 26px;
            }
            .profile-header p {
                margin: 4px 0 0;
                color: var(--st-muted, #5f6368);
                font-size: 13.5px;
            }
            .profile-card {
                background: #fff;
                border: 1px solid var(--st-border, #dfe1e6);
                border-radius: 14px;
                padding: 22px 24px;
                margin-bottom: 20px;
            }
            .profile-card h3 {
                font-size: 15px;
                margin: 0 0 4px;
            }
            .profile-card .section-sub {
                font-size: 12.5px;
                color: var(--st-muted, #5f6368);
                margin: 0 0 18px;
            }
            .profile-field-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 16px;
            }
            .profile-field-grid .full-width { grid-column: 1 / -1; }
            .profile-field label {
                display: block;
                font-size: 12.5px;
                font-weight: 600;
                margin-bottom: 6px;
                color: #2b2b34;
            }
            .profile-readonly {
                background: var(--st-surface-low, #f3f4f6);
                border: 1px solid var(--st-border, #dfe1e6);
                border-radius: 8px;
                padding: 9px 12px;
                font-size: 13.5px;
                color: var(--st-muted, #5f6368);
            }
            @media (max-width: 768px) {
                .profile-field-grid { grid-template-columns: 1fr; }
                .profile-header { gap: 14px; }
                .profile-avatar { width: 58px; height: 58px; border-radius: 14px; }
                .profile-header h1 { font-size: 21px; }
            }
            </style>

            <div class="container my-4" style="max-width: 760px;">

                <t t-if="success_message">
                    <div class="alert alert-success" role="alert">Your profile has been updated.</div>
                </t>
                <t t-if="error_message">
                    <div class="alert alert-danger" role="alert">Something went wrong while saving. Please try again.</div>
                </t>

                <div class="profile-header">
                    <img class="profile-avatar" t-att-src="image_data_uri(employee.image_128 or request.env.user.partner_id.avatar_128)"/>
                    <div>
                        <h1 t-esc="employee.name"/>
                        <p t-esc="employee.job_title or employee.job_id.name or ''"/>
                    </div>
                </div>

                <form method="post" action="/my/employee/profile/update">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- CONTACT INFO -->
                    <div class="profile-card">
                        <h3>Contact Information</h3>
                        <p class="section-sub">Keep your personal contact details up to date.</p>
                        <div class="profile-field-grid">
                            <div class="profile-field">
                                <label>Work Email</label>
                                <div class="profile-readonly" t-esc="employee.work_email or request.env.user.email or '—'"/>
                            </div>
                            <div class="profile-field">
                                <label>Personal Phone</label>
                                <input type="tel" name="private_phone" class="form-control" t-att-value="employee.private_phone"/>
                            </div>
                            <div class="profile-field">
                                <label>Personal Email</label>
                                <input type="email" name="private_email" class="form-control" t-att-value="employee.private_email"/>
                            </div>
                            <div class="profile-field">
                                <label>Country</label>
                                <select name="private_country_id" class="form-control">
                                    <option value="">Select...</option>
                                    <t t-foreach="request.env['res.country'].sudo().search([], order='name')" t-as="country">
                                        <option t-att-value="country.id" t-att-selected="'selected' if employee.private_country_id and employee.private_country_id.id == country.id else None" t-esc="country.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="profile-field full-width">
                                <label>Street Address</label>
                                <input type="text" name="private_street" class="form-control" t-att-value="employee.private_street"/>
                            </div>
                            <div class="profile-field">
                                <label>Street 2</label>
                                <input type="text" name="private_street2" class="form-control" t-att-value="employee.private_street2"/>
                            </div>
                            <div class="profile-field">
                                <label>City</label>
                                <input type="text" name="private_city" class="form-control" t-att-value="employee.private_city"/>
                            </div>
                            <div class="profile-field">
                                <label>ZIP / Postal Code</label>
                                <input type="text" name="private_zip" class="form-control" t-att-value="employee.private_zip"/>
                            </div>
                            <t t-if="'km_home_work' in available_personal_fields">
                                <div class="profile-field">
                                    <label>Home-Work Distance (km)</label>
                                    <input type="number" step="0.1" min="0" name="km_home_work" class="form-control" t-att-value="employee.km_home_work"/>
                                </div>
                            </t>
                            <t t-if="'private_car_plate' in available_personal_fields">
                                <div class="profile-field">
                                    <label>Private Car Plate</label>
                                    <input type="text" name="private_car_plate" class="form-control" t-att-value="employee.private_car_plate"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- PERSONAL DETAILS -->
                    <t t-if="available_personal_fields">
                        <div class="profile-card">
                            <h3>Personal Details</h3>
                            <p class="section-sub">Additional information used for HR records.</p>
                            <div class="profile-field-grid">
                                <t t-if="'birthday' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Date of Birth</label>
                                        <input type="date" name="birthday" class="form-control" t-att-value="employee.birthday"/>
                                    </div>
                                </t>
                                <t t-if="'gender' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Gender</label>
                                        <select name="gender" class="form-control">
                                            <option value="">Select...</option>
                                            <option value="male" t-att-selected="'selected' if employee.gender == 'male' else None">Male</option>
                                            <option value="female" t-att-selected="'selected' if employee.gender == 'female' else None">Female</option>
                                            <option value="other" t-att-selected="'selected' if employee.gender == 'other' else None">Other</option>
                                        </select>
                                    </div>
                                </t>
                                <t t-if="'place_of_birth' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Place of Birth</label>
                                        <input type="text" name="place_of_birth" class="form-control" t-att-value="employee.place_of_birth"/>
                                    </div>
                                </t>
                                <t t-if="'country_of_birth' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Country of Birth</label>
                                        <select name="country_of_birth" class="form-control">
                                            <option value="">Select...</option>
                                            <t t-foreach="request.env['res.country'].sudo().search([], order='name')" t-as="country">
                                                <option t-att-value="country.id" t-att-selected="'selected' if employee.country_of_birth and employee.country_of_birth.id == country.id else None" t-esc="country.name"/>
                                            </t>
                                        </select>
                                    </div>
                                </t>
                                <t t-if="'marital' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Marital Status</label>
                                        <select name="marital" class="form-control">
                                            <t t-foreach="marital_options" t-as="opt">
                                                <option t-att-value="opt[0]" t-att-selected="'selected' if employee.marital == opt[0] else None" t-esc="opt[1]"/>
                                            </t>
                                        </select>
                                    </div>
                                </t>
                                <t t-if="'spouse_complete_name' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Spouse Name</label>
                                        <input type="text" name="spouse_complete_name" class="form-control" t-att-value="employee.spouse_complete_name"/>
                                    </div>
                                </t>
                                <t t-if="'children' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Number of Children</label>
                                        <input type="number" min="0" name="children" class="form-control" t-att-value="employee.children"/>
                                    </div>
                                </t>
                                <t t-if="'country_id' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Nationality</label>
                                        <select name="country_id" class="form-control">
                                            <option value="">Select...</option>
                                            <t t-foreach="request.env['res.country'].sudo().search([], order='name')" t-as="country">
                                                <option t-att-value="country.id" t-att-selected="'selected' if employee.country_id and employee.country_id.id == country.id else None" t-esc="country.name"/>
                                            </t>
                                        </select>
                                    </div>
                                </t>
                                <t t-if="'identification_id' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Identification No.</label>
                                        <input type="text" name="identification_id" class="form-control" t-att-value="employee.identification_id"/>
                                    </div>
                                </t>
                                <t t-if="'ssn_no' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>SSN No.</label>
                                        <input type="text" name="ssn_no" class="form-control" t-att-value="employee.ssn_no"/>
                                    </div>
                                </t>
                                <t t-if="'passport_id' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Passport No.</label>
                                        <input type="text" name="passport_id" class="form-control" t-att-value="employee.passport_id"/>
                                    </div>
                                </t>
                                <t t-if="'permit_no' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Work Permit No.</label>
                                        <input type="text" name="permit_no" class="form-control" t-att-value="employee.permit_no"/>
                                    </div>
                                </t>
                                <t t-if="'visa_no' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Visa No.</label>
                                        <input type="text" name="visa_no" class="form-control" t-att-value="employee.visa_no"/>
                                    </div>
                                </t>
                                <t t-if="'visa_expire' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Visa Expiration</label>
                                        <input type="date" name="visa_expire" class="form-control" t-att-value="employee.visa_expire"/>
                                    </div>
                                </t>
                                <t t-if="'certificate' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Certificate Level</label>
                                        <select name="certificate" class="form-control">
                                            <option value="">Select...</option>
                                            <option value="graduate" t-att-selected="'selected' if employee.certificate == 'graduate' else None">Graduate</option>
                                            <option value="bachelor" t-att-selected="'selected' if employee.certificate == 'bachelor' else None">Bachelor</option>
                                            <option value="master" t-att-selected="'selected' if employee.certificate == 'master' else None">Master</option>
                                            <option value="doctor" t-att-selected="'selected' if employee.certificate == 'doctor' else None">Doctor</option>
                                            <option value="other" t-att-selected="'selected' if employee.certificate == 'other' else None">Other</option>
                                        </select>
                                    </div>
                                </t>
                                <t t-if="'study_field' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>Field of Study</label>
                                        <input type="text" name="study_field" class="form-control" t-att-value="employee.study_field"/>
                                    </div>
                                </t>
                                <t t-if="'study_school' in available_personal_fields">
                                    <div class="profile-field">
                                        <label>School</label>
                                        <input type="text" name="study_school" class="form-control" t-att-value="employee.study_school"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- EMERGENCY CONTACT -->
                    <t t-if="has_emergency_fields">
                        <div class="profile-card">
                            <h3>Emergency Contact</h3>
                            <p class="section-sub">Who should we reach out to in case of an emergency?</p>
                            <div class="profile-field-grid">
                                <div class="profile-field">
                                    <label>Contact Name</label>
                                    <input type="text" name="emergency_contact" class="form-control" t-att-value="employee.emergency_contact"/>
                                </div>
                                <div class="profile-field">
                                    <label>Contact Phone</label>
                                    <input type="tel" name="emergency_phone" class="form-control" t-att-value="employee.emergency_phone"/>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- BANK DETAILS -->
                    <t t-if="has_bank_field">
                        <div class="profile-card">
                            <h3>Bank Details</h3>
                            <p class="section-sub">Used for salary and reimbursement payments.</p>
                            <div class="profile-field-grid">
                                <div class="profile-field">
                                    <label>Bank Name</label>
                                    <input type="text" name="bank_name" class="form-control"
                                           t-att-value="bank_account.bank_id.name if bank_account else ''"/>
                                </div>
                                <div class="profile-field">
                                    <label>Account / IBAN Number</label>
                                    <input type="text" name="acc_number" class="form-control"
                                           t-att-value="bank_account.acc_number if bank_account else ''"/>
                                </div>
                            </div>
                        </div>
                    </t>

                    <button type="submit" class="btn btn-primary" style="min-width: 160px;">Save Changes</button>
                </form>

            </div>
        </t>
    </template>

</odoo>
