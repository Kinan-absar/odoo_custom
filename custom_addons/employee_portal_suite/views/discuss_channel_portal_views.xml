<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="discuss_channel_form_employee_portal" model="ir.ui.view">
        <field name="name">discuss.channel.form.employee.portal</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Employee Portal" name="employee_portal" invisible="channel_type != 'channel'">
                    <group>
                        <group string="Portal Access">
                            <field name="employee_portal_enabled"/>
                            <field name="employee_portal_readonly" invisible="not employee_portal_enabled"/>
                        </group>
                        <group string="Allowed Portal Employees" invisible="not employee_portal_enabled">
                            <field name="employee_portal_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not employee_portal_enabled">
                        Only the selected employee portal users can see this channel in Portal Chats.
                        They are synchronized as native Discuss members so internal and portal users share the same channel and message history.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
