<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="discuss_channel_employee_portal_form" model="ir.ui.view">
        <field name="name">discuss.channel.employee.portal.form</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='privacy']" position="after">
                <page string="Group Management" name="employee_portal_group_management" invisible="channel_type != 'group'">
                    <div class="alert alert-info" role="alert">
                        Employee Portal group conversation. Remove individual members below, or permanently delete the whole group for everyone.
                    </div>
                    <field name="channel_member_ids">
                        <list editable="bottom" create="false">
                            <field name="partner_id" readonly="1"/>
                        </list>
                    </field>
                    <button name="action_employee_portal_delete_group" type="object" string="Delete Group for Everyone" class="btn btn-danger mt-3" confirm="This permanently deletes this group conversation for every member. Continue?"/>
                </page>
                <page string="Employee Portal" name="employee_portal" invisible="channel_type != 'channel'">
                    <group>
                        <group string="Portal Access">
                            <field name="employee_portal_access"/>
                            <field name="employee_portal_all_employees" invisible="employee_portal_access == 'disabled'"/>
                        </group>
                        <group string="Portal Audience" invisible="employee_portal_access == 'disabled' or employee_portal_all_employees">
                            <field name="employee_portal_department_ids" widget="many2many_tags"/>
                            <field name="employee_portal_employee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="employee_portal_access == 'disabled'">
                        Portal members are synchronized automatically from the audience above.
                        <b>Read Only</b> allows viewing only: no messages, reactions, attachments, voice notes, member changes, audio calls, or video calls.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_employee_portal_group_conversations" model="ir.actions.act_window">
        <field name="name">Group Conversations</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel_type', '=', 'group'), ('is_employee_portal_channel', '=', True)]</field>
        <field name="context">{'search_default_employee_portal_groups': 1}</field>
    </record>

    <menuitem id="menu_employee_portal_group_conversations"
              name="Group Conversations"
              parent="employee_portal_suite.menu_employee_portal_root"
              action="action_employee_portal_group_conversations"
              sequence="85"
              groups="base.group_system"/>

</odoo>
