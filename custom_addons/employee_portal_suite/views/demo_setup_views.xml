<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_portal_demo_setup_form" model="ir.ui.view">
        <field name="name">employee.portal.demo.setup.form</field>
        <field name="model">employee.portal.demo.setup</field>
        <field name="arch" type="xml">
            <form string="Prepare Employee Portal Demo">
                <sheet>
                    <div class="oe_title">
                        <h1>Prepare Demo Environment</h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Use <strong>Prepare Showcase Demo</strong> for screenshots, sales videos and customer demonstrations.
                        It creates realistic fictional business data only. It does not create or modify Odoo users, passwords,
                        portal access, contacts, or security groups.
                    </div>
                    <group>
                        <field name="demo_password" password="True"/>
                        <field name="confirm_disposable"/>
                    </group>
                    <field name="result_html" widget="html" readonly="1" nolabel="1" invisible="not result_html"/>
                </sheet>
                <footer>
                    <button name="action_prepare_showcase_demo" type="object" string="Prepare Showcase Demo" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_portal_demo_setup" model="ir.actions.act_window">
        <field name="name">Demo Setup</field>
        <field name="res_model">employee.portal.demo.setup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_employee_portal_demo_setup"
              name="Demo Setup"
              parent="employee_portal_suite.menu_employee_portal_root"
              action="action_employee_portal_demo_setup"
              sequence="90"
              groups="base.group_system"/>
</odoo>
