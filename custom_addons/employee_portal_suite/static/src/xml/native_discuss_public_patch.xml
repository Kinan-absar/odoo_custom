<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="employee_portal_suite.NativeDiscussPortalPatch"
       t-inherit="mail.Discuss" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o-mail-Discuss-content')]/div[contains(@class, 'o-mail-Discuss-header')]" position="before">
            <div t-if="isEmployeePortalDiscuss" class="ep-native-discuss-toolbar d-flex align-items-center gap-2 px-2 py-2 border-bottom">
                <span class="ep-native-discuss-app-title d-inline-flex align-items-center gap-2">
                    <img class="ep-native-discuss-logo" data-ep-company-logo="1" alt=""/>
                    <strong>Chats</strong>
                </span>
                <span class="flex-grow-1"/>
                <button type="button" class="btn btn-light d-none d-sm-inline-flex" t-on-click="installEmployeeChats" title="Install Chats">
                    <i class="fa fa-download"/><span class="d-none d-lg-inline ms-1">Install</span>
                </button>
                <button type="button" class="btn btn-light d-none d-md-inline-flex" t-on-click="toggleEmployeeFullscreen" title="Full screen">
                    <i class="fa fa-expand"/>
                </button>
            </div>
        </xpath>
        <xpath expr="//MessagingMenu" position="attributes">
            <attribute name="t-if">ui.isSmall and !isEmployeePortalDiscuss</attribute>
        </xpath>
    </t>
</templates>
