<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="employee_portal_suite.EPSDemoManagerTourOverlay">
    <t t-if="state.visible">
      <button t-if="!state.active"
              type="button"
              class="btn btn-primary shadow-lg d-flex align-items-center gap-2"
              style="position: fixed; right: 24px; bottom: 24px; z-index: 10050; border-radius: 999px; padding: 12px 18px;"
              t-on-click="start">
        <i class="fa fa-compass"/>
        <span class="fw-semibold">Guided Setup Tour</span>
      </button>

      <div t-if="state.active"
           class="card shadow-lg border-primary"
           style="position: fixed; right: 24px; bottom: 24px; width: min(460px, calc(100vw - 48px)); z-index: 10050; border-radius: 16px; overflow: hidden;">
        <div class="card-body p-3 p-lg-4">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
            <div>
              <span class="badge text-bg-primary">MANAGER SETUP TOUR</span>
              <span class="text-muted small ms-2"><t t-esc="state.step + 1"/> / <t t-esc="total"/></span>
            </div>
            <button class="btn-close" type="button" aria-label="Collapse" t-on-click="collapse"/>
          </div>

          <div class="progress mb-3" style="height:5px">
            <div class="progress-bar" t-att-style="'width:' + (((state.step + 1) / total) * 100) + '%'"/>
          </div>

          <h4 class="mb-2"><t t-esc="current.title"/></h4>
          <p class="mb-3" style="white-space: pre-line"><t t-esc="current.text"/></p>

          <div t-if="current.target" class="alert alert-info py-2 px-3 small mb-3">
            The guide stays visible while you work on the page behind it. When ready, press <strong>Next</strong>.
          </div>

          <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" t-on-click="previous" t-att-disabled="state.step === 0">Back</button>
            <div class="d-flex gap-2 flex-wrap justify-content-end">
              <button t-if="current.target" class="btn btn-outline-primary" t-on-click="reopenStep">Open This Step</button>
              <button t-if="current.portal" class="btn btn-success" t-on-click="openPortal">Open Employee Portal</button>
              <button t-elif="state.step &lt; total - 1" class="btn btn-primary px-4" t-on-click="next">Next</button>
              <button t-else="" class="btn btn-success px-4" t-on-click="collapse">Finish</button>
            </div>
          </div>

          <div class="border-top mt-3 pt-2 text-end">
            <button class="btn btn-link btn-sm text-muted p-0" t-on-click="restart">Restart tour</button>
          </div>
        </div>
      </div>
    </t>
  </t>
</templates>
