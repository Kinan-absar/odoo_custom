<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="employee_portal_suite.EmployeeRequestListView"
       t-inherit="web.ListView"
       t-inherit-mode="primary">
        <xpath expr="//Layout/t[@t-component]" position="before">
            <EmployeeRequestDashboard onFilter.bind="onDashboardFilter"/>
        </xpath>
    </t>

    <t t-name="employee_portal_suite.EmployeeRequestDashboard">
        <div class="o_employee_request_dashboard px-3 py-3 border-bottom bg-view" t-if="cards.length">
            <div class="d-flex flex-wrap gap-2">
                <t t-foreach="cards" t-as="card" t-key="card.id">
                    <div t-att-class="'er_card er_card_' + card.style"
                         t-on-click="() => this.filter(card.domain)">
                        <div class="er_value"><t t-out="card.count"/></div>
                        <div class="er_label"><t t-if="card.icon"><span class="me-1"><t t-out="card.icon"/></span></t><t t-out="card.label"/></div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
