<odoo>
 <template id="invoice_source_links" inherit_id="absar_portal_accounting.header"><xpath expr="//nav" position="inside"><t t-if="roles.get('customer_invoicing')"><a t-att-href="'/my/employee/accounting/invoice-sources/sales-orders?company_id=%s' % company.id">Invoice Sales Orders</a><a t-att-href="'/my/employee/accounting/invoice-sources/ipcs?company_id=%s' % company.id">Invoice IPCs</a></t></xpath></template>
 <template id="invoice_sources"><t t-call="employee_portal_suite.employee_portal_layout"><section class="aca"><t t-call="absar_portal_accounting.header"/><h2 t-out="'Invoice Sales Orders' if kind == 'sales-orders' else 'Invoice IPCs'"/><div t-if="message" class="aca-alert" t-out="message"/><form class="aca-filters" method="get"><input type="hidden" name="company_id" t-att-value="company.id"/><input name="q" t-att-value="q" placeholder="Search reference…"/><button>Search</button></form><div class="aca-panel"><table class="table"><thead><tr><th>Reference</th><th>Customer</th><th>Status</th><th>Invoice</th></tr></thead><tbody><tr t-foreach="records" t-as="source"><td t-out="source.display_name"/><td t-out="source.partner_id.display_name if kind == 'sales-orders' else source.contract_id.partner_id.display_name"/><td t-out="source.state"/><td><a t-if="kind == 'ipcs' and source.move_id" t-att-href="'/my/employee/accounting/invoices/%s?company_id=%s' % (source.move_id.id,company.id)">Open Linked Invoice</a><form t-if="roles['preparer'] and (source.invoice_status == 'to invoice' if kind == 'sales-orders' else (not source.move_id or source._current_move_can_be_replaced()))" method="post" t-att-action="'/my/employee/accounting/invoice-sources/%s/%s/create' % (kind,source.id)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="company_id" t-att-value="company.id"/><input type="hidden" name="version" t-att-value="str(source.write_date)"/><button class="aca-primary">Create Invoice</button></form></td></tr><tr t-if="not records"><td colspan="4">No sources found.</td></tr></tbody></table></div><div class="aca-pager"><a t-if="page &gt; 1" t-att-href="'?' + urlencode(dict(company_id=company.id,page=page-1,q=q))">Previous</a><span>Page <t t-out="page"/></span><a t-if="page * 40 &lt; total" t-att-href="'?' + urlencode(dict(company_id=company.id,page=page+1,q=q))">Next</a></div></section></t></template>
</odoo>
