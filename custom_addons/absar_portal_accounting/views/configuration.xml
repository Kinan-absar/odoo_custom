<odoo>
    <record id="company_portal_accounting" model="ir.ui.view">
        <field name="active" eval="False"/>
        <field name="name">res.company.portal.accounting</field><field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Portal Accounting" groups="base.group_system">
                    <group>
                        <field name="portal_accounting_journal_ids" widget="many2many_tags" domain="[('company_id', '=', id)]" options="{'no_create': True}"/>
                    </group>
                    <p>Assign Accounting Preparer, Accounting Approver or Accounting Monitor on the user. Only journals selected here are available. Portal roles do not grant internal accounting permissions.</p>
                </page>
            </xpath>
        </field>
    </record>
    <record id="settings_portal_accounting" model="ir.ui.view">
        <field name="name">res.config.settings.portal.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Employee Portal Accounting" name="employee_portal_accounting" groups="base.group_system">
                    <setting id="portal_accounting_journals" string="Portal Journals" company_dependent="1" help="Choose which journals the employee accounting workspace may use in this company. Leaving this empty disables the workspace.">
                        <field name="portal_accounting_journal_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    <record id="move_portal_review" model="ir.ui.view">
        <field name="name">account.move.portal.review</field><field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="portal_accounting_requires_review" invisible="1"/>
                <button name="action_portal_accounting_submit" type="object" string="Submit for Approval" class="oe_highlight" groups="absar_portal_accounting.group_preparer" invisible="not portal_accounting_requires_review or portal_accounting_review in ('submitted','approved')"/>
                <field name="portal_accounting_can_review" invisible="1"/>
                <button name="action_portal_accounting_approve" type="object" string="Approve &amp; Post" groups="absar_portal_accounting.group_approver" invisible="not portal_accounting_can_review" class="oe_highlight"/>
                <button name="action_portal_accounting_return" type="object" string="Return for Correction" groups="absar_portal_accounting.group_approver" invisible="not portal_accounting_can_review"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible" add="(portal_accounting_requires_review and portal_accounting_review != 'approved')" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='action_post' and not(contains(@invisible, 'portal_accounting_requires_review'))]" position="attributes">
                <attribute name="invisible" add="(portal_accounting_requires_review and portal_accounting_review != 'approved')" separator=" or "/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Accounting Review / Reset Requests" invisible="not portal_accounting_review_required and not portal_accounting_reset_pending">
                    <group>
                        <field name="portal_accounting_issuer_id"/>
                        <field name="portal_accounting_review"/>
                        <field name="portal_accounting_reviewer_id"/>
                        <field name="portal_accounting_comment" readonly="not portal_accounting_can_review" string="Review / Return Reason"/>
                    </group>
                    <field name="portal_accounting_review_required" invisible="1"/>
                    <field name="portal_accounting_reset_pending"/>
                    <field name="portal_accounting_reset_requested_by"/>
                    <field name="portal_accounting_reset_reason"/>
                    <div class="text-muted" invisible="not portal_accounting_reset_pending">Reset requested. Review the reason and use the existing native Reset to Draft button and its approval rules. The portal does not reset this document.</div>
                </page>
            </xpath>
        </field>
    </record>
    <record id="payment_portal_review" model="ir.ui.view">
        <field name="name">account.payment.voucher.portal.review</field><field name="model">account.payment.voucher</field>
        <field name="inherit_id" ref="internal_transfer_voucher.view_payment_voucher_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="portal_accounting_requires_review" invisible="1"/>
                <button name="action_portal_accounting_submit" type="object" string="Submit for Approval" class="oe_highlight" invisible="not portal_accounting_requires_review or portal_accounting_review in ('submitted','approved')" groups="absar_portal_accounting.group_preparer"/>
                <field name="portal_accounting_can_review" invisible="1"/>
                <button name="action_portal_accounting_approve" type="object" string="Approve &amp; Post" groups="absar_portal_accounting.group_approver" invisible="not portal_accounting_can_review" class="oe_highlight"/>
                <button name="action_portal_accounting_return" type="object" string="Return for Correction" groups="absar_portal_accounting.group_approver" invisible="not portal_accounting_can_review"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible" add="(portal_accounting_requires_review and portal_accounting_review != 'approved')" separator=" or "/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Accounting Review / Reset Requests" invisible="not portal_accounting_review_required and not portal_accounting_reset_pending">
                    <field name="portal_accounting_issuer_id"/>
                    <field name="portal_accounting_review"/>
                    <field name="portal_accounting_reviewer_id"/>
                    <field name="portal_accounting_comment" readonly="not portal_accounting_can_review" string="Review / Return Reason"/>
                    <field name="portal_accounting_review_required" invisible="1"/>
                    <field name="portal_accounting_reset_pending"/>
                    <field name="portal_accounting_reset_requested_by"/>
                    <field name="portal_accounting_reset_reason"/>
                    <div class="text-muted" invisible="not portal_accounting_reset_pending">Reset requested. Review the reason and use the existing native Reset to Draft button and its approval rules. The portal does not reset this document.</div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="receipt_portal_review" model="ir.ui.view">
        <field name="name">account.receipt.voucher.portal.review</field><field name="model">account.receipt.voucher</field>
        <field name="inherit_id" ref="internal_transfer_voucher.view_receipt_voucher_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="portal_accounting_requires_review" invisible="1"/>
                <button name="action_portal_accounting_submit" type="object" string="Submit for Approval" class="oe_highlight" invisible="not portal_accounting_requires_review or portal_accounting_review in ('submitted','approved')" groups="absar_portal_accounting.group_preparer"/>
                <field name="portal_accounting_can_review" invisible="1"/>
                <button name="action_portal_accounting_approve" type="object" string="Approve &amp; Post" groups="absar_portal_accounting.group_approver" invisible="not portal_accounting_can_review" class="oe_highlight"/>
                <button name="action_portal_accounting_return" type="object" string="Return for Correction" groups="absar_portal_accounting.group_approver" invisible="not portal_accounting_can_review"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible" add="(portal_accounting_requires_review and portal_accounting_review != 'approved')" separator=" or "/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Accounting Review / Reset Requests" invisible="not portal_accounting_review_required and not portal_accounting_reset_pending">
                    <field name="portal_accounting_issuer_id"/>
                    <field name="portal_accounting_review"/>
                    <field name="portal_accounting_reviewer_id"/>
                    <field name="portal_accounting_comment" readonly="not portal_accounting_can_review" string="Review / Return Reason"/>
                    <field name="portal_accounting_review_required" invisible="1"/>
                    <field name="portal_accounting_reset_pending"/>
                    <field name="portal_accounting_reset_requested_by"/>
                    <field name="portal_accounting_reset_reason"/>
                    <div class="text-muted" invisible="not portal_accounting_reset_pending">Reset requested. Review the reason and use the existing native Reset to Draft button and its approval rules. The portal does not reset this document.</div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
