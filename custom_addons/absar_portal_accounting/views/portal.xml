<odoo>
    <template id="navigation" inherit_id="employee_portal_suite.employee_portal_layout" priority="90">
        <xpath expr="//nav[@id='ep-desktop-sidebar-nav']" position="inside">
            <div class="ep-sidebar-section" t-if="not request.env.user.has_group('employee_portal_suite.group_attendance_only') and (request.env.user.has_group('absar_portal_accounting.group_preparer') or request.env.user.has_group('absar_portal_accounting.group_approver') or request.env.user.has_group('absar_portal_accounting.group_monitor'))">
                <div class="ep-sidebar-section-title">Accounting</div><div class="ep-sidebar-section-links">
                    <a href="/my/employee/accounting" class="ep-sidebar-link"><i class="fa fa-book"/>Accounting Workspace</a>
                </div>
            </div>
        </xpath>
    </template>
    <template id="header">
        <nav class="aca-nav" aria-label="Accounting workspace">
            <a t-att-href="'/my/employee/accounting?company_id=%s' % company.id"><strong>Accounting</strong></a>
            <t t-foreach="kinds.items()" t-as="area">
                <a t-att-href="'/my/employee/accounting/%s?company_id=%s' % (area[0], company.id)" t-out="area[1][1]"/>
            </t>
        </nav>
        <div class="aca-company"><span t-out="company.name"/>
            <form method="get" t-if="len(companies) &gt; 1"><label>Company <select name="company_id" onchange="this.form.submit()">
                <option t-foreach="companies" t-as="c" t-att-value="c.id" t-att-selected="c == company" t-out="c.name"/>
            </select></label></form>
        </div>
        <div class="aca-alert" t-if="not configured">An administrator must select the available journals under Settings → Users &amp; Companies → Companies → Portal Accounting before this workspace can be used.</div>
    </template>
    <template id="home">
        <t t-call="employee_portal_suite.employee_portal_layout"><main class="aca">
            <t t-call="absar_portal_accounting.header"/>
            <h2>Accounting Workspace</h2><p>Prepare, review and monitor your accounting documents.</p>
            <div class="aca-cards"><a t-foreach="kinds.items()" t-as="area" class="aca-card" t-att-href="'/my/employee/accounting/%s?company_id=%s' % (area[0], company.id)">
                <span t-out="area[1][1]"/><strong t-out="counts[area[0]]"/>
            </a></div>
        </main></t>
    </template>
    <template id="listing">
        <t t-call="employee_portal_suite.employee_portal_layout"><main class="aca">
            <t t-call="absar_portal_accounting.header"/>
            <div class="aca-title"><h2 t-out="title"/>
                <a class="aca-primary" t-if="roles['preparer'] and configured" t-att-href="'/my/employee/accounting/%s/new?company_id=%s' % (kind, company.id)">New</a>
            </div>
            <div class="aca-alert" t-if="message" t-out="message"/>
            <form class="aca-filters" method="get"><input type="hidden" name="company_id" t-att-value="company.id"/>
                <input name="q" placeholder="Search number, reference or partner…" t-att-value="q" aria-label="Search accounting documents"/>
                <select name="status" aria-label="Document status"><option value="">All statuses</option>
                    <t t-if="kind not in ('planned','planned-receipts')"><option t-foreach="[('draft','Draft'),('submitted','Awaiting Approval'),('posted','Posted'),('cancel','Cancelled')]" t-as="s" t-att-value="s[0]" t-att-selected="status == s[0]" t-out="s[1]"/></t>
                </select><button>Search</button>
                <a t-att-href="'/my/employee/accounting/%s?company_id=%s' % (kind, company.id)">Clear</a>
                <span><t t-out="count"/> records</span>
            </form>
            <form method="post" t-att-action="'/my/employee/accounting/planned/submit-selected'">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="company_id" t-att-value="company.id"/>
            <button class="primary" t-if="kind == 'planned' and roles['preparer']">Submit Selected to CEO</button>
            <div class="aca-table-wrap"><table class="aca-table"><thead><tr>
                <th t-if="kind == 'planned' and roles['preparer']">Select</th>
                <th>Number / Name</th><th>Partner / Reference</th><th>Date</th><th>Journal</th><th>Amount</th><th>Status</th><th>Review</th><th>Prepared by</th>
            </tr></thead><tbody>
                <tr t-foreach="rows" t-as="row">
                    <td t-if="kind == 'planned' and roles['preparer']"><input type="checkbox" name="record_id" t-att-value="row['id']" t-att-disabled="row['state'] != 'planned' or row['review'] != 'not_sent'" t-att-aria-label="'Select ' + row['name']"/>
                        <input type="hidden" t-att-name="'version_%s' % row['id']" t-att-value="row['version']"/></td>
                    <td><a t-att-href="'/my/employee/accounting/%s/%s?company_id=%s' % (kind,row['id'],company.id)" t-out="row['name']"/></td>
                    <td t-out="row['partner']"/><td t-out="row['date']"/><td t-out="row['journal']"/>
                    <td class="aca-money"><t t-out="'{:,.2f}'.format(row['amount'])"/> <t t-out="row['currency']"/></td>
                    <td><span class="aca-badge" t-out="row['state']"/></td><td t-out="row['review'].replace('_',' ').title()"/><td t-out="row['issuer']"/>
                </tr>
                <tr t-if="not rows"><td colspan="8">No documents found.</td></tr>
            </tbody></table></div></form>
            <div class="aca-pager">
                <a t-if="page &gt; 1" t-att-href="'?company_id=%s&amp;page=%s&amp;q=%s&amp;status=%s' % (company.id,page-1,quote_plus(q),status)">Previous</a>
                <span>Page <t t-out="page"/></span>
                <a t-if="page * 40 &lt; count" t-att-href="'?company_id=%s&amp;page=%s&amp;q=%s&amp;status=%s' % (company.id,page+1,quote_plus(q),status)">Next</a>
            </div>
        </main></t>
    </template>
    <template id="detail">
        <t t-call="employee_portal_suite.employee_portal_layout"><main class="aca">
            <t t-call="absar_portal_accounting.header"/>
            <a t-att-href="'/my/employee/accounting/%s?company_id=%s' % (kind, company.id)" t-out="title"/>
            <div id="aca-editor" t-att-data-boot="boot_json" t-att-data-csrf="request.csrf_token()"/>
            <noscript>Enable JavaScript to use the accounting form.</noscript>
        </main></t>
    </template>
</odoo>
