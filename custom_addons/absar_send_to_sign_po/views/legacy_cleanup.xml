<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Keep the old XML id for upgrade safety, but disable the obsolete Company > PO Signers tab. -->
    <record id="view_company_form_send_to_sign" model="ir.ui.view">
        <field name="name">res.company.form.send.to.sign.po.legacy.disabled</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="po_signers_legacy_removed" string="PO Signers" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
