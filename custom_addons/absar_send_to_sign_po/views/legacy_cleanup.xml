<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
      Upgrade-safe cleanup of the old Company > PO Signers tab.
      The legacy Python fields are intentionally retained (unused) so the old
      inherited view can be loaded during registry initialization on databases
      upgrading from earlier versions. This XML then deactivates that view.
    -->
    <record id="view_company_form_send_to_sign" model="ir.ui.view">
        <field name="name">res.company.form.send.to.sign.po.legacy.disabled</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="po_signers_legacy_removed" string="PO Signers" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
