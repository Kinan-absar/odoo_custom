<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="po_add_signature_state_field" model="ir.ui.view">
        <field name="name">purchase.order.add.signature_state</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="sign_template_id" invisible="1"/>
                <field name="signing_workflow_id" invisible="1"/>
                <field name="signature_state" invisible="1"/>
                <field name="signature_completed_count" invisible="1"/>
                <field name="signature_total_count" invisible="1"/>
                <field name="revision" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_po_form_send_to_sign" model="ir.ui.view">
        <field name="name">purchase.order.form.send.to.sign</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_send_to_sign" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="state != 'purchase' or signature_state != 'draft'">
                    <div>Send to Sign</div>
                </button>
                <button name="action_open_signature_status" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="not sign_template_id">
                    <field name="signature_status_text" widget="statinfo" string="Signature"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="po_add_revision_display" model="ir.ui.view">
        <field name="name">purchase.order.revision.display</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h1" position="after">
                <field name="revision" class="ms-2" readonly="1" string="Revision" invisible="revision == 0"/>
            </xpath>
        </field>
    </record>

    <record id="rfq_list_view_inherit_sign" model="ir.ui.view">
        <field name="name">purchase.rfq.list.inherit.sign.state</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="signature_status_text" string="Signature" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_inherit_project" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.project.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_id" string="Project"/>
            </xpath>
        </field>
    </record>
</odoo>
