<odoo>
    <!-- Replace the existing bell, rather than adding a second bell next to it.
         EPS business screens/read markers are untouched. The new class names
         also prevent the old MR-only poller from overwriting combined counts. -->
    <template id="shared_notification_bell" inherit_id="employee_portal_suite.ep_notification_bell" name="Shared EPS and Workspace notification bell" priority="90">
        <xpath expr="//div[hasclass('ep-bell-wrap')]" position="replace">
            <t t-call="portal_backend_workspace.notification_bell"/>
        </xpath>
    </template>
    <template id="shared_notification_assets" inherit_id="employee_portal_suite.employee_portal_layout" name="Shared notification bell assets" priority="90">
        <xpath expr="//t[@t-call-assets='web.assets_frontend']" position="after">
            <t t-set="pbw_bell_data" t-value="request.env['pbw.notification.seen']._get_bell_data(request.env.user) if request.env['pbw.notification.seen']._can_use_bell(request.env.user) else {}"/>
            <t t-call="portal_backend_workspace.notification_assets"/>
            <script src="/portal_backend_workspace_eps_bridge/static/src/notification_compat.js?v=18.0.0.9.4" defer="defer"/>
        </xpath>
    </template>
    <template id="workspace_notification_compat" inherit_id="portal_backend_workspace.workspace_layout" name="Preserve EPS header tools in the workspace" priority="90">
        <xpath expr="//t[@t-call='portal_backend_workspace.notification_assets']" position="after">
            <script src="/portal_backend_workspace_eps_bridge/static/src/notification_compat.js?v=18.0.0.9.4" defer="defer"/>
        </xpath>
    </template>
</odoo>
