<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <template id="proposal_document_detail" inherit_id="portal_backend_workspace.sales__document_detail_extra">
    <xpath expr="." position="inside">
      <t t-if="order._pbw_sales_document_type() == 'technical'">
     <div t-if="not can_edit" class="pbw-sales-panel"><h5>Proposal Details</h5><div class="row"><div t-foreach="[('title', 'Proposal title'), ('reference', 'External Proposal Reference'), ('signatory', 'Authorized Signatory'), ('signatory_title', 'Signatory Title'), ('customer_signatory', 'Customer Authorized Signatory'), ('customer_signatory_title', 'Customer Signatory Title')]" t-as="entry" class="col-md-4" t-if="entry[0] in proposal_header_fields"><span class="text-muted" t-out="entry[1]"/><p t-out="order[proposal_header_fields[entry[0]]] or '-'"/></div></div></div><div class="pbw-sales-panel"><h5>Technical Proposal Template</h5>
      <form t-if="can_edit" method="post" t-att-action="'/my/workspace/sales/%s/template' % order.id" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-8"><select name="template_id" class="form-select" required="required"><option value="">Choose a template</option><option t-foreach="templates" t-as="t" t-att-value="t.id" t-out="t.name" t-att-selected="order.absar_proposal_template_id.id == t.id and 'selected' or None"/></select></div><div class="col-md-4"><button class="btn btn-outline-primary" data-pbw-sales-confirm="Replace existing proposal sections and milestones with the selected template?">Load / Replace Template</button></div></form>
      <p t-if="not can_edit" class="text-muted" t-out="order.absar_proposal_template_id.name or 'Custom proposal'"/>
     </div>
     <div class="pbw-sales-panel"><h5>Technical Sections</h5><p t-if="can_edit" class="text-muted small">Set the Order number and save to move a section to that position.</p><div class="pbw-sales-sortable" t-att-data-reorder-url="'/my/workspace/sales/%s/sections/reorder' % order.id" t-att-data-csrf="request.csrf_token()"><details t-foreach="order.absar_proposal_section_ids.sorted(key=lambda s:(s.sequence,s.id))" t-as="s" class="pbw-sales-section pbw-sales-section-compact" t-att-data-section-id="s.id"><summary class="pbw-sales-section-heading"><span class="pbw-sales-section-number" t-out="s_index + 1"/><span class="pbw-sales-section-name" t-out="s.name"/><span t-if="not s.include_in_report" class="pbw-sales-muted-tag">Hidden from PDF</span><span class="pbw-sales-section-toggle">Edit / View</span></summary><div class="pbw-sales-section-expanded">
      
      <form t-att-action="'/my/workspace/sales/%s/section/%s/save' % (order.id,s.id)" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
       <div class="d-flex align-items-center gap-2 mb-2"><label class="mb-0" for="pbw-sales-section-order">Order</label><input type="number" name="position" min="1" t-att-max="len(order.absar_proposal_section_ids)" t-att-value="s_index + 1" class="form-control form-control-sm" style="width:85px" t-att-readonly="not can_edit and 'readonly' or None"/><span class="text-muted small">Set the position, then Save Section</span></div><label>Section type</label><select name="section_type" class="form-select" t-att-disabled="not can_edit and 'disabled' or None"><option t-foreach="s._fields['section_type'].selection" t-as="opt" t-att-value="opt[0]" t-att-selected="s.section_type == opt[0] and 'selected' or None" t-out="opt[1]"/></select>
       <label class="mt-2">Section title</label><input class="form-control" name="name" t-att-value="s.name" t-att-readonly="not can_edit and 'readonly' or None"/>
       <label class="mt-2">Content</label>
       <div class="pbw-sales-editor" t-att-data-editable="can_edit and '1' or '0'">
        <div t-if="can_edit" class="pbw-sales-editor-toolbar" role="toolbar" aria-label="Format text"><button type="button" data-pbw-sales-format="bold" title="Bold"><b>B</b></button><button type="button" data-pbw-sales-format="italic" title="Italic"><i>I</i></button><button type="button" data-pbw-sales-format="underline" title="Underline"><u>U</u></button><select aria-label="Text size" class="pbw-sales-font-size"><option value="">Text size</option><option value="2">Small</option><option value="3">Normal</option><option value="4">Large</option><option value="5">Extra large</option></select><button type="button" data-pbw-sales-format="insertUnorderedList" title="Bullet list">• List</button></div>
        <div class="pbw-sales-editor-body" t-att-contenteditable="can_edit and 'true' or 'false'" role="textbox" aria-multiline="true" aria-label="Section content"><t t-if="s.content"><span t-field="s.content"/></t></div>
        <textarea name="content" hidden="hidden" t-out="s.content or ''"/>
       </div>
       <div t-if="can_edit" class="d-flex gap-3 align-items-center mt-2"><label><input type="checkbox" name="include" value="1" t-att-checked="s.include_in_report and 'checked' or None"/> Include in PDF</label><label><input type="checkbox" name="page_break" value="1" t-att-checked="s.page_break_before and 'checked' or None"/> New PDF page</label><button class="btn btn-sm btn-outline-primary">Save Section</button></div>
      </form>
      <form t-if="can_edit" method="post" t-att-action="'/my/workspace/sales/%s/section/%s/delete' % (order.id,s.id)" class="mt-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-danger" data-pbw-sales-confirm="Remove this section?">Delete Section</button></form>
     </div></details>
     </div><details t-if="can_edit" class="pbw-sales-add-section"><summary>+ Add Section</summary><form method="post" t-att-action="'/my/workspace/sales/%s/section/add' % order.id" class="pbw-sales-new row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-3"><select class="form-select" name="section_type"><option t-foreach="order.env['absar.proposal.section']._fields['section_type'].selection" t-as="opt" t-att-value="opt[0]" t-out="opt[1]"/></select></div><div class="col-md-4"><input class="form-control" name="name" placeholder="New section title" required="required"/></div><div class="col-md-5"><textarea class="form-control" rows="2" name="content" placeholder="Initial text (can be formatted after adding)"/></div><div class="col-12 d-flex gap-3 align-items-center"><label>Order <input type="number" class="form-control form-control-sm" style="width:85px" name="position" min="1" t-att-max="len(order.absar_proposal_section_ids) + 1" t-att-value="len(order.absar_proposal_section_ids) + 1" t-att-readonly="not can_edit and 'readonly' or None"/></label><label><input type="checkbox" name="page_break" value="1"/> Start on new PDF page</label><button class="btn btn-outline-primary">Save New Section</button></div></form></details>
     </div>
     <div class="pbw-sales-panel"><h5>Payment Milestones</h5>
<div class="table-responsive"><table class="table"><thead><tr><th>Order</th><th>Milestone</th><th>%</th><th>Due condition</th><th>Amount (excl. VAT)</th><th>Actions</th></tr></thead><tbody>
<tr t-foreach="order.absar_proposal_payment_ids.sorted(key=lambda p:(p.sequence,p.id))" t-as="p">
<td><input t-if="can_edit" type="number" min="1" t-att-max="len(order.absar_proposal_payment_ids)" name="position" class="form-control" style="width:80px" t-att-value="p_index+1" t-att-form="'pbw-milestone-%s' % p.id"/><span t-else="" t-out="p_index+1"/></td>
<td><input t-if="can_edit" name="name" class="form-control" required="required" t-att-value="p.name" t-att-form="'pbw-milestone-%s' % p.id"/><span t-else="" t-out="p.name"/></td>
<td><input t-if="can_edit" name="percentage" type="number" min="0" max="100" step="0.01" class="form-control" required="required" style="min-width:90px" t-att-value="p.percentage" t-att-form="'pbw-milestone-%s' % p.id"/><span t-else="" t-out="p.percentage"/></td>
<td><input t-if="can_edit" name="due_condition" class="form-control" t-att-value="p.due_condition or ''" t-att-form="'pbw-milestone-%s' % p.id"/><span t-else="" t-out="p.due_condition"/></td>
<td><span t-field="p.amount"/></td>
<td><div t-if="can_edit" class="d-flex gap-2"><form method="post" t-att-id="'pbw-milestone-%s' % p.id" t-att-action="'/my/workspace/sales/%s/milestone/%s/save' % (order.id,p.id)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-primary">Save Milestone</button></form><form method="post" t-att-action="'/my/workspace/sales/%s/milestone/%s/delete' % (order.id,p.id)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></div></td>
</tr></tbody></table></div>
<p class="text-muted small">Milestones use the VAT-exclusive quotation total. Total: <strong t-translation="off"><t t-out="'{:.2f}'.format(sum(order.absar_proposal_payment_ids.mapped('percentage')))"/>%</strong>. Milestones must total 100% before printing.</p>
<form t-if="can_edit" method="post" t-att-action="'/my/workspace/sales/%s/milestone/add' % order.id" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-md-4"><input class="form-control" name="name" placeholder="Milestone" required="required"/></div><div class="col-md-2"><input class="form-control" name="percentage" type="number" step="0.01" min="0" max="100" placeholder="%" required="required"/></div><div class="col-md-4"><input class="form-control" name="due_condition" placeholder="Payment due condition"/></div><div class="col-md-2"><button class="btn btn-outline-primary">Add</button></div></form>
</div></t>
    </xpath>
  </template>
  <template id="proposal_document_header" inherit_id="portal_backend_workspace.sales__document_header_extra">
    <xpath expr="." position="inside"><t t-if="order._pbw_sales_document_type() == 'technical'"><div t-foreach="[('title', 'Proposal title'), ('reference', 'External Proposal Reference'), ('signatory', 'Authorized Signatory'), ('signatory_title', 'Signatory Title'), ('customer_signatory', 'Customer Authorized Signatory'), ('customer_signatory_title', 'Customer Signatory Title')]" t-as="entry" class="col-md-4" t-if="entry[0] in proposal_header_fields"><label t-out="entry[1]"/><input class="form-control" t-att-name="entry[0]" data-pbw-sales-extra-header="1" t-att-value="order[proposal_header_fields[entry[0]]] or ''"/></div></t></xpath></template>
<template id="proposal_document_new" inherit_id="portal_backend_workspace.sales__document_new_extra">
<xpath expr="." position="inside"><t t-if="proposal_supported">
<div class="col-md-6 pbw-proposal-new-header" hidden="hidden"><label>Proposal title</label><input name="title" class="form-control" value="TECHNICAL &amp; FINANCIAL PROPOSAL" disabled="disabled"/></div>
<div class="col-md-6 pbw-proposal-new-header" hidden="hidden"><label>Technical Proposal Template</label><select name="template_id" class="form-select"><option value="">Custom proposal (no template)</option><option t-foreach="templates" t-as="proposal_template" t-att-value="proposal_template.id" t-att-data-company-id="proposal_template.company_id.id or 0" t-out="proposal_template.name"/></select><button type="button" class="btn btn-outline-primary mt-2" data-pbw-proposal-load="1" disabled="disabled">Load / Replace Template</button><small class="text-muted d-block">Loads sections and milestones below without changing quotation lines.</small></div>
<div class="col-md-6 pbw-proposal-new-header" hidden="hidden" t-if="'reference' in proposal_header_fields"><label>External Proposal Reference</label><input class="form-control" name="reference" data-pbw-sales-extra-header="1" disabled="disabled"/></div>
<div class="col-12 pbw-proposal-new-header" hidden="hidden"><textarea name="proposal_payload" data-pbw-sales-extra-header="1" hidden="hidden" disabled="disabled" data-pbw-sales-create-only="1"/><div class="alert alert-warning" role="alert" data-pbw-proposal-error="1" hidden="hidden"/></div>
<div class="col-12 pbw-proposal-new-header" hidden="hidden"><details><summary>Signatories</summary><div class="row g-3"><t t-foreach="[('signatory','Authorized Signatory'),('signatory_title','Signatory Title'),('customer_signatory','Customer Authorized Signatory'),('customer_signatory_title','Customer Signatory Title')]" t-as="entry"><div class="col-md-6" t-if="entry[0] in proposal_header_fields"><label t-out="entry[1]"/><input class="form-control" t-att-name="entry[0]" data-pbw-sales-extra-header="1" disabled="disabled"/></div></t></div></details></div></t></xpath></template><template id="proposal_new_editor" inherit_id="portal_backend_workspace.sales__sales_new">
<xpath expr="//div[@class='pbw-sales-panel']" position="after"><div t-if="proposal_supported" id="pbw-proposal-draft-editor" t-att-data-boot="proposal_draft_boot" t-att-data-csrf="request.csrf_token()" hidden="hidden">
<div class="pbw-sales-panel"><h5>Technical Sections</h5><p class="text-muted small">Prepare the proposal here. Save Draft saves the quotation, sections and payment milestones together.</p><div data-pbw-proposal-sections="1"/><button type="button" class="btn btn-outline-primary" data-pbw-proposal-add-section="1">+ Add Section</button></div>
<div class="pbw-sales-panel"><h5>Payment Milestones</h5><div class="table-responsive"><table class="table pbw-proposal-draft-payments"><thead><tr><th>Order</th><th>Milestone</th><th>%</th><th>Due condition</th><th>Amount (excl. VAT)</th><th>Actions</th></tr></thead><tbody data-pbw-proposal-payments="1"/></table></div><p class="text-muted small" data-pbw-proposal-payment-total="1"/><button type="button" class="btn btn-outline-primary" data-pbw-proposal-add-payment="1">+ Add Milestone</button></div>
</div></xpath></template></odoo>
