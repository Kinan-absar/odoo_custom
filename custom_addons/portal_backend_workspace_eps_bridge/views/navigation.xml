<odoo>
<template id="employee_workspace_navigation" inherit_id="employee_portal_suite.employee_portal_layout" name="Optional Business Workspace Navigation">
<xpath expr="//nav[@id='ep-desktop-sidebar-nav']" position="inside">
<div class="ep-sidebar-section" t-if="request.env.user._pbw_has_access()" id="pbw-eps-business-workspaces">
<div class="ep-sidebar-section-title">Business Workspaces</div><div class="ep-sidebar-section-links">
<a href="/my/workspace" class="ep-sidebar-link"><i class="fa fa-th-large"/>Workspace Home</a>
<t t-foreach="request.env.user._pbw_workspace_areas()" t-as="pbw_area"><a t-att-href="pbw_area['url']" class="ep-sidebar-link"><i t-att-class="'fa '+pbw_area['icon']"/><t t-out="pbw_area['name']"/></a></t>
</div></div>
</xpath>
</template>
</odoo>